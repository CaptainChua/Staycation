/* ---------- Booking Approval: custom date-range picker (matches the calendar's) ---------- */
let apRangeStart = null, apRangeEnd = null;   // applied range (iso)
let apDpMonth = null, apDpPending = null, apDpHover = null;

function openApPicker(e){
    if(e) e.stopPropagation();
    const pop = document.getElementById("apDpPopup");
    if(pop.classList.contains("show")){ closeApPicker(); return; }
    apDpPending = null; apDpHover = null;
    const base = apRangeStart ? new Date(apRangeStart + "T00:00:00") : today();
    apDpMonth = new Date(base.getFullYear(), base.getMonth(), 1);
    apRenderPicker();
    pop.classList.add("show");
}
function closeApPicker(){ apDpPending = null; apDpHover = null; const p = document.getElementById("apDpPopup"); if(p) p.classList.remove("show"); }
function apPickerNav(dir){ apDpMonth = new Date(apDpMonth.getFullYear(), apDpMonth.getMonth() + dir, 1); apRenderPicker(); }

function apHighlightRange(){
    if(apDpPending){
        let end = (apDpHover && apDpHover >= apDpPending) ? apDpHover : apDpPending;
        if(daysBetween(apDpPending, end) > MAX_RANGE - 1) end = iso(addDays(new Date(apDpPending + "T00:00:00"), MAX_RANGE - 1));
        return { start: apDpPending, end };
    }
    if(apRangeStart) return { start: apRangeStart, end: apRangeEnd || apRangeStart };
    return { start: null, end: null };
}
function apRenderPicker(){
    const y = apDpMonth.getFullYear(), m = apDpMonth.getMonth();
    document.getElementById("apDpTitle").textContent = MONTHS[m] + " " + y;
    const startDay = new Date(y, m, 1).getDay();
    const daysInMonth = new Date(y, m + 1, 0).getDate();
    const todayIso = iso(today());
    let html = "";
    ["Su","Mo","Tu","We","Th","Fr","Sa"].forEach(d => html += `<div class="dp-wd">${d}</div>`);
    for(let i = 0; i < startDay; i++) html += `<div class="dp-day empty"></div>`;
    for(let d = 1; d <= daysInMonth; d++){
        const cellIso = iso(new Date(y, m, d));
        let cls = "dp-day"; if(cellIso === todayIso) cls += " today";
        html += `<div class="${cls}" data-iso="${cellIso}" onclick="apPickDay('${cellIso}')" onmouseover="apHoverDay('${cellIso}')"><span class="n">${d}</span></div>`;
    }
    document.getElementById("apDpGrid").innerHTML = html;
    apUpdateHighlight();
}
function apUpdateHighlight(){
    const { start, end } = apHighlightRange();
    document.querySelectorAll("#apDpGrid .dp-day").forEach(cell => {
        cell.classList.remove("sel","range-start","range-end","in-range");
        const ci = cell.dataset.iso; if(!ci || !start) return;
        if(ci === start && ci === end) cell.classList.add("sel");
        else if(ci === start) cell.classList.add("sel","range-start");
        else if(ci === end) cell.classList.add("sel","range-end");
        else if(ci > start && ci < end) cell.classList.add("in-range");
    });
    document.getElementById("apDpHint").textContent = apDpPending
        ? "Now click an end date (max " + MAX_RANGE + " days), or the same day for a single date"
        : "Click a date, then an end date for a range (max " + MAX_RANGE + " days)";
}
function apPickDay(cellIso){
    if(!apDpPending){ apDpPending = cellIso; apDpHover = cellIso; apUpdateHighlight(); return; }
    if(cellIso < apDpPending){ apDpPending = cellIso; apUpdateHighlight(); return; }
    let endIso = cellIso;
    if(daysBetween(apDpPending, endIso) > MAX_RANGE - 1) endIso = iso(addDays(new Date(apDpPending + "T00:00:00"), MAX_RANGE - 1));
    apApplyRange(apDpPending, endIso);
}
function apHoverDay(cellIso){ if(!apDpPending) return; apDpHover = cellIso; apUpdateHighlight(); }
function apApplyRange(startIso, endIso){
    apRangeStart = startIso; apRangeEnd = endIso;
    closeApPicker();
    apUpdateRangeLabel();
    renderApproval();
}
function apUpdateRangeLabel(){
    const lbl = document.getElementById("apRangeLabel");
    if(!lbl) return;
    lbl.textContent = apRangeStart
        ? (apRangeStart === apRangeEnd ? fmt(apRangeStart) : fmt(apRangeStart) + " – " + fmt(apRangeEnd))
        : "Pick dates";
}
function apDpToday(){ apApplyRange(iso(today()), iso(today())); }
function apDpClear(){ apRangeStart = null; apRangeEnd = null; closeApPicker(); apUpdateRangeLabel(); renderApproval(); }
// close the approval picker on outside click
document.addEventListener("click", e => {
    const pop = document.getElementById("apDpPopup");
    if(pop && pop.classList.contains("show") && !e.target.closest(".dp-wrap")) closeApPicker();
});

function rejectBooking(id){
    const b = bookings.find(x => x.id === id);
    if(!b) return;
    if(!confirm(`Delete this reserved booking for ${b.haven} (${primaryName(b)})? This frees the slot and can't be undone.`)) return;
    logActivity(`deleted unapproved booking — ${b.haven} (${primaryName(b)})`);
    b.deleted = true; b.deletedAt = new Date().toISOString();   // soft-delete: stamped so it can't resurrect
    _stampLocal(b);
    setLocalKey(KEY, bookings);
    bookingAction(id, "delete");                                // durable per-record soft-delete on the server
    bookings = bookings.filter(x => !x.deleted);                // hide from this view
    renderApproval();
    renderAll();
}

/* ============================================================
   PAYMENT APPROVAL — balance / add-on collections made TODAY
   (downpayments + new bookings are handled on Booking Approval)
   ============================================================ */
// flatten every booking's payment collected today into {b, idx, p} rows
// every booking's payment (with its date) — flattened into {b, idx, p} rows
function paymentRowsAll(){
    const rows = [];
    bookings.forEach(b => {
        (b.payments || []).forEach((p, idx) => {
            if(p && p.at) rows.push({ b, idx, p });
        });
    });
    return rows;
}
function paymentRowsToday(){
    const todayIso = iso(today());
    return paymentRowsAll().filter(r => iso(new Date(r.p.at)) === todayIso);
}
function pendingPaymentsToday(){ return paymentRowsToday().filter(r => r.p.approved !== true); }
function updatePaymentApprovalBadge(){
    const badge = document.getElementById("paymentApprovalBadge");
    if(!badge) return;
    const n = pendingPaymentsToday().length;
    badge.textContent = n ? String(n) : "";
}
// security deposits STILL to return: guests who have already checked out (checkout ≤ today), have a
// deposit, and it hasn't been marked returned yet.
// the day a booking's security deposit is due to be returned:
//  • overnight stays (check-out after check-in) → the check-out day
//  • same-day / day-use stays (check-out not after check-in) → the NEXT day (returned tomorrow)
function depReturnDate(b){
    if(!b || !b.checkout) return b && b.checkout;
    if(b.checkin && !(b.checkout > b.checkin)) return iso(addDays(new Date(b.checkout + "T00:00:00"), 1));
    return b.checkout;
}
function depositsToReturn(){
    const t = iso(today());
    return bookings.filter(b => { const rd = depReturnDate(b); return b && !b.cancelled && !b.depositReturned && Number(b.deposit || 0) > 0 && rd && rd <= t; }).length;
}
function updateDepositBadge(){
    const badge = document.getElementById("depositBadge");
    if(!badge) return;
    const n = depositsToReturn();
    badge.textContent = n ? String(n) : "";
}

let paStatus = "all";    // all | pending | approved
let paDate = "today";    // all | today | yesterday | range
function setPaStatus(st){
    paStatus = st;
    document.querySelectorAll("#paStatusSeg button").forEach(x => x.classList.toggle("active", x.dataset.st === st));
    renderPaymentApproval();
}
function setPaDate(dt){
    paDate = dt;
    document.querySelectorAll("#paDateSeg button").forEach(x => x.classList.toggle("active", x.dataset.dt === dt));
    const r = document.getElementById("paRange");
    if(r) r.style.display = dt === "range" ? "inline-flex" : "none";
    renderPaymentApproval();
}
function renderPaymentApproval(){
    updatePaymentApprovalBadge();
    let rows = paymentRowsAll();
    if(paStatus === "pending")       rows = rows.filter(r => r.p.approved !== true);
    else if(paStatus === "approved") rows = rows.filter(r => r.p.approved === true);
    const dOf = r => iso(new Date(r.p.at));
    if(paDate === "today")          rows = rows.filter(r => dOf(r) === iso(today()));
    else if(paDate === "yesterday") rows = rows.filter(r => dOf(r) === iso(addDays(today(), -1)));
    else if(paDate === "range" && ppRangeStart){
        rows = rows.filter(r => { const d = dOf(r); return d >= ppRangeStart && d <= (ppRangeEnd || ppRangeStart); });
    }
    rows.sort((a, b) => new Date(b.p.at) - new Date(a.p.at));   // newest first

    const scope = document.getElementById("paymentApprovalScope");
    const pendN = pendingPaymentsToday().length;
    if(scope) scope.textContent = pendN ? `— ${pendN} awaiting review today` : "— all clear today";

    const el = document.getElementById("paymentApprovalList");
    if(!rows.length){
        // if payments exist on OTHER dates, the empty result is just the date filter — nudge to widen it
        const anyExist = paymentRowsAll().length > 0;
        const dateNarrowed = (paDate !== "all");
        const msg = (anyExist && dateNarrowed)
            ? `No payments on the selected date.<div style="margin-top:12px;"><button class="btn secondary" onclick="setPaDate('all')">Show all dates</button></div>`
            : `No payments match this filter.`;
        el.innerHTML = `<div class="ap-empty"><div style="font-size:30px;margin-bottom:8px;">✅</div>${msg}</div>`;
        return;
    }
    el.innerHTML = rows.map(({ b, idx, p }) => {
        const cat = (p.category === "Add Ons") ? "addon" : "balance";
        const catLabel = p.category || "Balance";
        const proof = p.proof
            ? `<img class="ap-proof" src="${p.proof}" alt="Payment screenshot" onclick="apViewProof(this.src)">`
            : `<div class="ap-noproof">No payment screenshot uploaded</div>`;
        const flag = p.approved
            ? `<span class="ap-flag approved">✓ Approved</span>`
            : `<span class="ap-flag pending">Pending</span>`;
        const when = new Date(p.at).toLocaleString("en-PH", { month:"short", day:"numeric", hour:"numeric", minute:"2-digit" });
        const actions = p.approved
            ? `<button class="btn secondary" onclick="revertPayment(${b.id},${idx})">↺ Revert to pending</button>
               <button class="btn secondary ap-del" onclick="deletePaymentRow(${b.id},${idx})">🗑 Delete</button>`
            : `<button class="btn" onclick="approvePayment(${b.id},${idx})">✓ Approve</button>
               <button class="btn secondary ap-del" onclick="deletePaymentRow(${b.id},${idx})">🗑 Delete</button>`;
        return `<div class="panel ap-card">
            <div class="ap-head">
                <div>
                    <h3>${b.haven} <span class="ap-cat ${cat}">${catLabel}</span> ${flag}</h3>
                    <div class="ap-sub">${primaryName(b)}${b.contact ? " · " + b.contact : ""}${b.bookingNo ? " · " + b.bookingNo : ""}</div>
                </div>
                <div class="ap-actions">${actions}</div>
            </div>
            <div class="ap-body">
                <div class="ap-info">
                    <div class="ap-row"><span>Amount collected</span><b>${peso(p.amount || 0)}</b></div>
                    <div class="ap-row"><span>For</span><b>${catLabel}</b></div>
                    <div class="ap-row"><span>Mode of payment</span><b>${p.mop || "—"}</b></div>
                    <div class="ap-row"><span>Collected</span><b>${when}</b></div>
                    <div class="ap-row"><span>Recorded by</span><b>${p.by || "—"}</b></div>
                    <div class="ap-row"><span>Booking total</span><b>${peso(b.total || 0)}</b></div>
                    <div class="ap-row"><span>Balance remaining</span><b>${peso(balanceOf(b))}</b></div>
                </div>
                <div class="ap-proof-col">
                    <div class="ap-proof-label">Payment screenshot</div>
                    ${proof}
                </div>
            </div>
        </div>`;
    }).join("");
}
function approvePayment(bookingId, idx){
    const b = bookings.find(x => x.id === bookingId);
    if(!b || !b.payments || !b.payments[idx]) return;
    b.payments[idx].approved = true;
    bkPaymentEdit(b, idx);
    logActivity(`approved payment — ${b.haven} · ${peso(b.payments[idx].amount)} (${b.payments[idx].category || "Balance"})`);
    renderPaymentApproval();
    renderAll();
}
function revertPayment(bookingId, idx){
    const b = bookings.find(x => x.id === bookingId);
    if(!b || !b.payments || !b.payments[idx]) return;
    b.payments[idx].approved = false;
    bkPaymentEdit(b, idx);
    logActivity(`reverted payment approval — ${b.haven} · ${peso(b.payments[idx].amount)}`);
    renderPaymentApproval();
    renderAll();
}
function deletePaymentRow(bookingId, idx){
    const b = bookings.find(x => x.id === bookingId);
    if(!b || !b.payments || !b.payments[idx]) return;
    const p = b.payments[idx];
    if(!confirm(`Delete this ${p.category || "Balance"} payment of ${peso(p.amount)}? This cannot be undone.`)) return;
    b.payments.splice(idx, 1);
    const clearAddon = ('addonProof' in b) && !(b.payments || []).some(x => x.category === "Add Ons");
    if(clearAddon) delete b.addonProof;
    bkPaymentDelete(b, idx, p.pid);
    if(clearAddon) patchBooking(b.id, { addonProof: null });
    logActivity(`deleted ${p.category || "Balance"} payment — ${b.haven} · ${peso(p.amount)} (${p.mop})`);
    renderPaymentApproval();
    renderAll();
}

/* ---------- Payment Approval: custom date-range picker (matches the calendar's) ---------- */
let ppRangeStart = null, ppRangeEnd = null;
let ppDpMonth = null, ppDpPending = null, ppDpHover = null;
function openPpPicker(e){
    if(e) e.stopPropagation();
    const pop = document.getElementById("ppDpPopup");
    if(pop.classList.contains("show")){ closePpPicker(); return; }
    ppDpPending = null; ppDpHover = null;
    const base = ppRangeStart ? new Date(ppRangeStart + "T00:00:00") : today();
    ppDpMonth = new Date(base.getFullYear(), base.getMonth(), 1);
    ppRenderPicker();
    pop.classList.add("show");
}
function closePpPicker(){ ppDpPending = null; ppDpHover = null; const p = document.getElementById("ppDpPopup"); if(p) p.classList.remove("show"); }
function ppPickerNav(dir){ ppDpMonth = new Date(ppDpMonth.getFullYear(), ppDpMonth.getMonth() + dir, 1); ppRenderPicker(); }
function ppHighlightRange(){
    if(ppDpPending){
        let end = (ppDpHover && ppDpHover >= ppDpPending) ? ppDpHover : ppDpPending;
        if(daysBetween(ppDpPending, end) > MAX_RANGE - 1) end = iso(addDays(new Date(ppDpPending + "T00:00:00"), MAX_RANGE - 1));
        return { start: ppDpPending, end };
    }
    if(ppRangeStart) return { start: ppRangeStart, end: ppRangeEnd || ppRangeStart };
    return { start: null, end: null };
}
function ppRenderPicker(){
    const y = ppDpMonth.getFullYear(), m = ppDpMonth.getMonth();
    document.getElementById("ppDpTitle").textContent = MONTHS[m] + " " + y;
    const startDay = new Date(y, m, 1).getDay();
    const daysInMonth = new Date(y, m + 1, 0).getDate();
    const todayIso = iso(today());
    let html = "";
    ["Su","Mo","Tu","We","Th","Fr","Sa"].forEach(d => html += `<div class="dp-wd">${d}</div>`);
    for(let i = 0; i < startDay; i++) html += `<div class="dp-day empty"></div>`;
    for(let d = 1; d <= daysInMonth; d++){
        const cellIso = iso(new Date(y, m, d));
        let cls = "dp-day"; if(cellIso === todayIso) cls += " today";
        html += `<div class="${cls}" data-iso="${cellIso}" onclick="ppPickDay('${cellIso}')" onmouseover="ppHoverDay('${cellIso}')"><span class="n">${d}</span></div>`;
    }
    document.getElementById("ppDpGrid").innerHTML = html;
    ppUpdateHighlight();
}
function ppUpdateHighlight(){
    const { start, end } = ppHighlightRange();
    document.querySelectorAll("#ppDpGrid .dp-day").forEach(cell => {
        cell.classList.remove("sel","range-start","range-end","in-range");
        const ci = cell.dataset.iso; if(!ci || !start) return;
        if(ci === start && ci === end) cell.classList.add("sel");
        else if(ci === start) cell.classList.add("sel","range-start");
        else if(ci === end) cell.classList.add("sel","range-end");
        else if(ci > start && ci < end) cell.classList.add("in-range");
    });
    document.getElementById("ppDpHint").textContent = ppDpPending
        ? "Now click an end date (max " + MAX_RANGE + " days), or the same day for a single date"
        : "Click a date, then an end date for a range (max " + MAX_RANGE + " days)";
}
function ppPickDay(cellIso){
    if(!ppDpPending){ ppDpPending = cellIso; ppDpHover = cellIso; ppUpdateHighlight(); return; }
    if(cellIso < ppDpPending){ ppDpPending = cellIso; ppUpdateHighlight(); return; }
    let endIso = cellIso;
    if(daysBetween(ppDpPending, endIso) > MAX_RANGE - 1) endIso = iso(addDays(new Date(ppDpPending + "T00:00:00"), MAX_RANGE - 1));
    ppApplyRange(ppDpPending, endIso);
}
function ppHoverDay(cellIso){ if(!ppDpPending) return; ppDpHover = cellIso; ppUpdateHighlight(); }
function ppApplyRange(startIso, endIso){
    ppRangeStart = startIso; ppRangeEnd = endIso;
    closePpPicker();
    ppUpdateRangeLabel();
    renderPaymentApproval();
}
function ppUpdateRangeLabel(){
    const lbl = document.getElementById("ppRangeLabel");
    if(!lbl) return;
    lbl.textContent = ppRangeStart
        ? (ppRangeStart === ppRangeEnd ? fmt(ppRangeStart) : fmt(ppRangeStart) + " – " + fmt(ppRangeEnd))
        : "Pick dates";
}
function ppDpToday(){ ppApplyRange(iso(today()), iso(today())); }
function ppDpClear(){ ppRangeStart = null; ppRangeEnd = null; closePpPicker(); ppUpdateRangeLabel(); renderPaymentApproval(); }
