<div class="page" id="page-booking">
    <div class="panel">
        <div class="panel-head">
            <h2>Rates and Add Ons <span class="muted">— used by the website booking form</span></h2>
            <div>
                <button class="btn" onclick="saveBookingSettings()">💾 Save</button>
                <button class="btn secondary" onclick="resetBookingSettings()">↺ Reset</button>
            </div>
        </div>

        <div class="settings-section">
            <h3>Stay rates (₱)</h3>
            <div class="settings-form">
                <label>6 hours<input type="number" id="s_stay6"></label>
                <label>10 hours<input type="number" id="s_stay10"></label>
                <label>21 hours · Sun–Thu<input type="number" id="s_stay21Weekday"></label>
                <label>21 hours · Fri/Sat<input type="number" id="s_stay21Weekend"></label>
                <label>3+ nights · Sun–Thu (per night)<input type="number" id="s_longWeekday"></label>
