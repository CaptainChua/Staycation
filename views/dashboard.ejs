function anDelta(d){
    if(d == null || !isFinite(d)) return `<div class="delta"><span class="muted">— vs last month</span></div>`;
    const up = d >= 0;
    return `<div class="delta"><span class="pct${up ? "" : " down"}">${up ? "↑ +" : "↓ "}${d}%</span><span>vs last month</span></div>`;
}

let anPeriod = "month";   // day | week | month | year | custom
/* ---------- partner running-balance carry-over ---------- */
// Net for ONE month (partner-scoped: bookings/bills/expenses are already filtered to their haven).
// Mirrors the window computation so a month's standalone net matches what its own window shows.
function _partnerMonthNet(ym, commissionRate){
    const bk = bookings.filter(b => b.checkin && b.checkin.slice(0, 7) === ym);
    const live = bk.filter(b => !b.cancelled);
    const swimRateOf = b => (b.holiday ? PRICING.swimHoliday : PRICING.swimRegular);
    const gross  = bk.reduce((s, b) => s + paidOf(b), 0);
    const dep    = live.filter(b => b.depositReturned).reduce((s, b) => s + (Number(b.deposit) || 0), 0);
    const pool   = live.reduce((s, b) => s + (Number(b.swimpass) || 0) * swimRateOf(b), 0);
    const towel  = live.reduce((s, b) => s + (Number(b.towels) || 0) * PRICING.towel, 0);
    const refund = bk.filter(b => b.cancelled && b.dpRefunded).reduce((s, b) => s + paidOf(b), 0);
    const hk     = 100 * live.length;
    const billsPaidM = bills.filter(b => b.paid && b.due && b.due.slice(0, 7) === ym).reduce((s, b) => s + Number(b.amount || 0), 0);
    const expM       = expenses.filter(e => e.date && e.date.slice(0, 7) === ym).reduce((s, e) => s + Number(e.amount || 0), 0);
    const commission = (Number(commissionRate) || 0) * live.length;
    return gross - (dep + pool + towel + refund + hk + billsPaidM + expM + commission);
}
function _partnerEarliestMonth(){
    let min = null;
    const upd = ym => { if(ym && (!min || ym < min)) min = ym; };
    bookings.forEach(b => { if(b.checkin) upd(b.checkin.slice(0, 7)); });
    bills.forEach(b => { if(b.due) upd(b.due.slice(0, 7)); });
    expenses.forEach(e => { if(e.date) upd(e.date.slice(0, 7)); });
    return min;
}
// Running balance carried INTO the window's start month: sum every prior month's net; only a DEFICIT
// carries (a profitable month pays down the debt; once the balance is >= 0, nothing positive carries).
function _partnerCarryIn(startYm, commissionRate){
    const first = _partnerEarliestMonth();
    if(!first || first >= startYm) return 0;
    let bal = 0, d = new Date(first + "-01T00:00:00");
    for(let guard = 0; iso(d).slice(0, 7) < startYm && guard < 240; guard++){
        bal += _partnerMonthNet(iso(d).slice(0, 7), commissionRate);
        if(bal > 0) bal = 0;   // surplus clears the debt; nothing positive carries forward
        d = new Date(d.getFullYear(), d.getMonth() + 1, 1);
    }
    return bal;   // <= 0
}
function renderAnalytics(){
    HAVENS = havenNames();
    const t = today();

    // money collected in a calendar month "YYYY-MM"
    const incOf = ym => bookings.filter(b => b.checkin && b.checkin.slice(0,7) === ym).reduce((s,b) => s + analyticsRevenueOf(b), 0);
    const billsOf = ym => bills.filter(b => b.due && b.due.slice(0,7) === ym).reduce((s,b) => s + Number(b.amount||0), 0);
    const expSpendOf = ym => expenses.filter(e => e.date && e.date.slice(0,7) === ym).reduce((s,e) => s + Number(e.amount||0), 0);
    const payOf  = ym => staff.reduce((s,st) => s + staffGross(st, ym), 0);
    const bkCntOf = ym => bookings.filter(b => b.checkin && b.checkin.slice(0,7) === ym && !b.cancelled).length;

    // trailing-12-month series (always shown in the chart)
    const series = [];
    for(let i = 11; i >= 0; i--){
        const d = new Date(t.getFullYear(), t.getMonth() - i, 1);
        const ym = iso(d).slice(0,7);
        series.push({ label: MONTHS[d.getMonth()].slice(0,3), ym, inc: incOf(ym), exp: billsOf(ym) + payOf(ym) + expSpendOf(ym), bk: bkCntOf(ym) });
    }
    const cur = series[11], prev = series[10] || { inc:0, exp:0, bk:0 };
    const pct = (a, b) => b ? Math.round((a - b) / b * 1000) / 10 : null;

    // scope window for the cards (day-level so Daily/Weekly work precisely)
    const tIso = iso(t);
    let startIso, endIso, scopeText;
    if(anPeriod === "day"){ startIso = endIso = tIso; scopeText = "today · " + fmt(tIso); }
    else if(anPeriod === "week"){ startIso = iso(addDays(t, -6)); endIso = tIso; scopeText = "last 7 days"; }
    else if(anPeriod === "year"){ startIso = t.getFullYear() + "-01-01"; endIso = tIso; scopeText = "this year"; }
    else if(anPeriod === "custom" && anRangeStart){
        startIso = anRangeStart; endIso = anRangeEnd || anRangeStart;
        scopeText = fmt(startIso) + (startIso === endIso ? "" : " – " + fmt(endIso));
    } else { startIso = iso(new Date(t.getFullYear(), t.getMonth(), 1)); endIso = tIso; scopeText = "this month"; }   // monthly (default)
    const months = anMonthsBetween(startIso.slice(0,7), endIso.slice(0,7));
    const inWin = d => d && d >= startIso && d <= endIso;

    const bk = bookings.filter(b => inWin(b.checkin));
    const bl = bills.filter(b => inWin(b.due));
    const ex = expenses.filter(e => inWin(e.date));
    const _scopedPartner = !!(window.__PARTNER__ && !window.__PARTNER__.superAdmin);
    // GROSS — everything collected BEFORE any deduction (all cash in for the haven(s) in view).
    const gross = Math.round(bk.reduce((s,b) => s + paidOf(b), 0));
    const receivables = Math.round(bk.reduce((s,b) => s + balanceOf(b), 0));

    // ---- deductions from gross (admin; a partner's gross already excludes these) ----
    const _live = bk.filter(b => !b.cancelled);
    const swimRateOf = b => (b.holiday ? PRICING.swimHoliday : PRICING.swimRegular);
    const depTotal    = Math.round(_live.filter(b => b.depositReturned).reduce((s,b) => s + (Number(b.deposit)||0), 0));   // only deposits actually RETURNED
    const poolTotal   = Math.round(_live.reduce((s,b) => s + (Number(b.swimpass)||0) * swimRateOf(b), 0));      // pool passes
    const towelTotal  = Math.round(_live.reduce((s,b) => s + (Number(b.towels)||0) * PRICING.towel, 0));         // towels
    const damageTotal = Math.round(_live.reduce((s,b) => s + (Number(b.depositDeductAmount)||0), 0));            // damages kept from deposits
    const refundTotal = Math.round(bk.filter(b => b.cancelled && b.dpRefunded).reduce((s,b) => s + paidOf(b), 0)); // refunds on cancelled bookings
    const housekeepingTotal = 100 * _live.length;   // ₱100 per (non-cancelled) booking
    // deposit, pool pass, towels and cancellation refunds all go to the MAIN ADMIN — not the
    // partner — so they're deducted from gross. Damages kept are the admin's income (added back,
    // and only relevant to the admin view).
    const deductions    = depTotal + poolTotal + towelTotal + refundTotal + housekeepingTotal;
    const damagesIncome = _scopedPartner ? 0 : damageTotal;
    const netRevenue    = gross - deductions + damagesIncome;   // NET after deductions (+ damages for admin)

    const billsTotal  = Math.round(bl.reduce((s,b) => s + Number(b.amount||0), 0));
    const billsPaid   = bl.filter(b => b.paid).reduce((s,b) => s + Number(b.amount||0), 0);
    const billsPending = Math.round(billsTotal - billsPaid);
    const billsPendingAll = Math.round(bills.filter(b => !b.paid).reduce((s,b) => s + Number(b.amount||0), 0));   // ALL unpaid bills (matches the Bills page total)
    const billsPaidAll    = Math.round(bills.filter(b => b.paid).reduce((s,b) => s + Number(b.amount||0), 0));    // ALL paid bills → counted as an expense
    const payrollGross = Math.round(months.reduce((s,ym) => s + payOf(ym), 0));
    const payroll = _scopedPartner ? 0 : payrollGross;   // payroll is business-wide, not per-haven
    const expensesSpend = Math.round(ex.reduce((s,e) => s + Number(e.amount||0), 0));
    // "Add Funds" = money the owner put in from her own pocket (entered as a NEGATIVE expense).
    // Split it out so "Expenses (supplies)" shows only real spend and Add Funds shows as a green credit.
    const addFundsSpend = Math.round(ex.filter(e => (e.type || "") === "Add Funds").reduce((s,e) => s + Number(e.amount||0), 0));   // negative
    const suppliesSpend = expensesSpend - addFundsSpend;   // real supplies spend, excludes owner top-ups
    const addFundsCredit = -addFundsSpend;                 // positive amount the owner added
    const totalExpenses = billsTotal + payroll + expensesSpend;
    const netProfit = netRevenue - totalExpenses;
    const leftAfterBE = netRevenue - billsTotal - expensesSpend;
    // partner: Total Expenses = deductions + PAID bills DUE IN THIS PERIOD + supplies + commission.
    // Use the windowed billsPaid (NOT all-time billsPaidAll) so a bill paid in June doesn't also
    // count against July — each paid bill hits only the month it's due.
    // Per-booking commission owed by this partner (rate set on their record) — deducted from their net.
    let commissionRate = 0;
    if(_scopedPartner){
        try{
            const _ps = window.__PARTNER__ || {};
            const _pl = JSON.parse(localStorage.getItem("shph_partners")) || [];
            const _me = _pl.find(function(p){ return String(p.id) === String(_ps.id); });
            commissionRate = _me ? Number(_me.rate || 0) : 0;
        }catch(e){}
    }
    const commissionTotal = Math.round(commissionRate * _live.length);   // per-booking rate × successful bookings
    const partnerExp = deductions + billsPaid + expensesSpend + commissionTotal;
    const partnerNet = gross - partnerExp;   // Gross − Total Expenses (this window only)
    // running balance: fold in any deficit carried from prior months so July opens at June's net, etc.
    const carriedIn = _scopedPartner ? Math.round(_partnerCarryIn(startIso.slice(0, 7), commissionRate)) : 0;
    const partnerNetRunning = partnerNet + carriedIn;

    document.getElementById("anScope").textContent =
        `All units combined — bookings, bills, payroll &amp; expenses · ${scopeText}`;
    const _bkEl = document.getElementById("anBookings"); if(_bkEl) _bkEl.textContent = _live.length;   // successful (non-cancelled) bookings, shown in the header

    // ---- big KPI cards ----
    let kpis;
    if(_scopedPartner){
        // Partner layout: Gross → Total Expenses → NET (Bookings shown as a mini below)
        kpis = [
            ["Gross", peso(gross), "#2e7d4f", AN_ICO.trendUp, "ic-green", null],
            ["Total expenses", peso(partnerExp), "var(--hv-terra-d)", AN_ICO.trendDown, "ic-terra", null],
            [carriedIn < 0 ? "NET (incl. carry-over)" : "NET (after bills & expenses)", peso(partnerNetRunning), partnerNetRunning >= 0 ? "#2e7d4f" : "#c0283d", AN_ICO.piggy, "ic-green", null]
        ];
    } else {
        kpis = [
            ["Collected (gross)", peso(gross), "#2e7d4f", AN_ICO.trendUp, "ic-green", pct(cur.inc, prev.inc)],
            ["Net (after deductions)", peso(netRevenue), netRevenue >= 0 ? "#2e7d4f" : "#c0283d", AN_ICO.piggy, "ic-green", null],
            ["Net profit", peso(netProfit), netProfit >= 0 ? "#2e7d4f" : "#c0283d", AN_ICO.piggy, "ic-green", pct(cur.inc - cur.exp, prev.inc - prev.exp)],
            ["Total expenses", peso(totalExpenses), "var(--hv-terra-d)", AN_ICO.trendDown, "ic-terra", pct(cur.exp, prev.exp)]
        ];
    }
    document.getElementById("anCards").innerHTML = kpis.map(k => `
        <div class="kpi">
            <div class="top"><span class="lbl">${k[0]}</span><span class="ico ${k[4]}">${k[3]}</span></div>
            <div class="val" style="color:${k[2]}">${k[1]}</div>
            ${anDelta(k[5])}
        </div>`).join("");

    // ---- compact cards ----  (m[4] = optional value colour)
    const RED = "#c0283d";
    const minis = [];
    if(_scopedPartner && carriedIn < 0) minis.push(["Carried over from last month", "−" + peso(-carriedIn), AN_ICO.hour, "ic-terra", RED]);
    if(!_scopedPartner) minis.push(["Receivables (pending)", peso(receivables), AN_ICO.hour, "ic-gold"]);
    // partner: "Pending Bills" = the unpaid balances still to collect (same as the Pending/Unpaid figure)
    minis.push(_scopedPartner
        ? ["Pending Bills", "−" + peso(billsPending), AN_ICO.hour, "ic-gold", RED]
        : ["Total bills", peso(billsTotal), AN_ICO.receipt, "ic-terra"]);
    minis.push(_scopedPartner
        ? ["Expenses (supplies)", "−" + peso(suppliesSpend), AN_ICO.receipt, "ic-green", RED]
        : ["Expenses (supplies)", peso(suppliesSpend), AN_ICO.receipt, "ic-green"]);
    // Add Funds — money the owner added from her own pocket (a credit) → GREEN
    minis.push(["Add Funds", "+" + peso(addFundsCredit), AN_ICO.receipt, "ic-green", "#2e7d4f"]);
    // Bills pending + Payroll are admin-only (business-wide; not shown on the partner view)
    if(!_scopedPartner) minis.push(
        ["Bills pending", peso(billsPending), AN_ICO.receipt, "ic-terra"],
        ["Payroll (gross)", peso(payrollGross), AN_ICO.badge, "ic-purple"]
    );
    // deductions from gross — shown in red (these go to the main admin, not the partner)
    minis.push(
        ["Security deposit", "−" + peso(depTotal), AN_ICO.receipt, "ic-terra", RED],
        ["Pool pass", "−" + peso(poolTotal), AN_ICO.receipt, "ic-terra", RED],
        ["Towels", "−" + peso(towelTotal), AN_ICO.receipt, "ic-terra", RED],
        ["Housekeeping", "−" + peso(housekeepingTotal), AN_ICO.receipt, "ic-terra", RED],
        ["Refunds (cancelled)", "−" + peso(refundTotal), AN_ICO.receipt, "ic-terra", RED]
    );
    // per-booking commission — partner view only (rate × successful bookings), deducted from their net
    if(_scopedPartner) minis.push(["Commission", "−" + peso(commissionTotal), AN_ICO.receipt, "ic-terra", RED]);
    // damages kept are the admin's income (not the partner's) → admin view only
    if(!_scopedPartner) minis.push(["Damages (kept → admin)", "+" + peso(damageTotal), AN_ICO.receipt, "ic-green", "#2e7d4f"]);
    document.getElementById("anMini").innerHTML = minis.map(m => `
        <div class="mini"><span class="ico ${m[3]}">${m[2]}</span>
            <div><div class="lbl">${m[0]}</div><div class="mval"${m[4] ? ` style="color:${m[4]}"` : ""}>${m[1]}</div></div>
        </div>`).join("");

    // ---- revenue vs expenses chart (trailing 12 months) ----
    const maxV = Math.max(1, ...series.map(s => Math.max(s.inc, s.exp)));
    document.getElementById("anChart").innerHTML = `<div class="chart">${series.map(s => `
        <div class="col">
            <div class="bars">
                <div class="bar inc" style="height:${Math.round(s.inc / maxV * 100)}%" title="Income ${peso(Math.round(s.inc))}"></div>
                <div class="bar exp" style="height:${Math.round(s.exp / maxV * 100)}%" title="Expenses ${peso(Math.round(s.exp))}"></div>
            </div>
            <div class="mlabel">${s.label}</div>
        </div>`).join("")}</div>`;
    const dNet = pct(cur.inc - cur.exp, prev.inc - prev.exp);
    document.getElementById("anChartLegend").innerHTML = `<div class="chart-legend">
        <span class="k"><span class="sw" style="background:#5aa873"></span>Income</span>
        <span class="k"><span class="sw" style="background:#bd6e3f"></span>Expenses</span>
        <span class="chart-net">↗ Net ${peso(_scopedPartner ? partnerNet : netProfit)}${dNet != null ? ` · ${dNet >= 0 ? "+" : ""}${dNet}%` : ""}</span>
    </div>`;

    // ---- revenue by haven ----
    const havenRev = HAVENS.map(h => ({
        label: h,
        value: Math.round(bk.filter(b => b.haven === h).reduce((s,b) => s + netCollectedOf(b), 0)),
        color: havenColors(h).am
    })).filter(x => x.value > 0).sort((a,b) => b.value - a.value);
    document.getElementById("anHavenRevenue").innerHTML =
        havenRev.length ? anHBars(havenRev, havenRev.reduce((s,x) => s + x.value, 0)) : `<p class="muted">No revenue yet.</p>`;

    // ---- expenses: bills vs payroll + bills by haven ----
    const expTotal = (billsTotal + payrollGross + expensesSpend) || 1;
    const billsW = Math.round(billsTotal / expTotal * 100);
    const payW   = Math.round(payrollGross / expTotal * 100);
    const expW   = Math.max(0, 100 - billsW - payW);
    const billCats = (typeof BILL_HAVENS !== "undefined") ? BILL_HAVENS : HAVENS;
    const havenBills = billCats.map(h => ({
        label: h,
        value: Math.round(bl.filter(b => b.haven === h).reduce((s,b) => s + Number(b.amount||0), 0)),
        color: havenColors(h).am
    })).filter(x => x.value > 0).sort((a,b) => b.value - a.value);
    const expByType = (typeof EXPENSE_TYPES !== "undefined" ? EXPENSE_TYPES : []).map(tp => ({
        label: tp,
        value: Math.round(ex.filter(e => e.type === tp).reduce((s,e) => s + Number(e.amount||0), 0)),
        color: "#3f9e6a"
    })).filter(x => x.value > 0).sort((a,b) => b.value - a.value);
    document.getElementById("anExpenses").innerHTML = `
        <div class="stack"><div class="seg-bills" style="width:${billsW}%"></div><div class="seg-pay" style="width:${payW}%"></div><div class="seg-exp" style="width:${expW}%"></div></div>
        <div class="stack-legend">
            <span class="k"><span class="sw" style="background:#bd6e3f"></span>Bills <b>${peso(billsTotal)}</b> · ${billsW}%</span>
            <span class="k"><span class="sw" style="background:#9a3db8"></span>Payroll <b>${peso(payrollGross)}</b> · ${payW}%</span>
            <span class="k"><span class="sw" style="background:#3f9e6a"></span>Expenses <b>${peso(expensesSpend)}</b> · ${expW}%</span>
        </div>
        <div class="sub-h">Bills by haven / category</div>
        ${havenBills.length ? anHBars(havenBills, havenBills.reduce((s,x) => s + x.value, 0)) : `<p class="muted">No bills yet.</p>`}
        <div class="sub-h">Expenses by type</div>
        ${expByType.length ? anHBars(expByType, expByType.reduce((s,x) => s + x.value, 0)) : `<p class="muted">No expenses yet.</p>`}`;
}
