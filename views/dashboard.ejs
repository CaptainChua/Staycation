const PROOF_CFG = {
    down:   { nameId:"downProofName",   imgId:"downProofImg",   thumbId:"downProofThumb",   fileId:"downProofFile"   },
    addon:  { nameId:"addonProofName",  imgId:"addonProofImg",  thumbId:"addonProofThumb",  fileId:"addonProofFile"  },
    extend: { nameId:"extendProofName", imgId:"extendProofImg", thumbId:"extendProofThumb", fileId:"extendProofFile" },
    bal:    { nameId:"balProofName",    imgId:"balProofImg",    thumbId:"balProofThumb"    }
};
let addonShownPayIdx = -1;   // payments[] index when the add-ons image is a collection's photo (else -1)
// shared core: accept an image File from the picker, a drop, or a paste
function applyProofFile(type, f){
    const cfg = PROOF_CFG[type];
    if(!cfg || !f || !/^image\//.test(f.type)) return;
    setProofName(cfg.nameId, f);
    resizeImage(f, dataUrl => {
        if(type === "down")   downProofData = dataUrl;
        if(type === "addon")  addonProofData = dataUrl;
        if(type === "extend") extendProofData = dataUrl;
        if(type === "bal"){ balProofData = dataUrl; balProofDirty = true; }
