// keep the From/To inputs in step with whatever window is shown
function syncFinInputs(){
    const from = document.getElementById("finFrom");
    const to = document.getElementById("finTo");
    if(from) from.value = iso(rangeStart);
    if(to) to.value = iso(addDays(rangeStart, viewDays - 1));
}
// apply an explicit start/end window (inclusive) and refresh everything
function finSetRange(startIso, endIso){
    viewMode = "custom";
    rangeStart = new Date(startIso + "T00:00:00");
    viewDays = Math.max(1, daysBetween(startIso, endIso) + 1);
    filterToWindow = true;
    closePicker();
    renderSummary();
    renderTimeline();
    renderTable();
}
function finQuickChange(){
    const v = document.getElementById("finQuick").value;
    const t = today();
    if(v === "today")      finSetRange(iso(t), iso(t));
    else if(v === "week")  finSetRange(iso(t), iso(addDays(t, 6)));
    else if(v === "month"){
        const start = new Date(t.getFullYear(), t.getMonth(), 1);
        const end   = new Date(t.getFullYear(), t.getMonth() + 1, 0);
        finSetRange(iso(start), iso(end));
    }
    else if(v === "year"){
        const start = new Date(t.getFullYear(), 0, 1);
        const end   = new Date(t.getFullYear(), 11, 31);
        finSetRange(iso(start), iso(end));
    }
    // "Custom range" -> let the user edit From/To, then click Apply
}
// which preset (if any) a From/To window matches — keeps the dropdown in sync
function matchQuick(fromIso, toIso){
    const t = today();
    if(fromIso === iso(t) && toIso === iso(t)) return "today";
    if(fromIso === iso(t) && toIso === iso(addDays(t, 6))) return "week";
    const mStart = new Date(t.getFullYear(), t.getMonth(), 1);
    const mEnd   = new Date(t.getFullYear(), t.getMonth() + 1, 0);
    if(fromIso === iso(mStart) && toIso === iso(mEnd)) return "month";
    const yStart = new Date(t.getFullYear(), 0, 1);
    const yEnd   = new Date(t.getFullYear(), 11, 31);
    if(fromIso === iso(yStart) && toIso === iso(yEnd)) return "year";
    return ""; // custom
}
function finApply(){
    const from = document.getElementById("finFrom").value;
    let to = document.getElementById("finTo").value || from;
    if(!from){ alert("Please pick a From date."); return; }
    if(to < from) to = from;
    // only fall back to "Custom range" if the dates don't match a preset
    document.getElementById("finQuick").value = matchQuick(from, to);
    finSetRange(from, to);
}
// Finance Overview quick ranges: This month / a chosen month of this year / This year
function finThisMonth(){
    const t = today();
    const mp = document.getElementById("finMonthPick"); if(mp) mp.value = "";
    finSetRange(iso(new Date(t.getFullYear(), t.getMonth(), 1)), iso(new Date(t.getFullYear(), t.getMonth() + 1, 0)));
}
function finThisYear(){
    const t = today();
    const mp = document.getElementById("finMonthPick"); if(mp) mp.value = "";
    finSetRange(iso(new Date(t.getFullYear(), 0, 1)), iso(new Date(t.getFullYear(), 11, 31)));
}
function finPickMonth(m){
    if(m === "" || m == null) return;
    const y = today().getFullYear(), mi = Number(m);
    finSetRange(iso(new Date(y, mi, 1)), iso(new Date(y, mi + 1, 0)));
}

/* ---------- calendar timeline ---------- */
function tlHourShort(h){ const ap = h < 12 ? "a" : "p"; let hh = h % 12; if(hh === 0) hh = 12; return hh + ap; }

// single-day view → hourly timeline; the hour window auto-fits the day's bookings
// (starts at the earliest check-in, ends at the latest check-out; empty hours are hidden)
function renderTimelineHours(){
    const grid = document.getElementById("timeline");
    const day = rangeStart, dayIso = iso(day);
    const rl = document.getElementById("rangeLabel"); if(rl) rl.textContent = fmt(dayIso);
    const dl = document.getElementById("tlDayLabel");
    if(dl) dl.textContent = day.toLocaleDateString("en-PH", { weekday:"long", month:"long", day:"numeric" });

    // collect the bookings active on this day, with their start/end minute within the day.
    // dayIso <= coIso (inclusive) so a stay that started earlier and checks out THIS morning
    // is still considered — but its guest bar is NOT drawn; instead we show only its cleaning
    // window and the time the haven becomes available (see the draw loop below).
    const dayBookings = [];
    bookings.forEach(b => {
        if(b.cancelled) return;                                        // cancelled → haven is free
        if(!bkMatchesSearch(b, calSearch)) return;                     // calendar search filter
        if(!HAVENS.includes(b.haven)) return;
        const coIso = b.checkout > b.checkin ? b.checkout : iso(addDays(new Date(b.checkin + "T00:00:00"), 1));
        if(!(b.checkin <= dayIso && dayIso <= coIso)) return;          // active this day (incl. the check-out morning)
        const ciMin = bookingCheckinMin(b);
        // multi-night overnight stays occupy the full span up to the check-out morning
        const iv = bookingInterval(b);
        const durMin = iv.end - iv.start;
        const dDiff = daysBetween(b.checkin, dayIso);                   // 0 = same day, >0 = carried over
        const startMin = Math.max(0, dDiff === 0 ? ciMin : 0);
        const endMin = Math.min(1440, ciMin + durMin - dDiff * 1440);
        if(endMin <= startMin) return;
        const departsToday = endMin < 1440;                            // the actual check-out is this day
        const carryover = dDiff > 0;                                   // came from an earlier day
        dayBookings.push({ b, startMin, endMin, departsToday, carryover });
    });

    // the visible time range each booking contributes to the window:
    //  • carry-over checking out today → only its cleaning block [check-out, free-at]
    //  • carry-over still in-house all day → its occupied span (neutral, rare multi-night)
    //  • a booking starting today → its own bar, plus its cleaning block if it ends today
    const visRange = x => {
        if(x.carryover && x.departsToday) return [x.startMin, Math.min(1440, x.endMin + CLEANING_GAP_MIN)]; // occupied span + cleaning
        if(x.carryover)                    return [x.startMin, x.endMin];
        return [x.startMin, x.departsToday ? Math.min(1440, x.endMin + CLEANING_GAP_MIN) : x.endMin];
    };

    // derive the visible hour window
    let HS = 0, HE = 24;
    if(dayBookings.length){
        const minStart = Math.min(...dayBookings.map(x => visRange(x)[0]));
        const maxEnd   = Math.max(...dayBookings.map(x => visRange(x)[1]));
        HS = Math.max(0, Math.floor(minStart / 60));
        HE = Math.min(24, Math.ceil(maxEnd / 60));
    } else {
        HS = 6; HE = 22;                                               // sensible default when nothing booked
    }
    if(HE - HS < 2){ HE = Math.min(24, HS + 2); }                      // keep at least a 2-hour span
    const HOURS = HE - HS;

    grid.style.gridTemplateColumns = `140px repeat(${HOURS}, 1fr)`;

    let html = `<div class="tl-haven tl-head">Haven</div>`;
    for(let h = HS; h < HE; h++)
        html += `<div class="tl-cell tl-head tl-hr">${(h - HS) % 2 === 0 ? tlHourShort(h) : ""}</div>`;

    const havenRows = calHaven ? HAVENS.filter(h => h === calHaven) : HAVENS;
    havenRows.forEach(haven => {
        const dot = havenColors(haven).am;
        html += `<div class="tl-haven"><span class="tl-dot" style="background:${dot}"></span>${haven}</div>`;
        for(let h = HS; h < HE; h++) html += `<div class="tl-cell tl-hr" data-h="${haven}" data-hr="${h}"></div>`;
    });
    grid.innerHTML = html;

    const winStart = HS * 60, winEnd = HE * 60;
    // draw one positioned block in a haven row; returns nothing
    function drawBlock(haven, sMin, eMin, opts){
        const s = Math.max(winStart, Math.min(winEnd, sMin));
        const e = Math.max(winStart, Math.min(winEnd, eMin));
        if(e <= s) return;
        const firstCell = grid.querySelector(`.tl-cell[data-h="${cssEscape(haven)}"][data-hr="${HS}"]`);
        if(!firstCell) return;
        const hourW = firstCell.offsetWidth, rowTop = firstCell.offsetTop, cellH = firstCell.offsetHeight;
        const el = document.createElement("div");
        el.className = opts.className || "bar";
        if(opts.bg) el.style.background = opts.bg;
        if(opts.color) el.style.color = opts.color;
        if(opts.borderLeft) el.style.borderLeft = opts.borderLeft;
        if(opts.label != null) el.textContent = opts.label;
        if(opts.title) el.title = opts.title;
        if(opts.onclick) el.onclick = opts.onclick;
        el.style.left = (firstCell.offsetLeft + ((s - winStart) / 60) * hourW + 2) + "px";
        el.style.width = Math.max(opts.minW || 10, ((e - s) / 60) * hourW - 4) + "px";
        el.style.top = (rowTop + 7) + "px";
        el.style.height = (cellH - 14) + "px";
        el.style.bottom = "auto";
        grid.appendChild(el);
    }

    dayBookings.forEach(({ b, startMin, endMin, departsToday, carryover }) => {
        const freeAt = minToTime(Math.min(1440, endMin + CLEANING_GAP_MIN));
        // a cleaning / turnaround block, labelled with when the haven is then available
        const drawCleaning = () => drawBlock(b.haven, endMin, endMin + CLEANING_GAP_MIN, {
            className: "bar bar-clean",
            label: "🧹 free " + freeAt,
            title: `${b.haven} — cleaning / turnaround, available from ${freeAt}`,
            minW: 6
        });

        if(carryover && departsToday){
            // still in-house today until check-out → show it OCCUPIED up to check-out, then the
            // cleaning/turnaround window with the available-from time.
            drawBlock(b.haven, startMin, endMin, {
                className: "bar bar-clean", label: "occupied",
                title: `${b.haven} — occupied until ${minToTime(endMin)} (${guestNames(b)}) · free at ${freeAt}`
            });
            drawCleaning();
        } else if(carryover){
            // still in-house all day (multi-night middle day): neutral "occupied" block, no details
            drawBlock(b.haven, startMin, endMin, {
                className: "bar bar-clean", label: "occupied", title: `${b.haven} — occupied all day`
            });
        } else {
            // a booking that STARTS today → show it normally
            drawBlock(b.haven, startMin, endMin, {
                bg: havenColor(b), color: "#222",
                borderLeft: "5px solid " + (STATUS_COLOR[statusOf(b)] || "#999"),
                label: (b.fbName || primaryName(b)) + (b.slot ? " (" + (b.slot === "morning" ? "AM" : "PM") + ")" : ""),
                title: `${guestNames(b)} • ${checkinTimeStr(b)}→${checkoutTimeStr(b)}`
                    + (departsToday ? ` • free at ${freeAt} (after cleaning)` : "")
                    + ` • ${peso(paidOf(b))}/${peso(b.total)}`,
                onclick: () => openModal(b.id)
            });
            if(departsToday) drawCleaning();
        }
    });
}

function renderTimeline(){
    HAVENS = havenNames();                                  // stay in sync with the Havens page
    if(viewDays === 1){ renderTimelineHours(); return; }   // hourly single-day view
    const dl = document.getElementById("tlDayLabel"); if(dl) dl.textContent = "";
    const grid = document.getElementById("timeline");
    const dates = [];
    for(let i=0;i<viewDays;i++) dates.push(addDays(rangeStart, i));

    // grid: first column = haven label, then one column per day
    grid.style.gridTemplateColumns = `140px repeat(${viewDays}, 1fr)`;

    document.getElementById("rangeLabel").textContent =
        viewDays === 1
            ? fmt(iso(dates[0]))
            : fmt(iso(dates[0])) + " – " + fmt(iso(dates[viewDays-1]));

    const todayIso = iso(today());

    let html = "";
    // header row
    html += `<div class="tl-haven tl-head">Haven</div>`;
    dates.forEach(d => {
        const wd = d.getDay();
        const weekend = (wd === 0 || wd === 6) ? "weekend" : "";
        const isToday = iso(d) === todayIso ? "is-today" : "";
        html += `<div class="tl-cell tl-head ${weekend} ${isToday}">
            ${d.toLocaleDateString("en-PH",{weekday:"short"})}<br>${d.getDate()}
        </div>`;
    });

    // one row per haven (optionally filtered to a single haven)
    const havenRows = calHaven ? HAVENS.filter(h => h === calHaven) : HAVENS;
    havenRows.forEach(haven => {
        html += `<div class="tl-haven">${haven}</div>`;
        // empty cells across the window (bars get absolutely positioned into a relative wrapper per row)
        for(let i=0;i<viewDays;i++){
            const isToday = iso(dates[i]) === todayIso ? "is-today" : "";
            html += `<div class="tl-cell ${isToday}" data-h="${haven}" data-i="${i}"></div>`;
        }
    });

    grid.innerHTML = html;

    // place bars
    const rangeStartIso = iso(rangeStart);
    const rangeEndIso = iso(addDays(rangeStart, viewDays)); // exclusive
    // First pass: figure out which bookings are visible and the columns they span.
    const placed = [];
    bookings.forEach(b => {
        if(b.cancelled) return;                                        // cancelled → not shown / haven free
        if(!bkMatchesSearch(b, calSearch)) return;                     // calendar search filter
        if(!HAVENS.includes(b.haven)) return;
        // exclusive end day for display; same-day (6h) bookings occupy 1 day
        const coIso = b.checkout > b.checkin ? b.checkout : iso(addDays(new Date(b.checkin + "T00:00:00"), 1));
        if(!(b.checkin < rangeEndIso && coIso > rangeStartIso)) return; // outside window

        const startIdx = Math.max(0, daysBetween(rangeStartIso, b.checkin));
        const endIdx = Math.min(viewDays, daysBetween(rangeStartIso, coIso));
        const span = endIdx - startIdx;
        if(span <= 0) return;
        placed.push({ b, startIdx, endIdx, span, lane: 0, lanes: 1 });
    });

    // Second pass: pack overlapping stays in the same haven into vertical LANES so two
    // bookings on the same day are BOTH visible (e.g. a 6h day-use + a 21h overnight),
    // instead of the full-height bar hiding the other. Only the overlapping cluster is
    // split — standalone stays still use the full row height / AM-PM halves below.
    HAVENS.forEach(haven => {
        const items = placed.filter(p => p.b.haven === haven)
                            .sort((a,c) => a.startIdx - c.startIdx || a.endIdx - c.endIdx);
        let i = 0;
        while(i < items.length){
            const cluster = [items[i]];
            let maxEnd = items[i].endIdx, j = i + 1;
            while(j < items.length && items[j].startIdx < maxEnd){      // transitively overlapping
                cluster.push(items[j]);
                if(items[j].endIdx > maxEnd) maxEnd = items[j].endIdx;
                j++;
            }
            const laneEnds = [];                                        // greedy lane colouring
            cluster.forEach(p => {
                let lane = laneEnds.findIndex(end => end <= p.startIdx);
                if(lane === -1) lane = laneEnds.length;
                laneEnds[lane] = p.endIdx;
                p.lane = lane;
            });
            cluster.forEach(p => p.lanes = laneEnds.length);
            i = j;
        }
    });

    // place bars
    placed.forEach(({ b, startIdx, span, lane, lanes }) => {
        // find the first cell of this haven row to anchor position
        const firstCell = grid.querySelector(`.tl-cell[data-h="${cssEscape(b.haven)}"][data-i="0"]`);
        if(!firstCell) return;

        const bar = document.createElement("div");
        bar.className = "bar";
        bar.style.background = havenColor(b);
        bar.style.color = "#222";
        bar.style.borderLeft = "5px solid " + (STATUS_COLOR[statusOf(b)] || "#999");
        if(viewMode === "month"){
            // This Month view: show a colored stay-shape instead of the guest name
            bar.textContent = stayShape(b);
            bar.classList.add("bar-shape");
        } else {
            bar.textContent = (b.fbName || primaryName(b)) + (b.slot ? " (" + (b.slot==="morning"?"AM":"PM") + ")" : "");
        }
        bar.title = `${guestNames(b)} • ${fmt(b.checkin)}${b.checkout>b.checkin?"→"+fmt(b.checkout):""}` +
            `${b.slot ? " • " + slotLabel(b.slot) : ""} • ${peso(paidOf(b))}/${peso(b.total)}`;
        bar.onclick = () => openModal(b.id);

        // position relative to the timeline grid using cell widths
        const cellWidth = firstCell.offsetWidth;
        const rowTop = firstCell.offsetTop;
        const cellH = firstCell.offsetHeight;
        bar.style.left = (firstCell.offsetLeft + startIdx*cellWidth + 2) + "px";
        bar.style.width = (span*cellWidth - 4) + "px";
        if(lanes > 1){
            // stacked: one horizontal slice per overlapping booking so all are visible
            const pad = 4, gap = 2;
            const laneH = (cellH - pad*2 - gap*(lanes-1)) / lanes;
            bar.style.top = (rowTop + pad + lane*(laneH + gap)) + "px";
            bar.style.height = laneH + "px";
        } else if(b.slot === "morning"){
            // time map: 6h AM = top half, 6h PM = bottom half, longer stays = full height
            bar.style.top = (rowTop + 4) + "px";
            bar.style.height = (cellH/2 - 5) + "px";
        } else if(b.slot === "evening"){
            bar.style.top = (rowTop + cellH/2 + 1) + "px";
            bar.style.height = (cellH/2 - 5) + "px";
        } else {
            bar.style.top = (rowTop + 7) + "px";
            bar.style.height = (cellH - 14) + "px";
        }
        bar.style.bottom = "auto";
        grid.appendChild(bar);
    });
}

function cssEscape(s){ return s.replace(/"/g, '\\"'); }

function shiftWeek(dir){
    closePicker();
    viewMode = "custom";
    rangeStart = addDays(rangeStart, dir*viewDays); renderSummary(); renderTimeline(); renderTable();
}
function showToday(){
    closePicker();
    viewMode = "today";
    viewDays = 1; filterToWindow = true; rangeStart = today(); renderSummary(); renderTimeline(); renderTable();
}
function showWeek(){
    closePicker();
    viewMode = "week";
    viewDays = DAYS; filterToWindow = false; rangeStart = today(); renderSummary(); renderTimeline(); renderTable();
}
function showYesterday(){
    closePicker();
    viewMode = "custom"; viewDays = 1; filterToWindow = true;
    rangeStart = addDays(today(), -1); renderSummary(); renderTimeline(); renderTable();
}
function showTomorrow(){
    closePicker();
    viewMode = "custom"; viewDays = 1; filterToWindow = true;
    rangeStart = addDays(today(), 1); renderSummary(); renderTimeline(); renderTable();
}
function setCalHaven(v){
    calHaven = v;
    renderTimeline(); // only the calendar rows change; table keeps its own haven filter
}
function setCalSearch(v){
    calSearch = (v || "").toLowerCase().trim();
    if(calSearch){
        // if there are matches but none fall in the current date window, jump to the earliest match's
        // check-in so the search actually surfaces bookings from any month.
        const matches = bookings.filter(b => b && !b.cancelled && bkMatchesSearch(b, calSearch));
        if(matches.length){
            const winStart = iso(rangeStart), winEnd = iso(addDays(rangeStart, viewDays));
            const inWindow = matches.some(b => {
                const co = b.checkout > b.checkin ? b.checkout : iso(addDays(new Date(b.checkin + "T00:00:00"), 1));
                return b.checkin < winEnd && co > winStart;
            });
            if(!inWindow){
                const earliest = matches.map(b => b.checkin).filter(Boolean).sort()[0];
                if(earliest) rangeStart = new Date(earliest + "T00:00:00");
            }
        }
    }
    renderTimeline();   // filter the timeline bars to matching bookings
}
function showThisMonth(){
    closePicker();
    const t = today();
    viewMode = "month";
    rangeStart = new Date(t.getFullYear(), t.getMonth(), 1);        // 1st of this month
    viewDays = new Date(t.getFullYear(), t.getMonth() + 1, 0).getDate(); // days in this month
    filterToWindow = true;
    renderSummary(); renderTimeline(); renderTable();
}

/* ---------- remember the calendar view across refreshes ---------- */
const VIEW_KEY = "shph_dashboard_view";
function saveView(){
    try{ localStorage.setItem(VIEW_KEY, JSON.stringify({ mode: viewMode, start: iso(rangeStart), viewDays, filterToWindow })); }catch(e){}
}
function restoreView(){
    let v;
    try{ v = JSON.parse(localStorage.getItem(VIEW_KEY)); }catch(e){ v = null; }
    if(!v) return;
    viewMode = v.mode || "week";
    if(viewMode === "today"){ viewDays = 1; filterToWindow = true; rangeStart = today(); }
    else if(viewMode === "week"){ viewDays = DAYS; filterToWindow = false; rangeStart = today(); }
    else if(viewMode === "month"){
        const t = today();
        rangeStart = new Date(t.getFullYear(), t.getMonth(), 1);
        viewDays = new Date(t.getFullYear(), t.getMonth() + 1, 0).getDate();
        filterToWindow = true;
    }
    else if(v.start){ rangeStart = new Date(v.start + "T00:00:00"); viewDays = Number(v.viewDays) || DAYS; filterToWindow = !!v.filterToWindow; }
}

/* ---------- custom date picker ---------- */
const MONTHS = ["January","February","March","April","May","June",
    "July","August","September","October","November","December"];
let pickerMonth = today();

function openDatePicker(e){
    if(e) e.stopPropagation();
    const pop = document.getElementById("dpPopup");
    if(pop.classList.contains("show")){ closePicker(); return; }
    pendingStart = null; hoverIso = null;
    pickerMonth = new Date(rangeStart.getFullYear(), rangeStart.getMonth(), 1);
    renderPicker();
    pop.classList.add("show");
}
function closePicker(){
    pendingStart = null; hoverIso = null;
    document.getElementById("dpPopup").classList.remove("show");
}

function pickerNav(dir){
    pickerMonth = new Date(pickerMonth.getFullYear(), pickerMonth.getMonth()+dir, 1);
    renderPicker();
}

// figure out which start/end to highlight (mid-selection preview, or the applied window)
function highlightRange(){
    if(pendingStart){
        let end = (hoverIso && hoverIso >= pendingStart) ? hoverIso : pendingStart;
        // clamp the preview to the max range
        if(daysBetween(pendingStart, end) > MAX_RANGE - 1){
            end = iso(addDays(new Date(pendingStart + "T00:00:00"), MAX_RANGE - 1));
        }
        return { start: pendingStart, end };
    }
    return { start: iso(rangeStart), end: iso(addDays(rangeStart, viewDays - 1)) };
}

// build the month grid once (only on open / month change), then highlight via classes
function renderPicker(){
    const y = pickerMonth.getFullYear();
    const m = pickerMonth.getMonth();
    document.getElementById("dpTitle").textContent = MONTHS[m] + " " + y;

    const startDay = new Date(y, m, 1).getDay();
    const daysInMonth = new Date(y, m+1, 0).getDate();
    const todayIso = iso(today());

    const allowPast = (typeof payrollIsAdmin === "function") ? payrollIsAdmin() : true; // admins can view past records
    let html = "";
    ["Su","Mo","Tu","We","Th","Fr","Sa"].forEach(d => html += `<div class="dp-wd">${d}</div>`);
    for(let i=0;i<startDay;i++) html += `<div class="dp-day empty"></div>`;
    for(let d=1; d<=daysInMonth; d++){
        const cellIso = iso(new Date(y, m, d));
        const blocked = (cellIso < todayIso) && !allowPast;
        let cls = "dp-day";
        if(blocked) cls += " disabled";
        if(cellIso === todayIso) cls += " today";
        const handlers = blocked ? "" : `onclick="pickDay('${cellIso}')" onmouseover="hoverDay('${cellIso}')"`;
        html += `<div class="${cls}" data-iso="${cellIso}" ${handlers}><span class="n">${d}</span></div>`;
    }
    document.getElementById("dpGrid").innerHTML = html;
    updateHighlight();
}

// recolor cells for the current selection/preview WITHOUT rebuilding the DOM
function updateHighlight(){
    const { start, end } = highlightRange();
    document.querySelectorAll("#dpGrid .dp-day").forEach(cell => {
        cell.classList.remove("sel","range-start","range-end","in-range");
        const ci = cell.dataset.iso;
        if(!ci) return;
        if(ci === start && ci === end) cell.classList.add("sel");
        else if(ci === start) cell.classList.add("sel","range-start");
        else if(ci === end) cell.classList.add("sel","range-end");
        else if(ci > start && ci < end) cell.classList.add("in-range");
    });
    document.getElementById("dpHint").textContent = pendingStart
        ? "Now click an end date (max " + MAX_RANGE + " days), or the same day for a single date"
        : "Click a date, then an end date for a range (max " + MAX_RANGE + " days)";
}

function pickDay(cellIso){
    if(!pendingStart){
        // first click: start the selection, keep popup open
        pendingStart = cellIso;
        hoverIso = cellIso;
        updateHighlight();
        return;
    }
    // second click
    if(cellIso < pendingStart){
        // clicked an earlier day -> restart from there
        pendingStart = cellIso;
        updateHighlight();
        return;
    }
    let endIso = cellIso;
    if(daysBetween(pendingStart, endIso) > MAX_RANGE - 1){
        endIso = iso(addDays(new Date(pendingStart + "T00:00:00"), MAX_RANGE - 1));
    }
    applyRange(pendingStart, endIso);
}

function hoverDay(cellIso){
    if(!pendingStart) return;
    hoverIso = cellIso;
    updateHighlight();
}

function applyRange(startIso, endIso){
    viewMode = "custom";
    rangeStart = new Date(startIso + "T00:00:00");
    viewDays = daysBetween(startIso, endIso) + 1; // inclusive (1 = single date)
    filterToWindow = true;
    closePicker();
    renderSummary();
    renderTimeline();
    renderTable();
}

function dpToday(){ applyRange(iso(today()), iso(today())); }
function dpClear(){ showWeek(); }

// close picker when clicking outside it
document.addEventListener("click", e => {
    if(!e.target.closest(".dp-wrap")) closePicker();
});

/* ---------- table ---------- */
function renderTable(){
    renderCancelled();   // keep the separate cancelled panel in sync with the filters
    const haven = document.getElementById("filterHaven").value;
    const status = document.getElementById("filterStatus").value;
    const search = document.getElementById("filterSearch").value.toLowerCase();

    let rows = bookings.filter(b => {
        if(b.cancelled) return false;          // cancelled bookings live in their own panel below
        if(haven && b.haven !== haven) return false;
        if(status && statusOf(b) !== status) return false;
        if(!bkMatchesSearch(b, search)) return false;
        return true;
    });

    // when a date / range is picked, limit the table to bookings overlapping that window
    const title = document.getElementById("bookingsTitle");
    if(filterToWindow){
        const startIso = iso(rangeStart);
        const endIso = iso(addDays(rangeStart, viewDays)); // exclusive
        rows = rows.filter(b => b.checkin < endIso && endExcl(b) > startIso);
        title.textContent = viewDays === 1
            ? "Bookings — " + fmt(startIso)
            : "Bookings — " + fmt(startIso) + " – " + fmt(iso(addDays(rangeStart, viewDays-1)));
    } else {
        title.textContent = "Bookings";
    }

    rows.sort((a,b) => a.checkin.localeCompare(b.checkin));

    const tbody = document.getElementById("tableBody");
    const pager = document.getElementById("bookingsPager");
    if(rows.length === 0){
        tbody.innerHTML = `<tr><td colspan="12" class="empty">No bookings match.</td></tr>`;
        if(pager) pager.innerHTML = "";
        return;
    }

    // paginate: 10 per page
    const pages = Math.ceil(rows.length / BOOKINGS_PER_PAGE);
    bookingsPage = Math.min(Math.max(0, bookingsPage), pages - 1);
    const pageRows = rows.slice(bookingsPage * BOOKINGS_PER_PAGE, bookingsPage * BOOKINGS_PER_PAGE + BOOKINGS_PER_PAGE);

    tbody.innerHTML = pageRows.map(b => {
        const balance = balanceOf(b);
        const st = statusOf(b);
        return `<tr>
            <td><strong>${b.haven}</strong></td>
            <td>${guestSummary(b)}<br><span class="muted">${b.contact||""}</span></td>
            <td>${fmt(b.checkin)}<br><span class="muted">${checkinTimeStr(b)}</span></td>
            <td>${fmt(b.checkout)}<br><span class="muted">${checkoutTimeStr(b)}</span></td>
            <td>${b.stayHours ? b.stayHours + "h" + (Number(b.stayHours)===6 && b.slot ? "<br><span class='muted'>"+(b.slot==="morning"?"AM":"PM")+"</span>" : "") : "—"}</td>
            <td>${b.swimpass>0 ? b.swimpass : '<span class="muted">—</span>'}</td>
            <td>${b.towels>0 ? b.towels : '<span class="muted">—</span>'}</td>
            <td>${b.extend>0 ? "+"+b.extend+"h" : '<span class="muted">—</span>'}</td>
            <td>${peso(b.downpayment)}</td>
            <td>${balance>0 ? `<span class="bal-due">${peso(balance)}</span>` : '<span class="bal-clear">₱0</span>'}</td>
            <td><span class="status ${st}">${st}</span></td>
            <td class="actions">
                <span class="edit" style="color:var(--hv-terra-d);" onclick="viewBooking(${b.id})">View</span>
                ${window.__PARTNER__ ? "" : `<span class="edit" onclick="openModal(${b.id})">Edit</span>
                <span class="cancel" onclick="cancelBooking(${b.id})">Cancel</span>
                <span class="del" onclick="deleteBooking(${b.id})">Delete</span>`}
            </td>
        </tr>`;
    }).join("");

    renderBookingsPager(pages);
}

const BOOKINGS_PER_PAGE = 10;
let bookingsPage = 0;

function resetBookingsPage(){ bookingsPage = 0; renderTable(); }
function gotoBookingsPage(n){ bookingsPage = n; renderTable(); }

function renderBookingsPager(pages){
    const pager = document.getElementById("bookingsPager");
    if(!pager) return;
    if(pages <= 1){ pager.innerHTML = ""; return; }
    let html = `<button class="page-btn" onclick="gotoBookingsPage(${bookingsPage - 1})" ${bookingsPage === 0 ? "disabled" : ""}>‹</button>`;
    for(let i = 0; i < pages; i++){
        html += `<button class="page-btn ${i === bookingsPage ? "active" : ""}" onclick="gotoBookingsPage(${i})">${i + 1}</button>`;
    }
    html += `<button class="page-btn" onclick="gotoBookingsPage(${bookingsPage + 1})" ${bookingsPage >= pages - 1 ? "disabled" : ""}>›</button>`;
    pager.innerHTML = html;
}

// separate panel listing cancelled bookings (same haven/search/date filters as the main table)
function renderCancelled(){
    const panel = document.getElementById("cancelledPanel");
    const body = document.getElementById("cancelledBody");
    const countEl = document.getElementById("cancelledCount");
    if(!panel || !body) return;

    const haven = document.getElementById("filterHaven").value;
    const search = document.getElementById("filterSearch").value.toLowerCase();
    let rows = bookings.filter(b => b.cancelled);
    if(haven) rows = rows.filter(b => b.haven === haven);
    if(search) rows = rows.filter(b => bkMatchesSearch(b, search));
    if(filterToWindow){
        const startIso = iso(rangeStart);
        const endIso = iso(addDays(rangeStart, viewDays)); // exclusive
        rows = rows.filter(b => b.checkin < endIso && endExcl(b) > startIso);
    }
    rows.sort((a,b) => (b.cancelledAt || "").localeCompare(a.cancelledAt || ""));

    if(rows.length === 0){ panel.style.display = "none"; body.innerHTML = ""; if(countEl) countEl.textContent = ""; return; }
    panel.style.display = "";
    if(countEl) countEl.textContent = `(${rows.length})`;
    body.innerHTML = rows.map(b => {
        const when = b.cancelledAt
            ? new Date(b.cancelledAt).toLocaleDateString("en-PH", { month:"short", day:"numeric" })
            : "—";
        return `<tr class="row-cancelled">
            <td><strong>${b.haven}</strong></td>
            <td>${guestSummary(b)}<br><span class="muted">${b.contact||""}</span></td>
            <td>${fmt(b.checkin)}<br><span class="muted">${checkinTimeStr(b)}</span></td>
            <td>${fmt(b.checkout)}<br><span class="muted">${checkoutTimeStr(b)}</span></td>
            <td>${b.stayHours ? b.stayHours + "h" : "—"}</td>
            <td>${b.dpRefunded
                ? `<span style="text-decoration:line-through;color:#a99;">${peso(paidOf(b))}</span> <span style="color:#2e7d4f;font-weight:700;font-size:11px;">refunded</span>`
                : peso(paidOf(b))}
                <div><span class="reinstate" style="font-size:12px;" onclick="toggleDpRefund(${b.id})">${b.dpRefunded ? "Undo refund" : "Mark DP refunded"}</span></div></td>
            <td>${when}</td>
            <td class="actions">
                <span class="reinstate" style="color:var(--hv-terra-d);" onclick="viewBooking(${b.id})">View</span>
                <span class="reinstate" onclick="reinstateBooking(${b.id})">Reinstate</span>
                <span class="del" onclick="deleteBooking(${b.id})">Delete</span>
            </td>
        </tr>`;
    }).join("");
}

// mark a cancelled booking's kept downpayment as refunded (or undo) — keeps the record,
// but removes the money from Finance/Analytics revenue (netCollectedOf returns 0).
function toggleDpRefund(id){
    const b = bookings.find(x => x.id === id);
    if(!b) return;
    if(!b.dpRefunded){
        if(!confirm(`Mark the ${peso(paidOf(b))} downpayment as REFUNDED to ${primaryName(b)}?\n\n`
            + `• It is removed from Finance & Analytics revenue.\n`
            + `• The cancelled booking record stays here for your records.`)) return;
        b.dpRefunded = true;
        b.dpRefundedAt = new Date().toISOString();
        logActivity(`refunded downpayment — ${b.haven} (${primaryName(b)}) · ${peso(paidOf(b))}`);
    } else {
        if(!confirm(`Undo the refund — put the ${peso(paidOf(b))} back into Finance revenue?`)) return;
        b.dpRefunded = false;
        delete b.dpRefundedAt;
        logActivity(`reverted downpayment refund — ${b.haven} (${primaryName(b)})`);
    }
    bkSave(b, b.dpRefunded ? { dpRefunded:true, dpRefundedAt:b.dpRefundedAt } : { dpRefunded:false, dpRefundedAt:null });
    renderAll();
}

async function deleteBooking(id){
    if(!confirm("Delete this booking?")) return;
    const b = bookings.find(x => x.id === id);
    if(b) logActivity(`deleted booking — ${b.haven} (${primaryName(b)})`);
    bookings = bookings.filter(b => b.id !== id);
    renderAll();   // instant feedback (in-memory)
    await bookingAction(id, "delete");   // durable tiny write so a quick refresh can't lose it
}

// cancel a booking: the guest backed out, so free the haven — but the downpayment is
// non-refundable, so the record stays and its collected money remains in Finance.
async function cancelBooking(id){
    const b = bookings.find(x => x.id === id);
    if(!b) return;
    const kept = paidOf(b);   // non-refundable: downpayment + anything already collected
    if(!confirm(`Cancel this booking for ${primaryName(b)} (${b.haven})?\n\n`
        + `• The haven is freed for new bookings.\n`
        + `• The ${peso(kept)} already paid is non-refundable and stays in Finance.\n`
        + `• The remaining balance is no longer due.`)) return;
    b.cancelled = true;
    b.cancelledAt = new Date().toISOString();
    renderAll();   // instant feedback (in-memory)
    logActivity(`cancelled booking — ${b.haven} (${primaryName(b)}); kept ${peso(kept)} non-refundable`);
    await bookingAction(id, "cancel");   // durable tiny write so a quick refresh can't lose it
}

// undo a cancellation, but only if the haven/time hasn't since been taken by another booking
async function reinstateBooking(id){
    const b = bookings.find(x => x.id === id);
    if(!b) return;
    const clash = findConflictAdmin(b, id);
    if(clash){
        alert(`Can't reinstate — ${b.haven} is now booked by ${primaryName(clash)} at that time. `
            + `Edit the dates/time first, then reinstate.`);
        return;
    }
    delete b.cancelled;
    delete b.cancelledAt;
    renderAll();   // instant feedback (in-memory)
    logActivity(`reinstated booking — ${b.haven} (${primaryName(b)})`);
    await bookingAction(id, "reinstate");   // durable tiny write so a quick refresh can't lose it
}

