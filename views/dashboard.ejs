}
function readOtSlots(){
    return [...document.querySelectorAll("#d_ot_list .ot-row")].map(r => ({
        in: r.querySelector(".ot-in").value,
        out: r.querySelector(".ot-out").value
    })).filter(o => o.in && o.out);
