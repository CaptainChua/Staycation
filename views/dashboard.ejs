        const proofCol = b.downProof
            ? `<div class="ap-proof-col">
                   <button type="button" class="ap-proof2" data-src="${String(b.downProof).replace(/"/g, "&quot;")}" onclick="apViewProof(this.dataset.src)">
                       <span class="zoom">🔍</span>
