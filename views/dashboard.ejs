/* ---------- Expenses (whole-business operating spend) ---------- */
const EXPENSE_TYPES = ["Laundry", "Supplies", "Tissues", "Fabcon", "Sponge",
    "Trashbags", "Cleaning agents", "Lalamove", "Dishwashing liquid", "Albatross",
    "Netflix", "Add Funds", "Housekeeping", "Towels", "Swimpass", "Others"];
const EXPENSES_KEY = "shph_expenses_v1";
function loadExpenses(){ try { return (JSON.parse(localStorage.getItem(EXPENSES_KEY)) || []).filter(x => !x.deleted); } catch(e){ return []; } }
let expenses = loadExpenses();
// (expenses are saved PER-RECORD via saveOneRecord/deleteOneRecord + setLocalKey — see below)
// PER-RECORD write helpers (like payments/deposits): touch ONE item on the server so a save
// can never overwrite the rest of the list. The item's base64 images (receipts) are offloaded
// server-side. Local copy updated WITHOUT a whole-array push. Returns true if the server confirmed.
// A scoped (non-super-admin) partner sees Bills & Expenses READ-ONLY. Enforce it at the ONE choke
// point every finance write funnels through — so it can't be bypassed by a future/renamed writer
// (the fragility that let partners write finance after the per-record refactor). Buttons are also
// hidden in partners.js; this is the defense-in-depth backstop.
function _partnerReadOnlyKey(key){
    return !!(window.__PARTNER__ && !window.__PARTNER__.superAdmin && (key === BILLS_KEY || key === EXPENSES_KEY));
}
// a scoped (non-super-admin) partner is READ-ONLY everywhere — use this to block writes that don't go
// through saveOneRecord/deleteOneRecord (e.g. security-deposit returns) and to hide their action buttons.
function _partnerReadOnly(){ return !!(window.__PARTNER__ && !window.__PARTNER__.superAdmin); }
async function saveOneRecord(key, item){
    if(_partnerReadOnlyKey(key)) return false;
    try{ const res = await fetch("/api/list/" + encodeURIComponent(key), { method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify({ upsert: item }) }); return res.ok; }catch(e){ return false; }
}
async function deleteOneRecord(key, id){
    if(_partnerReadOnlyKey(key)) return false;
    try{ const res = await fetch("/api/list/" + encodeURIComponent(key), { method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify({ del: id }) }); return res.ok; }catch(e){ return false; }
}
function setLocalKey(key, val){ try{ (window.shphSetLocal || localStorage.setItem.bind(localStorage))(key, JSON.stringify(val)); }catch(e){} }
// A short, human-friendly reservation code shown to guests instead of the long internal id (which
// must stay unchanged — every per-record save matches on it). Generated ONCE per booking from an
// unambiguous charset (no I/L/O/0/1), checked unique against existing codes, and persisted per-record
// so it's stable forever.
// Booking code = a short, STABLE, unique code DERIVED from the (already-unique) booking id — a hash,
// so it is IDENTICAL on the Edit header, the confirmation card, and the PDF, and can NEVER change.
// No randomness, no storage, no regeneration: same id → same 6-char code, forever.
function deriveCode(id){
    const CH = "ABCDEFGHJKMNPQRSTUVWXYZ23456789";   // 30 unambiguous chars (no I/L/O/0/1)
    let h = 2166136261 >>> 0;                        // FNV-1a hash of the id
    const s = String(id == null ? "" : id);
    for(let i=0;i<s.length;i++){ h ^= s.charCodeAt(i); h = Math.imul(h, 16777619) >>> 0; }
    let c = "";
    for(let i=0;i<6;i++){ c += CH.charAt(h % CH.length); h = Math.imul(h ^ (h >>> 13), 2654435761) >>> 0; }
    return c;
}
function bookingCode(b){ return (b && b.id != null) ? deriveCode(b.id) : ""; }
// Collision-resistant record id. `Math.max(...ids)+1` makes two browsers generate the SAME id at
// once, so a per-record save silently overwrites the other user's new record. A millisecond stamp
// (×1000) plus 3 random digits, kept strictly increasing within this tab, makes that practically
// impossible. Stays a safe integer (Date.now()*1000 ≈ 1.8e15 < 9.0e15) so all id math still works.
let _uidLast = 0;
function uid(){
    let t = Date.now() * 1000 + Math.floor(Math.random() * 1000);
    if(t <= _uidLast) t = _uidLast + 1;   // never repeat within a burst (e.g. linked haven segments)
    _uidLast = t;
    return t;
}
function expMonthKey(d){ return (d || "").slice(0, 7); }                 // "YYYY-MM"
function expMonthLabel(m){ return new Date(m + "-01T00:00:00").toLocaleDateString("en-PH", { month:"long", year:"numeric" }); }

