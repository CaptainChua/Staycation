/* ---------- payroll PDF (via the browser's print → Save as PDF) ---------- */
function staffPayslipSection(s, scope){
    const days = staffDaysInRange(s, scope.start, scope.end).slice().sort((a, b) => (a.date || "").localeCompare(b.date || ""));
    const gross = rangeGross(s, scope.start, scope.end);
    const dd = rangeDeductions(s, scope.start, scope.end);
    const net = gross - dd.total;
    let table;
    if(s.role === "CSR"){
        const span = (a, b) => (a && b) ? `${time12(a)}–${time12(b)}` : "—";
        const rows = days.map(d => {
            const reg = d.dayOff ? 0 : regHoursOf(d), ot = d.dayOff ? 0 : otHoursOf(d), nd = d.dayOff ? 0 : nightDiffOf(d);
            return `<tr><td>${fmt(d.date)}${d.dayOff ? " (day off)" : ""}${d.notes ? "<br><i>" + escHtml(d.notes) + "</i>" : ""}</td>
                <td>${(d.dayOff || d.amOff) ? "—" : span(d.timeIn, d.timeOut)}</td><td>${(d.dayOff || d.pmOff) ? "—" : span(d.pmIn, d.pmOut)}</td>
                <td>${otSlotsOf(d).map(o => span(o.in, o.out)).filter(x => x !== "—").join("<br>") || "—"}</td><td>${d.dayOff ? "—" : reg.toFixed(2)}</td><td>${ot ? ot.toFixed(2) + (nd ? " +0.5 ND" : "") : "—"}</td>
                <td>${peso2(dayPay(s, d))}</td></tr>`;
        }).join("");
        table = `<table><thead><tr><th>Date</th><th>Morning</th><th>Afternoon</th><th>OT</th><th>Reg hrs</th><th>OT hrs</th><th>Pay</th></tr></thead>
            <tbody>${rows || '<tr><td colspan="7">No entries</td></tr>'}</tbody></table>`;
    } else {
        const usesBooked = s.role === "ASSIST" || s.role === "COMMISSION";
        const rows = days.map(d => {
            const rooms = roomsForDay(s, d);
            return `<tr><td>${fmt(d.date)}${d.notes ? "<br><i>" + escHtml(d.notes) + "</i>" : ""}</td><td>${rooms}</td><td>${peso2(dayPay(s, d))}</td></tr>`;
        }).join("");
        table = `<table><thead><tr><th>Date</th><th>${usesBooked ? "Rooms booked" : "Rooms cleaned"}</th><th>Pay</th></tr></thead>
            <tbody>${rows || '<tr><td colspan="3">No entries</td></tr>'}</tbody></table>`;
    }
    const ded = s.role === "COMMISSION" ? "No deductions"
        : `SSS ${peso2(dd.sss)} · PhilHealth ${peso2(dd.philhealth)} · Pag-IBIG ${peso2(dd.pagibig)} · Loan ${peso2(dd.loan)}`;
    return `<section class="staff">
        <h2>${escHtml(s.name)}</h2>
        <div class="role">${ROLE_LABEL[s.role]} · ${ROLE_RATE_INFO[s.role]}</div>
        ${table}
        <div class="ded"><b>Deductions:</b> ${ded}</div>
        <div class="totals">Gross: <b>${peso2(gross)}</b> &nbsp;·&nbsp; Deductions: <b>−${peso2(dd.total)}</b> &nbsp;·&nbsp; <b>Net: ${peso2(net)}</b></div>
    </section>`;
}
function buildPayslipHtml(list, scope){
    const printed = new Date().toLocaleString("en-PH");
    const sections = list.length ? list.map(s => staffPayslipSection(s, scope)).join("") : "\x3Cp>No staff.\x3C/p>";
    // tags are written with \x3C (renders as "<") so the inline script can never
    // be confused by full-document tags inside this string
    const css = "body{ font-family:Arial,sans-serif; color:#222; margin:24px; }"
        + "h1{ font-size:20px; margin:0 0 2px; }"
        + ".meta{ color:#666; font-size:12px; margin-bottom:16px; }"
        + ".staff{ border:1px solid #ddd; border-radius:8px; padding:14px 16px; margin-bottom:16px; page-break-inside:avoid; }"
        + ".staff h2{ font-size:16px; margin:0; }"
        + ".role{ color:#666; font-size:12px; margin-bottom:10px; }"
        + "table{ width:100%; border-collapse:collapse; font-size:12px; margin-bottom:8px; }"
        + "th,td{ border:1px solid #e3e3e3; padding:5px 7px; text-align:left; }"
        + "th{ background:#f6f6f6; }"
        + ".ded{ font-size:12px; color:#444; margin-top:4px; }"
        + ".totals{ font-size:13px; margin-top:6px; }"
        + "@media print{ .staff{ page-break-inside:avoid; } }";
    return `\x3C!DOCTYPE html>\x3Chtml>\x3Chead>\x3Cmeta charset="utf-8">\x3Ctitle>Payroll — Staycation Haven PH\x3C/title>`
        + `\x3Cstyle>${css}\x3C/style>\x3C/head>\x3Cbody>`
        + `\x3Ch1>Staycation Haven PH — Payroll\x3C/h1>`
        + `\x3Cdiv class="meta">Period: ${scope.label} &nbsp;·&nbsp; ${list.length} staff &nbsp;·&nbsp; Printed ${printed}\x3C/div>`
        + sections
        + `\x3C/body>\x3C/html>`;
}
function openPrint(html){
    const w = window.open("", "_blank");
    if(!w){ alert("Please allow pop-ups so the PDF can open, then choose “Save as PDF” in the print dialog."); return; }
    w.document.write(html);
    w.document.close();
    setTimeout(function(){ try { w.focus(); w.print(); } catch(e){} }, 350);
}
function downloadPayrollPdf(){
    const scope = resolveScope(document.getElementById("payFilterCutoff").value);
    const fStaff = document.getElementById("payFilterStaff").value;
    const fRole  = document.getElementById("payFilterRole").value;
    const list = staff.filter(s => (!fStaff || String(s.id) === fStaff) && (!fRole || s.role === fRole));
    openPrint(buildPayslipHtml(list, scope));
}
function downloadStaffPdf(id){
    const scope = resolveScope(document.getElementById("payFilterCutoff").value);
    const s = staff.find(x => x.id === id);
    if(!s) return;
    openPrint(buildPayslipHtml([s], scope));
}

