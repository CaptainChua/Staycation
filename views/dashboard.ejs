@media print{
    @page{ size:A4; margin:0; }
    body{ padding:0 !important; background:#fff !important; }
    .sidebar, #appTopbar, #gfToolbar, .m-topbar, .mobile-only, .gfToolbar-inline{ display:none !important; }
    .page{ display:none !important; }
    #page-guestform.active{ display:block !important; }
    .gf-doc{ gap:0; }
    .gf-page{ box-shadow:none; border:none; width:100%; page-break-after:always; }
    .gf-page:last-child{ page-break-after:auto; }
    input.gf-ov:focus, input.gf-ov:hover{ background:transparent; }
    .gf-idphoto{ box-shadow:none; }
    .gf-idphoto .gf-idbtns, .gf-idphoto .gf-resize{ display:none !important; }
}
</style>
<div class="page" id="page-guestform">
    <div class="topbar" style="margin-bottom:14px;">
        <h2 style="font-size:20px;">Guest Form <span class="muted" style="font-size:13px;">— M Place Guest Move-In Clearance</span></h2>
        <div style="display:flex; gap:8px;">
            <button class="btn secondary" id="gfPdfBtn" onclick="gfSavePdf()">💾 Save as PDF</button>
        </div>
    </div>

    <!-- toolbar: pick a booking to auto-fill the form -->
    <div id="gfToolbar">
        <div class="field">
            <label>Haven</label>
            <select id="gf_haven" onchange="gfHavenChanged()"></select>
        </div>
        <div class="field">
            <label>Check-in date</label>
            <div class="dp-wrap">
                <div class="dpi-input" id="gf_date_pill" onclick="openGfCal(event)">Pick date</div>
                <div class="dp-popup" id="gf_date_popup" onclick="event.stopPropagation()">
                    <div class="dp-head">
                        <button type="button" onclick="gfCalNav(-1)">‹</button>
                        <span id="gf_date_title"></span>
                        <button type="button" onclick="gfCalNav(1)">›</button>
                    </div>
                    <div class="dp-grid" id="gf_date_grid"></div>
                    <div class="dp-foot"><span onclick="gfCalToday()">Today</span></div>
                </div>
                <input type="hidden" id="gf_date">
            </div>
        </div>
        <button class="btn" onclick="gfLoadBooking()">Load booking</button>
        <button class="btn secondary" onclick="gfClear()">Clear</button>
        <span class="muted" id="gf_pickMsg" style="align-self:center;"></span>
    </div>

    <!-- the printable document: the original form image + overlaid fields -->
    <div class="gf-doc" id="gfDoc">
        <!-- PAGE 1 — the form -->
        <div class="gf-page" id="gfPage1">
            <img class="gf-bg" src="images/guest-form-1.png" alt="Guest Move-In Clearance Form">
            <!-- overlay inputs injected here by gfBuildOverlay() -->
        </div>

        <!-- PAGE 2 — guest IDs -->
        <div class="gf-page" id="gfPage2">
            <img class="gf-bg" src="images/guest-form-id.png" alt="Unit IDs page">
            <input class="gf-ov big" id="gff_unit2" style="left:20.5%; top:3.3%; width:30%;" readonly>
            <div class="gfToolbar-inline" style="position:absolute; top:3.2%; right:3%; text-align:right;">
                <label class="btn" style="cursor:pointer; font-size:13px;">⬆ Upload guest IDs
                    <input type="file" id="gf_idFiles" accept="image/*" multiple onchange="gfAddIdPhotos(event)" style="display:none;">
                </label>
                <div class="muted" style="font-size:11px; margin-top:4px;">These print on this page</div>
            </div>
            <div class="gf-ids" id="gf_idGallery"></div>
        </div>
    </div>
</div><!-- /page-guestform -->

<!-- ===== Finance ===== -->
<div class="page" id="page-finance">
    <!-- finance header + date filter -->
    <div class="topbar" style="margin-bottom:18px;">
        <h2 style="font-size:20px;">Finance Overview</h2>
        <div class="filters fin-filter">
            <select id="finHaven" onchange="renderHavenAnalytics()"></select>
            <button class="btn secondary" onclick="finThisMonth()">This month</button>
            <select id="finMonthPick" onchange="finPickMonth(this.value)" style="padding:9px 14px; border:1px solid var(--hv-line); border-radius:10px; background:#faf6ee; font-family:inherit; font-size:13px; color:var(--hv-ink); cursor:pointer;">
                <option value="">Choose month…</option>
                <option value="0">January</option>
                <option value="1">February</option>
                <option value="2">March</option>
                <option value="3">April</option>
                <option value="4">May</option>
                <option value="5">June</option>
                <option value="6">July</option>
                <option value="7">August</option>
                <option value="8">September</option>
                <option value="9">October</option>
                <option value="10">November</option>
                <option value="11">December</option>
            </select>
            <button class="btn secondary" onclick="finThisYear()">This Year</button>
        </div>
    </div>
    <!-- summary cards -->
    <div class="cards" id="summaryCards"></div>

    <!-- per-haven analytics -->
    <div class="panel">
        <div class="panel-head">
            <h2>Per-Haven Analytics <span class="muted" id="havenAnalyticsPeriod"></span></h2>
        </div>
        <p class="muted" style="margin-bottom:16px;">
            Each card reflects the date window selected above — bookings, towels, pool passes,
            advance payments, extended hours, plus which stay length and check-in time are most booked.
        </p>
        <div class="haven-analytics" id="havenAnalytics"></div>
    </div>
</div>

