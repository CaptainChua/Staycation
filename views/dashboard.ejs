// download the confirmation as a PDF (lazy-loads the generator from a CDN)
function downloadConfirmation(){
    const el = document.getElementById("bkConfirm");
    if(!el) return;
    el.innerHTML = buildConfirmationHTML();   // fresh content
    const prev = el.style.transform;
    el.style.transform = "none";              // capture at full 760px (not the scaled preview)
    const rect = el.getBoundingClientRect();
    // round the page UP (+1px safety) so the document never spills a sliver onto a 2nd blank page
    const w = Math.ceil(rect.width), h = Math.ceil(rect.height) + 1;
    // filename = <check-in MMDDYY>-D<unit>, e.g. Jun 29 2026 · Haven 4 → 062926-D2602
    const ci = (document.getElementById("f_checkin") || {}).value || "";
    const havenVal = (document.getElementById("f_haven") || {}).value || "";
    const unitNo = GF_HAVEN_UNITS[havenVal] || "";
    let fname;
    const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(ci);
    if(m && unitNo){
        fname = `${m[2]}${m[3]}${m[1].slice(-2)}-${GF_TOWER}${unitNo}.pdf`;
    } else {
        fname = "Booking-Confirmation-" + (bookingCode(bookings.find(x => x.id === editingId)) || "new") + ".pdf";
    }
    const restore = () => { el.style.transform = prev; fitConfirmPreview(); };
    const go = () => html2pdf().set({
        margin: 0, filename: fname,
        image: { type:"jpeg", quality:0.98 },
        html2canvas: { scale: 2, useCORS: true, backgroundColor: "#ffffff", windowHeight: h },
        jsPDF: { unit:"px", format:[w, h], orientation: "portrait" },
        pagebreak: { mode: ["avoid-all"] }
    }).from(el).save().then(restore, restore);
    if(window.html2pdf) return go();
    const s = document.createElement("script");
    s.src = "https://cdn.jsdelivr.net/npm/html2pdf.js@0.10.2/dist/html2pdf.bundle.min.js";
    s.onload = go;
    s.onerror = () => { restore(); alert("Couldn't load the PDF tool. Use your browser's Print (Ctrl+P) → Save as PDF on this tab instead."); };
    document.body.appendChild(s);
}

/* ---------- booking modal: page 3 (guest IDs) ---------- */
let idsData = [];
const ID_MAX = 6;
async function renderIdPage(b){
    idsData = (b && Array.isArray(b.ids)) ? b.ids.slice() : [];   // show the local copy instantly
    document.getElementById("f_idOptOut").checked = b ? !!b.idOptOut : false;
    renderIdGrid();
    // then pull the LIVE saved IDs from the server so a stale local copy can't hide them (or let an
    // upload overwrite them). Skip if the user has already added a photo locally (don't lose it).
    if(b && b.id != null){
        const forId = b.id;
        try{
            const r = await fetch("/api/booking/" + encodeURIComponent(forId) + "/ids", { cache:"no-store" });
            if(!r.ok) return;
            const j = await r.json();
            if(editingId !== forId) return;                       // modal moved on
            const hasLocalUpload = idsData.some(v => typeof v === "string" && v.indexOf("data:image") === 0);
            if(hasLocalUpload) return;                            // user started uploading — keep their work
            if(Array.isArray(j.ids)){
                idsData = j.ids.slice();
                document.getElementById("f_idOptOut").checked = !!j.idOptOut;
                const idx = bookings.findIndex(x => x.id === forId);   // reflect the truth into the local copy
                if(idx !== -1){ bookings[idx].ids = j.ids.slice(); bookings[idx].idOptOut = !!j.idOptOut; setLocalKey(KEY, bookings); }
                renderIdGrid();
            }
        }catch(e){}
    }
}
// label an ID by its matching guest (e.g. "J. Mercado"), falling back to "ID n"
function idGuestLabel(i){
    try{
        const g = readGuests()[i];
        if(g && g.name){
            const parts = g.name.trim().split(/\s+/).filter(Boolean);
            if(parts.length >= 2) return parts[0][0].toUpperCase() + ". " + parts[parts.length - 1];
            return g.name;
        }
    }catch(e){}
    return "ID " + (i + 1);
}
function renderIdGrid(){
    const grid = document.getElementById("idGrid");
    const optedOut = document.getElementById("f_idOptOut").checked;
    let html = "";
    for(let i = 0; i < ID_MAX; i++){
        if(i < idsData.length){
            const bg = String(idsData[i]).replace(/"/g, "%22");
            html += `<div class="id-slot filled" style="background-image:url('${bg}')">
                <span class="id-check"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="3"><path d="m5 12 4.5 4.5L19 7"/></svg></span>
                <span class="id-del" title="Remove" onclick="event.stopPropagation();removeId(${i})">✕</span>
                <span class="id-name">${idGuestLabel(i)}</span>
                <span class="id-zoom" onclick="openProofImg('${bg}')"></span>
            </div>`;
        } else if(i === idsData.length){
            // the first empty slot is the uploader
            html += `<div class="id-slot add" onclick="document.getElementById('idFileInput').click()">
                <span class="id-plus">+</span>
                <span class="id-add-label">Add ID photo</span>
                <span class="id-choose">Choose file</span>
                <span class="id-hint">or drop / paste</span>
            </div>`;
        } else {
            html += `<div class="id-slot empty"><span>Empty</span></div>`;
        }
    }
    grid.innerHTML = html;
    grid.classList.toggle("disabled", optedOut);

    // drag & drop onto the grid (overwrites prior handlers, so no duplicates)
    grid.ondragover = e => { e.preventDefault(); grid.classList.add("drag"); };
    grid.ondragleave = e => { if(!grid.contains(e.relatedTarget)) grid.classList.remove("drag"); };
    grid.ondrop = e => {
        e.preventDefault();
        grid.classList.remove("drag");
        if(optedOut) return;
        const files = e.dataTransfer && e.dataTransfer.files;
        if(files && files.length) addIdsFromFiles(files);
    };

    document.getElementById("bkIdCount").textContent = `${idsData.length} / ${ID_MAX}`;
    updateIdFootNote();
}
function updateIdFootNote(){
    const note = document.getElementById("bkFootNote");
    if(!note) return;
    note.innerHTML = `<span class="dot"></span>${idsData.length} of ${ID_MAX} IDs uploaded`;
}
// add one or more image files (from picker, drag-drop, or paste), respecting the cap
function addIdsFromFiles(files){
    if(document.getElementById("f_idOptOut").checked){
        alert('Untick "Guest will send IDs via Facebook instead" to upload IDs.');
        return;
    }
    const imgs = [...files].filter(f => f && /^image\//.test(f.type));
    if(!imgs.length) return;
    const room = ID_MAX - idsData.length;
    if(room <= 0){ alert(`Maximum of ${ID_MAX} IDs.`); return; }
    if(imgs.length > room) alert(`Only ${room} more ID${room === 1 ? "" : "s"} can be added.`);
    imgs.slice(0, room).forEach(f => compressImageTo(f, idMaxBytes, dataUrl => {
        if(!dataUrl) return;
        idsData.push(dataUrl);
        renderIdGrid();
        persistBookingIds();   // save this ID to the server NOW (per-record) — never wait for Save
    }));
}
function onIdFileChange(input){
    if(input.files && input.files.length) addIdsFromFiles(input.files);
    input.value = "";
}
function removeId(i){
    idsData.splice(i, 1);
    renderIdGrid();
    persistBookingIds();       // persist the removal per-record too
}
// Save guest IDs IMMEDIATELY & per-record (for existing bookings) so a later whole-array save from a
// stale tab/device can never wipe them. A NEW booking's IDs are saved with its first create.
let _idSaving = false, _idSaveAgain = false;
async function persistBookingIds(){
    if(typeof editingId === "undefined" || editingId == null) return;   // new booking → saved on create
    if(_idSaving){ _idSaveAgain = true; return; }                       // coalesce rapid add/removes
    _idSaving = true;
    try{
        // offload any base64 photos to durable /img refs first (tiny request; the image is never lost)
        for(let i = 0; i < idsData.length; i++){
            const v = idsData[i];
            if(typeof v === "string" && v.indexOf("data:image") === 0){
                try{
                    const r = await fetch("/api/img", { method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify({ data: v }) });
                    if(r.ok){ const j = await r.json(); if(j && j.url) idsData[i] = j.url; }
                }catch(e){}
            }
        }
        const idOptOut = document.getElementById("f_idOptOut").checked;
        const r = await fetch("/api/booking/" + encodeURIComponent(editingId) + "/ids", {
            method:"POST", headers:{"Content-Type":"application/json"},
            body: JSON.stringify({ ids: idsData.slice(), idOptOut })
        });
        if(r.ok){
            const idx = bookings.findIndex(b => b.id === editingId);
            if(idx !== -1){ bookings[idx].ids = idsData.slice(); bookings[idx].idOptOut = idOptOut; }
            setLocalKey(KEY, bookings);
            renderIdGrid();
        }
    } finally {
        _idSaving = false;
        if(_idSaveAgain){ _idSaveAgain = false; persistBookingIds(); }
    }
}
// paste an image (Ctrl/Cmd+V) while the IDs or Proof of Payment tab is open
document.addEventListener("paste", e => {
    const overlay = document.getElementById("overlay");
    if(!overlay || !overlay.classList.contains("show")) return;
    const page2 = document.getElementById("bkPage2");
    const page3 = document.getElementById("bkPage3");
    const onIds   = page3 && page3.style.display !== "none";
    const onProof = page2 && page2.style.display !== "none";
    if(!onIds && !onProof) return;
    const items = (e.clipboardData && e.clipboardData.items) || [];
