function onMethodQrUpload(i, input){
    const file = input.files[0];
    if(!file) return;
    const apply = dataUrl => {
        if(!dataUrl) return;
        paymentMethods[i].qr = dataUrl;
        const box = document.getElementById("qrbox_" + i);
        if(box){
            box.classList.add("has");
            box.querySelector(".qr-text").textContent = "QR added";
            box.querySelector(".qr-ico").innerHTML = PM_ICONS.qr;
        }
        const rm = document.getElementById("mqrrm_" + i);
        if(rm) rm.style.display = "inline";
    };
    // compress so a big QR photo (e.g. 4MB) is shrunk to fit the max size before saving
    compressImageTo(file, idMaxBytes, dataUrl => {
        if(dataUrl){ apply(dataUrl); return; }
        const r = new FileReader();   // couldn't decode (e.g. HEIC) → keep original so it's never lost
        r.onload = e => apply(e.target.result);
        r.readAsDataURL(file);
    });
}

function removeMethodQr(i){
    paymentMethods[i].qr = "";
    const box = document.getElementById("qrbox_" + i);
    if(box){
        box.classList.remove("has");
        box.querySelector(".qr-text").textContent = "Add QR";
        box.querySelector(".qr-ico").innerHTML = PM_ICONS.img;
    }
    const rm = document.getElementById("mqrrm_" + i);
    if(rm) rm.style.display = "none";
}

