// scale the preview down so it fits the modal (no horizontal scroll)
function fitConfirmPreview(){
    const el = document.getElementById("bkConfirm");
    const wrap = document.getElementById("bkcWrap");
    if(!el || !wrap) return;
    el.style.transform = "none";                       // measure at full size
    const avail = wrap.clientWidth - 24;               // minus padding
    const scale = Math.min(1, avail / (el.offsetWidth || 760));
    el.style.transform = `scale(${scale})`;
    wrap.style.height = (el.offsetHeight * scale + 24) + "px";
}
