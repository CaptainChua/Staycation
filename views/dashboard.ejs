        return true;
    });

    const container = document.getElementById("payrollContainer");
    container.innerHTML = list.length
        ? list.map(s => staffBoxHtml(s, scope)).join("")
        : `<p class="empty">No staff match. Click “+ Add Staff” to begin.</p>`;

