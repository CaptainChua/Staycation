/* ---------- payroll: day entry modal ---------- */
let dayStaffId = null, editingDayId = null, dayRecordId = null;

// floating single-date calendar bound to the hidden #d_date field
let dayCalMonth = today();
let dayCalSelected = iso(today());
function dayDateText(ci){
    return ci
        ? new Date(ci + "T00:00:00").toLocaleDateString("en-PH", { weekday:"short", month:"short", day:"numeric", year:"numeric" })
        : "Select date";
}
function renderDayCal(){
    const y = dayCalMonth.getFullYear(), m = dayCalMonth.getMonth();
    const first = new Date(y, m, 1).getDay();
    const dim = new Date(y, m + 1, 0).getDate();
    const todayIso = iso(today());
