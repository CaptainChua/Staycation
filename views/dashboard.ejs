function anMonthsBetween(fromYm, toYm){
    const out = []; let [y, m] = fromYm.split("-").map(Number);
    const [ty, tm] = toYm.split("-").map(Number);
    while(y < ty || (y === ty && m <= tm)){
        out.push(`${y}-${String(m).padStart(2, "0")}`);
        if(++m > 12){ m = 1; y++; }
        if(out.length > 600) break;
    }
    return out;
}
