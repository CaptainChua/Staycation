/* ---------- Guest Form: custom calendar (matches the app's other pickers) ---------- */
let gfCalMonth = today();
let gfCalSel = iso(today());
function gfDateText(ci){
    return ci ? new Date(ci + "T00:00:00").toLocaleDateString("en-PH", { weekday:"short", month:"short", day:"numeric", year:"numeric" }) : "Pick date";
}
function renderGfCal(){
    const y = gfCalMonth.getFullYear(), m = gfCalMonth.getMonth();
    document.getElementById("gf_date_title").textContent = MONTHS[m] + " " + y;
    const first = new Date(y, m, 1).getDay();
    const dim = new Date(y, m + 1, 0).getDate();
    const todayIso = iso(today());
    let html = "";
    ["Su","Mo","Tu","We","Th","Fr","Sa"].forEach(d => html += `<div class="dp-wd">${d}</div>`);
    for(let i = 0; i < first; i++) html += `<div class="dp-day empty"></div>`;
    for(let d = 1; d <= dim; d++){
        const ci = iso(new Date(y, m, d));
        const cls = "dp-day" + (ci === gfCalSel ? " sel" : "") + (ci === todayIso ? " today" : "");
        html += `<div class="${cls}" onclick="pickGfDate('${ci}')"><span class="n">${d}</span></div>`;
    }
    document.getElementById("gf_date_grid").innerHTML = html;
}
function gfCalNav(dir){ gfCalMonth = new Date(gfCalMonth.getFullYear(), gfCalMonth.getMonth() + dir, 1); renderGfCal(); }
function openGfCal(e){
    if(e) e.stopPropagation();
    const pop = document.getElementById("gf_date_popup");
    if(pop.classList.contains("show")){ pop.classList.remove("show"); return; }
