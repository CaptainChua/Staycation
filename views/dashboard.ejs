let editingBillId = null;
function openBillModal(id){
    editingBillId = id || null;
    if(editingBillId){
        const b = bills.find(x => x.id === editingBillId);
        if(!b) return;
        document.getElementById("billModalTitle").textContent = "Edit Bill";
