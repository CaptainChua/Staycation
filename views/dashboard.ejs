        downProofData = dataUrl;
        const img = document.getElementById("downProofImg");
        img.src = dataUrl; img.style.display = "block";
        document.getElementById("downProofEmpty").style.display = "none";
    });
}
function onAddonProofChange(input){
    const f = input.files[0];
    if(!f) return;
    resizeImage(f, dataUrl => {
        addonProofData = dataUrl;
        const img = document.getElementById("addonProofImg");
        img.src = dataUrl; img.style.display = "block";
        document.getElementById("addonProofEmpty").style.display = "none";
    });
}
function onBalProofChange(input){
    const f = input.files[0];
    if(!f) return;
    resizeImage(f, dataUrl => {
        balProofData = dataUrl;
        const img = document.getElementById("balProofImg");
        if(img){ img.src = dataUrl; img.style.display = "block"; }
    });
}
function renderProofPage(b){
    // payment summary — total, what's been paid (downpayment + collections), and balance
    const sTotal = b ? Number(b.total || 0) : (Number(document.getElementById("f_total").value) || 0);
    const sDown  = b ? Number(b.downpayment || 0) : (Number(document.getElementById("f_down").value) || 0);
    const sColl  = b ? collectedSum(b) : 0;
    const sPaid  = sDown + sColl;
    const sBal   = Math.max(0, sTotal - sPaid);
    const sStatus = sPaid >= sTotal && sTotal > 0 ? "Fully paid" : sPaid > 0 ? "Partial" : "Unpaid";
    document.getElementById("proofSummary").innerHTML =
        `<div class="ps-item"><span class="ps-label">Total payable</span><span class="ps-val">${peso(sTotal)}</span></div>` +
        `<div class="ps-item"><span class="ps-label">Downpayment</span><span class="ps-val">${peso(sDown)}</span></div>` +
        `<div class="ps-item"><span class="ps-label">Collected</span><span class="ps-val">${peso(sColl)}</span></div>` +
        `<div class="ps-item"><span class="ps-label">Total paid</span><span class="ps-val paid">${peso(sPaid)}</span></div>` +
        `<div class="ps-item"><span class="ps-label">Balance</span><span class="ps-val bal">${peso(sBal)}</span></div>` +
        `<div class="ps-item"><span class="ps-label">Status</span><span class="ps-val">${sStatus}</span></div>`;

    downProofData = (b && b.downProof) || null;
    const down = b ? (Number(b.downpayment) || 0) : (Number(document.getElementById("f_down").value) || 0);
    const method = (b && b.method) || document.getElementById("f_method").value || "—";
    document.getElementById("downMeta").innerHTML =
        `Amount: <strong>${peso(down)}</strong> · Method: ${method}`;
    const dImg = document.getElementById("downProofImg");
    const dEmpty = document.getElementById("downProofEmpty");
    document.getElementById("downProofFile").value = "";
    if(downProofData){ dImg.src = downProofData; dImg.style.display = "block"; dEmpty.style.display = "none"; }
    else { dImg.src = ""; dImg.style.display = "none"; dEmpty.style.display = "block"; }

    // split collections by category so each shows in the right section
    const pays = (b && b.payments) || [];
    const balPays   = pays.filter(p => (p.category || "Balance") !== "Add Ons");
    const addonPays = pays.filter(p => p.category === "Add Ons");

    // balance collection (show the latest Balance payment)
    balProofData = null;
    const list = document.getElementById("balProofList");
    if(balPays.length){
        const p = balPays[balPays.length - 1];
        const more = balPays.length > 1 ? ` <span class="muted">(+${balPays.length - 1} earlier)</span>` : "";
        list.innerHTML =
            `<div class="proof-meta">Collected <strong>${peso(p.amount)}</strong> via ${p.mop}${more}<br>${new Date(p.at).toLocaleString("en-PH")} · by ${p.by || "—"}</div>` +
            `<img id="balProofImg" class="proof-img" src="${p.proof || ""}" style="${p.proof ? "" : "display:none;"}" onclick="openProofImg(this.src)">` +
            `<label class="proof-upload">${p.proof ? "Replace" : "Upload"} balance proof<input type="file" accept="image/*" onchange="onBalProofChange(this)"></label>` +
            `<span class="proof-del" onclick="deleteCollection('Balance')">Delete this collection</span>`;
    } else {
        list.innerHTML = `<div class="proof-empty">No balance payment recorded yet. Collect it from Today's Booking.</div>`;
    }

    // add-ons section: amount summary + latest Add Ons collection (or a manual upload)
    const swimpass = b ? (Number(b.swimpass) || 0) : (Number(document.getElementById("f_swimpass").value) || 0);
    const towels   = b ? (Number(b.towels) || 0)   : (Number(document.getElementById("f_towels").value) || 0);
    const extend   = b ? (Number(b.extend) || 0)   : (Number(document.getElementById("f_extend").value) || 0);
    const holiday  = b ? !!b.holiday : document.getElementById("f_holiday").checked;
    const swimRate = holiday ? PRICING.swimHoliday : PRICING.swimRegular;
    const addonTotal = swimpass * swimRate + towels * PRICING.towel + extend * PRICING.extendPerHr;
    const latestAddonPay = addonPays.length ? addonPays[addonPays.length - 1] : null;
    addonProofData = (b && b.addonProof) || null;   // manual-upload channel only (persisted on save)
    // show the latest Add Ons collection's proof if any, otherwise the manual upload
    const addonShown = (latestAddonPay && latestAddonPay.proof) ? latestAddonPay.proof : addonProofData;
    let addonMeta = `Swimpass ${swimpass} · Towels ${towels} · Extend ${extend}h<br>Total: <strong>${peso(addonTotal)}</strong>`;
    if(latestAddonPay){
        const more = addonPays.length > 1 ? ` <span class="muted">(+${addonPays.length - 1} earlier)</span>` : "";
        addonMeta += `<br>Collected <strong>${peso(latestAddonPay.amount)}</strong> via ${latestAddonPay.mop}${more} · by ${latestAddonPay.by || "—"}`;
    }
    document.getElementById("addonMeta").innerHTML = addonMeta;
    const aImg = document.getElementById("addonProofImg");
    const aEmpty = document.getElementById("addonProofEmpty");
    document.getElementById("addonProofFile").value = "";
    if(addonShown){ aImg.src = addonShown; aImg.style.display = "block"; aEmpty.style.display = "none"; }
    else { aImg.src = ""; aImg.style.display = "none"; aEmpty.style.display = "block"; }
    document.getElementById("addonDel").style.display = latestAddonPay ? "inline-block" : "none";
}
// remove the latest collection of a given category from the booking being edited
function deleteCollection(category){
    if(editingId == null) return;
    const idx = bookings.findIndex(x => x.id === editingId);
    if(idx === -1) return;
    const pays = bookings[idx].payments || [];
    let pos = -1;
    for(let k = pays.length - 1; k >= 0; k--){
        const cat = pays[k].category || "Balance";
        if((category === "Add Ons") ? (cat === "Add Ons") : (cat !== "Add Ons")){ pos = k; break; }
    }
    if(pos === -1) return;
    if(!confirm(`Delete this ${category} collection of ${peso(pays[pos].amount)}? This cannot be undone.`)) return;
    const removed = pays.splice(pos, 1)[0];
    save(bookings);
    logActivity(`deleted ${category} collection — ${bookings[idx].haven} · ${peso(removed.amount)}`);
    renderProofPage(bookings[idx]);
    renderAll();
}
function openProofImg(src){
    if(!src) return;
    document.getElementById("imgLightboxImg").src = src;
    document.getElementById("imgLightbox").classList.add("show");
}

function saveBooking(){
    const guests = readGuests();
    const checkin = document.getElementById("f_checkin").value;
    const checkout = document.getElementById("f_checkout").value;

    if(guests.length === 0){ alert("Please enter at least one guest name."); return; }

    // every guest needs a valid age
    for(let i=0;i<guests.length;i++){
        const g = guests[i];
        if(g.age == null || isNaN(g.age) || g.age < 0){
            alert(`Please enter a valid age for ${g.name || ("guest " + (i+1))}.`);
            return;
        }
    }

    // rule 1: first guest must be 18+
    if(guests[0].age < 18){
        alert("The first guest (primary booker) must be 18 years old and above.");
        return;
    }
    // rule 2: if the second guest is a minor, they must be a family member (same last name)
    if(guests.length >= 2 && guests[1].age < 18 && lastName(guests[1].name) !== lastName(guests[0].name)){
        alert("The second guest is a minor and must be a family member (same last name) of the first guest.");
        return;
    }

    // capacity & composition: max 5 pax, up to 4 adults and 2 kids (0–13)
    const kids = guests.filter(g => g.age <= PRICING.kidMaxAge).length;
    const adults = guests.length - kids;
    if(guests.length > PRICING.maxPax){ alert(`Maximum of ${PRICING.maxPax} pax per unit.`); return; }
    if(adults > PRICING.maxAdults){ alert(`Maximum of ${PRICING.maxAdults} adults per unit.`); return; }
    if(kids > PRICING.maxKids){ alert(`Maximum of ${PRICING.maxKids} kids (0–13 yrs) per unit.`); return; }

    if(!checkin || !checkout || checkout < checkin){
        alert("Please enter a valid check-in and check-out date.");
        return;
    }
    // Saturday check-ins are 21 hours only
    const checkinWd = new Date(checkin + "T00:00:00").getDay();
    const stayHours = Number(document.getElementById("f_stay").value);
    if(checkinWd === 6 && stayHours !== 21){
        alert("Saturday check-ins are 21 hours only.");
        return;
    }

    const data = {
        haven: document.getElementById("f_haven").value,
        guests,
        contact: document.getElementById("f_contact").value.trim(),
        checkin, checkout,
        stayHours: stayHours,
        checkinTime: dashCheckinTimeValue(),
        slot: stayHours === 6 ? (dashCheckinMin(dashCheckinTimeValue()) <= 720 ? "morning" : "evening") : null,
        swimpass: Number(document.getElementById("f_swimpass").value) || 0,
        towels: Number(document.getElementById("f_towels").value) || 0,
        extend: Number(document.getElementById("f_extend").value) || 0,
        holiday: document.getElementById("f_holiday").checked,
        deposit: Number(document.getElementById("f_deposit").value) || 0,
        method: document.getElementById("f_method").value,
        downpayment: Number(document.getElementById("f_down").value) || 0,
        notes: document.getElementById("f_notes").value.trim(),
        downProof: downProofData || null,
        addonProof: addonProofData || null
    };
    data.total = computeTotal(data); // auto-calculated from pricing rules

    if(!data.haven){
        alert("No haven is available for the selected dates and stay. Please choose different dates.");
        return;
    }

    // double-booking guard
    const clash = findConflict(data, editingId);
    if(clash){
        const both6 = Number(clash.stayHours) === 6 && stayHours === 6;
        alert(
            `${data.haven} is already booked for these dates by ${primaryName(clash)} ` +
            `(${fmt(clash.checkin)}${clash.checkout > clash.checkin ? "–" + fmt(clash.checkout) : ""}` +
            `${clash.slot ? ", " + slotLabel(clash.slot) : ""}).\n\n` +
            (both6
                ? "That 6-hour time slot is taken — choose the other slot, or a different haven/date."
                : "A 10- or 21-hour booking occupies the unit for those dates, so it can't be double-booked.")
        );
        return;
    }

    if(editingId){
        const idx = bookings.findIndex(b => b.id === editingId);
        if(idx !== -1){
            bookings[idx] = { ...bookings[idx], ...data };
            // replace the latest BALANCE collection's proof photo if a new one was chosen
            if(balProofData){
                const pays = bookings[idx].payments || [];
                let target = null;
                for(let k = pays.length - 1; k >= 0; k--){ if((pays[k].category || "Balance") !== "Add Ons"){ target = pays[k]; break; } }
                if(target){
                    target.proof = balProofData;
                    target.editedAt = new Date().toISOString();
                    target.editedBy = currentUser();
                }
            }
            logActivity(`edited booking — ${data.haven} (${primaryName(data)})`);
        }
    } else {
        const newId = bookings.length ? Math.max(...bookings.map(b => b.id)) + 1 : 1;
        bookings.push({ id:newId, ...data });
        logActivity(`added booking — ${data.haven} (${primaryName(data)})`);
    }
    save(bookings);
    closeModal();
    renderAll();
}

function logout(){ logActivity("logged out"); localStorage.removeItem("shph_current_user"); window.location.href = "admin.html"; }

/* ---------- sidebar navigation ---------- */
function showPage(page){
    if(!pageAllowed(page)) return;   // access control
    document.querySelectorAll(".page").forEach(p =>
        p.classList.toggle("active", p.id === "page-" + page));
    document.querySelectorAll(".sidebar .nav-item").forEach(n =>
        n.classList.toggle("active", n.dataset.page === page));
    localStorage.setItem("shph_dashboard_page", page);   // remember across refreshes
    // the timeline needs the element visible to measure cell widths
    if(page === "today") renderToday();
    if(page === "calendar") renderTimeline();
    if(page === "analytics" && typeof renderAnalytics === "function") renderAnalytics();
    if(page === "users" && typeof renderUsers === "function") renderUsers();
    if(page === "employees" && typeof renderEmployees === "function") renderEmployees();
    if(page === "log" && typeof renderLog === "function") renderLog();
    if(page === "assist" && typeof renderAssist === "function") renderAssist();
}

/* ---------- Assist: towels to place per haven ---------- */
function renderAssist(){
    const inp = document.getElementById("assistDate");
    if(!inp) return;
    if(!inp.value) inp.value = iso(today());
    const d = inp.value;
    // bookings active on the date (guest is in-house) — that's where towels need to be set up
    const list = bookings
        .filter(b => b.checkin <= d && d < endExcl(b))
        .sort((a, b) => a.haven.localeCompare(b.haven));
    const body = document.getElementById("assistBody");
    body.innerHTML = list.length ? list.map(b => {
        const dot = (HAVEN_COLORS[b.haven] || { am:"#ccc" }).am;
        const towels = Number(b.towels) || 0;
        const towelText = towels > 0
            ? `🧺 <strong>${towels}</strong> towel${towels > 1 ? "s" : ""}`
            : `<span class="muted">None</span>`;
        return `<tr>
            <td><span class="dot" style="background:${dot}"></span>${b.haven}</td>
            <td>${primaryName(b)}</td>
            <td>${fmt(b.checkin)} · <span class="muted">${checkinTimeStr(b)}</span></td>
            <td>${towelText}</td>
        </tr>`;
    }).join("") : `<tr><td colspan="4" class="empty">No occupied havens on this date.</td></tr>`;

    const totalTowels = list.reduce((s, b) => s + (Number(b.towels) || 0), 0);
    document.getElementById("assistTotal").innerHTML =
        `<div class="card"><h3>Occupied havens</h3><div class="number">${list.length}</div></div>` +
        `<div class="card"><h3>Total towels to place</h3><div class="number">🧺 ${totalTowels}</div></div>`;
}

