// limit time-of-stay options by check-in day: Sat = 21h only; Sun–Fri = 6/10/21h
const STAY_OPTIONS = [
    [6,  "6 hrs — ₱999"],
    [10, "10 hrs — ₱1,599"],
    [21, "21 hrs — ₱1,799 / ₱2,099 (Fri–Sat)"]
];
function updateStayOptions(keep){
    const sel = document.getElementById("f_stay");
    const checkin = document.getElementById("f_checkin").value;
    const wd = checkin ? new Date(checkin + "T00:00:00").getDay() : 1; // 6 = Saturday
    const opts = (wd === 6) ? STAY_OPTIONS.filter(o => o[0] === 21) : STAY_OPTIONS;
    const want = String(keep != null ? keep : sel.value);
    sel.innerHTML = opts.map(o => `<option value="${o[0]}">${o[1]}</option>`).join("");
    sel.value = opts.some(o => String(o[0]) === want) ? want : String(opts[0][0]);
}
function onCheckinChange(){
