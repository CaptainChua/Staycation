// the minute-of-day a haven becomes free for `cand` = latest clashing check-out + cleaning gap,
// or null if nothing clashes. Used to label/snap busy havens in the dropdown.
function havenFreeAtMin(haven, cand){
    const ci = bookingInterval(cand);
    let latest = null, latestEnd = null;
    bookings.forEach(b => {
        if(b.id === editingId) return;
        if(b.cancelled) return;
        if(b.haven !== haven) return;
        const bi = bookingInterval(b);   // absolute minutes — fine for comparing/clashing
        if(ci.start < bi.end + CLEANING_GAP_MIN && bi.start < ci.end + CLEANING_GAP_MIN){
            if(latestEnd == null || bi.end > latestEnd){ latestEnd = bi.end; latest = b; }
        }
    });
    if(!latest) return null;
    // free-at = the clashing booking's LOCAL check-out time-of-day + cleaning gap.
    // (bookingInterval.end is absolute epoch minutes, so % 1440 would be timezone-shifted)
    const dur = ((Number(latest.stayHours) || 21) + (Number(latest.extend) || 0)) * 60;
    const m = bookingCheckinMin(latest) + dur + CLEANING_GAP_MIN;
    return ((m % 1440) + 1440) % 1440;
}
// List EVERY haven. Free havens are selectable as-is; a haven that's busy for the chosen time
// is still selectable but labelled "free from HH:MM" — picking it snaps the check-in time to
// when it frees up (see onHavenChange), so the booking goes straight through.
function updateHavenOptions(){
    const sel = document.getElementById("f_haven");
    const current = sel.value;
    const checkin = document.getElementById("f_checkin").value;
    const checkout = document.getElementById("f_checkout").value;
    const stayVal = document.getElementById("f_stay").value;
    const stayHours = stayVal === "multi" ? 21 : Number(stayVal);
    const extend = Number(document.getElementById("f_extend").value) || 0;
    const checkinTime = dashCheckinTimeValue();

    let html = "", firstFree = null, currentStillFree = false;
    HAVENS.forEach(h => {
        const cand = { haven:h, checkin, checkout, stayHours, extend, checkinTime, slot:null };
        const clash = (checkin && checkinTime) ? findConflictAdmin(cand, editingId) : null;
        if(clash){
            const freeMin = havenFreeAtMin(h, cand);
            const freeStr = freeMin != null ? minToTime(freeMin) : "";
            html += `<option value="${h}" data-freemin="${freeMin}">${h} — free from ${freeStr}</option>`;
        } else {
            if(firstFree == null) firstFree = h;
            if(h === current) currentStillFree = true;
            html += `<option value="${h}">${h}</option>`;
        }
    });
    sel.innerHTML = html || `<option value="">— No haven —</option>`;
    sel.value = currentStillFree ? current : (firstFree || "");
    updateSlotOptions();
}
// when a haven is picked that's busy at the current time, snap the check-in time to when it frees
function onHavenChange(){
    const sel = document.getElementById("f_haven");
    const opt = sel.options[sel.selectedIndex];
    const fm = opt && opt.dataset ? Number(opt.dataset.freemin) : NaN;
    if(opt && opt.dataset && opt.dataset.freemin != null && opt.dataset.freemin !== "" && !isNaN(fm)){
        setDashCheckinTime(minToTime(Math.max(fm, EARLIEST_CHECKIN_MIN)));   // book from when it frees
        onStayChange();   // recompute check-out/totals and re-validate the haven list
    } else {
        updateSlotOptions();
    }
}

// slot is now derived from the explicit check-in time (no separate slot picker)
function updateSlotOptions(){ /* no-op */ }

// auto-calculate total payable from the pricing rules, then balance
function recalc(){
    const stayVal = document.getElementById("f_stay").value;
    const stayHours = stayVal === "multi" ? 21 : (Number(stayVal) || 0);
    const checkout = document.getElementById("f_checkout").value;
    const b = {
        stayHours: stayHours,
        checkin: document.getElementById("f_checkin").value,
        swimpass: document.getElementById("f_swimpass").value,
        towels: document.getElementById("f_towels").value,
        extend: document.getElementById("f_extend").value,
        holiday: document.getElementById("f_holiday").checked,
        deposit: document.getElementById("f_deposit").value
    };
    const guests = readGuests();
    const base = baseRate(stayHours, b.checkin, checkout);
    const nights = stayHours === 21 ? stayNights(b.checkin, checkout) : 0;
    const extraHeads = Math.max(0, billablePax(guests) - PRICING.baseIncludedPax);
    const pax  = extraHeads * PRICING.addPax;
    const swimRate = b.holiday ? PRICING.swimHoliday : PRICING.swimRegular;
    const swim = (Number(b.swimpass) || 0) * swimRate;
    const tow  = (Number(b.towels) || 0) * PRICING.towel;
    const ext  = (Number(b.extend) || 0) * PRICING.extendPerHr;
    const dep  = Number(b.deposit) || 0;
    const discount = Number(document.getElementById("f_discount").value) || 0;
    const total = Math.max(0, base + pax + swim + tow + ext + dep - discount);

    document.getElementById("f_total").value = total;
    const down = Number(document.getElementById("f_down").value) || 0;
    const collected = editingId ? collectedSum(bookings.find(x => x.id === editingId) || {}) : 0;
    document.getElementById("f_balance").value = peso(Math.max(0, total - down - collected));

    const baseLabel = stayHours === 21
        ? `Base for 2 pax (${nights} night${nights > 1 ? "s" : ""}${nights >= 3 ? ", long-stay rate" : ""})`
        : `Base for 2 pax (${stayHours}h)`;
    document.getElementById("f_breakdown").innerHTML =
        `${baseLabel}: ${peso(base)}` +
        ` · Extra pax ${extraHeads}×₱300: ${peso(pax)}` +
        ` · Swimpass ${Number(b.swimpass)||0}×${peso(swimRate)}: ${peso(swim)}` +
        ` · Towels ${Number(b.towels)||0}×₱50: ${peso(tow)}` +
        ` · Extend ${Number(b.extend)||0}h×₱150: ${peso(ext)}` +
        ` · Deposit: ${peso(dep)}` +
        (discount > 0 ? ` · Discount: −${peso(discount)}` : "");
}
