        document.getElementById("b_type").value = b.type;
        document.getElementById("b_amount").value = b.amount || 0;
        setBillDate(b.due || iso(today()));
        document.getElementById("b_paid").checked = !!b.paid;
    } else {
        document.getElementById("billModalTitle").textContent = "Add Bill";
        document.getElementById("b_haven").selectedIndex = 0;
        document.getElementById("b_type").selectedIndex = 0;
