    onStayChange();
}

// populate the check-in time options (hourly, 12 MN … 11 PM)
function fillCheckinTimes(){
    const sel = document.getElementById("f_checkinTime");
    let html = "";
    for(let h = 0; h < 24; h++){ const t = minToTime(h * 60); html += `<option value="${t}">${t}</option>`; }
    html += `<option value="__custom__">Custom time…</option>`;
    sel.innerHTML = html;
}
function dashCheckinMin(timeStr){ const m = parseTimeMin(timeStr); if(m == null) return 480; return m === 0 ? 1440 : m; }
// toggle the free time input when "Custom time…" is picked
function onCheckinTimeSelChange(){
    const custom = document.getElementById("f_checkinTimeCustom");
    custom.style.display = document.getElementById("f_checkinTime").value === "__custom__" ? "block" : "none";
    onStayChange();
}
// the effective check-in time string (handles the custom HH:MM input)
function dashCheckinTimeValue(){
    const sel = document.getElementById("f_checkinTime");
    if(sel.value === "__custom__"){
        const v = document.getElementById("f_checkinTimeCustom").value; // "HH:MM" 24h
        if(!v) return "8:00 AM";
        const [h, m] = v.split(":").map(Number);
        return minToTime(h * 60 + m);
    }
    return sel.value;
}
// set the picker to a time string, switching to custom mode for non-hourly times
function setDashCheckinTime(timeStr){
    const sel = document.getElementById("f_checkinTime");
    const custom = document.getElementById("f_checkinTimeCustom");
    const hourly = [...sel.options].some(o => o.value === timeStr);
    if(hourly){
        sel.value = timeStr;
        custom.style.display = "none"; custom.value = "";
    } else {
        sel.value = "__custom__";
        const min = dashCheckinMin(timeStr) % 1440;
        custom.value = `${String(Math.floor(min/60)).padStart(2,"0")}:${String(min%60).padStart(2,"0")}`;
        custom.style.display = "block";
    }
}

// derive check-out date + time from check-in date/time + stay length (+ extend)
function recomputeDashCheckout(){
    const ci = document.getElementById("f_checkin").value;
    const t = dashCheckinTimeValue();
    const hours = Number(document.getElementById("f_stay").value) || 0;
    const ext = Number(document.getElementById("f_extend").value) || 0;
    if(!ci || !t) return;
    const total = dashCheckinMin(t) + (hours + ext) * 60;
    const co = addDays(new Date(ci + "T00:00:00"), Math.floor(total / 1440));
    document.getElementById("f_checkout").value = iso(co);
    document.getElementById("f_checkoutTime").value = minToTime(total);
}

function onStayChange(){
    recomputeDashCheckout();
    recalc();
    updateHavenOptions();
}
function onTimeChange(){ onStayChange(); }
function onExtendChange(){ recomputeDashCheckout(); recalc(); }

// which 6-hour slots (AM/PM) are still free for a haven on the chosen dates
function freeSlotsFor(haven, checkin, checkout){
    return ["morning", "evening"].filter(slot =>
        !findConflict({ haven, checkin, checkout, stayHours: 6, slot }, editingId));
}

// show only havens that have room for the chosen stay; for 6h that means
// at least ONE free slot (so a haven with only a morning booking still shows)
function updateHavenOptions(){
    const sel = document.getElementById("f_haven");
    const current = sel.value;
    const checkin = document.getElementById("f_checkin").value;
    const checkout = document.getElementById("f_checkout").value;
    const stayHours = Number(document.getElementById("f_stay").value);

    let list = HAVENS;
    if(checkin && checkout){
        list = (stayHours === 6)
            ? HAVENS.filter(h => freeSlotsFor(h, checkin, checkout).length > 0)
            : HAVENS.filter(h => !findConflict({ haven:h, checkin, checkout, stayHours, slot:null }, editingId));
    }
    sel.innerHTML = list.length
        ? list.map(h => `<option>${h}</option>`).join("")
        : `<option value="">${stayHours === 6 ? "— Both time slots are booked on every haven —" : "— No haven available for these dates —"}</option>`;
    if(list.includes(current)) sel.value = current;
    updateSlotOptions();
}

// slot is now derived from the explicit check-in time (no separate slot picker)
function updateSlotOptions(){ /* no-op */ }

// auto-calculate total payable from the pricing rules, then balance
function recalc(){
    const b = {
        stayHours: document.getElementById("f_stay").value,
        checkin: document.getElementById("f_checkin").value,
        swimpass: document.getElementById("f_swimpass").value,
        towels: document.getElementById("f_towels").value,
        extend: document.getElementById("f_extend").value,
        holiday: document.getElementById("f_holiday").checked,
        deposit: document.getElementById("f_deposit").value
    };
    const guests = readGuests();
    const base = baseRate(b.stayHours, b.checkin);
    const extraHeads = Math.max(0, billablePax(guests) - PRICING.baseIncludedPax);
    const pax  = extraHeads * PRICING.addPax;
    const swimRate = b.holiday ? PRICING.swimHoliday : PRICING.swimRegular;
    const swim = (Number(b.swimpass) || 0) * swimRate;
    const tow  = (Number(b.towels) || 0) * PRICING.towel;
    const ext  = (Number(b.extend) || 0) * PRICING.extendPerHr;
    const dep  = Number(b.deposit) || 0;
    const total = base + pax + swim + tow + ext + dep;

    document.getElementById("f_total").value = total;
    const down = Number(document.getElementById("f_down").value) || 0;
    const collected = editingId ? collectedSum(bookings.find(x => x.id === editingId) || {}) : 0;
    document.getElementById("f_balance").value = peso(Math.max(0, total - down - collected));

    document.getElementById("f_breakdown").innerHTML =
        `Base for 2 pax (${b.stayHours}h${Number(b.stayHours)===21 ? (base===PRICING.stay21Weekend?", Fri–Sat":", Sun–Thu") : ""}): ${peso(base)}` +
        ` · Extra pax ${extraHeads}×₱300: ${peso(pax)}` +
        ` · Swimpass ${Number(b.swimpass)||0}×${peso(swimRate)}: ${peso(swim)}` +
        ` · Towels ${Number(b.towels)||0}×₱50: ${peso(tow)}` +
        ` · Extend ${Number(b.extend)||0}h×₱150: ${peso(ext)}` +
        ` · Deposit: ${peso(dep)}`;
}

// open as "Add" when no id is passed, or "Edit" (pre-filled) when an id is given
function openModal(id){
    // only admins/CSRs may create a new booking (editing an existing one is still allowed via row Edit)
    if(!id && !canAddBooking()){ alert("Only an administrator or CSR can add a booking."); return; }
    editingId = id || null;
    // reset haven dropdown to all havens (filtering happens at the end via onStayChange)
    document.getElementById("f_haven").innerHTML = HAVENS.map(h => `<option>${h}</option>`).join("");
    fillCheckinTimes();
    if(editingId){
        const b = bookings.find(x => x.id === editingId);
        if(!b) return;
        document.getElementById("modalTitle").textContent = "Edit Booking";
        setField("f_haven", b.haven);
        renderGuestRows(b.guests);
        setField("f_contact", b.contact || "");
        setField("f_checkin", b.checkin);
        setField("f_checkout", b.checkout);
        updateStayOptions(b.stayHours || 6);
        setDashCheckinTime(checkinTimeStr(b));
        setField("f_swimpass", b.swimpass || 0);
        setField("f_towels", b.towels || 0);
        setField("f_extend", b.extend || 0);
        document.getElementById("f_holiday").checked = !!b.holiday;
        setField("f_deposit", b.deposit === undefined ? PRICING.deposit : b.deposit);
        setField("f_method", b.method || "GCash");
        setField("f_down", b.downpayment || 0);
        setField("f_notes", b.notes || "");
        renderProofPage(b);
    } else {
        document.getElementById("modalTitle").textContent = "Add Booking";
        document.getElementById("f_haven").selectedIndex = 0;
        renderGuestRows([{name:"",age:""}]);
        setField("f_contact", "");
        setField("f_checkin", iso(today()));
        setField("f_checkout", iso(addDays(today(),1)));
        updateStayOptions(6);
        setDashCheckinTime("8:00 AM");
        setField("f_swimpass", 0);
        setField("f_towels", 0);
        setField("f_extend", 0);
        document.getElementById("f_holiday").checked = false;
        setField("f_deposit", PRICING.deposit);
        setField("f_method", "GCash");
        setField("f_down", 0);
        setField("f_notes", "");
        renderProofPage(null);
    }
    bkGoPage(1);
    onStayChange();
    document.getElementById("overlay").classList.add("show");
}
function closeModal(){
    editingId = null;
    document.getElementById("overlay").classList.remove("show");
}

