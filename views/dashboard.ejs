// toggle a haven Live (shown on the website) ⇄ Offline (hidden). Default (no flag) = Live.
let _togglingLive = false;
async function toggleHavenLive(i){
    const h = listings[i]; if(!h) return;
    if(_togglingLive) return;
    _togglingLive = true;
    const next = (h.live === false);   // currently offline → go Live; otherwise → go Offline
    h.live = next;
    try{
        const ok = await saveOneRecord("staycation_havens", h);
        if(!ok){ h.live = !next; alert("⚠️ Couldn't update on the server (slow / offline). Please try again."); return; }
        setLocalKey("staycation_havens", listings);
        if(typeof logActivity === "function") logActivity((next ? "set LIVE" : "took OFFLINE") + " — " + (h.name || "haven"));
        renderListings();
    } finally { _togglingLive = false; }
}
let _savingHaven = false;
async function saveHaven(){
    if(hvEditIndex < 0) return;
    if(_savingHaven) return;   // block double-submit (redundant write + double log)
    _savingHaven = true;
    try{
        const i = hvEditIndex;
        const item = {
            id: listings[i].id,
            order: listings[i].order,                       // keep the haven's position through the edit
            name: document.getElementById("hvName").value.trim() || "Untitled Haven",
            image: document.getElementById("hvImg").value.trim(),
            gallery: hvDraftGallery.map(s => s.trim()).filter(Boolean),
            price: document.getElementById("hvPrice").value.trim(),
            description: document.getElementById("hvDesc").value,
            amenities: hvDraftAmen.map(s => s.trim()).filter(Boolean),
            live: !document.getElementById("hvLive") || document.getElementById("hvLive").checked   // Live/Offline (preserve through edits)
        };
        // PER-RECORD save: the server offloads every gallery/main-image photo to a durable ref,
        // so the images are never lost and one haven's save can't overwrite the others.
        const ok = await saveOneRecord("staycation_havens", item);
        if(!ok){ alert("⚠️ The haven was NOT saved — the server didn't confirm (slow / offline). Please try again."); return; }
        listings[i] = item;
        setLocalKey("staycation_havens", listings);
        logActivity(`edited haven listing — ${item.name}`);
        closeHaven();
        renderListings();
    } finally { _savingHaven = false; }
}

let _deletingHaven = false;
async function hvDeleteFromDrawer(){
    if(hvEditIndex < 0) return;
    const i = hvEditIndex;
    if(!confirm(`Delete "${listings[i].name}"? This removes it from the website.`)) return;
    if(_deletingHaven) return;   // block double-click (2nd delete would splice the wrong haven after the array shifts)
    _deletingHaven = true;
    try{
        const id = listings[i].id, name = listings[i].name;
        const ok = await deleteOneRecord("staycation_havens", id);
        if(!ok){ alert("⚠️ Couldn't delete on the server (slow / offline). Please try again."); return; }
        const idx = listings.findIndex(h => h.id === id);   // re-find by id (index may have shifted)
        if(idx !== -1){ listings[idx].deleted = true; listings[idx].deletedAt = new Date().toISOString(); listings.splice(idx, 1); }
        setLocalKey("staycation_havens", listings);
        logActivity(`deleted haven listing — ${name}`);
        closeHaven();
        renderListings();
    } finally { _deletingHaven = false; }
}

/* ---------- drag to reorder havens ---------- */
let dragSrcIndex = null;
function onDragStart(e, i){
    dragSrcIndex = i;
    e.dataTransfer.effectAllowed = "move";
    e.dataTransfer.setData("text/plain", String(i)); // Firefox needs data set
}
function onDragEnd(){
    dragSrcIndex = null;
    document.querySelectorAll(".hv-card.drag-over").forEach(c => c.classList.remove("drag-over"));
}
function onDragOver(e){ e.preventDefault(); e.dataTransfer.dropEffect = "move"; }
function onDragEnter(e){ if(dragSrcIndex !== null) e.currentTarget.classList.add("drag-over"); }
function onDragLeave(e){ e.currentTarget.classList.remove("drag-over"); }
async function onDrop(e, targetIndex){
    e.preventDefault();
    e.currentTarget.classList.remove("drag-over");
    if(dragSrcIndex === null || dragSrcIndex === targetIndex) return;
    const moved = listings.splice(dragSrcIndex, 1)[0];
    listings.splice(targetIndex, 0, moved);
    dragSrcIndex = null;
    renderListings();                                   // optimistic — snap into place immediately
    // persist the new order PER-RECORD: set order=index and save each haven whose position changed,
    // so the reorder survives the server's id-keyed merge (a whole-array write would be reordered away).
    const changed = [];
    listings.forEach((h, i) => { if(h.order !== i){ h.order = i; changed.push(h); } });
    for(const h of changed){ await saveOneRecord("staycation_havens", h); }
    setLocalKey("staycation_havens", listings);
}

async function saveListings(){
    listings.forEach((h, i) => { h.order = i; });       // lock in the current on-screen order
    for(const h of listings){ await saveOneRecord("staycation_havens", h); }
    setLocalKey("staycation_havens", listings);
    alert("All listings saved! They now show on the Home page and haven detail pages.");
}

