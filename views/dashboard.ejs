    sel.value = opts.some(s => String(s.id) === prev) ? prev : "";
}
// 15th/30th filter resolves to a cut-off in the latest period that has data
function payrollAnchor(){
    const cuts = [...new Set(staff.flatMap(s => staffCutoffs(s)))].sort();
    const base = cuts.length ? new Date(cuts[cuts.length - 1] + "T00:00:00") : today();
    return { y: base.getFullYear(), m: base.getMonth() };
}
function resolveCutoff(sel){
    if(sel !== "15" && sel !== "30") return "";
    const a = payrollAnchor();
    return sel === "15"
        ? pIso(new Date(a.y, a.m, 15))
        : pIso(new Date(a.y, a.m, Math.min(30, pLastDay(a.y, a.m))));
}

/* ---------- payroll scope (cut-off OR date range) ---------- */
// turn the period dropdown into a { start, end, label } range (null start = all time)
function resolveScope(val){
    const t = today();
    if(val === "today"){ const i = iso(t); return { start:i, end:i, label:"Today · " + fmt(i) }; }
    if(val === "month"){
        const s = iso(new Date(t.getFullYear(), t.getMonth(), 1));
        const e = iso(new Date(t.getFullYear(), t.getMonth() + 1, 0));
        return { start:s, end:e, label:"This month · " + monthLabel(s.slice(0, 7)) };
    }
    if(val === "custom"){
        const f = document.getElementById("payFrom").value;
        let tt = document.getElementById("payTo").value || f;
        if(!f) return { start:null, end:null, label:"custom (pick dates)" };
        if(tt < f) tt = f;
        return { start:f, end:tt, label:fmt(f) + " – " + fmt(tt) };
    }
    if(val === "15" || val === "30"){
        const payIso = resolveCutoff(val);
        const r = cutoffRangeOf(payIso);
        return { start:r.start, end:r.end, label:cutoffLabel(payIso) };
    }
    return { start:null, end:null, label:"all cut-offs" };
}
function staffDaysInRange(s, start, end){
    return staffAllDays(s).filter(d => d.date && (!start || d.date >= start) && (!end || d.date <= end));
}
function rangeGross(s, start, end){ return staffDaysInRange(s, start, end).reduce((sum, d) => sum + dayPay(s, d), 0); }
// deductions = sum of the cut-offs that the days in this range belong to
function rangeDeductions(s, start, end){
    if(s.role === "COMMISSION") return { sss:0, philhealth:0, pagibig:0, loan:0, total:0 };
    const cuts = [...new Set(staffDaysInRange(s, start, end).map(d => cutoffOf(d.date).payIso))];
    let sss = 0, ph = 0, pag = 0, loan = 0;
    cuts.forEach(p => { const dd = cutoffDeductions(s, p); sss += dd.sss; ph += dd.philhealth; pag += dd.pagibig; loan += dd.loan; });
    return { sss, philhealth:ph, pagibig:pag, loan, total: sss + ph + pag + loan };
}

// reusable day-entry table; recordId = null for the staff's main days, or a record id
function dayTableHtml(s, days, recordId){
    days = days.slice().sort((a, b) => (a.date || "").localeCompare(b.date || ""));
    const rid = recordId == null ? "null" : recordId;
    let head, rows, cols;
    if(s.role === "CSR"){
        cols = 8;
        const span = (a, b) => (a && b) ? `${time12(a)}–${time12(b)}` : "—";
        head = `<tr><th>Date</th><th>Morning</th><th>Afternoon</th><th>OT</th><th>Reg hrs</th><th>OT hrs</th><th>Pay</th><th class="col-actions"></th></tr>`;
        rows = days.map(d => {
            const reg = d.dayOff ? 0 : regHoursOf(d), ot = d.dayOff ? 0 : otHoursOf(d), nd = d.dayOff ? 0 : nightDiffOf(d);
            return `<tr>
                <td>${fmt(d.date)}${d.dayOff ? '<br><span class="muted">Day off</span>' : ''}${d.notes ? '<br><span class="muted">' + escHtml(d.notes) + '</span>' : ''}</td>
                <td>${(d.dayOff || d.amOff) ? '—' : span(d.timeIn, d.timeOut)}</td>
                <td>${(d.dayOff || d.pmOff) ? '—' : span(d.pmIn, d.pmOut)}</td>
                <td>${otSlotsOf(d).map(o => span(o.in, o.out)).filter(x => x !== '—').join('<br>') || '—'}</td>
                <td>${d.dayOff ? '—' : reg.toFixed(2)}</td>
                <td>${ot ? ot.toFixed(2) + (nd ? ' <span class="muted">+0.5 ND</span>' : '') : '—'}</td>
                <td><strong>${peso2(dayPay(s, d))}</strong></td>
                <td class="col-actions">${payrollIsAdmin() ? `
                    <span class="edit" onclick="openDayModal(${s.id}, ${d.id}, ${rid})">Edit</span>
                    <span class="del" onclick="deleteDay(${s.id}, ${d.id}, ${rid})">Delete</span>` : ""}
                </td>
            </tr>`;
        }).join("");
    } else {
        cols = 4;
        const booksRooms = s.role === "ASSIST" || s.role === "COMMISSION";
        head = `<tr><th>Date</th><th>Rooms</th><th>Pay</th><th class="col-actions"></th></tr>`;
        rows = days.map(d => {
            const booked = booksRooms ? roomsBookedOn(d.date) : 0;
            const cleaned = roomsCleanedOn(d.date, s.name);
            const bits = [];
            if(booksRooms) bits.push(`${booked} booked`);
            if(cleaned || !booksRooms) bits.push(`${cleaned} cleaned`);
            return `<tr>
                <td>${fmt(d.date)}${d.notes ? '<br><span class="muted">' + escHtml(d.notes) + '</span>' : ''}</td>
                <td>${bits.join(' · ')} <span class="muted">(auto)</span></td>
                <td><strong>${peso2(dayPay(s, d))}</strong></td>
                <td class="col-actions">${(payrollIsAdmin() && s.role !== "HOUSEKEEPING") ? `
                    <span class="edit" onclick="openDayModal(${s.id}, ${d.id}, ${rid})">Edit</span>
                    <span class="del" onclick="deleteDay(${s.id}, ${d.id}, ${rid})">Delete</span>` : ""}
                </td>
            </tr>`;
        }).join("");
    }
    if(!rows) rows = `<tr><td colspan="${cols}" class="muted" style="text-align:center;padding:16px;">No entries.</td></tr>`;
    return `<div style="overflow-x:auto;"><table class="pay-table"><thead>${head}</thead><tbody>${rows}</tbody></table></div>`;
}

/* ---------- separate records (standalone cut-off computations) ---------- */
function recordGross(s, rec){ return (rec.days || []).reduce((sum, d) => sum + dayPay(s, d), 0); }
function recordDeductions(s, rec){
    if(s.role === "COMMISSION") return { sss:0, philhealth:0, pagibig:0, loan:0, total:0 };
    const base = recordGross(s, rec);   // standalone: base is this record's own gross
    const b = s.benefits || {};
    const loan = Number(b.loans) || 0;
    if(cutoffHalf(rec.cutoff) === "15"){
        const ph = base * philRateOf(s) / 100, pag = Number(b.pagibig) || 0;
        return { philhealth:ph, pagibig:pag, sss:0, loan, total: ph + pag + loan };
    }
    const sss = sssMSC(base) * sssRateOf(s) / 100;   // SSS on bracketed MSC
    return { philhealth:0, pagibig:0, sss, loan, total: sss + loan };
}
function recordsHtml(s){
    const recs = s.records || [];
    if(!recs.length) return "";
    return `<div class="pay-records">
        <div class="pay-bt" style="margin-bottom:8px;">Separate records</div>` +
        recs.map(rec => {
            const g = recordGross(s, rec), dd = recordDeductions(s, rec), net = g - dd.total;
            return `<div class="pay-record">
                <div class="pay-record-head">
                    <b>${cutoffOptionLabel(rec.cutoff)}</b>
                    <div style="display:flex; align-items:center; gap:12px;">
                        ${payrollIsAdmin() ? `<button class="btn secondary" onclick="openDayModal(${s.id}, null, ${rec.id})">+ Add day</button>
                        <span class="del" onclick="deleteRecord(${s.id}, ${rec.id})">Delete record</span>` : ""}
                    </div>
                </div>
                ${dayTableHtml(s, rec.days || [], rec.id)}
                <div class="pay-benefits" style="margin-top:8px;"><span class="pay-bt">Deductions</span>${benefitsHtml(s, dd)}</div>
                <div class="pay-totals" style="margin-top:6px;">
                    <span>Gross: <b>${peso2(g)}</b></span>
                    <span>Deductions: <b style="color:#c0283d;">−${peso2(dd.total)}</b></span>
                    <span>Net: <b style="color:#2e7d4f;">${peso2(net)}</b></span>
                </div>
            </div>`;
        }).join("") + `</div>`;
}

function staffBoxHtml(s, scope){
    const days = staffDaysInRange(s, scope.start, scope.end);
    const gross = rangeGross(s, scope.start, scope.end);
    const dd = rangeDeductions(s, scope.start, scope.end);
    const ded = dd.total;
    const net = gross - ded;

    return `<div class="pay-staff">
        <div class="pay-staff-head">
            <div>
                <div class="pay-name">${s.name}</div>
                <div class="muted">${ROLE_LABEL[s.role]} · ${ROLE_RATE_INFO[s.role]}</div>
                <div class="muted" style="font-weight:bold; color:#b8923a;">Cut-off: ${scope.label}</div>
            </div>
            <div class="pay-staff-actions">
                ${(payrollIsAdmin() && s.role !== "HOUSEKEEPING") ? `<button class="btn secondary" onclick="openDayModal(${s.id})">+ Add day</button>` : ""}
                <span class="edit" onclick="downloadStaffPdf(${s.id})">PDF</span>
                ${payrollIsAdmin() ? `<span class="edit" onclick="openStaffModal(${s.id})">Edit</span>
                <span class="del" onclick="deleteStaff(${s.id})">Delete</span>` : ""}
            </div>
        </div>
        ${dayTableHtml(s, days, null)}
        <div class="pay-summary">
            <div class="pay-benefits">
                <span class="pay-bt">Deductions</span>
                ${benefitsHtml(s, dd)}
            </div>
            <div class="pay-totals">
                <span>Gross: <b>${peso2(gross)}</b></span>
                <span>Deductions: <b style="color:#c0283d;">−${peso2(ded)}</b></span>
                <span>Net: <b style="color:#2e7d4f;">${peso2(net)}</b></span>
            </div>
        </div>
        ${recordsHtml(s)}
        ${staffLogHtml(s)}
    </div>`;
}
function benefitsHtml(s, dd){
    if(s.role === "COMMISSION") return `<span class="muted">No deductions</span>`;
    return `<span>SSS ${peso2(dd.sss)} <span class="muted">(${sssRateOf(s)}%)</span></span>
            <span>PhilHealth ${peso2(dd.philhealth)} <span class="muted">(${philRateOf(s)}%)</span></span>
            <span>Pag-IBIG ${peso2(dd.pagibig)}</span>
            <span>Loan ${peso2(dd.loan)}</span>`;
}
