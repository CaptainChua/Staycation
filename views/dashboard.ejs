  #page-analytics .stack .seg-bills{ background:#bd6e3f; } #page-analytics .stack .seg-pay{ background:#9a3db8; } #page-analytics .stack .seg-exp{ background:#3f9e6a; }
  #page-analytics .stack-legend{ display:flex; flex-wrap:wrap; gap:18px; font-size:12.5px; color:var(--hv-muted); margin-bottom:20px; }
  #page-analytics .stack-legend b{ color:var(--hv-ink); }
