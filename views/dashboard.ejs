function toggleDayOff(){
    const off = document.getElementById("d_dayoff").checked;
    const amOff = off || document.getElementById("d_amoff").checked;
    const pmOff = off || document.getElementById("d_pmoff").checked;
    ["d_in","d_out"].forEach(id => document.getElementById(id).disabled = amOff);
    ["d_pmin","d_pmout"].forEach(id => document.getElementById(id).disabled = pmOff);
    document.querySelectorAll("#d_ot_list input").forEach(i => i.disabled = off);
    const otAdd = document.getElementById("d_ot_add"); if(otAdd) otAdd.disabled = off;
    document.getElementById("d_amoff").disabled = off;
    document.getElementById("d_pmoff").disabled = off;
}
function fillDayStaffOptions(){
    document.getElementById("d_staff").innerHTML = staff.map(s => `<option value="${s.id}">${escHtml(s.name)} (${ROLE_LABEL[s.role]})</option>`).join("");
}
// when the chosen staff changes in the modal, switch the role-specific fields
function onDayStaffChange(){
    const s = staff.find(x => x.id === Number(document.getElementById("d_staff").value));
    if(!s) return;
    setRoleFields(s.role);
    document.getElementById("dayModalTitle").textContent = (editingDayId ? "Edit" : "Add") + " Day — " + s.name;
    if(s.role === "CSR") toggleDayOff();
}
// where the day modal's entry lives: a staff record (rec.days) or the main s.days
function dayCollection(s){
    if(dayRecordId != null){ const rec = (s.records || []).find(r => r.id === dayRecordId); return rec ? (rec.days = rec.days || []) : []; }
    return (s.days = s.days || []);
}
// for a record day: a dropdown limited to the cut-off's dates; otherwise the calendar
function setDayDateField(s, dateIso){
    const g = i => document.getElementById(i);
    if(dayRecordId != null){
        const rec = (s.records || []).find(r => r.id === dayRecordId);
        g("d_date_cal_wrap").style.display = "none";
        g("d_day").style.display = "";
        fillDayOptions(rec ? rec.cutoff : cutoffOf(dateIso).payIso, dateIso);
    } else {
        g("d_date_cal_wrap").style.display = "";
        g("d_day").style.display = "none";
        setDayDate(dateIso);
    }
}
function openDayModal(staffId, dayId, recordId){
    if(!staff.length){ alert("Add a staff member first."); return; }
    fillDayStaffOptions();
    const s = staffId ? staff.find(x => x.id === staffId) : staff[0];
    if(!s) return;
    dayStaffId = s.id; editingDayId = dayId != null ? dayId : null; dayRecordId = (recordId != null ? recordId : null);
    const g = i => document.getElementById(i);
    g("d_staff").value = s.id;
    g("d_staff").disabled = !!editingDayId || dayRecordId != null;   // staff fixed when editing or adding to a record
    setRoleFields(s.role);
    g("dayModalTitle").textContent = (editingDayId ? "Edit" : "Add") + " Day — " + s.name;
    if(editingDayId){
        const d = dayCollection(s).find(x => x.id === editingDayId) || {};
        setDayDateField(s, d.date || iso(today()));
        g("d_dayoff").checked = !!d.dayOff;
        g("d_amoff").checked = !!d.amOff;
        g("d_pmoff").checked = !!d.pmOff;
        g("d_in").value = d.timeIn || "";
        g("d_out").value = d.timeOut || "";
        g("d_pmin").value = d.pmIn || "";
        g("d_pmout").value = d.pmOut || "";
        renderOtRows(otSlotsOf(d));
        g("d_cleaned").value = d.cleaned || 0;
        g("d_notes").value = d.notes || "";
    } else {
        setDayDateField(s, iso(today()));
        g("d_dayoff").checked = false;
        g("d_amoff").checked = false;
        g("d_pmoff").checked = false;
        g("d_in").value = "08:00";
        g("d_out").value = "12:00";
        g("d_pmin").value = "13:00";
        g("d_pmout").value = "17:00";
        renderOtRows([]);
        g("d_cleaned").value = 0;
        g("d_notes").value = "";
    }
    toggleDayOff();
    g("dayOverlay").classList.add("show");
}
function closeDayModal(){ dayStaffId = null; editingDayId = null; dayRecordId = null; document.getElementById("dayOverlay").classList.remove("show"); }
function saveDay(){
    const g = i => document.getElementById(i);
    const s = staff.find(x => x.id === Number(g("d_staff").value));
    if(!s) return;
    const date = g("d_date").value;
    if(!date){ alert("Please pick a date."); return; }
    const d = { date };
    if(s.role === "CSR"){
        d.dayOff  = g("d_dayoff").checked;
        d.amOff   = g("d_amoff").checked;
        d.pmOff   = g("d_pmoff").checked;
        d.timeIn  = g("d_in").value;
        d.timeOut = g("d_out").value;
        d.pmIn    = g("d_pmin").value;
        d.pmOut   = g("d_pmout").value;
        d.ots     = readOtSlots();
    } else if(s.role === "HOUSEKEEPING"){
        d.cleaned = Number(g("d_cleaned").value) || 0;
    }
    // ASSIST / COMMISSION rooms come from the calendar — only the date is stored
    d.notes = g("d_notes").value.trim();
    const where = dayRecordId != null ? " (record)" : "";
    const coll = dayCollection(s);
    if(editingDayId){
        const idx = coll.findIndex(x => x.id === editingDayId);
        if(idx !== -1) coll[idx] = { ...coll[idx], ...d };
        addStaffLog(s, "Edited day " + fmt(date) + where);
    } else {
        const id = coll.length ? Math.max(...coll.map(x => x.id || 0)) + 1 : 1;
        coll.push({ id, ...d });
        addStaffLog(s, "Added day " + fmt(date) + where);
    }
    persistStaff(); closeDayModal(); renderPayroll();
}
function deleteDay(staffId, dayId, recordId){
    if(!confirm("Delete this entry?")) return;
    const s = staff.find(x => x.id === staffId);
    if(!s) return;
    let coll;
    if(recordId != null){ const rec = (s.records || []).find(r => r.id === recordId); if(!rec) return; coll = rec.days = rec.days || []; }
    else coll = s.days = s.days || [];
    const d = coll.find(x => x.id === dayId);
    const idx = coll.findIndex(x => x.id === dayId);
    if(idx !== -1) coll.splice(idx, 1);
    addStaffLog(s, "Deleted day " + (d ? fmt(d.date) : "") + (recordId != null ? " (record)" : ""));
    persistStaff(); renderPayroll();
}

