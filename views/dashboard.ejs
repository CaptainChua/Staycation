/* ---------- users & access control ---------- */
const USERS_KEY = "shph_users";
const DASH_PAGES = [
    { key:"today",     label:"Today's Booking" },
    { key:"addbooking", label:"Add Booking" },
    { key:"approval",  label:"Booking Approval" },
    { key:"paymentapproval", label:"Payment Approval" },
    { key:"deposit",   label:"Security Deposit" },
    { key:"finance",   label:"Finance" },
    { key:"analytics", label:"Analytics" },
    { key:"calendar",  label:"Calendar/Bookings" },
    { key:"guestform", label:"Guest Form" },
    { key:"havens",    label:"Havens" },
    { key:"booking",   label:"Rates &amp; Add-ons" },
    { key:"payments",  label:"Payments" },
    { key:"cleaners",  label:"Housekeeping" },
    { key:"employees", label:"Employees" },
    { key:"log",       label:"Activity Log" },
    { key:"payroll",   label:"Payroll" },
    { key:"bills",     label:"Bills" },
    { key:"expenses",  label:"Expenses" },
    { key:"assist",    label:"Assist" }
];
function pageLabel(key){ const p = DASH_PAGES.find(x => x.key === key); return p ? p.label : key; }
function loadUsers(){
    let arr = null;
    const raw = localStorage.getItem(USERS_KEY);
    if(raw){ try { arr = JSON.parse(raw); } catch(e){} }
    if(!Array.isArray(arr)) arr = [];
    // self-heal (IN MEMORY ONLY): make sure this session always has an admin so the
    // UI works, but NEVER write/mirror it to the server here — a stale/empty local
    // copy (e.g. right after a cold start) would otherwise overwrite the real user
    // list on the server and wipe everyone. Persisting the admin is admin.html's job.
    if(!arr.some(u => u.admin && !u.deleted)){
        const nextId = (arr.reduce((m, u) => Math.max(m, Number(u.id) || 0), 0) || 0) + 1;
        arr.push({ id: nextId, name:"admin", password:"1234", admin:true, perms: DASH_PAGES.map(p => p.key) });
    }
    return arr.filter(u => !u.deleted);   // soft-deleted users stay on the server, hidden here
}
let users = loadUsers();
function persistUsers(){
    // 1) local copy (also triggers the seed-bridge's automatic mirror)
    localStorage.setItem(USERS_KEY, JSON.stringify(users));
    // 2) explicit, VERIFIED write to the shared server (Firestore) so a user is
    //    never silently lost if the fire-and-forget mirror happens to fail.
    saveUsersToServer(users.slice());
}
// PUT users to the server, confirm Firestore really stored them, retry on
// failure, and warn the admin if it ultimately can't be saved.
async function saveUsersToServer(arr, attempt){
    attempt = attempt || 1;
    const MAX = 4;
    const note = document.getElementById("userSaveNote");
    if(note && attempt === 1){ note.style.color = "#9a7b3f"; note.textContent = "Saving…"; }
    try {
        const res = await fetch("/api/kv/shph_users", {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(arr),
            cache: "no-store"
        });
        if(!res.ok) throw new Error("HTTP " + res.status);
        // read it back and confirm every user we sent is actually stored
        const check = await fetch("/api/kv/shph_users", { cache: "no-store" });
        const saved = check.ok ? await check.json() : null;
        const ok = Array.isArray(saved) &&
            arr.every(u => saved.some(s => String(s.id) === String(u.id) && s.name === u.name));
        if(!ok) throw new Error("verify mismatch");
        if(note){ note.style.color = "#1f9d3c"; note.textContent = "✓ Saved to server";
                  setTimeout(() => { if(note.textContent === "✓ Saved to server") note.textContent = ""; }, 3000); }
        return true;
    } catch(e){
        if(attempt < MAX){
            await new Promise(r => setTimeout(r, 500 * attempt));
            return saveUsersToServer(arr, attempt + 1);
        }
        if(note){ note.style.color = "#c0392b"; note.textContent = "⚠ NOT saved to server"; }
        alert("⚠️ This change is saved on THIS device but could NOT be saved to the server "
            + "(you may be offline or the server is unreachable).\n\nPlease check your internet "
            + "and open the Users page again to re-save — otherwise it may be lost on the next refresh.");
        return false;
    }
}

// resolve the logged-in user from the RAW stored name (no "Admin" default) so an
// unknown/missing session can't accidentally inherit admin access
function currentUserObj(){
    const name = (localStorage.getItem("shph_current_user") || "").trim();
    if(!name) return null;
    return users.find(u => (u.name || "").toLowerCase() === name.toLowerCase()) || null;
}
// fail CLOSED: an unrecognised user gets no admin / no pages (prevents the
// "full sidebar flashes for a limited user" glitch)
function isAdminUser(){ const u = currentUserObj(); return !!(u && u.admin); }
function currentPerms(){
    const u = currentUserObj();
    if(!u) return [];
    if(u.admin) return DASH_PAGES.map(p => p.key);
    return u.perms || [];
}
function pageAllowed(page){
    if(window.__PARTNER__) return ["today", "calendar", "deposit", "analytics", "finance", "bills", "expenses", "board"].includes(page);   // partner pages
    if(page === "users" || page === "log") return isAdminUser();   // Activity Log is admin-only (not partners/employees)
    return currentPerms().includes(page);
}
// hide nav items the current user can't access; redirect off a disallowed page
function applyPermissions(){
    // partner mode is driven entirely by partners.js (no admin user required)
    if(window.__PARTNER__){ if(typeof applyPartnerChrome === "function") applyPartnerChrome(); return; }
    // no recognised logged-in user → send to the login page instead of revealing anything
    if(!currentUserObj()){ window.location.href = window.__ON_PARTNER_PATH__ ? "/partner-login" : "/admin.html"; return; }
    const perms = currentPerms();
    const admin = isAdminUser();
    // the inline Activity Log on the Calendar page is admin-only — hide it from employees
    const _calLog = document.getElementById("calLogPanel");
    if(_calLog) _calLog.style.display = admin ? "" : "none";
    document.querySelectorAll(".sidebar .nav-item").forEach(n => {
        const pg = n.dataset.page;
        const ok = (pg === "users" || pg === "log") ? admin : perms.includes(pg);
        n.style.display = ok ? "flex" : "none";
    });
    // hide a section header (Property / Finance / Team …) when all its items are hidden
    document.querySelectorAll(".sidebar .nav-group").forEach(g => {
        let sib = g.nextElementSibling, any = false;
        while(sib && !(sib.classList && sib.classList.contains("nav-group"))){
            if(sib.classList && sib.classList.contains("nav-item") && sib.style.display !== "none"){ any = true; break; }
            sib = sib.nextElementSibling;
        }
        g.style.display = any ? "" : "none";
    });
    document.querySelector(".sidebar").classList.remove("perms-pending");  // reveal now that it's filtered
    if(typeof applyNavCollapse === "function") applyNavCollapse();          // honor minimized sub-categories
    const ab = document.getElementById("addBookingBtn");
    if(ab) ab.style.display = canAddBooking() ? "" : "none";   // only admin/CSR can add bookings
    const active = document.querySelector(".sidebar .nav-item.active");
    if(!active || active.style.display === "none"){
        const first = [...document.querySelectorAll(".sidebar .nav-item")].find(n => n.style.display !== "none");
        if(first) showPage(first.dataset.page);
    }
}

function renderUsers(){
    const el = document.getElementById("usersList");
    if(!el) return;
    el.innerHTML = users.map(u => {
        const access = u.admin ? "All pages + Users (administrator)"
            : ((u.perms && u.perms.length) ? u.perms.map(pageLabel).join(", ") : "No pages");
        const actCount = userActivityEntries(u.name).length;
        return `<div class="pay-staff">
            <div class="pay-staff-head">
                <div>
                    <div class="pay-name">${escHtml(u.name)} ${u.admin ? '<span class="tag yes">admin</span>' : ''}</div>
                    <div class="muted">${access}</div>
                </div>
                <div class="pay-staff-actions">
                    <span class="edit" onclick="toggleUserActivity(${u.id}, '${escAttr(u.name).replace(/'/g, "\\'")}')">Activity${actCount ? " (" + actCount + ")" : ""}</span>
                    <span class="edit" onclick="openUserModal(${u.id})">Edit</span>
                    <span class="del" onclick="deleteUser(${u.id})">Delete</span>
                </div>
            </div>
            <div class="user-activity" id="userActivity_${u.id}" style="display:none; margin-top:10px; border-top:1px solid #eee; padding-top:8px;"></div>
        </div>`;
    }).join("");
}
// every activity-log entry recorded by this user (admins-only view; the Users
// page is already restricted to administrators)
function userActivityEntries(name){
    let log = [];
    try { log = JSON.parse(localStorage.getItem(ACTIVITY_KEY)) || []; } catch(e){}
    const lname = (name || "").toLowerCase();
    return log.filter(e => (e.user || "").toLowerCase() === lname);
}
// show / hide a single user's activity log under their card
function toggleUserActivity(id, name){
    const box = document.getElementById("userActivity_" + id);
    if(!box) return;
    if(box.style.display !== "none"){ box.style.display = "none"; return; }
    const entries = userActivityEntries(name).slice().reverse().slice(0, 200);
    box.innerHTML = entries.length
        ? `<div class="muted" style="margin-bottom:6px;">${entries.length} action${entries.length === 1 ? "" : "s"} by ${escHtml(name)}</div>`
          + `<div style="max-height:300px; overflow-y:auto;">` + entries.map(e =>
            `<div class="log-row">
                <span class="log-when">${new Date(e.at).toLocaleString("en-PH")}</span>
                <span class="log-action">${escHtml(e.action || "")}</span>
             </div>`).join("") + `</div>`
        : `<div class="muted" style="padding:6px 2px;">No activity recorded for ${escHtml(name)} yet.</div>`;
    box.style.display = "";
}
function fillUserPerms(selected){
    document.getElementById("u_perms").innerHTML = `<div class="opt-row">` + DASH_PAGES.map(p =>
        `<label class="opt-check"><input type="checkbox" class="u-perm" value="${p.key}" ${selected.includes(p.key) ? "checked" : ""}> ${p.label}</label>`
    ).join("") + `</div>`;
}
function toggleUserAdmin(){
    const admin = document.getElementById("u_admin").checked;
    document.querySelectorAll(".u-perm").forEach(c => { c.disabled = admin; if(admin) c.checked = true; });
}
let editingUserId = null;
function openUserModal(id){
    editingUserId = id || null;
    const g = i => document.getElementById(i);
    if(editingUserId){
        const u = users.find(x => x.id === editingUserId);
        if(!u) return;
        g("userModalTitle").textContent = "Edit User";
        g("u_name").value = u.name;
        g("u_pass").value = u.password || "";
        g("u_admin").checked = !!u.admin;
        fillUserPerms(u.perms || []);
    } else {
        g("userModalTitle").textContent = "Add User";
        g("u_name").value = "";
        g("u_pass").value = "";
        g("u_admin").checked = false;
        fillUserPerms([]);
    }
    toggleUserAdmin();
    g("userOverlay").classList.add("show");
}
function closeUserModal(){ editingUserId = null; document.getElementById("userOverlay").classList.remove("show"); }
function saveUser(){
    const g = i => document.getElementById(i);
    const name = g("u_name").value.trim();
    if(!name){ alert("Please enter a username."); return; }
    const password = g("u_pass").value;
    if(!password){ alert("Please enter a password."); return; }
    if(users.some(u => (u.name || "").toLowerCase() === name.toLowerCase() && u.id !== editingUserId)){
        alert("That username already exists."); return;
    }
    const admin = g("u_admin").checked;
    const perms = admin ? DASH_PAGES.map(p => p.key) : [...document.querySelectorAll(".u-perm:checked")].map(c => c.value);
    const now = new Date().toISOString();   // stamp so the server's last-write-wins merge protects cross-device edits
    if(editingUserId){
        const idx = users.findIndex(u => u.id === editingUserId);
        users[idx] = { ...users[idx], name, password, admin, perms, updatedAt: now };
        logActivity(`edited user — ${name}`);
    } else {
        const id = uid();
        users.push({ id, name, password, admin, perms, updatedAt: now });
        logActivity(`added user — ${name}`);
    }
    persistUsers(); closeUserModal(); renderUsers(); applyPermissions();
}
function deleteUser(id){
    const u = users.find(x => x.id === id);
    if(u && u.admin && users.filter(x => x.admin).length <= 1){ alert("You can't delete the last administrator."); return; }
    if(!confirm("Delete this user?")) return;
    if(u) logActivity(`deleted user — ${u.name}`);
    if(u){ const now = new Date().toISOString(); u.deleted = true; u.deletedAt = now; u.updatedAt = now; }   // kept on the server, just hidden
    persistUsers();
    users = users.filter(x => !x.deleted);
    renderUsers(); applyPermissions();
}

renderUsers();
applyPermissions();
document.getElementById("currentUserLabel").textContent = "Logged in as " + currentUser();

// reopen the last page the admin was on (instead of resetting to Finance)
const savedPage = localStorage.getItem("shph_dashboard_page");
if(savedPage && document.getElementById("page-" + savedPage)) showPage(savedPage);
applyPermissions();

// opened here from Today's Booking's "+ Add booking" → show the unified modal
try{
    if(localStorage.getItem("shph_open_add") === "1"){
        localStorage.removeItem("shph_open_add");
        setTimeout(function(){ if(typeof openModal === "function") openModal(); }, 60);
    }
}catch(e){}
</script>

