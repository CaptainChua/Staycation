<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/seed') %>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard - Staycation Haven PH</title>
<link rel="icon" href="images/logo.png">

<style>
@import url('https://fonts.googleapis.com/css2?family=Mulish:wght@400;500;600;700;800&display=swap');
*{ margin:0; padding:0; box-sizing:border-box; font-family:'Mulish', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; }

body{ background:#f5f5f5; color:#222; padding:30px 30px 30px 250px; }

/* sidebar */
.sidebar{
    position:fixed;
    top:0;
    left:0;
    width:220px;
    height:100vh;
    background:#1a1a1a;
    color:#fff;
    padding:24px 0;
    overflow-y:auto;
    z-index:30;
}
.sidebar .brand{
    font-size:16px;
    font-weight:bold;
    padding:0 22px 22px;
    border-bottom:1px solid #2c2c2c;
    margin-bottom:14px;
    line-height:1.3;
}
.sidebar .nav-item{
    display:flex;
    align-items:center;
    gap:12px;
    padding:13px 22px;
    font-size:14px;
    color:#cfcfcf;
    cursor:pointer;
    border-left:3px solid transparent;
    transition:all .15s ease;
}
.sidebar .nav-item:hover{ background:#262626; color:#fff; }
.sidebar .nav-item.active{
    background:#262626;
    color:#fff;
    border-left-color:#ff385c;
    font-weight:bold;
}
.sidebar .nav-item .ico{ font-size:17px; width:20px; text-align:center; }
.sidebar.perms-pending .nav-item{ display:none !important; }  /* hide until access is checked (no flash) */

@media (max-width:760px){
    body{ padding:30px 15px 30px 15px; }
    .sidebar{
        position:static;
        width:auto;
        height:auto;
        display:flex;
        flex-wrap:wrap;
        padding:10px;
        margin:-30px -15px 20px;
    }
    .sidebar .brand{ width:100%; border:none; padding:8px 12px; margin-bottom:6px; }
    .sidebar .nav-item{ border-left:none; border-radius:8px; padding:9px 12px; }
    .sidebar .nav-item.active{ border-left:none; }
}

/* --- general mobile polish --- */
@media (max-width:600px){
    body{ padding:14px; }
    .topbar{ margin-bottom:18px; }
    .topbar h1{ font-size:19px; }
    .panel{ padding:16px; margin-bottom:18px; border-radius:12px; }
    .panel-head h2{ font-size:16px; }
    .cards{ gap:10px; margin-bottom:18px; }
    .card{ padding:14px; }
    .number{ font-size:24px; } .number.money{ font-size:19px; }
    .form-grid{ grid-template-columns:1fr; }       /* stack form fields */
    .modal{ padding:20px; border-radius:14px; }
    .overlay{ padding:16px 10px; }
    .modal-actions{ flex-wrap:wrap; }
    .modal-actions .btn, .modal-actions button{ flex:1; }   /* full-width modal buttons */
    .cal-nav{ flex-wrap:wrap; }
    .filters{ flex-wrap:wrap; }
    table{ font-size:12px; }
    th, td{ padding:8px 7px; }
    #cleanContainer{ grid-template-columns:1fr; }
    .clean-photos{ grid-template-columns:repeat(2, minmax(0, 1fr)); }
    .btn{ padding:10px 14px; font-size:13px; }
}

/* page sections */
.page{ display:none; }
.page.active{ display:block; }

.topbar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:25px;
    flex-wrap:wrap;
    gap:15px;
}
.topbar h1{ font-size:26px; }

.btn{
    border:none;
    background:#ff385c;
    color:white;
    padding:11px 18px;
    border-radius:10px;
    cursor:pointer;
    font-size:14px;
}
.btn.secondary{ background:#fff; color:#444; border:1px solid #ddd; }
.btn:hover{ opacity:.9; }

/* summary cards */
.cards{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(150px, 1fr));
    gap:16px;
    margin-bottom:30px;
}
.card{
    background:white;
    padding:18px;
    border-radius:14px;
    box-shadow:0 5px 15px rgba(0,0,0,.07);
}
.card h3{ font-size:13px; color:#777; font-weight:normal; margin-bottom:8px; }
.number{ font-size:28px; font-weight:bold; color:#ff385c; }
.number.money{ font-size:22px; }

/* section wrapper */
.panel{
    background:white;
    border-radius:16px;
    box-shadow:0 5px 15px rgba(0,0,0,.07);
    padding:22px;
    margin-bottom:30px;
}
.panel-head{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:18px;
    flex-wrap:wrap;
    gap:10px;
}
.panel-head h2{ font-size:18px; }

/* calendar timeline */
.cal-nav{ display:flex; gap:8px; align-items:center; }
.date-pill{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:8px;
    font-size:13px;
    font-weight:bold;
    color:#444;
    background:#fff;
    border:1px solid #e6e6e6;
    border-radius:30px;
    padding:9px 16px;
    min-width:170px;
    cursor:pointer;
    box-shadow:0 2px 6px rgba(0,0,0,.06);
    transition:all .15s ease;
}
.date-pill::before{ content:"📅"; font-size:14px; }
.date-pill::after{
    content:"▾";
    font-size:11px;
    color:#bbb;
    transition:color .15s ease;
}
.date-pill:hover{
    color:#ff385c;
    border-color:#ff385c;
    box-shadow:0 4px 12px rgba(255,56,92,.18);
    transform:translateY(-1px);
}
.date-pill:hover::after{ color:#ff385c; }

/* custom date picker popup */
.dp-wrap{ position:relative; }
.dp-popup{
    display:none;
    position:absolute;
    top:50px;
    left:50%;
    transform:translateX(-50%);
    width:300px;
    background:#fff;
    border:1px solid #f0f0f0;
    border-radius:20px;
    box-shadow:0 12px 35px rgba(0,0,0,.16);
    padding:18px;
    z-index:40;
}
.dp-popup.show{ display:block; }
.dp-popup::before{ /* little pointer */
    content:"";
    position:absolute;
    top:-8px;
    left:50%;
    transform:translateX(-50%) rotate(45deg);
    width:16px; height:16px;
    background:#fff;
    border-left:1px solid #f0f0f0;
    border-top:1px solid #f0f0f0;
}
/* cleaners picker sits at the right of the header — open it leftward so it
   doesn't overflow the page edge (default .dp-popup is centered) */
#cleanDpPopup{ left:auto; right:0; transform:none; }
#cleanDpPopup::before{ left:auto; right:30px; transform:rotate(45deg); }
/* bill due-date picker — keep it inside the modal */
#b_due_popup{ left:auto; right:0; transform:none; top:48px; }
#b_due_popup::before{ left:auto; right:30px; transform:rotate(45deg); }
.dp-head{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:14px;
}
.dp-head span{ font-size:15px; font-weight:bold; color:#333; }
.dp-head button{
    width:32px; height:32px;
    border:none;
    background:#f6f6f6;
    border-radius:50%;
    cursor:pointer;
    font-size:16px;
    color:#555;
    transition:all .15s ease;
}
.dp-head button:hover{ background:#f0f0f0; color:#111; }
.dp-grid{
    display:grid;
    grid-template-columns:repeat(7, minmax(0, 1fr));
    column-gap:0;
    row-gap:6px;
}
.dp-wd{
    text-align:center;
    font-size:11px;
    font-weight:bold;
    color:#bbb;
    padding:4px 0;
    min-width:0;
}
.dp-day{
    position:relative;
    height:40px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:13px;
    color:#333;
    cursor:pointer;
    min-width:0;
}
.dp-day .n{
    width:34px;
    height:34px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:50%;
    position:relative;
    z-index:1;
    transition:background .12s ease;
}
.dp-day.empty{ cursor:default; }
.dp-day.disabled{ color:#d2d2d2; cursor:default; }
.dp-day.today .n{ font-weight:bold; }
.dp-day:not(.sel):not(.disabled):not(.empty):hover .n{ background:#efefef; }

/* continuous range band */
.dp-day.in-range{ background:#f1f1f1; }
.dp-day.range-start{ background:linear-gradient(to right, transparent 50%, #f1f1f1 50%); }
.dp-day.range-end{ background:linear-gradient(to left, transparent 50%, #f1f1f1 50%); }
.dp-day.sel .n{ background:#1a1a1a; color:#fff; font-weight:bold; }

/* round the band at the row edges */
.dp-grid > *:nth-child(7n+1){ border-top-left-radius:20px; border-bottom-left-radius:20px; }
.dp-grid > *:nth-child(7n){ border-top-right-radius:20px; border-bottom-right-radius:20px; }
.dp-hint{
    font-size:11px;
    color:#999;
    text-align:center;
    margin-top:12px;
    line-height:1.4;
}
.dp-foot{
    display:flex;
    justify-content:space-between;
    margin-top:10px;
    padding-top:12px;
    border-top:1px solid #f3f3f3;
}
.dp-foot span{
    font-size:13px;
    font-weight:bold;
    color:#333;
    cursor:pointer;
}
.dp-foot span:hover{ text-decoration:underline; }

.timeline{ overflow-x:auto; }
.tl-grid{ display:grid; min-width:760px; }
.tl-cell{
    border-bottom:1px solid #f0f0f0;
    border-right:1px solid #f5f5f5;
    height:54px;
    position:relative;
}
.tl-head{
    font-size:11px;
    color:#888;
    text-align:center;
    padding:6px 2px;
    height:auto;
    border-bottom:2px solid #eee;
}
.tl-head.weekend{ color:#ff385c; }
.tl-cell.is-today{ background:#fff0f3; }
.tl-head.is-today{ background:#ffe3ea; color:#ff385c; font-weight:bold; border-radius:6px 6px 0 0; }
.tl-haven{
    font-size:13px;
    font-weight:bold;
    display:flex;
    align-items:center;
    padding:0 12px;
    border-bottom:1px solid #f0f0f0;
    background:#fafafa;
    position:sticky;
    left:0;
    z-index:2;
}
.tl-haven.tl-head{ background:#fff; }

.bar{
    position:absolute;
    top:7px;
    bottom:7px;
    border-radius:7px;
    color:white;
    font-size:11px;
    padding:0 8px;
    display:flex;
    align-items:center;
    overflow:hidden;
    white-space:nowrap;
    cursor:pointer;
    z-index:1;
}
.bar.paid{ background:#2e9e5b; }
.bar.partial{ background:#e0a800; }
.bar.unpaid{ background:#d63a4f; }

.legend{ display:flex; gap:16px; font-size:12px; color:#666; margin-top:14px; flex-wrap:wrap; }
.dot{ display:inline-block; width:11px; height:11px; border-radius:3px; margin-right:5px; vertical-align:middle; }
.dot.paid{ background:#2e9e5b; }
.dot.partial{ background:#e0a800; }
.dot.unpaid{ background:#d63a4f; }

/* filters */
.filters{ display:flex; gap:10px; flex-wrap:wrap; }
.filters select, .filters input{
    padding:9px 11px;
    border:1px solid #ddd;
    border-radius:9px;
    font-size:13px;
}
.fin-filter{ align-items:center; }
.fin-filter .fin-date{
    display:inline-flex;
    align-items:center;
    gap:6px;
    font-size:12px;
    color:#666;
}

/* per-haven analytics */
.haven-analytics{
    display:grid;
    grid-template-columns:repeat(auto-fill, minmax(270px, 1fr));
    gap:16px;
}
.ha-card{
    border:1px solid #eee;
    border-radius:14px;
    padding:14px 16px;
    background:#fdfdfd;
}
.ha-head{ font-weight:bold; font-size:15px; margin-bottom:12px; display:flex; align-items:center; }
.ha-stats{
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:8px;
    margin-bottom:6px;
}
.ha-stat{
    background:#fff;
    border:1px solid #f0f0f0;
    border-radius:10px;
    padding:8px 6px;
    text-align:center;
}
.ha-stat b{ display:block; font-size:16px; color:#222; line-height:1.2; }
.ha-stat span{ font-size:10px; color:#999; }
.ha-chart{ margin-top:12px; }
.ha-chart-title{
    font-size:11px; color:#888; font-weight:bold;
    margin-bottom:6px; text-transform:uppercase; letter-spacing:.3px;
}
.ha-peak{ color:#ff385c; font-weight:bold; }
.mini-bars{ display:flex; flex-direction:column; gap:5px; }
.mb-row{ display:flex; align-items:center; gap:8px; font-size:11px; }
.mb-label{ width:56px; color:#666; flex:none; }
.mb-track{ flex:1; height:10px; background:#f0f0f0; border-radius:6px; overflow:hidden; }
.mb-fill{ display:block; height:100%; border-radius:6px; transition:width .25s ease; }
.mb-val{ width:30px; text-align:right; color:#333; font-weight:bold; flex:none; }

/* bills grouped by haven — bordered group per haven, auto-fitting */
.bills-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(440px, 1fr));
    gap:18px;
}
.bills-haven{
    border:1px solid #e6e6e6;
    border-radius:14px;
    padding:16px 18px 6px;
}
.bills-haven-title{
    text-align:center;
    font-size:18px;
    font-weight:800;
    margin:2px 0 14px;
    padding-bottom:12px;
    border-bottom:1px solid #eee;
}
.bills-table{ width:100%; border-collapse:collapse; font-size:13px; table-layout:fixed; }
.bills-table th, .bills-table td{
    padding:11px 8px;
    border-bottom:1px solid #f0f0f0;
    text-align:left;
    vertical-align:top;
}
.bills-table th{
    color:#888; font-weight:bold; font-size:12px;
    text-transform:uppercase; letter-spacing:.3px;
}
.bills-table tbody tr:hover{ background:#fafafa; }
.bills-table .col-actions{ text-align:right; }
.bills-table .col-actions .edit,
.bills-table .col-actions .del{ margin-right:6px; }

/* payroll */
.pay-staff{ border:1px solid #e6e6e6; border-radius:14px; padding:16px 18px; margin-bottom:18px; }
.pay-staff:last-child{ margin-bottom:0; }
.pay-staff-head{ display:flex; justify-content:space-between; align-items:flex-start; gap:12px; flex-wrap:wrap; margin-bottom:12px; }
.pay-name{ font-size:17px; font-weight:800; }
.pay-staff-actions{ display:flex; align-items:center; gap:12px; }
.pay-table{ width:100%; border-collapse:collapse; font-size:13px; }
.pay-table th, .pay-table td{ padding:9px 8px; border-bottom:1px solid #f0f0f0; text-align:left; white-space:nowrap; }
.pay-table th{ color:#888; font-weight:bold; font-size:11px; text-transform:uppercase; letter-spacing:.3px; }
.pay-table tbody tr:hover{ background:#fafafa; }
.pay-table .col-actions{ text-align:right; }
.pay-table .col-actions .edit{ margin-right:8px; }
.pay-summary{ display:flex; justify-content:space-between; gap:16px; flex-wrap:wrap; margin-top:14px; padding-top:12px; border-top:1px solid #eee; }
.pay-benefits{ display:flex; flex-wrap:wrap; gap:12px; font-size:12px; color:#666; align-items:center; }
.pay-benefits .pay-bt{ font-weight:bold; color:#888; text-transform:uppercase; font-size:11px; letter-spacing:.3px; }
.pay-totals{ display:flex; gap:18px; font-size:14px; align-items:center; flex-wrap:wrap; }
.pay-records{ border-top:1px solid #eee; margin-top:14px; padding-top:10px; }
.pay-record{ border:1px solid #eee; border-radius:10px; padding:12px 14px; margin-bottom:12px; background:#fcfcfc; }
.pay-record-head{ display:flex; justify-content:space-between; align-items:center; gap:10px; margin-bottom:8px; flex-wrap:wrap; }
.pay-record-head .btn{ padding:7px 12px; font-size:13px; }

/* cleaners / housekeeping */
#cleanContainer{ display:grid; grid-template-columns:repeat(2, 1fr); gap:16px; align-items:start; }
@media(max-width:760px){ #cleanContainer{ grid-template-columns:1fr; } }
.clean-card{ background:#fff; border:1px solid #ececec; border-radius:12px; box-shadow:none; padding:18px 22px; margin-bottom:0; }
.clean-head{ display:flex; justify-content:space-between; align-items:flex-start; gap:12px; margin-bottom:12px; }
.clean-haven{ font-size:16px; font-weight:700; }
.clean-info{ display:flex; gap:24px; flex-wrap:wrap; margin-bottom:14px; }
.clean-info .ci-label{ display:block; font-size:11px; color:#aaa; text-transform:uppercase; letter-spacing:.3px; margin-bottom:2px; }
.clean-info b{ font-weight:600; font-size:13px; }
.clean-towels{ background:transparent; color:#a8851f; border:none; padding:0; font-size:13px; font-weight:600; margin-bottom:16px; }
.clean-towels.none{ color:#bbb; font-weight:normal; }
.clean-photos-title{ font-size:12px; font-weight:600; color:#888; margin-bottom:10px; }
.clean-photos{ display:grid; grid-template-columns:repeat(auto-fill, minmax(120px, 1fr)); gap:12px; margin-bottom:16px; }
.photo-slot{ border:none; border-radius:0; padding:0; text-align:center; }
.photo-label{ font-size:11px; font-weight:600; color:#888; margin-bottom:6px; letter-spacing:.2px; }
.photo-thumb{ width:100%; aspect-ratio:1/1; height:auto; object-fit:cover; border-radius:10px; display:block; margin-bottom:6px; }
.photo-empty{ width:100%; aspect-ratio:1/1; display:flex; align-items:center; justify-content:center; background:#fafafa; border:1px dashed #e2e2e2; border-radius:10px; color:#c4c4c4; font-size:11px; margin-bottom:6px; }
.photo-btn{ display:inline-block; font-size:11px; color:#2b6cb0; cursor:pointer; }
.photo-btn input{ display:none; }
.photo-remove{ display:block; font-size:11px; color:#c0283d; cursor:pointer; margin-top:3px; }
.clean-actions{ display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:10px; }
.clean-actions .btn{ padding:8px 18px; font-size:13px; border-radius:8px; box-shadow:none; }
.log-row{ display:flex; gap:14px; align-items:baseline; padding:10px 2px; border-bottom:1px solid #f1f1f1; font-size:13px; }
.log-row:last-child{ border-bottom:none; }
.log-when{ flex:0 0 170px; color:#999; font-size:12px; }
.log-user{ flex:0 0 120px; font-weight:700; color:#1f1f1f; }
.log-action{ flex:1; color:#444; }
.clean-summary-table{ font-size:12px; }
.clean-summary-table th{ font-size:10px; }
.clean-summary-table th, .clean-summary-table td{ padding:7px 10px; }
.clean-summary-table .dot{ display:inline-block; width:9px; height:9px; border-radius:50%; margin-right:6px; vertical-align:middle; }
.haven-link{ color:#2b6cb0; cursor:pointer; font-weight:600; }
.haven-link:hover{ text-decoration:underline; }
.clean-haven .dot{ display:inline-block; width:11px; height:11px; border-radius:50%; margin-right:7px; vertical-align:middle; }
.clean-reports{ background:#fdeef0; border:1px solid #f5c2c8; border-radius:10px; padding:10px 12px; margin:10px 0; font-size:13px; }
.clean-reports b{ display:block; color:#c0283d; margin-bottom:4px; }
.clean-report-item{ margin-bottom:3px; }
.clean-card-flash{ outline:3px solid #ff385c; outline-offset:3px; transition:outline .3s; }
.btn-report{ border:none; background:#d63a4f; color:#fff; padding:11px 18px; border-radius:10px; font-size:13px; font-weight:600; cursor:pointer; }
.btn-report:hover{ opacity:.9; }
.clean-log{ font-size:12px; }
.clean-log summary{ cursor:pointer; color:#2b6cb0; font-weight:600; }
.clean-log ul{ margin:8px 0 0 18px; }
.clean-log li{ margin-bottom:4px; }
.btn:disabled{ opacity:.5; cursor:not-allowed; }

/* floating single-date calendar (payroll day modal) */
.dpi-wrap{ position:relative; }
.dpi-input{
    padding:10px 12px;
    border:1px solid #ddd;
    border-radius:9px;
    font-size:13px;
    background:#fff;
    cursor:pointer;
    display:flex;
    align-items:center;
    justify-content:space-between;
}
.dpi-input::after{ content:"📅"; font-size:14px; }
.dpi-input:hover{ border-color:#b8923a; }
.dpi-popup{
    display:none;
    position:absolute;
    top:48px;
    left:0;
    z-index:70;
    width:300px;
    box-sizing:border-box;
    background:#fff;
    border:1px solid #f0f0f0;
    border-radius:16px;
    box-shadow:0 12px 35px rgba(0,0,0,.18);
    padding:16px;
}
.dpi-popup.show{ display:block; }
.dpi-popup .dp-head{ margin-bottom:10px; }
.dpi-popup .dp-grid{ grid-template-columns:repeat(7, minmax(0, 1fr)); column-gap:0; row-gap:2px; width:100%; }
.dpi-popup .dp-wd{ padding:2px 0; min-width:0; }
.dpi-popup .dp-day{ height:36px; min-width:0; }
.dpi-popup .dp-day .n{ width:32px; height:32px; font-size:13px; }

/* table */
table{ width:100%; border-collapse:collapse; font-size:13px; }
th, td{ text-align:left; padding:11px 10px; border-bottom:1px solid #f0f0f0; vertical-align:top; }
th{ color:#888; font-weight:bold; font-size:12px; text-transform:uppercase; letter-spacing:.3px; }
tbody tr:hover{ background:#fafafa; }
.tag{
    display:inline-block;
    padding:2px 8px;
    border-radius:20px;
    font-size:11px;
    background:#eef;
    color:#446;
}
.tag.yes{ background:#e3f5ea; color:#2e7d4f; }
.tag.no{ background:#f3f3f3; color:#aaa; }
.status{
    padding:3px 10px;
    border-radius:20px;
    font-size:11px;
    font-weight:bold;
}
.status.paid{ background:#e3f5ea; color:#2e7d4f; }
.status.partial{ background:#fff4d6; color:#9a7700; }
.status.unpaid{ background:#fde3e7; color:#c0283d; }
.actions{ white-space:nowrap; }
.edit{ color:#2b6cb0; cursor:pointer; font-size:12px; margin-right:10px; }
.edit:hover{ text-decoration:underline; }
.del{ color:#c0283d; cursor:pointer; font-size:12px; }
.del:hover{ text-decoration:underline; }
.muted{ color:#999; font-size:12px; }

/* modal */
.overlay{
    display:none;
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.45);
    z-index:50;
    justify-content:center;
    align-items:flex-start;
    padding:40px 15px;
    overflow:auto;
}
.overlay.show{ display:flex; }
.modal{
    background:white;
    border-radius:18px;
    padding:28px;
    width:560px;
    max-width:100%;
}
.modal h2{ margin-bottom:18px; }
.form-grid{ display:grid; grid-template-columns:1fr 1fr; gap:14px; }
.field{ display:flex; flex-direction:column; gap:5px; }
.field.full{ grid-column:1 / -1; }
.field label{ font-size:12px; color:#666; }
.field input, .field select, .field textarea{
    padding:10px;
    border:1px solid #ddd;
    border-radius:9px;
    font-size:13px;
    font-family:inherit;
}
.modal-actions{ display:flex; justify-content:flex-end; gap:10px; margin-top:22px; }

/* booking modal tabs + proof of payment page */
.bk-tabs{ display:flex; gap:6px; margin:6px 0 18px; border-bottom:1px solid #eee; }
.bk-tab{ padding:9px 14px; font-size:13px; font-weight:600; color:#888; cursor:pointer; border-bottom:2px solid transparent; margin-bottom:-1px; }
.bk-tab:hover{ color:#444; }
.bk-tab.active{ color:#ff385c; border-bottom-color:#ff385c; }
#bkPage2{ display:grid; grid-template-columns:repeat(auto-fit, minmax(190px, 1fr)); gap:18px; }
.proof-summary{ grid-column:1 / -1; display:flex; flex-wrap:wrap; gap:10px; background:#f7f7f8; border-radius:12px; padding:14px 16px; }
.proof-summary .ps-item{ flex:1 1 120px; }
.proof-summary .ps-label{ display:block; font-size:11px; color:#999; text-transform:uppercase; letter-spacing:.3px; margin-bottom:3px; }
.proof-summary .ps-val{ font-size:16px; font-weight:700; color:#1f1f1f; }
.proof-summary .ps-val.bal{ color:#d63a4f; }
.proof-summary .ps-val.paid{ color:#2e9e5b; }
.proof-del{ display:inline-block; margin-top:6px; font-size:12px; color:#c0283d; cursor:pointer; }
.proof-del:hover{ text-decoration:underline; }
.proof-block h3{ font-size:15px; margin:0 0 8px; }
.proof-meta{ font-size:12px; color:#555; background:#f7f7f8; border-radius:8px; padding:9px 12px; margin-bottom:8px; line-height:1.5; }
.proof-img{ width:150px; height:150px; object-fit:cover; border-radius:10px; border:1px solid #eee; display:block; margin-bottom:8px; cursor:zoom-in; transition:transform .1s; }
.proof-img:hover{ transform:scale(1.02); }
.proof-empty{ font-size:13px; color:#aaa; padding:8px 0; }
.proof-upload{ display:inline-block; font-size:12px; color:#2b6cb0; cursor:pointer; }
.proof-upload input{ display:block; margin-top:6px; font-size:12px; }
/* full-size image viewer */
.img-lightbox{ position:fixed; inset:0; background:rgba(0,0,0,.85); display:none; align-items:center; justify-content:center; z-index:120; cursor:zoom-out; }
.img-lightbox.show{ display:flex; }
.img-lightbox img{ max-width:92vw; max-height:92vh; border-radius:8px; }
@media (max-width:560px){ #bkPage2{ grid-template-columns:1fr; } }

/* guest rows in the form */
.guest-row-edit{ display:flex; gap:8px; margin-bottom:8px; align-items:center; }
.guest-row-edit .g-name{ flex:2; }
.guest-row-edit .g-age{ flex:1; }
.guest-row-edit input{ padding:10px; border:1px solid #ddd; border-radius:9px; font-size:13px; }
.g-remove{
    color:#c0283d;
    cursor:pointer;
    font-size:16px;
    padding:0 6px;
    user-select:none;
}
.add-guest{ font-size:12px; padding:8px 14px; }
.check-label{ flex-direction:row !important; align-items:center; gap:8px; cursor:pointer; }
.check-label input{ width:auto; }
.breakdown{ font-size:11px; color:#999; margin-top:6px; line-height:1.5; }
#f_total{ background:#fafafa; font-weight:bold; }
#f_balance{ background:#fafafa; }

.empty{ text-align:center; color:#aaa; padding:30px; }

/* haven listings manager */
.listing-grid{
    display:grid;
    grid-template-columns:repeat(auto-fill, minmax(300px, 1fr));
    gap:18px;
}
.listing-card{
    border:1px solid #eee;
    border-radius:14px;
    padding:14px;
    background:#fdfdfd;
}
.listing-card img{
    width:100%;
    height:150px;
    object-fit:cover;
    border-radius:10px;
    margin-bottom:10px;
    background:#f0f0f0;
}
.listing-card label{
    display:block;
    font-size:12px;
    color:#666;
    margin-top:9px;
}
.listing-card input, .listing-card textarea{
    width:100%;
    padding:8px;
    border:1px solid #ddd;
    border-radius:8px;
    font-size:13px;
    font-family:inherit;
    margin-top:3px;
}
.gallery-list{ display:flex; flex-direction:column; gap:8px; margin-top:6px; }
.gallery-row{ display:flex; gap:6px; align-items:center; }
.gallery-row input{ flex:1; margin-top:0 !important; }
.gallery-del{ flex:0 0 auto; border:none; background:#f4f4f4; color:#c0283d; width:32px; height:32px; border-radius:8px; cursor:pointer; font-size:18px; line-height:1; }
.gallery-del:hover{ background:#fde3e7; }
.add-photo-btn{ margin-top:8px; font-size:12px; padding:7px 14px; }
.listing-card .row2{ display:flex; gap:10px; }
.listing-card .row2 > div{ flex:1; }
.listing-card .delete-btn{
    width:100%;
    margin-top:12px;
    background:#fff;
    color:#c0283d;
    border:1px solid #f2c2c9;
    border-radius:9px;
    padding:9px;
    cursor:pointer;
    font-size:13px;
}
.listing-card .delete-btn:hover{ background:#fde3e7; }
.listing-card .save-one-btn{ width:100%; margin-top:12px; padding:10px; font-size:13px; }
.drag-handle{
    cursor:grab;
    color:#999;
    font-size:12px;
    text-align:center;
    padding:6px;
    margin-bottom:10px;
    border:1px dashed #ddd;
    border-radius:8px;
    user-select:none;
}
.drag-handle:active{ cursor:grabbing; }
.listing-card.drag-over{ outline:2px dashed #ff385c; outline-offset:3px; }

.listing-toolbar{ display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:16px; }
.listing-toolbar select{
    padding:9px 12px;
    border:1px solid #ddd;
    border-radius:8px;
    font-size:14px;
    font-family:inherit;
    background:#fff;
    cursor:pointer;
}
.listing-toolbar select:focus{ outline:none; border-color:#b8923a; }
.listing-pager{ display:flex; align-items:center; justify-content:center; gap:16px; margin-top:22px; }
.listing-pager .btn:disabled{ opacity:.45; cursor:not-allowed; }

.bookings-pager{ display:flex; align-items:center; justify-content:center; gap:6px; flex-wrap:wrap; margin-top:18px; }
.page-btn{ min-width:36px; padding:7px 11px; border:1px solid #ddd; background:#fff; color:#333; border-radius:8px; cursor:pointer; font-size:14px; }
.page-btn.active{ background:#ff385c; color:#fff; border-color:#ff385c; font-weight:bold; }
.page-btn:disabled{ opacity:.45; cursor:not-allowed; }
.page-btn:hover:not(:disabled):not(.active){ background:#f5f5f5; }

/* website settings editors */
.settings-section{
    background:#fafafa;
    border:1px solid #ececec;
    border-radius:14px;
    padding:18px 20px 20px;
    margin-top:18px;
}
.settings-section h3{
    font-size:15px;
    margin:0 0 16px;
    padding-bottom:12px;
    border-bottom:1px solid #e6e6e6;
}
.settings-form{
    display:grid;
    grid-template-columns:repeat(auto-fill, minmax(210px, 1fr));
    gap:16px;
}
.settings-form label{
    display:block;
    font-size:12px;
    font-weight:600;
    color:#666;
}
.settings-form input{
    width:100%;
    margin-top:6px;
    padding:10px;
    border:1px solid #ddd;
    border-radius:8px;
    font-size:14px;
    font-family:inherit;
    background:#fff;
}
.settings-form input:focus{
    outline:none;
    border-color:#b8923a;
}
.settings-form label.full{ grid-column:1 / -1; }

.opt-row{ display:flex; align-items:center; gap:18px; flex-wrap:wrap; margin-top:16px; }
.opt-check{ display:flex; align-items:center; gap:6px; font-size:14px; color:#333; cursor:pointer; }
.opt-check input{ width:auto; }
.custom-addons-head{ font-weight:600; margin:20px 0 10px; }
.addon-edit-row{ display:flex; align-items:center; gap:10px; margin-bottom:8px; flex-wrap:wrap; }
.addon-edit-row input[type=text]{ flex:2; min-width:150px; padding:9px; border:1px solid #ddd; border-radius:8px; font-size:14px; font-family:inherit; }
.addon-edit-row input[type=number]{ width:110px; padding:9px; border:1px solid #ddd; border-radius:8px; font-size:14px; font-family:inherit; }
.addon-del{ background:#fff; color:#c0283d; border:1px solid #f2c2c9; border-radius:8px; padding:9px 12px; cursor:pointer; }
.addon-del:hover{ background:#fde3e7; }

.method-card{
    background:#fff;
    border:1px solid #e6e6e6;
    border-radius:12px;
    padding:16px;
    margin-bottom:14px;
}
.method-card .method-qr{ margin-top:14px; }
.method-card .qr-preview{ max-width:150px; margin:8px 0; }
.method-card .delete-btn{
    width:100%;
    margin-top:14px;
    background:#fff;
    color:#c0283d;
    border:1px solid #f2c2c9;
    border-radius:9px;
    padding:9px;
    cursor:pointer;
    font-size:13px;
}
.method-card .delete-btn:hover{ background:#fde3e7; }

.qr-grid{
    display:grid;
    grid-template-columns:repeat(auto-fill, minmax(200px, 1fr));
    gap:16px;
}
.qr-box{
    border:1px solid #eee;
    border-radius:12px;
    padding:14px;
    background:#fdfdfd;
}
.qr-box .qr-title{ font-weight:bold; font-size:14px; margin-bottom:10px; }
.qr-preview{
    width:100%;
    max-width:180px;
    border:1px solid #eee;
    border-radius:10px;
    margin-bottom:10px;
    display:block;
}
.qr-box input[type=file]{ font-size:12px; width:100%; }
.qr-box .qr-remove{ margin-top:10px; padding:7px 12px; font-size:12px; }

.brand-logo{ height:26px; width:auto; vertical-align:middle; margin-right:6px; }
.title-logo{ height:34px; width:auto; vertical-align:middle; margin-right:8px; }
</style>
</head>
