function hvPreviewImg(url){
    const box = document.getElementById("hvMainImg");
    box.style.backgroundImage = url ? `url("${String(url).replace(/"/g, "%22")}")` : "";
}

function hvRenderGallery(){
    document.getElementById("hvGallery").innerHTML = hvDraftGallery.map((u, idx) => {
        const bg = String(u || "").replace(/'/g, "%27").replace(/"/g, "%22");
        return `<div class="hv-gcard" draggable="true" data-gi="${idx}" title="Drag to reorder"`
            + ` ondragstart="hvGalDragStart(event, ${idx})" ondragend="hvGalDragEnd(event)"`
            + ` ondragover="hvGalDragOver(event)" ondragleave="hvGalDragLeave(event)" ondrop="hvGalDrop(event, ${idx})"`
            + ` style="background-image:url('${bg}')">`
            + `<button class="hv-gx" draggable="false" onmousedown="event.stopPropagation()" onclick="hvDelGallery(${idx})" title="Remove">✕</button></div>`;
    }).join("");
}
function hvDelGallery(idx){ hvDraftGallery.splice(idx, 1); hvRenderGallery(); }
// drag to rearrange the gallery photos
let _hvGalDrag = -1;
function hvGalDragStart(e, i){ _hvGalDrag = i; e.currentTarget.classList.add("dragging"); try{ e.dataTransfer.effectAllowed = "move"; e.dataTransfer.setData("text/plain", String(i)); }catch(_){} }
function hvGalDragEnd(e){ e.currentTarget.classList.remove("dragging"); _hvGalDrag = -1; document.querySelectorAll("#hvGallery .hv-gcard.over").forEach(el => el.classList.remove("over")); }
function hvGalDragOver(e){ e.preventDefault(); try{ e.dataTransfer.dropEffect = "move"; }catch(_){} e.currentTarget.classList.add("over"); }
function hvGalDragLeave(e){ e.currentTarget.classList.remove("over"); }
function hvGalDrop(e, i){
    e.preventDefault();
    e.currentTarget.classList.remove("over");
    const from = _hvGalDrag; _hvGalDrag = -1;
    if(from < 0 || from === i) return;
    const moved = hvDraftGallery.splice(from, 1)[0];
    hvDraftGallery.splice(i, 0, moved);
    hvRenderGallery();
}
// upload an image file (compressed) as the main image
function hvUploadMain(file, inputEl){
    if(!file) return;
    compressImageTo(file, idMaxBytes, function(dataUrl){
        if(!dataUrl){ alert("Sorry, couldn't read that image — please try another file."); return; }
        document.getElementById("hvImg").value = dataUrl;
        hvPreviewImg(dataUrl);
    });
    if(inputEl) inputEl.value = "";
}
// upload one or more images (compressed) into the gallery — from the file input, a drop, or a paste
function hvUploadGallery(files, inputEl){
    if(!files || !files.length) return;
    let pending = 0, added = 0;
    Array.prototype.forEach.call(files, function(f){
        if(!f || !/^image\//.test(f.type)) return;
        pending++;
        compressImageTo(f, idMaxBytes, function(dataUrl){
            if(dataUrl){ hvDraftGallery.push(dataUrl); added++; }
            else { const r = new FileReader(); r.onload = e => { hvDraftGallery.push(e.target.result); added++; hvRenderGallery(); }; r.readAsDataURL(f); }
            if(--pending === 0){ hvRenderGallery(); const nm = document.getElementById("hvGalName"); if(nm && added) nm.textContent = added + " photo" + (added > 1 ? "s" : "") + " added ✓ — Save changes to keep them"; }
        });
    });
    if(inputEl) inputEl.value = "";
}
// drag / drop / paste into the gallery card (paste only while the haven drawer is open)
(function initHvGalleryUpload(){
    const card = document.getElementById("hvGalCard");
    if(card){
        card.addEventListener("dragover", e => { e.preventDefault(); card.classList.add("drag"); });
        card.addEventListener("dragleave", e => { if(!card.contains(e.relatedTarget)) card.classList.remove("drag"); });
        card.addEventListener("drop", e => { e.preventDefault(); card.classList.remove("drag"); const f = e.dataTransfer && e.dataTransfer.files; if(f && f.length) hvUploadGallery(f); });
    }
    document.addEventListener("paste", e => {
        const dr = document.getElementById("hvDrawer");
        if(!dr || !dr.classList.contains("open")) return;   // only while the Editing Haven drawer is open
        const items = (e.clipboardData && e.clipboardData.items) || [];
        const imgs = [];
        for(const it of items){ if(it.type && it.type.indexOf("image") === 0){ const f = it.getAsFile(); if(f) imgs.push(f); } }
        if(imgs.length){ hvUploadGallery(imgs); e.preventDefault(); }
    });
})();

