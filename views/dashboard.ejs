// fill the Day dropdown with every date inside the chosen cut-off
function fillDayOptions(payIso, selectIso){
    const sel = document.getElementById("d_day");
    const r = cutoffRangeOf(payIso);
    let opts = "";
    for(let d = new Date(r.start + "T00:00:00"); iso(d) <= r.end; d = addDays(d, 1)){
        const i = iso(d);
        opts += `<option value="${i}">${fmt(i)}</option>`;
    }
    sel.innerHTML = opts;
    if(selectIso) sel.value = selectIso;
    syncDayDate();
}
