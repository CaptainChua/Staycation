  #page-analytics .mini{ display:flex; align-items:center; gap:12px; background:#fff; border:1px solid var(--hv-line); border-radius:14px; padding:13px 16px; box-shadow:0 6px 20px rgba(80,60,30,.04); }
  #page-analytics .mini .ico svg{ width:17px; height:17px; }
  #page-analytics .mini .lbl{ font-size:10.5px; letter-spacing:.4px; text-transform:uppercase; color:var(--hv-muted); font-weight:700; }
  #page-analytics .mini .mval{ font-size:17px; font-weight:800; color:var(--hv-ink); margin-top:2px; }

  #page-analytics .panel-head h2{ font-family:'Playfair Display',Georgia,serif; font-weight:700; }
