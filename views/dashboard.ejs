<script src="havens-data.js"></script>
<script src="site-settings.js"></script>
<script src="amenity-icons.js"></script>
<script>
/* ---------- config ---------- */
// haven list is derived from the real haven listings so the calendar always
// matches what's on the Havens page (no hardcoded names that drift out of sync)
function havenNames(){
    try {
        const hv = loadHavens();
        if(Array.isArray(hv) && hv.length) return hv.map(h => h.name).filter(Boolean);
    } catch(e){}
    return ["Haven 1","Haven 2","Haven 3","Haven 4","Haven 5","Haven 7","Haven 8","CasaBienca","CasaSiesta"];
}
let HAVENS = havenNames();
// per-haven calendar colors: am = pastel, pm = slightly darker pastel.
// Any haven not listed here falls back to a generated pastel (see havenColor).
const HAVEN_COLORS = {
    "Haven 1":    { am:"#d9bdf5", pm:"#b98ee6" }, // pastel purple
    "Haven 2":    { am:"#fde68a", pm:"#ecca4e" }, // pastel yellow
    "Haven 3":    { am:"#bcbcbc", pm:"#8c8c8c" }, // pastel black (gray)
    "Haven 4":    { am:"#bcf3cf", pm:"#84dca0" }, // pastel green
    "Haven 5":    { am:"#bcd0fb", pm:"#7ea6f4" }, // pastel royal blue
    "Haven 7":    { am:"#aef0f7", pm:"#66d8e8" }, // pastel cyan
    "Haven 8":    { am:"#fcd0e7", pm:"#f5a3d0" }, // pastel pink
    "CasaBienca": { am:"#cdff8f", pm:"#a8ec5c" }, // pastel neon green
    "CasaSiesta": { am:"#ffd2a8", pm:"#f5ab68" }  // pastel orange
};
// deterministic pastel for any haven without an explicit color
function havenPastel(name){
    let h = 0; for(let i=0;i<name.length;i++) h = (h*31 + name.charCodeAt(i)) % 360;
    return { am:`hsl(${h} 70% 80%)`, pm:`hsl(${h} 60% 66%)` };
}
function havenColors(name){ return HAVEN_COLORS[name] || (HAVEN_COLORS[name] = havenPastel(name)); }
function havenColor(b){
    const c = havenColors(b.haven);
    return b.slot === "evening" ? c.pm : c.am;
}
const STATUS_COLOR = { paid:"#2e9e5b", partial:"#e0a800", unpaid:"#d63a4f" };
const DAYS = 7; // days shown in calendar (week view)
let viewDays = DAYS; // current number of days shown (1 = today only)
let filterToWindow = false; // when true, the bookings table is limited to the shown date window
const MAX_RANGE = 30; // max selectable days in the date picker
let pendingStart = null; // iso of first click while choosing a range
let hoverIso = null;     // iso of hovered day (for live range preview)
const KEY = "shph_bookings_v3"; // bumped: pricing-based totals + deposit/holiday fields

/* ---------- date helpers ---------- */
function today(){ const d = new Date(); d.setHours(0,0,0,0); return d; }
function addDays(date, n){ const d = new Date(date); d.setDate(d.getDate()+n); return d; }
function iso(date){
    // local date (avoids UTC timezone shifting the day, e.g. in PH / UTC+8)
    const y = date.getFullYear();
    const m = String(date.getMonth()+1).padStart(2,"0");
    const d = String(date.getDate()).padStart(2,"0");
    return `${y}-${m}-${d}`;
}
function fmt(dateStr){
    const d = new Date(dateStr + "T00:00:00");
    return d.toLocaleDateString("en-PH", {month:"short", day:"numeric"});
}
function daysBetween(a, b){ // whole days from a to b
    return Math.round((new Date(b) - new Date(a)) / 86400000);
}
function peso(n){ return "₱" + Number(n).toLocaleString("en-PH"); }
// money with centavos, e.g. ₱90.50
function peso2(n){ return "₱" + Number(n).toLocaleString("en-PH", { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }

/* ---------- booking check-in / check-out times ---------- */
const DASH_HAVEN_TIMES = {
    "Haven 1":{in:"12:00 NN"}, "Haven 2":{in:"12:00 NN"}, "Haven 3":{in:"12:00 NN"},
    "Haven 4":{in:"3:00 PM"}, "Haven 5":{in:"3:00 PM"}, "Haven 7":{in:"3:00 PM"},
    "Haven 8":{in:"6:00 PM"}, "Casa Bienca":{in:"6:00 PM"}
};
function parseTimeMin(str){
    const m = String(str).match(/^(\d{1,2}):(\d{2})\s*(AM|PM|NN|MN)$/i);
    if(!m) return null;
    let h = Number(m[1]); const min = Number(m[2]); const suf = m[3].toUpperCase();
    if(suf === "NN") h = 12; else if(suf === "MN") h = 0; else if(suf === "PM") h = (h % 12) + 12; else h = h % 12;
    return h * 60 + min;
}
function minToTime(min){
    min = ((min % 1440) + 1440) % 1440;
    const h = Math.floor(min / 60), mm = String(min % 60).padStart(2, "0");
    if(h === 0) return `12:${mm} MN`;
    if(h === 12) return `12:${mm} NN`;
    return `${h > 12 ? h - 12 : h}:${mm} ${h < 12 ? "AM" : "PM"}`;
}
function bookingCheckinMin(b){
    if(b.checkinTime){ const m = parseTimeMin(b.checkinTime); if(m != null) return m === 0 ? 1440 : m; }
    const h = Number(b.stayHours) || 21;
    if(h === 6) return parseTimeMin(b.slot === "evening" ? "7:00 PM" : "9:00 AM");
    if(h === 21){ const t = DASH_HAVEN_TIMES[b.haven]; return t ? parseTimeMin(t.in) : parseTimeMin("12:00 NN"); }
    return parseTimeMin("8:00 AM");
}
function checkinTimeStr(b){ return minToTime(bookingCheckinMin(b)); }
function checkoutTimeStr(b){
    return minToTime(bookingCheckinMin(b) + ((Number(b.stayHours) || 21) + (Number(b.extend) || 0)) * 60);
}

/* ---------- pricing ---------- */
const PRICING = {
    stay6: 999,
    stay10: 1599,
    stay21Weekday: 1799,   // Sunday–Thursday
    stay21Weekend: 2099,   // Friday or Saturday (based on check-in day)
    longWeekday: 1699,     // 3+ nights · Sunday–Thursday (per night)
    longWeekend: 1899,     // 3+ nights · Friday or Saturday (per night)
    swimRegular: 150,      // per pax
    swimHoliday: 300,      // per pax
    towel: 50,             // each
    extendPerHr: 150,
    deposit: 1000,
    baseIncludedPax: 2,    // base stay rate covers 2 pax
    addPax: 300,           // per extra head, age 5 and above
    addPaxMinAge: 5,       // only guests this age or older are charged
    maxPax: 5,             // max guests per unit
    maxAdults: 4,
    maxKids: 2,
    kidMaxAge: 13          // kid = 0–13 yo
};
// billable heads = guests aged 5+ ; first 2 are covered by the base rate
function billablePax(guests){
    return (guests || []).filter(g => g.age != null && Number(g.age) >= PRICING.addPaxMinAge).length;
}
function addPaxFee(guests){
    return Math.max(0, billablePax(guests) - PRICING.baseIncludedPax) * PRICING.addPax;
}
function lastName(name){
    const parts = (name || "").trim().split(/\s+/);
    return parts.length ? parts[parts.length - 1].toLowerCase() : "";
}
// occupied day range as a half-open interval [checkin, endExcl); same-day (6h) = 1 day
function endExcl(b){
    return b.checkout > b.checkin ? b.checkout : iso(addDays(new Date(b.checkin + "T00:00:00"), 1));
}
// returns an existing booking that conflicts with `cand`, or null.
// 10h/21h fully occupy the haven for overlapping dates; 6h allows a second
// booking on the same date only if it uses the OTHER time slot.
function findConflict(cand, excludeId){
    const cs = cand.checkin, ce = endExcl(cand);
    return bookings.find(b => {
        if(b.id === excludeId) return false;
        if(b.cancelled) return false;            // cancelled bookings free up the haven
        if(b.haven !== cand.haven) return false;
        const overlap = cs < endExcl(b) && b.checkin < ce; // half-open: back-to-back is OK
        if(!overlap) return false;
        if(Number(b.stayHours) !== 6 || Number(cand.stayHours) !== 6) return true; // a 10h/21h blocks fully
        return b.slot === cand.slot; // both 6h: clash only if same slot
    }) || null;
}
function slotLabel(slot){
    return slot === "morning" ? "AM (8AM–12NN)" : slot === "evening" ? "PM (7PM–12MN)" : "";
}
// ADMIN-side conflict check: based on the actual time window (check-in time + duration),
// not a whole-day block — so a short 6h booking can sit in a haven's free hours even when a
// later/longer booking exists the same day. The public site keeps its own strict day rules.
function bookingInterval(b){
    const midnightMin = Math.round(new Date(b.checkin + "T00:00:00").getTime() / 60000);
    const start = midnightMin + bookingCheckinMin(b);
    // overnight stays (incl. multi-night) are occupied until the check-out date's morning,
    // so a 2-night booking blocks every night — not just the first 21h window
    if(Number(b.stayHours) === 21 && b.checkout && b.checkout > b.checkin){
        const coMidnight = Math.round(new Date(b.checkout + "T00:00:00").getTime() / 60000);
        const checkoutMin = (bookingCheckinMin(b) + (21 + (Number(b.extend) || 0)) * 60) % 1440;
        return { start, end: coMidnight + checkoutMin };
    }
    const dur = ((Number(b.stayHours) || 21) + (Number(b.extend) || 0)) * 60;
    return { start, end: start + dur };
}
// minimum turnaround/cleaning gap required between two stays in the same haven.
// e.g. if a guest checks out at 8:00 AM, the next check-in can only be 9:00 AM or later.
const CLEANING_GAP_MIN = 60; // 1 hour
// the property opens for check-ins at 9:00 AM. A same-day check-out pushes the next
// check-in even later via CLEANING_GAP_MIN; this floor covers havens that have been
// vacant since an earlier day (you still can't check a guest in before 9 AM).
const EARLIEST_CHECKIN_MIN = 540; // 9:00 AM
// do two booking time-windows clash, including the required cleaning gap between them?
function intervalsClash(ai, bi){
    return ai.start < bi.end + CLEANING_GAP_MIN && bi.start < ai.end + CLEANING_GAP_MIN;
}
function findConflictAdmin(cand, excludeId){
    const ci = bookingInterval(cand);
    return bookings.find(b => {
        if(b.id === excludeId) return false;
        if(b.cancelled) return false;            // cancelled bookings free up the haven
        if(b.haven !== cand.haven) return false;
        return intervalsClash(ci, bookingInterval(b));   // overlap incl. the 2h cleaning gap
    }) || null;
}
// nights of an overnight stay (>=1) from the check-in/out dates
function stayNights(checkin, checkout){
    if(!checkin || !checkout) return 1;
    return Math.max(1, daysBetween(checkin, checkout));
}
// overnight base across one or more nights; the "3+ nights" long-stay rate kicks in at 3 nights
function overnightBase(checkin, checkout){
    const nights = stayNights(checkin, checkout);
    const longStay = nights >= 3;
    let sum = 0;
    const d = new Date(checkin + "T00:00:00");
    for(let i = 0; i < nights; i++){
        const wd = d.getDay();                       // 0 Sun .. 6 Sat
        const weekend = (wd === 5 || wd === 6);      // Fri / Sat
        sum += longStay ? (weekend ? PRICING.longWeekend : PRICING.longWeekday)
                        : (weekend ? PRICING.stay21Weekend : PRICING.stay21Weekday);
        d.setDate(d.getDate() + 1);
    }
    return sum;
}
function baseRate(stayHours, checkinIso, checkoutIso){
    stayHours = Number(stayHours);
    if(stayHours === 6) return PRICING.stay6;
    if(stayHours === 10) return PRICING.stay10;
    if(stayHours === 21){
        const co = checkoutIso || iso(addDays(new Date(checkinIso + "T00:00:00"), 1));
        return overnightBase(checkinIso, co);        // 1 night = single overnight rate
    }
    return 0;
}
function computeTotal(b){
    const base = baseRate(b.stayHours, b.checkin, b.checkout);
    const pax  = addPaxFee(b.guests);
    const swim = (Number(b.swimpass) || 0) * (b.holiday ? PRICING.swimHoliday : PRICING.swimRegular);
    const tow  = (Number(b.towels) || 0) * PRICING.towel;
    const ext  = (Number(b.extend) || 0) * PRICING.extendPerHr;
    const dep  = (b.deposit === undefined ? PRICING.deposit : Number(b.deposit)) || 0;
    return Math.max(0, base + pax + swim + tow + ext + dep - (Number(b.discount) || 0));
}

/* ---------- data ---------- */
function load(){
    const raw = localStorage.getItem(KEY);
    // soft-deleted bookings are KEPT on the server (never erased) but hidden from every view here
    if(raw) return JSON.parse(raw).map(migrate).filter(b => !b.deleted);
    const seed = seedData();
    localStorage.setItem(KEY, JSON.stringify(seed));
    return seed;
}
// canonical signature of a booking (key-order-independent, ignores updatedAt) so we can
// tell which records actually changed and stamp only those with a fresh edit time.
function _bkCanon(v){
    if(Array.isArray(v)) return "[" + v.map(_bkCanon).join(",") + "]";
    if(v && typeof v === "object") return "{" + Object.keys(v).filter(k => k !== "updatedAt").sort()
        .map(k => JSON.stringify(k) + ":" + _bkCanon(v[k])).join(",") + "}";
    return JSON.stringify(v);
}
let _bkSig = null;   // id -> last-saved canonical signature (baseline for change detection)
// (re)build the change-detection baseline from the CURRENT loaded list, so _stampLocal only marks
// records the user actually changes afterward. Seeding from localStorage was wrong: migrate()
// normalises fields on load, so every migrated booking looked "changed" and got mass-stamped with a
// fresh time — that stale snapshot then won the merge and wiped real edits (e.g. deposit returns).
function _seedBkSig(arr){
    _bkSig = {};
    (arr || []).forEach(b => { if(b && b.id != null) _bkSig[String(b.id)] = _bkCanon(b); });
}
let _lastCreatedBookingId = null;
// NOTE: the old whole-array save()/confirmBookingSaved() were removed — every booking write is now
// per-record (patchBooking / saveOneRecord / bkPaymentEdit·Delete / bookingAction).
// durably apply a single booking status change (cancel / reinstate / delete) by sending only
// the id + action — a tiny request the server applies to the stored array. This avoids
// re-uploading the whole bookings array (which carries base64 images), so a quick refresh
// right after the click can't lose the change.
async function bookingAction(id, action){
    try {
        await fetch(`/api/booking/${encodeURIComponent(id)}/${action}`, { method: "POST" });
    } catch(e){ /* offline — the normal localStorage mirror is the fallback */ }
}

// bring older saved bookings up to the current data shape
function migrate(b){
    if(!b.guests){
        b.guests = b.name ? [{ name:b.name, age:18 }] : [];
    }
    if(b.downpayment === undefined) b.downpayment = Number(b.paid) || 0;
    if(typeof b.swimpass === "boolean") b.swimpass = b.swimpass ? 1 : 0;
    if(b.stayHours === undefined) b.stayHours = 6;
    if(Number(b.stayHours) === 6 && !b.slot) b.slot = "morning"; // legacy 6h → default to AM slot
    return b;
}

// collections recorded after booking (via the Paid button) — separate from the downpayment
function collectedSum(b){ return (b.payments || []).reduce((s,p) => s + (Number(p.amount) || 0), 0); }
// total the customer has paid = original downpayment + later collections
function paidOf(b){ return Number(b.downpayment || 0) + collectedSum(b); }
// a cancelled booking owes nothing more — the non-refundable downpayment stays as revenue,
// but the remaining balance is no longer due
function balanceOf(b){ if(b.cancelled) return 0; return Math.max(0, Number(b.total || 0) - paidOf(b)); }
// revenue actually kept = everything paid, minus a security deposit that's been returned to the guest
function netCollectedOf(b){
    // a cancelled booking's kept downpayment that was refunded to the guest leaves revenue entirely
    if(b.dpRefunded) return 0;
    if(!b.depositReturned) return paidOf(b);
    // only the amount actually refunded leaves revenue; any deduction (damage/smoking) is kept
    const refund = (b.depositRefundAmount != null) ? Number(b.depositRefundAmount) : Number(b.deposit || 0);
    return paidOf(b) - refund;
}
// Revenue per booking for Business Analytics. A scoped partner earns only the ROOM RATE +
// EXTENDED HOURS — add-ons (towels / pool pass) aren't theirs and the refundable security
// deposit is never revenue, so it's excluded. Admin keeps the full collected-revenue figure.
function analyticsRevenueOf(b){
    if(window.__PARTNER__ && !window.__PARTNER__.superAdmin){
        if(b.cancelled || b.deleted) return 0;
        const room = baseRate(b.stayHours, b.checkin, b.checkout);
        const ext  = (Number(b.extend) || 0) * PRICING.extendPerHr;
        return Math.max(0, room + ext);   // deposit & add-ons intentionally not included
    }
    return netCollectedOf(b);
}
function statusOf(b){
    if(b.cancelled) return "cancelled";
    const paid = paidOf(b);
    if(paid >= b.total && b.total > 0) return "paid";
    if(paid > 0) return "partial";
    return "unpaid";
}

function seedData(){
    const t = today();
    const d = n => iso(addDays(t, n));
    const raw = [
        { id:1, haven:"Haven 1", contact:"0917 123 4567",
          guests:[{name:"Maria Santos",age:34},{name:"Pedro Santos",age:36}],
          checkin:d(0), checkout:d(2), stayHours:21,
          swimpass:2, towels:3, extend:0, holiday:false, method:"GCash", pay:"full", notes:"Early check-in requested" },
        { id:2, haven:"Haven 3", contact:"0928 555 1212",
          guests:[{name:"John Dela Cruz",age:28}],
          checkin:d(0), checkout:d(1), stayHours:10,
          swimpass:1, towels:4, extend:2, holiday:false, method:"Cash", pay:"partial", notes:"" },
        { id:3, haven:"Casa Bienca", contact:"0905 777 8899",
          guests:[{name:"Anna Reyes",age:41},{name:"Luis Reyes",age:43}],
          checkin:d(1), checkout:d(4), stayHours:21,
          swimpass:0, towels:5, extend:0, holiday:true, method:"BDO", pay:"full", notes:"Anniversary celebration" },
        { id:4, haven:"Haven 2", contact:"0917 444 3322",
          guests:[{name:"Mark Villanueva",age:30},{name:"Liza Cruz",age:27}],
          checkin:d(3), checkout:d(5), stayHours:10,
          swimpass:2, towels:2, extend:0, holiday:false, method:"Maya", pay:"none", notes:"" },
        { id:5, haven:"Haven 5", contact:"0939 222 1100",
          guests:[{name:"Grace Lim",age:25}],
          checkin:d(2), checkout:d(2), stayHours:6, slot:"morning",
          swimpass:0, towels:1, extend:1, holiday:false, method:"GCash", pay:"partial", notes:"" }
    ];
    return raw.map(b => {
        b.deposit = PRICING.deposit;
        b.total = computeTotal(b);
        b.downpayment = b.pay === "full" ? b.total : b.pay === "partial" ? 500 : 0;
        delete b.pay;
        return b;
    });
}

let bookings = load();
_seedBkSig(bookings);   // baseline for edit-stamping = the loaded state (prevents mass-stamping on first save)
/* Partner mode (read-only, single haven): a logged-in partner sees ONLY their
   haven. Filtering the bookings array here scopes EVERY view (stats, calendar,
   table). Chrome/lockdown lives in partners.js (applyPartnerChrome). */
var _pPath = location.pathname.replace(/\/+$/, "").toLowerCase();
if(new URLSearchParams(location.search).get("mode") === "partner"
   || _pPath === "/partners" || _pPath.endsWith("/partner-dashboard")){
    window.__ON_PARTNER_PATH__ = true;   // on a partner URL → if not signed in, send to partner-login (never admin)
    let _ps = null;
    try{ _ps = JSON.parse(localStorage.getItem("shph_partner_session") || "null"); }catch(e){}
    if(_ps && _ps.superAdmin){
        window.__PARTNER__ = _ps;                       // super admin: every haven, no filter
    } else if(_ps && _ps.haven){
        window.__PARTNER__ = _ps;
        bookings = bookings.filter(b => b.haven === _ps.haven);
    } else {
        location.replace("/partner-login");
    }
}
// Cross-tab sync: when ANOTHER tab changes the shared bookings, reload them here so this
// tab can never save a STALE list back over newer data. Without this, having the dashboard
// open in two tabs lets an old tab silently overwrite (delete) bookings a newer tab added.
window.addEventListener("storage", function(e){
    if(e.key !== KEY) return;
    try{
        bookings = load();
        _seedBkSig(bookings);   // another tab's data is now our baseline → don't re-stamp it as ours
        if(window.__PARTNER__ && !window.__PARTNER__.superAdmin && window.__PARTNER__.haven){
            bookings = bookings.filter(b => b.haven === window.__PARTNER__.haven);
        }
    }catch(err){ return; }
    if(typeof renderAll === "function") renderAll();
});
// Cross-tab refresh for the OTHER shared lists. When another tab — or the guest website — changes a
// bill/expense/staff/user/haven, reload that list here and re-render, so an open tab never shows (or
// acts on) stale data. The callback runs long after load, so the *_KEY consts are initialised by then.
window.addEventListener("storage", function(e){
    if(!e || !e.key) return;
    try{
        if(e.key === BILLS_KEY){ bills = loadBills(); if(typeof renderBills === "function") renderBills(); }
        else if(e.key === EXPENSES_KEY){ expenses = loadExpenses(); if(typeof renderExpenses === "function") renderExpenses(); }
        else if(e.key === PAYROLL_KEY){ staff = loadStaff(); if(typeof renderPayroll === "function") renderPayroll(); }
        else if(e.key === USERS_KEY){ users = loadUsers(); if(typeof renderUsers === "function") renderUsers(); }
        else if(e.key === CLEAN_KEY){ try{ cleaning = JSON.parse(localStorage.getItem(CLEAN_KEY) || "{}") || {}; }catch(e2){} if(typeof renderCleaners === "function") renderCleaners(); }
        else if(e.key === "staycation_havens"){
            const dr = document.getElementById("hvDrawer");
            if(dr && dr.classList.contains("open")) return;   // don't swap listings out from under an open edit
            listings = loadHavens(); if(typeof sortListings === "function") sortListings(); if(typeof renderListings === "function") renderListings();
        }
    }catch(err){}
});
let rangeStart = today();
let viewMode = "week";   // "today" | "week" | "custom" — remembered across refreshes
let calHaven = "";       // calendar haven filter ("" = all havens)
let calSearch = "";      // calendar search — show only bookings matching name / mobile / booking #

/* ---------- guest helpers ---------- */
function primaryName(b){ return (b.guests && b.guests[0] && b.guests[0].name) || "(no name)"; }
// month-view glyph for a booking's stay length: 6h = star, 10h = square, 21h = circle
function stayShape(b){
    const h = Number(b.stayHours) || 21;
    if(h === 6)  return "★";
    if(h === 10) return "■";
    return "●"; // 21h / overnight (and any other length)
}
function guestNames(b){ return (b.guests || []).map(g => g.name).join(", "); }
// match a booking against the search box: guest name, booking CODE (6-char), internal id, website
// booking no., FB name, or contact — so you (or a customer's code) can find a booking fast.
function bkMatchesSearch(b, q){
    if(!q) return true;
    q = String(q).toLowerCase().trim();
    return guestNames(b).toLowerCase().includes(q)
        || bookingCode(b).toLowerCase().includes(q)
        || String(b.id || "").includes(q)
        || String(b.bookingNo || "").toLowerCase().includes(q)
        || String(b.fbName || "").toLowerCase().includes(q)
        || String(b.contact || "").toLowerCase().includes(q);
}
function guestSummary(b){
    return (b.guests || []).map(g => `${g.name} (${g.age})`).join("<br>");
}

/* ---------- today's booking ---------- */
// classify a booking relative to TODAY
function todayInfo(b, t){
    const dayUse = !(b.checkout > b.checkin);          // 6h/10h same-day stays
    const arrives  = b.checkin === t;
    const departs  = dayUse ? b.checkin === t : b.checkout === t;
    const staying  = b.checkin <= t && t < endExcl(b); // physically in-house today
    let status = "", cls = "";
    if(arrives && departs){ status = "Day-use"; cls = "partial"; }
    else if(arrives)      { status = "Arriving"; cls = "unpaid"; }
    else if(departs)      { status = "Departing"; cls = "paid"; }
    else if(staying)      { status = "In-house"; cls = "partial"; }
    return { arrives, departs, staying, status, cls, relevant: arrives || departs || staying };
}
function addonsCell(b){
    const bits = [];
    if(b.swimpass > 0) bits.push(`🏊 ${b.swimpass}`);
    if(b.towels   > 0) bits.push(`🧺 ${b.towels}`);
    if(b.extend   > 0) bits.push(`⏱ +${b.extend}h`);
    return bits.length ? bits.join(" · ") : '<span class="muted">—</span>';
}
function todayRow(b, amountCol){
    const balance = balanceOf(b);
    const st = statusOf(b);
    return `<tr>
        <td><strong>${b.haven}</strong></td>
        <td>${guestSummary(b)}<br><span class="muted">${b.contact||""}</span></td>
        <td>${fmt(b.checkin)}<br><span class="muted">${checkinTimeStr(b)}</span></td>
        <td>${fmt(b.checkout)}<br><span class="muted">${checkoutTimeStr(b)}</span></td>
        <td>${b.stayHours ? b.stayHours + "h" + (Number(b.stayHours)===6 && b.slot ? "<br><span class='muted'>"+(b.slot==="morning"?"AM":"PM")+"</span>" : "") : "—"}</td>
        <td>${addonsCell(b)}</td>
        <td>${amountCol > 0 ? peso(amountCol) : '<span class="muted">—</span>'}</td>
        <td><span class="status ${st}">${st}</span></td>
        <td class="actions">${window.__PARTNER__ ? `<span class="edit" style="color:var(--hv-terra-d);" onclick="viewBooking(${b.id})">View</span>` : `<span class="edit" onclick="openModal(${b.id})">Edit</span>`}</td>
    </tr>`;
}
function renderToday(){
    const t = iso(today());
    const lbl = document.getElementById("todayDateLabel");
    if(lbl) lbl.textContent = "— " + new Date(t + "T00:00:00").toLocaleDateString("en-PH", { weekday:"long", month:"long", day:"numeric", year:"numeric" });

    const tagged = bookings.filter(b => !b.cancelled).map(b => ({ b, info: todayInfo(b, t) })).filter(x => x.info.relevant);
    const arrivals = tagged.filter(x => x.info.arrives).map(x => x.b)
        .sort((a,c) => bookingCheckinMin(a) - bookingCheckinMin(c));
    // in-house + departing, excluding pure arrivals already shown above
    const others = tagged.filter(x => !x.info.arrives).map(x => x.b)
        .sort((a,c) => checkoutTimeStr(a).localeCompare(checkoutTimeStr(c)));

    // cards
    const departCount = tagged.filter(x => x.info.departs).length;
    const inHouseCount = tagged.filter(x => x.info.staying).length;
    const toCollect = arrivals.reduce((s,b) => s + balanceOf(b), 0);
    const cards = [
        ["Arriving today",   arrivals.length, ""],
        ["Departing today",  departCount, ""],
        ["In-house now",     inHouseCount, ""],
        ["To collect today", peso(toCollect), "money"]
    ];
    const cardsEl = document.getElementById("todayCards");
    if(cardsEl) cardsEl.innerHTML = cards.map(c =>
        `<div class="card"><h3>${c[0]}</h3><div class="number ${c[2]}">${c[1]}</div></div>`).join("");

    const aBody = document.getElementById("todayArriveBody");
    if(aBody) aBody.innerHTML = arrivals.length
        ? arrivals.map(b => todayRow(b, balanceOf(b))).join("")
        : `<tr><td colspan="9" class="empty">No arrivals today.</td></tr>`;
    const aCount = document.getElementById("todayArriveCount");
    if(aCount) aCount.textContent = arrivals.length ? `(${arrivals.length})` : "";

    const sBody = document.getElementById("todayStayBody");
    if(sBody) sBody.innerHTML = others.length
        ? others.map(b => todayRow(b, balanceOf(b))).join("")
        : `<tr><td colspan="9" class="empty">Nobody else in-house or departing today.</td></tr>`;
    const sCount = document.getElementById("todayStayCount");
    if(sCount) sCount.textContent = others.length ? `(${others.length})` : "";
}

/* ---------- summary cards ---------- */
// the cards reflect whatever date window the calendar is showing
function renderSummary(){
    HAVENS = havenNames();                                  // stay in sync with the Havens page
    const startIso = iso(rangeStart);
    const endIso = iso(addDays(rangeStart, viewDays)); // exclusive
    const todayIso = iso(today());
    const isToday = (viewDays === 1 && startIso === todayIso);

    const inWindow = b => b.checkin >= startIso && b.checkin < endIso;
    // cancelled bookings free the haven, so they don't count as check-ins/outs or occupancy…
    const live = b => !b.cancelled;
    const checkins  = bookings.filter(b => live(b) && inWindow(b)).length;
    const checkouts = bookings.filter(b => live(b) && b.checkout >= startIso && b.checkout < endIso).length;
    // occupied = havens with a (live) booking overlapping the window
    const occHavens = new Set(
        bookings.filter(b => live(b) && b.checkin < endIso && endExcl(b) > startIso).map(b => b.haven)
    );
    const occupied = HAVENS.filter(h => occHavens.has(h)).length;
    const available = HAVENS.length - occupied;
    // …but their non-refundable downpayment stays in revenue (balanceOf is 0 once cancelled)
    const revenue = bookings.filter(inWindow).reduce((s,b) => s + netCollectedOf(b), 0);
    const pending = bookings.filter(inWindow).reduce((s,b) => s + balanceOf(b), 0);

    // period label for the card titles
    const period = isToday ? "Today"
        : (viewDays === 1 ? fmt(startIso)
        : fmt(startIso) + "–" + fmt(iso(addDays(rangeStart, viewDays-1))));
    const occLabel = isToday ? "" : ` (${period})`;

    const SVG = {
        arrive:'<svg viewBox="0 0 24 24"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><path d="m10 17 5-5-5-5"/><path d="M15 12H3"/></svg>',
        depart:'<svg viewBox="0 0 24 24"><path d="M9 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/></svg>',
        bed:'<svg viewBox="0 0 24 24"><path d="M2 20v-7a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v7"/><path d="M2 16h20"/><path d="M6 11V8.5A1.5 1.5 0 0 1 7.5 7h3A1.5 1.5 0 0 1 12 8.5V11"/></svg>',
        door:'<svg viewBox="0 0 24 24"><path d="M3 21h18"/><path d="M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16"/><path d="M14 12h.01"/></svg>',
        cash:'<svg viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 12h.01M18 12h.01"/></svg>',
        clock:'<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>'
    };
    const cards = [
        [isToday ? "Today's Check-ins"  : `Check-ins · ${period}`, checkins, SVG.arrive, false],
        [isToday ? "Today's Check-outs" : `Check-outs · ${period}`, checkouts, SVG.depart, false],
        [`Occupied Havens${occLabel}`, occupied, SVG.bed, false],
        [`Available Havens${occLabel}`, available, SVG.door, false],
        [isToday ? "Collected Today" : `Collected · ${period}`, peso(revenue), SVG.cash, true],
        [isToday ? "Pending Today"   : `Pending · ${period}`, peso(pending), SVG.clock, true]
    ];
    const cardsHtml = cards.map(c => `
        <div class="card">
            <div class="card-top"><span class="card-label">${c[0]}</span><span class="card-ico">${c[2]}</span></div>
            <div class="number${c[3] ? " money" : ""}">${c[1]}</div>
        </div>`).join("");
    document.getElementById("summaryCards").innerHTML = cardsHtml;
    const calCards = document.getElementById("summaryCardsCal");
    if(calCards) calCards.innerHTML = cardsHtml;
    syncFinInputs();
    renderHavenAnalytics();
    saveView();
}

/* ---------- per-haven analytics ---------- */
// small horizontal bar group; bolds the biggest row ("mostly booked")
function miniBars(items){
    const max = Math.max(1, ...items.map(i => i.value));
    const peak = Math.max(...items.map(i => i.value));
    return `<div class="mini-bars">` + items.map(i => `
        <div class="mb-row">
            <span class="mb-label">${i.label}</span>
            <span class="mb-track"><span class="mb-fill" style="width:${(i.value / max) * 100}%;background:${i.color}"></span></span>
            <span class="mb-val ${peak > 0 && i.value === peak ? "ha-peak" : ""}">${i.value}</span>
        </div>`).join("") + `</div>`;
}

function renderHavenAnalytics(){
    const el = document.getElementById("havenAnalytics");
    if(!el) return;

    const startIso = iso(rangeStart);
    const endIso   = iso(addDays(rangeStart, viewDays)); // exclusive
    const inWin = b => b.checkin < endIso && endExcl(b) > startIso;

    const periodEl = document.getElementById("havenAnalyticsPeriod");
    if(periodEl){
        periodEl.textContent = viewDays === 1
            ? "— " + fmt(startIso)
            : "— " + fmt(startIso) + " to " + fmt(iso(addDays(rangeStart, viewDays - 1)));
    }

    // show all havens, or only the one chosen in the haven filter
    const havenSel = document.getElementById("finHaven");
    const pick = havenSel ? havenSel.value : "";
    const list = pick ? HAVENS.filter(h => h === pick) : HAVENS;

    el.innerHTML = list.map(h => {
        const c  = HAVEN_COLORS[h] || { am:"#cccccc", pm:"#aaaaaa" };
        const bk = bookings.filter(b => b.haven === h && inWin(b) && !b.cancelled);   // successful bookings only (cancelled free the haven)
        const booked = bk.length;

        // booked vs free days inside the window (clamped to the window)
        const occDays = new Set();
        bk.forEach(b => {
            const s = b.checkin < startIso ? startIso : b.checkin;
            const e = endExcl(b) > endIso ? endIso : endExcl(b);
            for(let d = new Date(s + "T00:00:00"); iso(d) < e; d = addDays(d, 1)) occDays.add(iso(d));
        });
        const occupiedDays = occDays.size;
        const freeDays = Math.max(0, viewDays - occupiedDays);

        // stay-length distribution (which hours are mostly booked)
        const stay = { 6:0, 10:0, 21:0 };
        bk.forEach(b => { const s = Number(b.stayHours) || 0; if(stay[s] != null) stay[s]++; });

        // check-in time (AM / PM for 6h, otherwise full-day)
        const ci = { AM:0, PM:0, Full:0 };
        bk.forEach(b => {
            if(Number(b.stayHours) === 6) ci[b.slot === "evening" ? "PM" : "AM"]++;
            else ci.Full++;
        });

        const towels    = bk.reduce((s, b) => s + (Number(b.towels)   || 0), 0);
        const pool      = bk.reduce((s, b) => s + (Number(b.swimpass) || 0), 0);
        const extendHrs = bk.reduce((s, b) => s + (Number(b.extend)   || 0), 0);
        const advList   = bk.filter(b => Number(b.downpayment) > 0);
        const advCount  = advList.length;
        const advTotal  = advList.reduce((s, b) => s + Number(b.downpayment), 0);

        return `<div class="ha-card">
            <div class="ha-head"><span class="dot" style="background:${c.am}"></span>${h}</div>
            <div class="ha-stats">
                <div class="ha-stat"><b>${booked}</b><span>booking${booked === 1 ? "" : "s"}</span></div>
                <div class="ha-stat"><b>${freeDays}</b><span>free day${freeDays === 1 ? "" : "s"}</span></div>
                <div class="ha-stat"><b>${occupiedDays}</b><span>booked day${occupiedDays === 1 ? "" : "s"}</span></div>
                <div class="ha-stat"><b>${towels}</b><span>towels</span></div>
                <div class="ha-stat"><b>${pool}</b><span>pool pass</span></div>
                <div class="ha-stat"><b>+${extendHrs}h</b><span>extended</span></div>
                <div class="ha-stat" style="grid-column:1 / -1;"><b>${peso(advTotal)}</b><span>${advCount} advance booking${advCount === 1 ? "" : "s"} (with downpayment)</span></div>
            </div>
            <div class="ha-chart">
                <div class="ha-chart-title">Hours booked</div>
                ${miniBars([
                    { label:"6 hrs",  value:stay[6],  color:c.am },
                    { label:"10 hrs", value:stay[10], color:c.pm },
                    { label:"21 hrs", value:stay[21], color:"#7a7a7a" }
                ])}
            </div>
            <div class="ha-chart">
                <div class="ha-chart-title">Check-in time</div>
                ${miniBars([
                    { label:"AM slot",  value:ci.AM,   color:"#f5a3d0" },
                    { label:"PM slot",  value:ci.PM,   color:"#7ea6f4" },
                    { label:"Full day", value:ci.Full, color:"#bcbcbc" }
                ])}
            </div>
        </div>`;
    }).join("");
}

