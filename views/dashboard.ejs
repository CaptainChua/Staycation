    document.getElementById("depositTotal").innerHTML =
        `<div class="card"><h3>Check-outs</h3><div class="number">${list.length}</div></div>` +
        `<div class="card"><h3>Deposit still to return</h3><div class="number money">${peso(toReturn)}</div></div>`;
