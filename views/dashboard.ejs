// where each value sits on the scanned form, as % of the image
// (left = from left edge, top = vertical centre of the blank). Tweak to nudge.
const GF_OV = [
    { id:"gff_date",      left:15,   top:9.3,  width:16 },
    { id:"gff_owner",     left:23.5, top:11.2, width:24 },
    { id:"gff_unit",      left:22.5, top:13.0, width:20, change:"gfSaveUnit()" },
    { id:"gff_contact",   left:24,   top:14.8, width:20 },
    { id:"gff_movein",    left:73,   top:11.2, width:16 },
    { id:"gff_moveout",   left:74,   top:13.0, width:15 },
    { id:"gff_days",      left:72,   top:14.8, width:17 }
];
const GF_ROW_TOP = 23.7, GF_ROW_STEP = 1.95;   // guest table: row-1 centre + per-row step (%)
const GF_NAME = { left:16,   width:40 };
const GF_AGE  = { left:59.5, width:6  };

// inject the overlay inputs onto page 1 (once)
function gfBuildOverlay(){
    const page = document.getElementById("gfPage1");
    if(!page || page.dataset.built) return;
    let html = "";
    GF_OV.forEach(f => {
        const cls = "gf-ov" + (f.cls ? " " + f.cls : "");
        const ch  = f.change ? ` onchange="${f.change}"` : "";
        html += `<input class="${cls}" id="${f.id}" style="left:${f.left}%; top:${f.top}%; width:${f.width}%;"${ch}>`;
    });
    for(let i = 0; i < 5; i++){
        const top = GF_ROW_TOP + i * GF_ROW_STEP;
        html += `<input class="gf-ov" id="gff_name_${i+1}" style="left:${GF_NAME.left}%; top:${top}%; width:${GF_NAME.width}%;">`;
        html += `<input class="gf-ov" id="gff_age_${i+1}"  style="left:${GF_AGE.left}%; top:${top}%; width:${GF_AGE.width}%; text-align:center;">`;
    }
    page.insertAdjacentHTML("beforeend", html);
    page.dataset.built = "1";
}

function gfLoadUnits(){
    try { return JSON.parse(localStorage.getItem(GF_UNITS_KEY)) || {}; } catch(e){ return {}; }
}
function gfSaveUnits(map){ localStorage.setItem(GF_UNITS_KEY, JSON.stringify(map)); }

// remember the typed Unit No. & Tower for the currently selected haven
function gfSaveUnit(){
    const haven = document.getElementById("gf_haven").value;
    const unit  = document.getElementById("gff_unit").value.trim();
    if(!haven) return;
    const map = gfLoadUnits();
    if(unit) map[haven] = unit; else delete map[haven];
    gfSaveUnits(map);
    gfSetUnit2(unit);
}

// the page-2 "UNIT #:" shows just the unit number (first token of "2602 Tower D")
function gfSetUnit2(unitStr){
    const el = document.getElementById("gff_unit2");
    if(el) el.value = (unitStr || "").trim().split(/\s+/)[0] || "";
}

// prefill the 5 guest name/age slots from the booking's guest list
function gfRenderGuestRows(guests){
    for(let i = 0; i < 5; i++){
        const g = (guests && guests[i]) || {};
        const n = document.getElementById(`gff_name_${i+1}`);
        const a = document.getElementById(`gff_age_${i+1}`);
        if(n) n.value = g.name || "";
        if(a) a.value = (g.age != null && g.age !== "") ? g.age : "";
    }
}

// init when the page opens: build overlay, populate haven dropdown, defaults
function renderGuestForm(){
    gfBuildOverlay();
    const sel = document.getElementById("gf_haven");
    if(sel && !sel.options.length) sel.innerHTML = HAVENS.map(h => `<option>${escHtml(h)}</option>`).join("");
