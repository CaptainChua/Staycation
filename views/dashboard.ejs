/* ---------- haven listings manager (website content) ---------- */
let listings = loadHavens();
// Havens carry an explicit `order` field so the drag-reorder survives the server's per-item merge
// (which keys by id and can't preserve array position). Sort by it; havens without one keep their
// current relative position (stable sort with a high fallback).
function sortListings(){ listings.sort((a, b) => (a.order != null ? a.order : 1e9) - (b.order != null ? b.order : 1e9)); }
sortListings();

function escAttr(s){ return String(s).replace(/"/g, "&quot;"); }
function escHtml(s){ return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;"); }

/* show-per-page filter + pagination */
let listingPageSize = 9;   // 1, 2, 3, or 9 (View all)
let listingPage = 0;

function listingTotalPages(){ return Math.max(1, Math.ceil(listings.length / listingPageSize)); }

function setListingPageSize(size){
    listingPageSize = size;
    listingPage = 0;
    renderListings();
}

function gotoListingPage(delta){
    const pages = listingTotalPages();
    listingPage = Math.min(pages - 1, Math.max(0, listingPage + delta));
    renderListings();
}

function renderListingPager(){
    const pager = document.getElementById("listingPager");
    if(listings.length <= listingPageSize){ pager.innerHTML = ""; return; }
    const pages = listingTotalPages();
    pager.innerHTML =
        `<button class="hv-btn ghost" onclick="gotoListingPage(-1)" ${listingPage === 0 ? "disabled" : ""}>‹ Prev</button>` +
        `<span class="hv-muted">Page ${listingPage + 1} of ${pages}</span>` +
        `<button class="hv-btn ghost" onclick="gotoListingPage(1)" ${listingPage >= pages - 1 ? "disabled" : ""}>Next ›</button>`;
}

// gold amenity icons for the card (amenityIcon/amenityLabel come from amenity-icons.js)
function hvAmenIcons(amenities){
    return (amenities || []).slice(0, 5).map(a =>
        `<span title="${escAttr(amenityLabel(a))}">${amenityIcon(a)}</span>`).join("");
}

function renderListings(){
    const pages = listingTotalPages();
    listingPage = Math.min(Math.max(0, listingPage), pages - 1);
    const start = listingPage * listingPageSize;
    const end = Math.min(start + listingPageSize, listings.length);

    const countEl = document.getElementById("hvCount");
    if(countEl) countEl.textContent =
        `${listings.length} listing${listings.length === 1 ? "" : "s"} · shown on staycationhaven.ph`;

    let html = "";
    for(let i = start; i < end; i++){
        const h = listings[i];
        const photo = h.image
            ? `<img src="${escAttr(h.image)}" alt="" onerror="this.remove()">`
            : "";
        html += `
        <div class="hv-card" data-index="${i}" draggable="true"
             ondragstart="onDragStart(event, ${i})" ondragend="onDragEnd(event)"
             ondragover="onDragOver(event)" ondragenter="onDragEnter(event)"
             ondragleave="onDragLeave(event)" ondrop="onDrop(event, ${i})">
            <div class="hv-photo">${photo}
                <span class="hv-badge${h.live === false ? " off" : ""}" draggable="false" onmousedown="event.stopPropagation()" onclick="event.stopPropagation();toggleHavenLive(${i})" title="${h.live === false ? "Offline — click to make Live (show on the website)" : "Live — click to take Offline (hide from the website)"}"><i></i>${h.live === false ? "Offline" : "Live"}</span>
                <span class="hv-grip" title="Drag to reorder">⠿</span>
            </div>
            <div class="hv-cardbody">
                <h3>${escHtml(h.name)}</h3>
                <div class="hv-amen">${hvAmenIcons(h.amenities)}</div>
                <div class="hv-foot">
                    <div class="hv-price"><b>${escHtml(h.price || "—")}</b></div>
                    <button class="hv-edit" onclick="openHaven(${i})">✎ Edit</button>
                </div>
            </div>
        </div>`;
    }
    document.getElementById("hvGrid").innerHTML = html;
    renderListingPager();
}

