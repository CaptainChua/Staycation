function setBillReceipt(dataUrl){
    billReceiptData = dataUrl;
    const img = document.getElementById("billReceiptImg"), thumb = document.getElementById("billReceiptThumb"), nm = document.getElementById("billReceiptName");
    if(img) img.src = dataUrl; if(thumb) thumb.style.display = "inline-block"; if(nm) nm.textContent = "Photo attached ✓";
}
function clearBillPhoto(){
