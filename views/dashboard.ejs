// derive check-out date + time from check-in date/time + stay length (+ extend)
function recomputeDashCheckout(){
    const ci = document.getElementById("f_checkin").value;
    const t = dashCheckinTimeValue();
    const stayVal = document.getElementById("f_stay").value;
    const ext = Number(document.getElementById("f_extend").value) || 0;
    if(!ci || !t) return;
    if(stayVal === "multi"){
        // multi-night: keep the user's check-out (default to 2 nights), show the overnight check-out time
        const coEl = document.getElementById("f_checkout");
        if(!coEl.value || coEl.value <= ci) coEl.value = iso(addDays(new Date(ci + "T00:00:00"), 2));
        document.getElementById("f_checkoutTime").value = minToTime(dashCheckinMin(t) + (21 + ext) * 60);
        paintDates();
        return;
    }
    const hours = Number(stayVal) || 0;
    const total = dashCheckinMin(t) + (hours + ext) * 60;
    const co = addDays(new Date(ci + "T00:00:00"), Math.floor(total / 1440));
    document.getElementById("f_checkout").value = iso(co);
    document.getElementById("f_checkoutTime").value = minToTime(total);
    paintDates();
}
