// hours between two "HH:MM" times (handles crossing midnight)
function hoursBetween(inT, outT){
    if(!inT || !outT) return 0;
    const [ih, im] = inT.split(":").map(Number);
    const [oh, om] = outT.split(":").map(Number);
    let mins = (oh * 60 + om) - (ih * 60 + im);
    if(mins < 0) mins += 24 * 60;
    return mins / 60;
}
// regular hours for a CSR day = morning session + afternoon session (skip any half-day-off session)
function regHoursOf(d){
    const am = d.amOff ? 0 : hoursBetween(d.timeIn, d.timeOut);
    const pm = d.pmOff ? 0 : hoursBetween(d.pmIn, d.pmOut);
    return am + pm;
}
// a day's OT periods as [{in,out},...] — supports the new array + legacy fields
function otSlotsOf(d){
    if(Array.isArray(d.ots)) return d.ots;
    const arr = [];
    if(d.otIn || d.otOut) arr.push({ in:d.otIn, out:d.otOut });
    if(d.otIn2 || d.otOut2) arr.push({ in:d.otIn2, out:d.otOut2 });
    return arr;
}
// total overtime hours; 3.5h or more (across all slots) earns a +0.5h night differential
function otHoursOf(d){ return otSlotsOf(d).reduce((sum, o) => sum + hoursBetween(o.in, o.out), 0); }
function nightDiffOf(d){ return otHoursOf(d) >= 3.5 ? 0.5 : 0; }
function otPaidHoursOf(d){ return otHoursOf(d) + nightDiffOf(d); }
// rooms booked on a date = bookings checking in that day (straight from the calendar)
function roomsBookedOn(dateIso){
    if(!dateIso) return 0;
    return bookings.filter(b => b.checkin === dateIso).length;
}
// rooms a housekeeper actually FINISHED (marked DONE) on a date — only DONE turnovers count
function safeCleaning(){ try { return cleaning || {}; } catch(e){ return {}; } }  // may run before `cleaning` is initialized
function roomsCleanedOn(dateIso, staffName){
    if(!dateIso) return 0;
    const data = safeCleaning();
    const nm = (staffName || "").trim().toLowerCase();
    let count = 0;
    for(const id in data){
        const lg = data[id];
        if(lg && lg.doneAt && iso(new Date(lg.doneAt)) === dateIso){
            if(!nm || (lg.doneBy || "").trim().toLowerCase() === nm) count++;
        }
    }
    return count;
}
// the room count that drives pay for a given staff/day, by role
function roomsForDay(s, d){
    const cleaned = roomsCleanedOn(d.date, s.name);
    if(s.role === "ASSIST" || s.role === "COMMISSION") return roomsBookedOn(d.date) + cleaned;
    return cleaned;
}
function dayPay(s, d){
    let pay = 0;
    if(s.role === "CSR"){
        if(!d.dayOff){
            const hourly = PAY_RATES.csrDay / PAY_RATES.csrHours;
            pay += Math.min(regHoursOf(d), PAY_RATES.csrHours) * hourly; // caps at ₱695
            pay += otPaidHoursOf(d) * hourly * PAY_RATES.otMult;          // includes +0.5h night diff
        }
    } else if(s.role === "ASSIST"){
        pay += roomsBookedOn(d.date) * PAY_RATES.assistRoom;
    } else if(s.role === "COMMISSION"){
        pay += roomsBookedOn(d.date) * PAY_RATES.commissionRoom;
    }
    // cleaning credit — anyone who marked rooms DONE earns the housekeeping room rate
    pay += roomsCleanedOn(d.date, s.name) * PAY_RATES.hkRoom;
    return pay;
}
// housekeeping "days" come from completed cleanings (DONE), not manual entries
function cleaningDatesFor(staffName){
    const nm = (staffName || "").trim().toLowerCase();
    const dates = {};
    const data = safeCleaning();
    for(const id in data){
        const lg = data[id];
        if(lg && lg.doneAt && (lg.doneBy || "").trim().toLowerCase() === nm){
            const dt = iso(new Date(lg.doneAt));
            dates[dt] = (dates[dt] || 0) + 1;
        }
    }
    return dates;
}
// the day list that drives a staff's payroll (auto for housekeeping, manual otherwise)
function staffAllDays(s){
    const map = {};
    // manual entries (CSR hours, or ASSIST/COMMISSION date markers)
    if(s.role !== "HOUSEKEEPING") (s.days || []).forEach(d => { if(d.date) map[d.date] = { ...d }; });
    // dates this person finished cleanings (DONE) — counts for any role
    const dc = cleaningDatesFor(s.name);
    Object.keys(dc).forEach(dt => { if(!map[dt]) map[dt] = { id: "clean-" + dt, date: dt }; });
    return Object.keys(map).sort().map(dt => map[dt]);
}
function staffDaysInScope(s, month){
    return staffAllDays(s).filter(d => !month || (d.date && d.date.slice(0, 7) === month));
}
function staffGross(s, month){
    return staffDaysInScope(s, month).reduce((sum, d) => sum + dayPay(s, d), 0);
}
const DEFAULT_SSS_RATE = 5;          // % of monthly salary (editable per staff, 30th cut-off)
const DEFAULT_PHILHEALTH_RATE = 2.5; // % of monthly salary (editable per staff, 15th cut-off)
function sssRateOf(s){ const p = s.benefits && s.benefits.sssPct; return (p == null || isNaN(p)) ? DEFAULT_SSS_RATE : Number(p); }
function philRateOf(s){ const p = s.benefits && s.benefits.philhealthPct; return (p == null || isNaN(p)) ? DEFAULT_PHILHEALTH_RATE : Number(p); }
// SSS Monthly Salary Credit bracket (2025 employer/employee schedule):
// MSC ₱5,000–₱35,000 in ₱500 steps. Salary snaps to the nearest ₱500 bracket,
// clamped to the floor/ceiling. Employee contribution = 5% of MSC.
function sssMSC(salary){
    const s = Number(salary) || 0;
    return Math.max(5000, Math.min(35000, Math.round(s / 500) * 500));
}
// SSS contribution = rate × MSC (bracketed), not a flat % of actual salary
function staffSss(s, month){ return sssMSC(staffGross(s, month)) * sssRateOf(s) / 100; }
function staffPhilhealth(s, month){ return staffGross(s, month) * philRateOf(s) / 100; }
// monthly total (used by Analytics) — loan is deducted on BOTH cut-offs → ×2
function staffDeductions(s, month){
    if(s.role === "COMMISSION") return 0;   // commission has no deductions
    const b = s.benefits || {};
    return staffSss(s, month) + staffPhilhealth(s, month) + (Number(b.pagibig) || 0) + 2 * (Number(b.loans) || 0);
}

/* ---------- payroll cut-offs (paid 15th & 30th) ----------
   15th payout covers work dates 24th(prev month)–8th; 30th covers 9th–23rd.
   PhilHealth (2.5%) + Pag-IBIG charged on the 15th; SSS (5%) on the 30th;
   Loan on both. Contributions are % of the whole month's salary. */
function pIso(d){ const y=d.getFullYear(), m=String(d.getMonth()+1).padStart(2,"0"), day=String(d.getDate()).padStart(2,"0"); return `${y}-${m}-${day}`; }
function pLastDay(y, m){ return new Date(y, m + 1, 0).getDate(); }
function cutoffOf(dateIso){
    const d = new Date(dateIso + "T00:00:00");
    const day = d.getDate(), y = d.getFullYear(), m = d.getMonth();
    if(day >= 24) return { payIso: pIso(new Date(y, m + 1, 15)), half:"15" };
    if(day <= 8)  return { payIso: pIso(new Date(y, m, 15)), half:"15" };
    return { payIso: pIso(new Date(y, m, Math.min(30, pLastDay(y, m)))), half:"30" };
}
function cutoffHalf(payIso){ return new Date(payIso + "T00:00:00").getDate() <= 15 ? "15" : "30"; }
function cutoffRangeOf(payIso){
    const d = new Date(payIso + "T00:00:00"), y = d.getFullYear(), m = d.getMonth();
    if(cutoffHalf(payIso) === "15") return { start: pIso(new Date(y, m - 1, 24)), end: pIso(new Date(y, m, 8)) };
    return { start: pIso(new Date(y, m, 9)), end: pIso(new Date(y, m, 23)) };
}
function cutoffLabel(payIso){
    const d = new Date(payIso + "T00:00:00"), r = cutoffRangeOf(payIso);
    return d.toLocaleDateString("en-PH", { month:"short", day:"numeric", year:"numeric" }) + " · " + fmt(r.start) + "–" + fmt(r.end);
}
function cutoffDays(s, payIso){ return (s.days || []).filter(d => d.date && cutoffOf(d.date).payIso === payIso); }
function cutoffGross(s, payIso){ return cutoffDays(s, payIso).reduce((sum, d) => sum + dayPay(s, d), 0); }
// whole-month salary (both cut-offs paid that month) — base for SSS / PhilHealth
function monthlyBaseFor(s, payIso){
    const d = new Date(payIso + "T00:00:00"), y = d.getFullYear(), m = d.getMonth();
    return cutoffGross(s, pIso(new Date(y, m, 15))) + cutoffGross(s, pIso(new Date(y, m, Math.min(30, pLastDay(y, m)))));
}
function cutoffDeductions(s, payIso){
    if(s.role === "COMMISSION") return { philhealth:0, pagibig:0, sss:0, loan:0, total:0 };
    const b = s.benefits || {};
    const loan = Number(b.loans) || 0;   // loan every cut-off
    const base = monthlyBaseFor(s, payIso);
    if(cutoffHalf(payIso) === "15"){
        const ph = base * philRateOf(s) / 100, pag = Number(b.pagibig) || 0;
        return { philhealth: ph, pagibig: pag, sss: 0, loan, total: ph + pag + loan };
    }
    const sss = sssMSC(base) * sssRateOf(s) / 100;   // SSS on bracketed MSC
    return { philhealth: 0, pagibig: 0, sss, loan, total: sss + loan };
}
function staffCutoffs(s){ return [...new Set(staffAllDays(s).map(d => d.date && cutoffOf(d.date).payIso).filter(Boolean))].sort(); }
function aggregateDeductions(s){
    let sss = 0, ph = 0, pag = 0, loan = 0;
    staffCutoffs(s).forEach(p => { const dd = cutoffDeductions(s, p); sss += dd.sss; ph += dd.philhealth; pag += dd.pagibig; loan += dd.loan; });
    return { sss, philhealth: ph, pagibig: pag, loan, total: sss + ph + pag + loan };
}
function staffGrossAll(s){ return staffAllDays(s).reduce((sum, d) => sum + dayPay(s, d), 0); }

/* ---------- payroll render ---------- */
function fillPayrollStaffFilter(){
    const sel = document.getElementById("payFilterStaff");
    const prev = sel.value;
    // non-admins only see themselves in the filter
    const opts = payrollIsAdmin() ? staff : staff.filter(payrollOwns);
    sel.innerHTML = `<option value="">All staff</option>` +
        opts.map(s => `<option value="${s.id}">${s.name}</option>`).join("");
    sel.value = opts.some(s => String(s.id) === prev) ? prev : "";
}
// 15th/30th filter resolves to a cut-off in the latest period that has data
function payrollAnchor(){
    const cuts = [...new Set(staff.flatMap(s => staffCutoffs(s)))].sort();
    const base = cuts.length ? new Date(cuts[cuts.length - 1] + "T00:00:00") : today();
    return { y: base.getFullYear(), m: base.getMonth() };
}
function resolveCutoff(sel){
    if(sel !== "15" && sel !== "30") return "";
    const a = payrollAnchor();
    return sel === "15"
        ? pIso(new Date(a.y, a.m, 15))
        : pIso(new Date(a.y, a.m, Math.min(30, pLastDay(a.y, a.m))));
}

/* ---------- payroll scope (cut-off OR date range) ---------- */
// turn the period dropdown into a { start, end, label } range (null start = all time)
function resolveScope(val){
    const t = today();
    if(val === "today"){ const i = iso(t); return { start:i, end:i, label:"Today · " + fmt(i) }; }
    if(val === "month"){
        const s = iso(new Date(t.getFullYear(), t.getMonth(), 1));
        const e = iso(new Date(t.getFullYear(), t.getMonth() + 1, 0));
        return { start:s, end:e, label:"This month · " + monthLabel(s.slice(0, 7)) };
    }
    if(val === "custom"){
        const f = document.getElementById("payFrom").value;
        let tt = document.getElementById("payTo").value || f;
        if(!f) return { start:null, end:null, label:"custom (pick dates)" };
        if(tt < f) tt = f;
        return { start:f, end:tt, label:fmt(f) + " – " + fmt(tt) };
    }
    if(val === "15" || val === "30"){
        const payIso = resolveCutoff(val);
        const r = cutoffRangeOf(payIso);
        return { start:r.start, end:r.end, label:cutoffLabel(payIso) };
    }
    return { start:null, end:null, label:"all cut-offs" };
}
function staffDaysInRange(s, start, end){
    return staffAllDays(s).filter(d => d.date && (!start || d.date >= start) && (!end || d.date <= end));
}
function rangeGross(s, start, end){ return staffDaysInRange(s, start, end).reduce((sum, d) => sum + dayPay(s, d), 0); }
// deductions = sum of the cut-offs that the days in this range belong to
function rangeDeductions(s, start, end){
    if(s.role === "COMMISSION") return { sss:0, philhealth:0, pagibig:0, loan:0, total:0 };
    const cuts = [...new Set(staffDaysInRange(s, start, end).map(d => cutoffOf(d.date).payIso))];
    let sss = 0, ph = 0, pag = 0, loan = 0;
    cuts.forEach(p => { const dd = cutoffDeductions(s, p); sss += dd.sss; ph += dd.philhealth; pag += dd.pagibig; loan += dd.loan; });
    return { sss, philhealth:ph, pagibig:pag, loan, total: sss + ph + pag + loan };
}

// reusable day-entry table; recordId = null for the staff's main days, or a record id
function dayTableHtml(s, days, recordId){
    days = days.slice().sort((a, b) => (a.date || "").localeCompare(b.date || ""));
    const rid = recordId == null ? "null" : recordId;
    let head, rows, cols;
    if(s.role === "CSR"){
        cols = 8;
        const span = (a, b) => (a && b) ? `${time12(a)}–${time12(b)}` : "—";
        head = `<tr><th>Date</th><th>Morning</th><th>Afternoon</th><th>OT</th><th>Reg hrs</th><th>OT hrs</th><th>Pay</th><th class="col-actions"></th></tr>`;
        rows = days.map(d => {
            const reg = d.dayOff ? 0 : regHoursOf(d), ot = d.dayOff ? 0 : otHoursOf(d), nd = d.dayOff ? 0 : nightDiffOf(d);
            return `<tr>
                <td>${fmt(d.date)}${d.dayOff ? '<br><span class="muted">Day off</span>' : ''}${d.notes ? '<br><span class="muted">' + escHtml(d.notes) + '</span>' : ''}</td>
                <td>${(d.dayOff || d.amOff) ? '—' : span(d.timeIn, d.timeOut)}</td>
                <td>${(d.dayOff || d.pmOff) ? '—' : span(d.pmIn, d.pmOut)}</td>
                <td>${otSlotsOf(d).map(o => span(o.in, o.out)).filter(x => x !== '—').join('<br>') || '—'}</td>
                <td>${d.dayOff ? '—' : reg.toFixed(2)}</td>
                <td>${ot ? ot.toFixed(2) + (nd ? ' <span class="muted">+0.5 ND</span>' : '') : '—'}</td>
                <td><strong>${peso2(dayPay(s, d))}</strong></td>
                <td class="col-actions">${payrollIsAdmin() ? `
                    <span class="edit" onclick="openDayModal(${s.id}, ${d.id}, ${rid})">Edit</span>
                    <span class="del" onclick="deleteDay(${s.id}, ${d.id}, ${rid})">Delete</span>` : ""}
                </td>
            </tr>`;
        }).join("");
    } else {
        cols = 4;
        const booksRooms = s.role === "ASSIST" || s.role === "COMMISSION";
        head = `<tr><th>Date</th><th>Rooms</th><th>Pay</th><th class="col-actions"></th></tr>`;
        rows = days.map(d => {
            const booked = booksRooms ? roomsBookedOn(d.date) : 0;
            const cleaned = roomsCleanedOn(d.date, s.name);
            const bits = [];
            if(booksRooms) bits.push(`${booked} booked`);
            if(cleaned || !booksRooms) bits.push(`${cleaned} cleaned`);
            return `<tr>
                <td>${fmt(d.date)}${d.notes ? '<br><span class="muted">' + escHtml(d.notes) + '</span>' : ''}</td>
                <td>${bits.join(' · ')} <span class="muted">(auto)</span></td>
                <td><strong>${peso2(dayPay(s, d))}</strong></td>
                <td class="col-actions">${(payrollIsAdmin() && s.role !== "HOUSEKEEPING") ? `
                    <span class="edit" onclick="openDayModal(${s.id}, ${d.id}, ${rid})">Edit</span>
                    <span class="del" onclick="deleteDay(${s.id}, ${d.id}, ${rid})">Delete</span>` : ""}
                </td>
            </tr>`;
        }).join("");
    }
    if(!rows) rows = `<tr><td colspan="${cols}" class="muted" style="text-align:center;padding:16px;">No entries.</td></tr>`;
    return `<div style="overflow-x:auto;"><table class="pay-table"><thead>${head}</thead><tbody>${rows}</tbody></table></div>`;
}

/* ---------- separate records (standalone cut-off computations) ---------- */
function recordGross(s, rec){ return (rec.days || []).reduce((sum, d) => sum + dayPay(s, d), 0); }
function recordDeductions(s, rec){
    if(s.role === "COMMISSION") return { sss:0, philhealth:0, pagibig:0, loan:0, total:0 };
    const base = recordGross(s, rec);   // standalone: base is this record's own gross
    const b = s.benefits || {};
    const loan = Number(b.loans) || 0;
    if(cutoffHalf(rec.cutoff) === "15"){
        const ph = base * philRateOf(s) / 100, pag = Number(b.pagibig) || 0;
        return { philhealth:ph, pagibig:pag, sss:0, loan, total: ph + pag + loan };
    }
    const sss = sssMSC(base) * sssRateOf(s) / 100;   // SSS on bracketed MSC
    return { philhealth:0, pagibig:0, sss, loan, total: sss + loan };
}
function recordsHtml(s){
    const recs = s.records || [];
    if(!recs.length) return "";
    return `<div class="pay-records">
        <div class="pay-bt" style="margin-bottom:8px;">Separate records</div>` +
        recs.map(rec => {
            const g = recordGross(s, rec), dd = recordDeductions(s, rec), net = g - dd.total;
            return `<div class="pay-record">
                <div class="pay-record-head">
                    <b>${cutoffOptionLabel(rec.cutoff)}</b>
                    <div style="display:flex; align-items:center; gap:12px;">
                        ${payrollIsAdmin() ? `<button class="btn secondary" onclick="openDayModal(${s.id}, null, ${rec.id})">+ Add day</button>
                        <span class="del" onclick="deleteRecord(${s.id}, ${rec.id})">Delete record</span>` : ""}
                    </div>
                </div>
                ${dayTableHtml(s, rec.days || [], rec.id)}
                <div class="pay-benefits" style="margin-top:8px;"><span class="pay-bt">Deductions</span>${benefitsHtml(s, dd)}</div>
                <div class="pay-totals" style="margin-top:6px;">
                    <span>Gross: <b>${peso2(g)}</b></span>
                    <span>Deductions: <b style="color:#c0283d;">−${peso2(dd.total)}</b></span>
                    <span>Net: <b style="color:#2e7d4f;">${peso2(net)}</b></span>
                </div>
            </div>`;
        }).join("") + `</div>`;
}

function staffBoxHtml(s, scope){
    const days = staffDaysInRange(s, scope.start, scope.end);
    const gross = rangeGross(s, scope.start, scope.end);
    const dd = rangeDeductions(s, scope.start, scope.end);
    const ded = dd.total;
    const net = gross - ded;

    return `<div class="pay-staff">
        <div class="pay-staff-head">
            <div>
                <div class="pay-name">${s.name}</div>
                <div class="muted">${ROLE_LABEL[s.role]} · ${ROLE_RATE_INFO[s.role]}</div>
                <div class="muted" style="font-weight:bold; color:#b8923a;">Cut-off: ${scope.label}</div>
            </div>
            <div class="pay-staff-actions">
                ${(payrollIsAdmin() && s.role !== "HOUSEKEEPING") ? `<button class="btn secondary" onclick="openDayModal(${s.id})">+ Add day</button>` : ""}
                <span class="edit" onclick="downloadStaffPdf(${s.id})">PDF</span>
                ${payrollIsAdmin() ? `<span class="edit" onclick="openStaffModal(${s.id})">Edit</span>
                <span class="del" onclick="deleteStaff(${s.id})">Delete</span>` : ""}
            </div>
        </div>
        ${dayTableHtml(s, days, null)}
        <div class="pay-summary">
            <div class="pay-benefits">
                <span class="pay-bt">Deductions</span>
                ${benefitsHtml(s, dd)}
            </div>
            <div class="pay-totals">
                <span>Gross: <b>${peso2(gross)}</b></span>
                <span>Deductions: <b style="color:#c0283d;">−${peso2(ded)}</b></span>
                <span>Net: <b style="color:#2e7d4f;">${peso2(net)}</b></span>
            </div>
        </div>
        ${recordsHtml(s)}
        ${staffLogHtml(s)}
    </div>`;
}
function benefitsHtml(s, dd){
    if(s.role === "COMMISSION") return `<span class="muted">No deductions</span>`;
    return `<span>SSS ${peso2(dd.sss)} <span class="muted">(${sssRateOf(s)}%)</span></span>
            <span>PhilHealth ${peso2(dd.philhealth)} <span class="muted">(${philRateOf(s)}%)</span></span>
            <span>Pag-IBIG ${peso2(dd.pagibig)}</span>
            <span>Loan ${peso2(dd.loan)}</span>`;
}
// who is logged in (set on the admin login page)
function currentUser(){ return localStorage.getItem("shph_current_user") || "Admin"; }

/* ---------- global activity log (shared with todaysbooking.html) ---------- */
const ACTIVITY_KEY = "shph_activity_log";
function logActivity(action, user){
    try {
        let log = [];
        try { log = JSON.parse(localStorage.getItem(ACTIVITY_KEY)) || []; } catch(e){}
        log.push({ user: user || currentUser(), action, at: new Date().toISOString() });
        localStorage.setItem(ACTIVITY_KEY, JSON.stringify(log.slice(-500))); // keep last 500
    } catch(e){ /* never let logging break an action (e.g. storage full) */ }
}
function renderLog(){
    const el = document.getElementById("logList");
    if(!el) return;
    let log = [];
    try { log = JSON.parse(localStorage.getItem(ACTIVITY_KEY)) || []; } catch(e){}
    if(!log.length){ el.innerHTML = `<div class="muted">No activity logged yet.</div>`; return; }
    el.innerHTML = log.slice().reverse().map(e => `
        <div class="log-row">
            <span class="log-when">${new Date(e.at).toLocaleString("en-PH")}</span>
            <span class="log-user">${escHtml(e.user || "—")}</span>
            <span class="log-action">${escHtml(e.action || "")}</span>
        </div>`).join("");
}
function clearActivityLog(){
    if(!confirm("Clear the entire activity log?")) return;
    localStorage.removeItem(ACTIVITY_KEY);
    renderLog();
}
// per-staff change log
function addStaffLog(s, action){
    s.log = s.log || [];
    s.log.push({ action, user: currentUser(), at: new Date().toISOString() });
    logActivity(`${action} — ${s.name}`);   // mirror into the global activity log
}
function staffLogHtml(s){
    const hist = (s.log || []).slice().reverse();
    if(!hist.length) return `<div class="muted" style="font-size:12px;margin-top:10px;">No activity yet.</div>`;
    return `<details class="clean-log" style="margin-top:10px;"><summary>Activity log (${hist.length})</summary><ul>` +
        hist.map(h => `<li><b>${escHtml(h.user || "Admin")}</b> — ${h.action} — <span class="muted">${nowFmt(h.at)}</span></li>`).join("") +
        `</ul></details>`;
}

// self-contained admin check for payroll (independent of load order)
function payrollIsAdmin(){
    try {
        const us = JSON.parse(localStorage.getItem("shph_users")) || [];
        const u = us.find(x => (x.name || "").toLowerCase() === currentUser().toLowerCase());
        return u ? !!u.admin : true;
    } catch(e){ return true; }
}
// does this staff record belong to the logged-in user? (handles "Maris" → "Maris Pamilaga")
function payrollOwns(s){
    const sn = (s.name || "").trim().toLowerCase();
    const un = currentUser().trim().toLowerCase();
    if(!sn || !un) return false;
    return sn === un || sn.startsWith(un + " ") || sn.split(/\s+/)[0] === un;
}
// only admins and CSRs may create bookings
function canAddBooking(){
    if(payrollIsAdmin()) return true;
    return staff.filter(s => payrollOwns(s)).some(s => s.role === "CSR");
}
function renderPayroll(){
    fillPayrollStaffFilter();
    const admin = payrollIsAdmin();
    const me = currentUser().toLowerCase();
    // non-admins only manage/view their OWN payroll, and can't add/edit/delete
    const adminBtns = document.getElementById("payrollAdminBtns");
    if(adminBtns) adminBtns.style.display = admin ? "" : "none";

    const fStaff = document.getElementById("payFilterStaff").value;
    const fRole  = document.getElementById("payFilterRole").value;
    const periodVal = document.getElementById("payFilterCutoff").value;
    const customEl = document.getElementById("payCustomDates");
    if(customEl) customEl.style.display = periodVal === "custom" ? "" : "none";
    const scope = resolveScope(periodVal);

    const list = staff.filter(s => {
        if(!admin && !payrollOwns(s)) return false;   // own record only
        if(fStaff && String(s.id) !== fStaff) return false;
        if(fRole && s.role !== fRole) return false;
        return true;
    });

    const container = document.getElementById("payrollContainer");
    container.innerHTML = list.length
        ? list.map(s => staffBoxHtml(s, scope)).join("")
        : `<p class="empty">No staff match. Click “+ Add Staff” to begin.</p>`;

    // summary cards (scoped to the current period)
    const gross = list.reduce((sum, s) => sum + rangeGross(s, scope.start, scope.end), 0);
    const ded   = list.reduce((sum, s) => sum + rangeDeductions(s, scope.start, scope.end).total, 0);
    const net   = gross - ded;
    document.getElementById("payrollScopeLabel").textContent =
        "— " + scope.label + " · " + list.length + " staff";
    const cards = [
        ["Total Gross Pay", peso2(gross), "#2e7d4f"],
        ["Total Benefits / Deductions", peso2(ded), "#c0283d"],
        ["Total Net Pay", peso2(net), "#ff385c"]
    ];
    document.getElementById("payrollCards").innerHTML = cards.map(c => `
        <div class="card"><h3>${c[0]}</h3><div class="number money" style="color:${c[2]};">${c[1]}</div></div>`).join("");

    savePayrollFilters();
}
// remember the payroll filters across refreshes
function savePayrollFilters(){
    const v = id => { const el = document.getElementById(id); return el ? el.value : ""; };
    localStorage.setItem("shph_payroll_filters", JSON.stringify({
        staff: v("payFilterStaff"), role: v("payFilterRole"), cutoff: v("payFilterCutoff"),
        from: v("payFrom"), to: v("payTo")
    }));
}
function restorePayrollFilters(){
    let f; try { f = JSON.parse(localStorage.getItem("shph_payroll_filters")); } catch(e){}
    if(!f) return;
    fillPayrollStaffFilter();   // populate staff options so the saved one can be selected
    const set = (id, val) => { const el = document.getElementById(id); if(el && val != null) el.value = val; };
    set("payFilterRole", f.role);
    set("payFilterCutoff", f.cutoff);
    set("payFrom", f.from);
    set("payTo", f.to);
    const ss = document.getElementById("payFilterStaff");
    if(ss){ ss.value = f.staff || ""; if(![...ss.options].some(o => o.value === ss.value)) ss.value = ""; }
}

/* ---------- payroll: staff modal ---------- */
let editingStaffId = null;
function openStaffModal(id){
    editingStaffId = id || null;
    const g = i => document.getElementById(i);
    if(editingStaffId){
        const s = staff.find(x => x.id === editingStaffId);
        if(!s) return;
        const b = s.benefits || {};
        g("staffModalTitle").textContent = "Edit Staff";
        g("st_name").value = s.name;
        g("st_role").value = s.role;
        g("st_ssspct").value = (b.sssPct == null ? DEFAULT_SSS_RATE : b.sssPct);
        g("st_philpct").value = (b.philhealthPct == null ? DEFAULT_PHILHEALTH_RATE : b.philhealthPct);
        g("st_pagibig").value = b.pagibig || 0;
        g("st_loans").value = b.loans || 0;
    } else {
        g("staffModalTitle").textContent = "Add Staff";
        g("st_name").value = "";
        g("st_role").selectedIndex = 0;
        g("st_ssspct").value = DEFAULT_SSS_RATE;
        g("st_philpct").value = DEFAULT_PHILHEALTH_RATE;
        g("st_pagibig").value = 0; g("st_loans").value = 0;
    }
    g("staffOverlay").classList.add("show");
}
function closeStaffModal(){ editingStaffId = null; document.getElementById("staffOverlay").classList.remove("show"); }
function saveStaff(){
    const g = i => document.getElementById(i);
    const name = g("st_name").value.trim();
    if(!name){ alert("Please enter a staff name."); return; }
    const data = {
        name,
        role: g("st_role").value,
        benefits:{
            sssPct:Number(g("st_ssspct").value) || 0,
            philhealthPct:Number(g("st_philpct").value) || 0,
            pagibig:Number(g("st_pagibig").value) || 0,
            loans:Number(g("st_loans").value) || 0
        }
    };
    if(editingStaffId){
        const idx = staff.findIndex(s => s.id === editingStaffId);
        if(idx !== -1){ staff[idx] = { ...staff[idx], ...data }; addStaffLog(staff[idx], "Edited staff info"); }
    } else {
        const id = staff.length ? Math.max(...staff.map(s => s.id)) + 1 : 1;
        const ns = { id, ...data, days:[] };
        addStaffLog(ns, "Staff added");
        staff.push(ns);
    }
    persistStaff(); closeStaffModal(); renderPayroll(); renderEmployees();
}
function deleteStaff(id){
    if(!confirm("Delete this staff member and all their entries?")) return;
    staff = staff.filter(s => s.id !== id);
    persistStaff(); renderPayroll(); renderEmployees();
}

