// downscale before saving so localStorage doesn't overflow
function resizeImage(file, cb){
    const reader = new FileReader();
    reader.onload = e => {
        const img = new Image();
        img.onload = () => {
            const max = 1000;
            let w = img.width, h = img.height;
            if(w > max || h > max){ const r = Math.min(max / w, max / h); w = Math.round(w * r); h = Math.round(h * r); }
            const canvas = document.createElement("canvas");
            canvas.width = w; canvas.height = h;
            canvas.getContext("2d").drawImage(img, 0, 0, w, h);
            cb(canvas.toDataURL("image/jpeg", 0.7));
        };
        img.src = e.target.result;
    };
    reader.readAsDataURL(file);
}
// Compress an image so the stored file stays under maxBytes — keeps IDs legible
// while saving storage. Steps resolution/quality down until it fits. Returns a
// JPEG data URL (or null if the file isn't a readable image).
// Cap for ID photos. Until Cloud Storage is active we must fit the 1MB Firestore
// fallback, so default to ~0.9MB (no photo is lost). Once /api/health reports
// Storage is on, bump to 2MB for better quality — auto-upgrades, no redeploy.
let idMaxBytes = 950 * 1024;
fetch("/api/health").then(r => r.json()).then(h => { if(h && h.imageStorage) idMaxBytes = 2 * 1024 * 1024; }).catch(() => {});
function compressImageTo(file, maxBytes, cb){
    const reader = new FileReader();
    reader.onload = e => {
        const img = new Image();
        img.onload = () => {
            const render = (maxDim, q) => {
                let w = img.width, h = img.height;
                if(w > maxDim || h > maxDim){ const r = Math.min(maxDim / w, maxDim / h); w = Math.round(w * r); h = Math.round(h * r); }
                const c = document.createElement("canvas"); c.width = w; c.height = h;
                c.getContext("2d").drawImage(img, 0, 0, w, h);
                return c.toDataURL("image/jpeg", q);
            };
            const bytesOf = url => { const i = url.indexOf(","); return Math.ceil((url.length - i - 1) * 3 / 4); };
            const steps = [[2600,0.9],[2200,0.86],[1900,0.82],[1600,0.8],[1300,0.78],[1000,0.72]];
            let out = render(steps[0][0], steps[0][1]);
            for(let i = 1; i < steps.length && bytesOf(out) > maxBytes; i++) out = render(steps[i][0], steps[i][1]);
            cb(out);
        };
        img.onerror = () => cb(null);
        img.src = e.target.result;
    };
    reader.readAsDataURL(file);
}

function cleanBegin(id){
    const log = cleanLog(id);
    log.startedAt = new Date().toISOString();
    if(log.doneAt && log.doneAt < log.startedAt) log.doneAt = null;
    cleanAddHistory(log, "Started cleaning", id);
    persistCleaning(); renderCleaners();
}
function cleanDone(id){
    const log = cleanLog(id);
    if(!log.startedAt){ alert("Please tap START first."); return; }
    const photos = log.photos || {};
    const missing = PHOTO_ROOMS.filter(([k]) => !photos[k]);
    if(missing.length){
        alert("Please attach all room photos before marking DONE:\n• " + missing.map(([, label]) => label).join("\n• "));
        return;
    }
    log.doneAt = new Date().toISOString();
    log.doneBy = cleanCurrentUser();   // who finished it → drives housekeeping payroll
    cleanAddHistory(log, "Marked done", id);
    persistCleaning(); renderCleaners();
}
// admin can revert an accidental START / DONE
function cleanUndoStart(id){
    if(!confirm("Undo START? This clears the start (and done) time for this task.")) return;
    const log = cleanLog(id);
    log.startedAt = null;
    log.doneAt = null;
    log.doneBy = null;
    cleanAddHistory(log, "Undid start", id);
    persistCleaning(); renderCleaners();
}
function cleanUndoDone(id){
    if(!confirm("Undo DONE? This marks the task back to in progress.")) return;
    const log = cleanLog(id);
    log.doneAt = null;
    log.doneBy = null;   // no longer counts toward payroll
    cleanAddHistory(log, "Undid done", id);
    persistCleaning(); renderCleaners();
}
const _cleanBusy = new Set();   // per-slot in-flight guard so a re-triggered same-photo upload can't double-write
function cleanPhoto(id, key, input){
    const file = input.files && input.files[0];
    if(!file) return;
    const slot = id + "|" + key;
    if(_cleanBusy.has(slot)) return;   // this exact photo slot is already processing
    _cleanBusy.add(slot);
    resizeImage(file, dataUrl => {
        try{
            const log = cleanLog(id);
            log.photos = log.photos || {};
            const existed = !!log.photos[key];
            log.photos[key] = dataUrl;
            cleanAddHistory(log, (existed ? "Replaced" : "Added") + " " + key + " photo", id);
            persistCleaning(); renderCleaners();
        } finally { _cleanBusy.delete(slot); }
    });
}
function cleanRemovePhoto(id, key){
    const log = cleanLog(id);
    if(!log.photos || !log.photos[key]) return;
    if(!confirm("Remove this photo?")) return;
    delete log.photos[key];
    cleanAddHistory(log, "Removed " + key + " photo", id);
    persistCleaning(); renderCleaners();
}

