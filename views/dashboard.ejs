function renderDeposit(){
    updateDepositBadge();
    const inp = document.getElementById("depositDate");
    if(!inp) return;
    if(!inp.value) inp.value = iso(today());
    const endInp = document.getElementById("depositDateEnd");
    const start = inp.value;
    const end = (endInp && endInp.value) ? endInp.value : start;
    sdUpdateLabel();
    // keep the quick-filter segment in sync with the chosen range
    document.querySelectorAll("#depSeg button").forEach(x => x.classList.toggle("active", x.dataset.d === depQuick));

    const hv = (document.getElementById("depHavenFilter") || {}).value || "";
    const list = bookings.filter(b => { const rd = depReturnDate(b); return !b.cancelled && rd && rd >= start && rd <= end && (!hv || b.haven === hv); })
        .sort((a, b) => (depReturnDate(a) || "").localeCompare(depReturnDate(b) || "") || a.haven.localeCompare(b.haven));
    const body = document.getElementById("depositBody");
    body.innerHTML = list.length ? list.map(b => {
        const dot = (HAVEN_COLORS[b.haven] || { am:"#ccc" }).am;
        const dep = Number(b.deposit || 0);
        const returned = !!b.depositReturned;
        const ro = _partnerReadOnly();   // scoped partners see deposits READ-ONLY (View only)
        let statusCell;
        if(dep > 0){
            if(returned){
                const mopTxt = b.depositMop ? " · " + b.depositMop : "";
                const pill = ro
                    ? `<span class="dep-status returned">✓ Returned${mopTxt}</span>`
                    : `<span class="dep-status returned" style="cursor:pointer;" onclick="openDepReturn(${b.id})" title="View / manage refund">✓ Returned${mopTxt}</span>`;
                statusCell = `<div class="dep-cell">${pill}<button class="btn secondary" onclick="viewBooking(${b.id})">View</button>${ro ? "" : `<button class="btn secondary" onclick="undoDeposit(${b.id})">↺ Undo</button>`}</div>`;
            } else {
                statusCell = `<div class="dep-cell"><span class="dep-status held">To return</span><button class="btn secondary" onclick="viewBooking(${b.id})">View</button>${ro ? "" : `<button class="btn" onclick="openDepReturn(${b.id})">Mark returned</button>`}</div>`;
            }
        } else {
            statusCell = `<span class="muted">No deposit</span>`;
        }
        return `<tr>
            <td><span class="dot" style="background:${dot}"></span>${b.haven}</td>
            <td>${primaryName(b)}${b.fbName ? `<br><span class="muted">FB: ${b.fbName}</span>` : ""}</td>
            <td>${b.contact || "—"}</td>
