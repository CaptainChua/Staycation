        g("d_cleaned").value = d.cleaned || 0;
        g("d_notes").value = d.notes || "";
    } else {
        setDayDateField(s, iso(today()));
        g("d_dayoff").checked = false;
        g("d_amoff").checked = false;
        g("d_pmoff").checked = false;
