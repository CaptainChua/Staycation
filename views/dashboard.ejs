let sdDpMonth = null;
let depQuick = "today";                       // "yesterday" | "today" | "month" | "custom"
let sdRangeMode = false, sdPendingStart = null;
function _depMonthStart(){ const t = today(); return new Date(t.getFullYear(), t.getMonth(), 1); }
function _depMonthEnd(){ const t = today(); return new Date(t.getFullYear(), t.getMonth() + 1, 0); }
