  #page-analytics .stack-legend .sw{ width:10px; height:10px; border-radius:3px; }
  #page-analytics .sub-h{ font-size:10.5px; letter-spacing:.4px; text-transform:uppercase; color:var(--hv-muted); font-weight:700; margin:4px 0 14px; }
</style>

