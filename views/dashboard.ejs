    page.addEventListener("mouseover", e => { const c = cardOf(e); if(c && c.dataset.proof) proofHoverType = c.dataset.proof; });
    page.addEventListener("dragover", e => { const c = cardOf(e); if(!c) return; e.preventDefault(); c.classList.add("drag"); });
    page.addEventListener("dragleave", e => { const c = cardOf(e); if(c && !c.contains(e.relatedTarget)) c.classList.remove("drag"); });
