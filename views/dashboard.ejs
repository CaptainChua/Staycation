let _savingExpense = false;
// Instant click feedback: the moment an awaiting button is clicked, disable it and show a
// "working" label so the click never feels frozen while the server confirms. Restored on failure;
// on success the modal/row re-renders so the restore is a harmless no-op.
function btnBusy(btn, label){
    if(!btn || btn.dataset.busy) return;
    btn.dataset.busy = "1"; btn.dataset.txt = btn.innerHTML; btn.dataset.dis = btn.disabled ? "1" : "";
    btn.disabled = true; btn.innerHTML = label || "Saving…";
}
function btnDone(btn){
    if(!btn || !btn.dataset.busy) return;
    btn.innerHTML = btn.dataset.txt; btn.disabled = btn.dataset.dis === "1";
    delete btn.dataset.busy; delete btn.dataset.txt; delete btn.dataset.dis;
}
// give a clicked row link (Delete) an immediate "…" state; restored only if it's still on-screen
// (a successful delete re-renders the table, removing it, so no restore is needed there)
function linkBusy(ev, label){
    const el = ev && (ev.currentTarget || ev.target);
    if(el && !el.dataset.busy){ el.dataset.busy = "1"; el.dataset.txt = el.textContent; el.textContent = label || "…"; }
    return el || null;
}
function linkDone(el){
    if(el && el.dataset.busy && document.body.contains(el)){ el.textContent = el.dataset.txt; delete el.dataset.busy; delete el.dataset.txt; }
}

async function saveExpense(){
    const type   = document.getElementById("e_type").value;
    const amount = Number(document.getElementById("e_amount").value) || 0;
    const date   = document.getElementById("e_date").value;
    const notes  = document.getElementById("e_notes").value.trim();
    const haven  = document.getElementById("e_haven") ? document.getElementById("e_haven").value : "";
    if(!amount){ alert("Please enter an amount. Tip: use a negative amount (e.g. −5000) to record funds the owner added from her own pocket."); return; }
    if(!date){ alert("Please pick a date."); return; }
    if(_savingExpense) return;   // block double-submit (a 2nd click would create a duplicate)
    _savingExpense = true;
    const _btn = document.getElementById("expenseSaveBtn"); btnBusy(_btn, "Saving…");
    try{
        const data = { type, amount, date, notes, haven, receipt: expReceiptData || null };
        let item;
        if(editingExpenseId){ const cur = expenses.find(x => x.id === editingExpenseId) || {}; item = { ...cur, ...data, id: editingExpenseId }; }
        else { item = { id: uid(), ...data }; }
        const ok = await saveOneRecord(EXPENSES_KEY, item);   // per-record — can't overwrite other expenses
        if(!ok){ alert("⚠️ The expense was NOT saved — the server didn't confirm (slow / offline). Please try again."); return; }
        if(editingExpenseId){ const idx = expenses.findIndex(x => x.id === editingExpenseId); if(idx !== -1) expenses[idx] = item; logActivity(`edited expense — ${type} ${peso(amount)}`); }
        else { expenses.push(item); logActivity(`added expense — ${type} ${peso(amount)}`); }
        setLocalKey(EXPENSES_KEY, expenses);
        closeExpenseModal(); renderExpenses();
    } finally { btnDone(_btn); _savingExpense = false; }
}
function viewExpReceipt(id){ const e = expenses.find(x => x.id === id); if(e && e.receipt) openProofImg(e.receipt); }
let _deletingExpense = false;
async function deleteExpense(id, ev){
    const e = expenses.find(x => x.id === id);
    if(!confirm("Delete this expense?")) return;
    if(_deletingExpense) return;   // block a rapid 2nd click (idempotent anyway, but keeps it clean)
    _deletingExpense = true;
    const _lnk = linkBusy(ev, "Deleting…");
    try{
        const ok = await deleteOneRecord(EXPENSES_KEY, id);
        if(!ok){ alert("⚠️ Couldn't delete on the server (slow / offline). Please try again."); return; }
        if(e){ e.deleted = true; e.deletedAt = new Date().toISOString(); logActivity(`deleted expense — ${e.type} ${peso(e.amount)}`); }
        expenses = expenses.filter(x => !x.deleted);
        setLocalKey(EXPENSES_KEY, expenses);
        renderExpenses();
    } finally { linkDone(_lnk); _deletingExpense = false; }
}

function renderExpenses(){
    // static type lists (build once)
    const tSel = document.getElementById("e_type");
    if(tSel && !tSel.options.length) tSel.innerHTML = EXPENSE_TYPES.map(t => `<option>${t}</option>`).join("");
    const ftSel = document.getElementById("expFilterType");
    if(ftSel && !ftSel.options.length) ftSel.innerHTML = `<option value="">All types</option>` + EXPENSE_TYPES.map(t => `<option>${t}</option>`).join("");
    // month filter from existing data (preserve current selection)
    const mSel = document.getElementById("expFilterMonth");
    const curMonth = mSel.value;
    const months = [...new Set(expenses.map(e => expMonthKey(e.date)).filter(Boolean))].sort().reverse();
    mSel.innerHTML = `<option value="">All months</option>` + months.map(m => `<option value="${m}">${expMonthLabel(m)}</option>`).join("");
    if(months.includes(curMonth)) mSel.value = curMonth;
    // haven filter (expenses can be tagged to a haven)
    const fhSel = document.getElementById("expFilterHaven");
    if(fhSel){
        const curH = fhSel.value;
        fhSel.innerHTML = `<option value="">All havens</option>` + ((typeof BILL_HAVENS !== "undefined" && BILL_HAVENS) ? BILL_HAVENS : []).map(h => `<option>${h}</option>`).join("");
        if(curH) fhSel.value = curH;
    }

    const fType = ftSel.value, fMonth = mSel.value, fHaven = fhSel ? fhSel.value : "";
    const rows = expenses.slice()
        .filter(e => (!fType || e.type === fType) && (!fMonth || expMonthKey(e.date) === fMonth) && (!fHaven || (e.haven || "") === fHaven))
        .sort((a, b) => (b.date || "").localeCompare(a.date || "") || b.id - a.id);

    const total = rows.reduce((s, e) => s + (Number(e.amount) || 0), 0);
    const thisMonth = expMonthKey(iso(today()));
    const monthTotal = expenses.filter(e => expMonthKey(e.date) === thisMonth && (!fHaven || (e.haven || "") === fHaven)).reduce((s, e) => s + (Number(e.amount) || 0), 0);

    const card = (label, val) => `<div class="bcard"><div class="card-label">${label}</div><div class="num">${val}</div></div>`;
    document.getElementById("expCards").innerHTML =
        card("Total" + (fType || fMonth ? " (filtered)" : ""), peso(total)) +
        card("This month", peso(monthTotal)) +
        card("Entries", String(rows.length));

    const scope = document.getElementById("expScopeLabel");
    if(scope) scope.textContent = fMonth ? "— " + expMonthLabel(fMonth) : "— all time";

    document.getElementById("expContainer").innerHTML = rows.length ? `
        <table class="exp-table">
            <thead><tr><th>Date</th><th>Type</th><th>Haven</th><th>Amount</th><th>Notes</th><th class="col-actions">Actions</th></tr></thead>
            <tbody>${rows.map(e => `
                <tr>
                    <td>${e.date ? fmt(e.date) : '<span class="muted">—</span>'}</td>
                    <td><span class="exp-type">${escHtml(e.type || "")}</span></td>
                    <td>${e.haven ? escHtml(e.haven) : '<span class="muted">—</span>'}</td>
                    <td><strong>${peso(e.amount || 0)}</strong></td>
                    <td>${e.notes ? `<span class="exp-note" style="white-space:pre-line;">${escHtml(e.notes)}</span>` : '<span class="muted">—</span>'}${e.receipt ? ` &nbsp;<span class="reinstate" style="font-size:12px;" onclick="viewExpReceipt(${e.id})">📎 receipt</span>` : ""}</td>
                    <td class="col-actions">
                        <span class="act edit" onclick="openExpenseModal(${e.id})">Edit</span>
                        <span class="act del" onclick="deleteExpense(${e.id}, event)">Delete</span>
                    </td>
                </tr>`).join("")}</tbody>
        </table>`
        : `<div class="muted" style="padding:22px 4px;">No expenses recorded${fType || fMonth ? " for this filter" : ""}. Click “+ Add expense” to log one.</div>`;
}

function fillBillSelectors(){
    const havenOpts = BILL_HAVENS.map(h => `<option>${h}</option>`).join("");
    const typeOpts  = BILL_TYPES.map(t => `<option>${t}</option>`).join("");
    document.getElementById("billFilterHaven").innerHTML = `<option value="">All havens</option>` + havenOpts;
    document.getElementById("billFilterType").innerHTML  = `<option value="">All payables</option>` + typeOpts;
    document.getElementById("b_haven").innerHTML = havenOpts;
    document.getElementById("b_type").innerHTML  = typeOpts;
}

// a bill is overdue if it's unpaid and the due date has passed
function billOverdue(b){ return !b.paid && b.due && b.due < iso(today()); }

// icon for a biller, guessed from its name
function billerIcon(type){
    const t = (type || "").toLowerCase();
    if(/meralco|electric|power|veco|light|kuryente/.test(t))
        return '<svg viewBox="0 0 24 24"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/></svg>';
    if(/maynilad|manila water|water|tubig|prime/.test(t))
        return '<svg viewBox="0 0 24 24"><path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11Z"/></svg>';
    if(/converge|pldt|globe|sky|internet|wifi|fiber|dito|smart/.test(t))
        return '<svg viewBox="0 0 24 24"><path d="M2.5 9.5a14 14 0 0 1 19 0M5.5 13a9.5 9.5 0 0 1 13 0M8.5 16.5a5 5 0 0 1 7 0"/><circle cx="12" cy="20" r=".9" style="fill:currentColor;stroke:none"/></svg>';
    if(/rent|lease|amilyar|tax|hoa|assoc/.test(t))
        return '<svg viewBox="0 0 24 24"><path d="M3 21V9l9-6 9 6v12"/><path d="M9 21v-6h6v6"/></svg>';
    return '<svg viewBox="0 0 24 24"><path d="M6 2h9l4 4v16H6z"/><path d="M14 2v5h5M9 13h6M9 17h4"/></svg>';
}

// one haven's bills as a Biller / Amount / Due Date / Status table
function billTableHtml(rows){
    const body = rows.map(b => {
        const overdue = billOverdue(b);
        const st = overdue ? "overdue" : (b.paid ? "paid" : "unpaid");
        const stLabel = overdue ? "Overdue" : (b.paid ? "Paid" : "Unpaid");
        const att = `${b.photo ? `<span class="reinstate" style="font-size:12px;margin-left:8px;" onclick="viewBillPhoto(${b.id})">📎 bill</span>` : ""}${b.receipt ? `<span class="reinstate" style="font-size:12px;margin-left:8px;" onclick="viewBillReceipt(${b.id})">📎 receipt</span>` : ""}`;
        return `<tr>
            <td><span class="biller">${billerIcon(b.type)}${b.type}</span>${att}</td>
            <td><strong>${peso(b.amount || 0)}</strong></td>
            <td>${b.due ? fmt(b.due) : '<span class="muted">—</span>'}</td>
            <td><span class="status ${st}">${stLabel}</span></td>
            <td class="col-actions">
                ${b.paid ? "" : `<span class="act markpaid" onclick="openMarkPaid(${b.id})"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8.5 12 2.5 2.5 4.5-5"/></svg>Mark paid</span>`}
                <span class="act view" onclick="viewBill(${b.id})"><svg viewBox="0 0 24 24"><path d="M1.5 12S5 5 12 5s10.5 7 10.5 7-3.5 7-10.5 7S1.5 12 1.5 12Z"/><circle cx="12" cy="12" r="3"/></svg>View</span>
                <span class="act edit" onclick="openBillModal(${b.id})">Edit</span>
                <span class="act del" onclick="deleteBill(${b.id}, event)">Delete</span>
            </td>
        </tr>`;
    }).join("");
    return `<table class="bills-table">
        <thead>
            <tr><th>Biller</th><th>Amount</th><th>Due date</th><th>Status</th><th class="col-actions">Actions</th></tr>
        </thead>
        <tbody>${body}</tbody>
    </table>`;
}

// build the month dropdown from the months present in the bills' due dates
function populateBillMonths(){
    const sel = document.getElementById("billFilterMonth");
    const prev = sel.value;
    const months = [...new Set(bills.filter(b => b.due).map(b => b.due.slice(0, 7)))].sort();
    sel.innerHTML = `<option value="">All months</option>` +
        months.map(ym => {
            const [y, m] = ym.split("-");
            return `<option value="${ym}">${MONTHS[Number(m) - 1]} ${y}</option>`;
        }).join("");
    sel.value = months.includes(prev) ? prev : "";
}

function renderBills(){
    populateBillMonths();
    const haven  = document.getElementById("billFilterHaven").value;
    const type   = document.getElementById("billFilterType").value;
    const month  = document.getElementById("billFilterMonth").value;
    const status = document.getElementById("billFilterStatus").value;

    const filtered = bills.filter(b => {
        if(haven && b.haven !== haven) return false;
        if(type && b.type !== type) return false;
        if(month && (!b.due || b.due.slice(0, 7) !== month)) return false;
        if(status === "paid" && !b.paid) return false;
        if(status === "unpaid" && b.paid) return false;
        return true;
    });

    const container = document.getElementById("billsContainer");
    // which havens get a section (selected one, or every haven that has matching bills)
    const havenList = haven ? [haven] : BILL_HAVENS.filter(h => filtered.some(b => b.haven === h));

    if(filtered.length === 0){
        container.innerHTML = `<p class="empty">No bills match.</p>`;
    } else {
        const boxes = havenList.map(h => {
            const rows = filtered
                .filter(b => b.haven === h)
                .sort((a, b) => (a.due || "").localeCompare(b.due || ""));
            if(rows.length === 0) return "";
            const due = rows.filter(b => !b.paid).reduce((s, b) => s + Number(b.amount || 0), 0);
            const dot = havenColors(h).am;
            return `<div class="bills-haven">
                <div class="bh-head">
                    <span class="bh-dot" style="background:${dot}"></span>
                    <span class="bh-name">${h}</span>
                    <span class="bh-count">${rows.length} bill${rows.length > 1 ? "s" : ""}</span>
                    <span class="bh-due">Due <b>${peso(due)}</b></span>
                </div>
                ${billTableHtml(rows)}
            </div>`;
        }).join("");
        container.innerHTML = `<div class="bills-grid">${boxes}</div>`;
    }

    renderBillsStatement(haven, month);
}

// statement of account — totals respect the selected haven + month; ties payables to money earned
function renderBillsStatement(haven, month){
    const scope = bills.filter(b =>
        (!haven || b.haven === haven) &&
        (!month || (b.due && b.due.slice(0, 7) === month))
    );
    const totalPayables = scope.reduce((s, b) => s + Number(b.amount || 0), 0);
    const paid    = scope.filter(b => b.paid).reduce((s, b) => s + Number(b.amount || 0), 0);
    const pending = totalPayables - paid;

    // money earned = downpayments collected from bookings (same haven + month scope)
    const earnScope = bookings.filter(b =>
        (!haven || b.haven === haven) &&
        (!month || (b.checkin && b.checkin.slice(0, 7) === month))
    );
    // exclude ONLY downpayments that were refunded. A non-refundable cancellation keeps the DP as real
    // revenue (dpRefunded stays false), so it still counts — same rule Finance/Analytics use (netCollectedOf).
    const earned = earnScope.filter(b => !b.dpRefunded).reduce((s, b) => s + Number(b.downpayment || 0), 0);
    const net = earned - pending;

    const scopeBits = [haven || "all havens"];
    if(month){ const [y, m] = month.split("-"); scopeBits.push(MONTHS[Number(m) - 1] + " " + y); }
    document.getElementById("billsScopeLabel").textContent = "— " + scopeBits.join(" · ");

    const ICO_WALLET = '<svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 9h14a2 2 0 0 1 0 4H3"/><path d="M17 11h.01"/></svg>';
    const ICO_HOUR  = '<svg viewBox="0 0 24 24"><path d="M6 3h12M6 21h12M7 3c0 5 5 6 5 9s-5 4-5 9M17 3c0 5-5 6-5 9s5 4 5 9"/></svg>';
    const ICO_COLL  = '<svg viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 12h.01M18 12h.01"/></svg>';
    const ICO_DOWN  = '<svg viewBox="0 0 24 24"><path d="m3 7 7 7 4-4 7 7"/><path d="M21 17v-4h-4"/></svg>';
    const cards = [
        ["Total payables",            peso(totalPayables), "var(--hv-terra-d)", "chip-gold",  ICO_WALLET],
        ["Pending (unpaid)",          peso(pending),       "var(--hv-terra-d)", "chip-terra", ICO_HOUR],
        ["Money earned (collected)",  peso(earned),        "#2e7d4f",           "chip-green", ICO_COLL],
        [net >= 0 ? "Net after pending" : "Short by", peso(Math.abs(net)), net >= 0 ? "#2e7d4f" : "var(--hv-terra-d)", "chip-terra", ICO_DOWN]
    ];
    document.getElementById("billsCards").innerHTML = cards.map(c => `
        <div class="bcard">
            <div class="card-top"><span class="card-label">${c[0]}</span><span class="card-ico ${c[3]}">${c[4]}</span></div>
            <div class="num" style="color:${c[2]};">${c[1]}</div>
        </div>`).join("");
}

/* ---------- bill due-date floating calendar ---------- */
let billCalMonth = today();
let billCalSel = iso(today());
function billDateText(ci){
    return ci ? new Date(ci + "T00:00:00").toLocaleDateString("en-PH", { weekday:"short", month:"short", day:"numeric", year:"numeric" }) : "Pick date";
}
function renderBillCal(){
    const y = billCalMonth.getFullYear(), m = billCalMonth.getMonth();
    document.getElementById("b_due_title").textContent = MONTHS[m] + " " + y;
    const first = new Date(y, m, 1).getDay();
    const dim = new Date(y, m + 1, 0).getDate();
    const todayIso = iso(today());
    let html = "";
    ["Su","Mo","Tu","We","Th","Fr","Sa"].forEach(d => html += `<div class="dp-wd">${d}</div>`);
    for(let i = 0; i < first; i++) html += `<div class="dp-day empty"></div>`;
    for(let d = 1; d <= dim; d++){
        const ci = iso(new Date(y, m, d));
        const cls = "dp-day" + (ci === billCalSel ? " sel" : "") + (ci === todayIso ? " today" : "");
        html += `<div class="${cls}" onclick="pickBillDate('${ci}')"><span class="n">${d}</span></div>`;
    }
    document.getElementById("b_due_grid").innerHTML = html;
}
function billCalNav(dir){ billCalMonth = new Date(billCalMonth.getFullYear(), billCalMonth.getMonth() + dir, 1); renderBillCal(); }
function openBillCal(e){
    if(e) e.stopPropagation();
    const pop = document.getElementById("b_due_popup");
    if(pop.classList.contains("show")){ pop.classList.remove("show"); return; }
    billCalMonth = new Date((billCalSel || iso(today())) + "T00:00:00");
    renderBillCal();
    pop.classList.add("show");
}
function closeBillCal(){ const p = document.getElementById("b_due_popup"); if(p) p.classList.remove("show"); }
function pickBillDate(ci){
    billCalSel = ci;
    document.getElementById("b_due").value = ci;
    document.getElementById("b_due_pill").textContent = billDateText(ci);
    closeBillCal();
}
function setBillDate(ci){
    billCalSel = ci || iso(today());
    document.getElementById("b_due").value = ci || "";
    document.getElementById("b_due_pill").textContent = billDateText(ci);
    if(ci) billCalMonth = new Date(ci + "T00:00:00");
    closeBillCal();
}
function billCalToday(){ pickBillDate(iso(today())); }
document.addEventListener("click", e => { if(!e.target.closest(".dp-wrap")) closeBillCal(); });

let editingBillId = null;
function openBillModal(id){
    editingBillId = id || null;
    if(editingBillId){
        const b = bills.find(x => x.id === editingBillId);
        if(!b) return;
        document.getElementById("billModalTitle").textContent = "Edit Bill";
        document.getElementById("b_haven").value = b.haven;
        document.getElementById("b_type").value = b.type;
        document.getElementById("b_amount").value = b.amount || 0;
        setBillDate(b.due || iso(today()));
        document.getElementById("b_paid").checked = !!b.paid;
        if(b.photo) setBillPhoto(b.photo); else clearBillPhoto();
        if(b.receipt) setBillReceipt(b.receipt); else clearBillReceipt();
    } else {
        document.getElementById("billModalTitle").textContent = "Add Bill";
        document.getElementById("b_haven").selectedIndex = 0;
        document.getElementById("b_type").selectedIndex = 0;
        document.getElementById("b_amount").value = "";
        setBillDate(iso(today()));
        document.getElementById("b_paid").checked = false;
        clearBillPhoto(); clearBillReceipt();
    }
    document.getElementById("billOverlay").classList.add("show");
}
function closeBillModal(){
    editingBillId = null;
    document.getElementById("billOverlay").classList.remove("show");
}

let _savingBill = false;
async function saveBill(){
    const data = {
        haven: document.getElementById("b_haven").value,
        type: document.getElementById("b_type").value,
        amount: Number(document.getElementById("b_amount").value) || 0,
        due: document.getElementById("b_due").value,
        paid: document.getElementById("b_paid").checked,
        photo: billPhotoData || null,
        receipt: billReceiptData || null
    };
    if(data.amount <= 0){ alert("Please enter an amount."); return; }
    if(_savingBill) return;   // block double-submit (a 2nd click would create a duplicate)
    _savingBill = true;
    const _btn = document.getElementById("billSaveBtn"); btnBusy(_btn, "Saving…");
    try{
        let item;
        if(editingBillId){ const cur = bills.find(b => b.id === editingBillId) || {}; item = { ...cur, ...data, id: editingBillId }; }
        else { item = { id: uid(), ...data }; }
        const ok = await saveOneRecord(BILLS_KEY, item);   // per-record — offloads photos, can't overwrite other bills
        if(!ok){ alert("⚠️ The bill was NOT saved — the server didn't confirm (slow / offline). Please try again."); return; }
        if(editingBillId){ const idx = bills.findIndex(b => b.id === editingBillId); if(idx !== -1) bills[idx] = item; }
        else { bills.push(item); }
        setLocalKey(BILLS_KEY, bills);
        closeBillModal();
        renderBills();
    } finally { btnDone(_btn); _savingBill = false; }
}

let _togglingBill = false;
async function toggleBillPaid(id){
    const b = bills.find(x => x.id === id);
    if(!b) return;
    if(_togglingBill) return;   // block double-click (a 2nd click would double-toggle local state out of sync)
    _togglingBill = true;
    try{
        const newPaid = !b.paid;
        const item = { ...b, paid: newPaid };
        const ok = await saveOneRecord(BILLS_KEY, item);
        if(!ok){ alert("⚠️ Couldn't update on the server (slow / offline). Please try again."); return; }
        b.paid = newPaid;   // set to the value we actually sent — never re-toggle after the await
        setLocalKey(BILLS_KEY, bills);
        renderBills();
    } finally { _togglingBill = false; }
}
let _deletingBill = false;
async function deleteBill(id, ev){
    if(!confirm("Delete this bill?")) return;
    if(_deletingBill) return;   // block a rapid 2nd click
    _deletingBill = true;
    const _lnk = linkBusy(ev, "Deleting…");
    try{
        const ok = await deleteOneRecord(BILLS_KEY, id);
        if(!ok){ alert("⚠️ Couldn't delete on the server (slow / offline). Please try again."); return; }
        const b = bills.find(x => x.id === id);
        if(b){ b.deleted = true; b.deletedAt = new Date().toISOString(); }   // kept on the server, just hidden
        bills = bills.filter(x => !x.deleted);   // hide from this view
        setLocalKey(BILLS_KEY, bills);
        renderBills();
    } finally { linkDone(_lnk); _deletingBill = false; }
}
/* ---------- bill photo + receipt uploads (offloaded via per-record save, like deposits) ---------- */
let billPhotoData = null, billReceiptData = null;
function onBillPhotoChange(input){ if(input.files && input.files[0]) applyBillPhoto(input.files[0]); }
function onBillReceiptChange(input){ if(input.files && input.files[0]) applyBillReceipt(input.files[0]); }
function applyBillPhoto(f){
    if(!f || !/^image\//.test(f.type)) return;
    document.getElementById("billPhotoName").textContent = f.name || "Photo attached";
    compressImageTo(f, idMaxBytes, dataUrl => { if(dataUrl){ setBillPhoto(dataUrl); return; } const r = new FileReader(); r.onload = e => setBillPhoto(e.target.result); r.readAsDataURL(f); });
}
function applyBillReceipt(f){
    if(!f || !/^image\//.test(f.type)) return;
    document.getElementById("billReceiptName").textContent = f.name || "Photo attached";
    compressImageTo(f, idMaxBytes, dataUrl => { if(dataUrl){ setBillReceipt(dataUrl); return; } const r = new FileReader(); r.onload = e => setBillReceipt(e.target.result); r.readAsDataURL(f); });
}
function setBillPhoto(dataUrl){
    billPhotoData = dataUrl;
    const img = document.getElementById("billPhotoImg"), thumb = document.getElementById("billPhotoThumb"), nm = document.getElementById("billPhotoName");
    if(img) img.src = dataUrl; if(thumb) thumb.style.display = "inline-block"; if(nm) nm.textContent = "Photo attached ✓";
