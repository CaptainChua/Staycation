const GF_CONTACT = "0945 693 5211";            // always the owner's contact
const GF_TOWER = "D";                          // every haven is in Tower D
const GF_HAVEN_UNITS = {                        // fixed unit number per haven
    "Haven 1":"2802", "Haven 2":"2823", "Haven 3":"2334", "Haven 4":"2602",
    "Haven 5":"1923", "Haven 7":"930", "Haven 8":"2535",
