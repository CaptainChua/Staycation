              (Number(b.stayHours) === 6 && b.slot ? " · " + (b.slot === "morning" ? "AM" : "PM") : "");
        const guestCell = (b.guests || []).length
            ? (b.guests || []).map(g => `<div>${escHtml(g.name || "")}${g.age != null && g.age !== "" ? ` <span class="age">${g.age}</span>` : ""}</div>`).join("")
            : "—";
        const pax = (b.guests || []).length;
