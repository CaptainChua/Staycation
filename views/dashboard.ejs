// a bill is overdue if it's unpaid and the due date has passed
function billOverdue(b){ return !b.paid && b.due && b.due < iso(today()); }

// one haven's bills as a Biller / Amount / Due Date / Status table
function billTableHtml(rows){
    const body = rows.map(b => {
        const overdue = billOverdue(b);
        const st = b.paid ? "paid" : "unpaid";
        return `<tr>
            <td><strong>${b.type}</strong></td>
            <td>${peso(b.amount || 0)}</td>
            <td>${b.due ? fmt(b.due) : '<span class="muted">—</span>'}${overdue ? ' <span class="muted" style="color:#c0283d;font-weight:bold;">(Overdue)</span>' : ''}</td>
            <td><span class="status ${st}">${st}</span></td>
            <td class="col-actions">
                <span class="edit" onclick="toggleBillPaid(${b.id})">${b.paid ? "Mark unpaid" : "Mark paid"}</span>
                <span class="edit" onclick="openBillModal(${b.id})">Edit</span>
                <span class="del" onclick="deleteBill(${b.id})">Delete</span>
            </td>
        </tr>`;
    }).join("");
    return `<table class="bills-table">
        <colgroup>
            <col style="width:22%"><col style="width:14%"><col style="width:18%"><col style="width:13%"><col style="width:33%">
        </colgroup>
        <thead>
            <tr><th>Biller</th><th>Amount</th><th>Due Date</th><th>Status</th><th class="col-actions"></th></tr>
        </thead>
        <tbody>${body}</tbody>
    </table>`;
}

// build the month dropdown from the months present in the bills' due dates
function populateBillMonths(){
    const sel = document.getElementById("billFilterMonth");
    const prev = sel.value;
    const months = [...new Set(bills.filter(b => b.due).map(b => b.due.slice(0, 7)))].sort();
    sel.innerHTML = `<option value="">All months</option>` +
        months.map(ym => {
            const [y, m] = ym.split("-");
            return `<option value="${ym}">${MONTHS[Number(m) - 1]} ${y}</option>`;
        }).join("");
    sel.value = months.includes(prev) ? prev : "";
}

function renderBills(){
    populateBillMonths();
    const haven  = document.getElementById("billFilterHaven").value;
    const type   = document.getElementById("billFilterType").value;
    const month  = document.getElementById("billFilterMonth").value;
    const status = document.getElementById("billFilterStatus").value;

    const filtered = bills.filter(b => {
        if(haven && b.haven !== haven) return false;
        if(type && b.type !== type) return false;
        if(month && (!b.due || b.due.slice(0, 7) !== month)) return false;
        if(status === "paid" && !b.paid) return false;
        if(status === "unpaid" && b.paid) return false;
        return true;
    });

    const container = document.getElementById("billsContainer");
    // which havens get a section (selected one, or every haven that has matching bills)
    const havenList = haven ? [haven] : BILL_HAVENS.filter(h => filtered.some(b => b.haven === h));

    if(filtered.length === 0){
        container.innerHTML = `<p class="empty">No bills match.</p>`;
    } else {
        const boxes = havenList.map(h => {
            const rows = filtered
                .filter(b => b.haven === h)
                .sort((a, b) => (a.due || "").localeCompare(b.due || ""));
            if(rows.length === 0) return "";
            return `<div class="bills-haven">
                <div class="bills-haven-title">${h}</div>
                ${billTableHtml(rows)}
            </div>`;
        }).join("");
        container.innerHTML = `<div class="bills-grid">${boxes}</div>`;
    }

    renderBillsStatement(haven, month);
}

// statement of account — totals respect the selected haven + month; ties payables to money earned
function renderBillsStatement(haven, month){
    const scope = bills.filter(b =>
        (!haven || b.haven === haven) &&
        (!month || (b.due && b.due.slice(0, 7) === month))
    );
    const totalPayables = scope.reduce((s, b) => s + Number(b.amount || 0), 0);
    const paid    = scope.filter(b => b.paid).reduce((s, b) => s + Number(b.amount || 0), 0);
    const pending = totalPayables - paid;

    // money earned = downpayments collected from bookings (same haven + month scope)
    const earnScope = bookings.filter(b =>
        (!haven || b.haven === haven) &&
        (!month || (b.checkin && b.checkin.slice(0, 7) === month))
    );
    const earned = earnScope.reduce((s, b) => s + Number(b.downpayment || 0), 0);
    const net = earned - pending;

    const scopeBits = [haven || "all havens"];
    if(month){ const [y, m] = month.split("-"); scopeBits.push(MONTHS[Number(m) - 1] + " " + y); }
    document.getElementById("billsScopeLabel").textContent = "— " + scopeBits.join(" · ");

    const cards = [
        ["Total Payables", peso(totalPayables), "#ff385c"],
        ["Pending (unpaid)", peso(pending), "#c0283d"],
        ["Money Earned (collected)", peso(earned), "#2e7d4f"],
        [net >= 0 ? "Net after pending" : "Short by", peso(Math.abs(net)), net >= 0 ? "#2e7d4f" : "#c0283d"]
    ];
    document.getElementById("billsCards").innerHTML = cards.map(c => `
        <div class="card">
            <h3>${c[0]}</h3>
            <div class="number money" style="color:${c[2]};">${c[1]}</div>
        </div>`).join("");
}

