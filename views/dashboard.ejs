  /* ---- canvas ---- */
  body{ background:var(--hv-cream); color:var(--hv-ink); }

  /* ---- sidebar ---- */
  .sidebar{ background:var(--hv-sidebar); color:#d9cfc5; }
  .sidebar .brand{ border-bottom-color:#403730; color:#fff; }
  .sidebar .nav-item{ color:#cabdb1; border-left-color:transparent; margin:1px 8px; border-radius:9px; padding-left:14px; }
  .sidebar .nav-item:hover{ background:var(--hv-sidebar-2); color:#fff; }
