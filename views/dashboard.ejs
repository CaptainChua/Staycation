    pop.classList.add("show");
}
function closeGfCal(){ const p = document.getElementById("gf_date_popup"); if(p) p.classList.remove("show"); }
function pickGfDate(ci){
    gfCalSel = ci;
    document.getElementById("gf_date").value = ci;
    document.getElementById("gf_date_pill").textContent = gfDateText(ci);
    closeGfCal();
}
function setGfDate(ci){
    gfCalSel = ci || iso(today());
    const inp = document.getElementById("gf_date"); if(inp) inp.value = ci || "";
    const pill = document.getElementById("gf_date_pill"); if(pill) pill.textContent = gfDateText(ci);
    if(ci) gfCalMonth = new Date(ci + "T00:00:00");
}
function gfCalToday(){ pickGfDate(iso(today())); }
document.addEventListener("click", e => { if(!e.target.closest(".dp-wrap")) closeGfCal(); });

// when the haven dropdown changes, pull its remembered Unit No. & Tower
function gfHavenChanged(){
    const haven = document.getElementById("gf_haven").value;
    const unit  = gfUnitFor(haven);
    document.getElementById("gff_unit").value = unit;
    gfSetUnit2(unit);
}

// "No. of Days" on a move-in/out form = whole days between the two dates
function gfDays(b){
    if(!b.checkin) return "";
    const co = b.checkout && b.checkout > b.checkin ? b.checkout
             : iso(addDays(new Date(b.checkin + "T00:00:00"), 1));
    return Math.max(1, daysBetween(b.checkin, co));
}

// dates on the form read like "JUNE 28"
function gfDate(dateStr){
    if(!dateStr) return "";
    return new Date(dateStr + "T00:00:00")
        .toLocaleDateString("en-PH", { month:"long", day:"numeric" }).toUpperCase();
}

// find the booking for the picked haven + date and fill the form
function gfLoadBooking(){
    const haven = document.getElementById("gf_haven").value;
    const date  = document.getElementById("gf_date").value;
    const msg   = document.getElementById("gf_pickMsg");
    if(!date){ if(msg) msg.textContent = "Pick a check-in date first."; return; }
    // a booking covers the date when checkin <= date < checkout (or same-day day-use)
    const match = bookings.find(b => !b.cancelled && b.haven === haven &&
        b.checkin <= date && date < endExcl(b));
    if(!match){
        if(msg) msg.textContent = `No booking for ${haven} on ${fmt(date)}.`;
        return;
    }
    if(msg) msg.textContent = `Loaded ${primaryName(match)} · ${fmt(match.checkin)}.`;
    gfFill(match);
}

function gfFill(b){
    const set = (id, v) => { const el = document.getElementById(id); if(el) el.value = v ?? ""; };
    set("gff_owner", GF_OWNER_DEFAULT);
    set("gff_date", gfTodayLabel());
    set("gff_contact", GF_CONTACT);
    // Unit No. & Tower is fixed per haven (all Tower D)
    const unit = gfUnitFor(b.haven);
    set("gff_unit", unit);
    gfSetUnit2(unit);
    set("gff_movein", gfDate(b.checkin));
    set("gff_moveout", b.checkout ? gfDate(b.checkout) : gfDate(iso(addDays(new Date(b.checkin + "T00:00:00"), 1))));
    set("gff_days", gfDays(b));
    gfRenderGuestRows(b.guests || []);
    // load this booking's saved ID photos so they're shown (and stay persisted)
    gfBookingId = b.id;
    gfIdPhotos = Array.isArray(b.ids) ? b.ids.slice() : [];
    gfIdLayout = [];   // reset placement for the newly loaded set
    gfRenderIds();
}

// APPEND a newly-uploaded ID photo to the loaded booking (so uploads are saved &
// never lost). It never overwrites the booking's list — so removing a photo on
// the form is form-only and does NOT delete it from the booking.
async function gfAttachIdToBooking(dataUrl){
    if(gfBookingId == null || !dataUrl) return;
    const b = bookings.find(x => x.id === gfBookingId);
    if(!b) return;
    b.ids = Array.isArray(b.ids) ? b.ids : [];
    b.ids.push(await _offloadImg(dataUrl));       // durable /img ref
    _bkMirror(b);
    // per-record ID save (reads live record, sets ids) — can't clobber other fields
    fetch(`/api/booking/${encodeURIComponent(gfBookingId)}/ids`, { method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify({ ids: b.ids }) }).catch(()=>{});
}

// reset the form to blanks — including the Date and Unit No. & Tower
function gfClear(){
    ["gff_date","gff_unit","gff_movein","gff_moveout","gff_days"]
        .forEach(id => { const el = document.getElementById(id); if(el) el.value = ""; });
    const set = (id, v) => { const el = document.getElementById(id); if(el) el.value = v; };
    set("gff_owner", GF_OWNER_DEFAULT);
    set("gff_contact", GF_CONTACT);      // contact stays (always the fixed number)
    gfSetUnit2("");                       // clear the page-2 UNIT # too
    gfRenderGuestRows([]);
    gfBookingId = null;
    gfIdPhotos = []; gfIdLayout = []; gfRenderIds();
    const msg = document.getElementById("gf_pickMsg"); if(msg) msg.textContent = "";
}

// add ID photos → store as data URLs and show them on page 2
function gfAddIdPhotos(ev){
    const files = Array.from(ev.target.files || []);
    if(files.length && gfBookingId == null){
        // not blocking — just a heads-up that they won't be saved without a booking
        const msg = document.getElementById("gf_pickMsg");
        if(msg) msg.textContent = "Tip: Load a booking first so the IDs save to it (still shown for printing).";
    }
    const add = dataUrl => { if(!dataUrl) return; gfIdPhotos.push(dataUrl); gfRenderIds(); gfAttachIdToBooking(dataUrl); };
    files.forEach(file => {
        if(file.type && !/^image\//.test(file.type)) return;   // allow empty type (e.g. HEIC)
        compressImageTo(file, idMaxBytes, dataUrl => {
            if(dataUrl){ add(dataUrl); return; }
            // compression couldn't decode it → keep the original so it's never lost
            const r = new FileReader();
            r.onload = e => add(e.target.result);
            r.readAsDataURL(file);
        });
    });
    ev.target.value = "";   // allow re-selecting the same file
}

// default placement: stacked down the page, centred, sensible size (aspect kept)
function gfDefaultLayout(i){ return { x:27, y:7 + i * 36, w:46, rot:0 }; }
function gfRenderIds(){
    const box = document.getElementById("gf_idGallery");
    if(!box) return;
    box.innerHTML = gfIdPhotos.map((src, i) => {
        const lay = gfIdLayout[i] || (gfIdLayout[i] = gfDefaultLayout(i));
        return `<div class="gf-idphoto" id="gfIdPhoto_${i}" style="left:${lay.x}%; top:${lay.y}%; width:${lay.w}%; transform:rotate(${lay.rot || 0}deg);" onmousedown="gfPhotoDragStart(event, ${i})">
            <img src="${src}" alt="Guest ID" draggable="false">
            <div class="gf-idbtns">
                <button class="btn secondary" onmousedown="event.stopPropagation()" onclick="gfOpenCrop(${i})" title="Crop">✂</button>
                <button class="btn secondary" onmousedown="event.stopPropagation()" onclick="gfRotateId(${i})" title="Rotate 90°">↻</button>
                <button class="btn secondary" onmousedown="event.stopPropagation()" onclick="gfRemoveId(${i})" title="Remove from this print">✕</button>
            </div>
            <span class="gf-resize" onmousedown="gfPhotoResizeStart(event, ${i})" title="Drag to resize"></span>
        </div>`;
    }).join("");
}
// rotate a photo 90° (fixes sideways IDs)
function gfRotateId(i){
    const lay = gfIdLayout[i] || (gfIdLayout[i] = gfDefaultLayout(i));
    lay.rot = ((lay.rot || 0) + 90) % 360;
    const el = document.getElementById("gfIdPhoto_" + i);
    if(el) el.style.transform = "rotate(" + lay.rot + "deg)";
}
// drag a photo to move it
function gfPhotoDragStart(e, i){
    if(e.target.classList.contains("gf-resize")) return;
    e.preventDefault();
    const page = document.getElementById("gfPage2");
    const rect = page.getBoundingClientRect();
    const lay = Object.assign({}, gfIdLayout[i] || gfDefaultLayout(i));
    const sx = e.clientX, sy = e.clientY;
    const el = document.getElementById("gfIdPhoto_" + i);
    function move(ev){
        const x = lay.x + (ev.clientX - sx) / rect.width * 100;
        const y = lay.y + (ev.clientY - sy) / rect.height * 100;
        gfIdLayout[i] = { x, y, w: lay.w, rot: lay.rot };
        if(el){ el.style.left = x + "%"; el.style.top = y + "%"; }
    }
    function up(){ document.removeEventListener("mousemove", move); document.removeEventListener("mouseup", up); }
    document.addEventListener("mousemove", move);
    document.addEventListener("mouseup", up);
}
// drag the corner handle to resize a photo
function gfPhotoResizeStart(e, i){
    e.preventDefault(); e.stopPropagation();
    const page = document.getElementById("gfPage2");
    const rect = page.getBoundingClientRect();
    const lay = Object.assign({}, gfIdLayout[i] || gfDefaultLayout(i));
    const sx = e.clientX;
    const el = document.getElementById("gfIdPhoto_" + i);
    function move(ev){
        const w = Math.max(10, Math.min(95, lay.w + (ev.clientX - sx) / rect.width * 100));
        gfIdLayout[i] = { x: lay.x, y: lay.y, w, rot: lay.rot };
        if(el) el.style.width = w + "%";
    }
    function up(){ document.removeEventListener("mousemove", move); document.removeEventListener("mouseup", up); }
    document.addEventListener("mousemove", move);
    document.addEventListener("mouseup", up);
}

// Save the whole guest form (both pages) as a downloadable PDF. The overlay
// <input> fields are converted to plain text in the captured copy so their
// values render reliably; the on-screen controls are hidden.
function gfSavePdf(){
    const doc = document.getElementById("gfDoc");
    if(!doc) return;
    const _btn = document.getElementById("gfPdfBtn");
    const _orig = _btn ? _btn.innerHTML : "";
    if(_btn){ if(_btn.disabled) return; _btn.disabled = true; _btn.innerHTML = "⏳ Generating PDF…"; }
    const _done = () => { if(_btn){ _btn.disabled = false; _btn.innerHTML = _orig; } };
    const snap = {};
    let idx = 0;
    doc.querySelectorAll("input.gf-ov").forEach(inp => {
        const key = "pdf" + (idx++);
        inp.dataset.pdfkey = key;
        const cs = getComputedStyle(inp);
        snap[key] = {
            value: inp.value || "",
            css: `position:absolute; left:${inp.style.left}; top:${inp.style.top}; width:${inp.style.width};`
                + `transform:${cs.transform === "none" ? "translateY(-50%)" : cs.transform};`
                + `font-family:${cs.fontFamily}; font-size:${cs.fontSize}; font-weight:${cs.fontWeight};`
                + `color:${cs.color}; text-align:${cs.textAlign}; line-height:${cs.lineHeight};`
                + `white-space:nowrap; overflow:hidden; box-sizing:border-box;`
        };
    });
    const page = doc.querySelector(".gf-page");
    // filename = GAF <Tower><Unit> (<Move-in date>), e.g. GAF D2802 (July 2)
    const unitNo = GF_HAVEN_UNITS[document.getElementById("gf_haven").value] || "";
    let moveIn = gfCalSel;
    try{ moveIn = new Date(gfCalSel + "T00:00:00").toLocaleDateString("en-US", { month: "long", day: "numeric" }); }catch(e){}
    const fname = `GAF ${GF_TOWER}${unitNo} (${moveIn}).pdf`;
    // Render ONE PDF page per .gf-page (skip an ID page that has no photos). Doing the pages
    // ourselves — instead of letting html2pdf auto-paginate one tall canvas — avoids the blank
    // "sliver" pages that appeared between/after the real pages.
    const allPages = Array.from(doc.querySelectorAll(".gf-page"));
    const pages = allPages.filter(el => el.id !== "gfPage2" || gfIdPhotos.length > 0);   // drop the empty IDs page
    const onclonePage = cd => {
        cd.querySelectorAll("input.gf-ov").forEach(inp => {
            const s = snap[inp.dataset.pdfkey]; if(!s) return;
            const d = cd.createElement("div");
            d.textContent = s.value; d.setAttribute("style", s.css);
            inp.parentNode.replaceChild(d, inp);
        });
        cd.querySelectorAll(".gfToolbar-inline, .gf-idbtns, .gf-resize").forEach(e => e.remove());
    };
    const loadScript = src => new Promise((res, rej) => { const s = document.createElement("script"); s.src = src; s.onload = res; s.onerror = rej; document.body.appendChild(s); });
    const render = async () => {
        let pdf = null;
        for(let i = 0; i < pages.length; i++){
            const el = pages[i], w = el.offsetWidth, h = el.offsetHeight;
            const canvas = await window.html2canvas(el, { scale: 2, useCORS: true, backgroundColor: "#ffffff", onclone: onclonePage });
            const img = canvas.toDataURL("image/jpeg", 0.95);
            if(!pdf) pdf = new window.jspdf.jsPDF({ unit:"px", format:[w, h], orientation:"portrait" });
            else pdf.addPage([w, h], "portrait");
            pdf.addImage(img, "JPEG", 0, 0, w, h);
        }
        if(pdf) pdf.save(fname);
    };
    const start = async () => {
        try{
            if(!window.html2canvas) await loadScript("https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js");
            if(!(window.jspdf && window.jspdf.jsPDF)) await loadScript("https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js");
            await render();
        }catch(e){
            alert("Couldn't build the PDF here — opening Print so you can choose “Save as PDF”."); window.print();
        }finally{ _done(); }
    };
    // let the "Generating…" state paint before the heavy html2canvas render blocks the main thread
    setTimeout(start, 30);
}

