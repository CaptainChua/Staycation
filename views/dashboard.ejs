/* ---------- bills / payables ---------- */
const BILL_TYPES = ["Meralco", "Water", "GAF", "Condo dues", "Internet", "Rent"];
// bills can be tagged to a haven or to these extra expense categories
const BILL_HAVENS = [...HAVENS, "Pia", "OTHERS"];
const BILLS_KEY = "shph_bills_v1";

function loadBills(){
    const raw = localStorage.getItem(BILLS_KEY);
    if(raw) return JSON.parse(raw);
    // seed a few examples so the page isn't empty
    const t = today();
    const due = n => iso(addDays(t, n));
    const seed = [
        { id:1, haven:"Haven 1", type:"Meralco",    amount:3200, due:due(5),  paid:false },
        { id:2, haven:"Haven 1", type:"Water",      amount:650,  due:due(8),  paid:true  },
        { id:3, haven:"Haven 1", type:"Internet",   amount:1699, due:due(-2), paid:false },
        { id:4, haven:"Haven 3", type:"Condo dues", amount:2500, due:due(10), paid:false },
        { id:5, haven:"Haven 3", type:"GAF",        amount:1200, due:due(3),  paid:true  }
    ];
    localStorage.setItem(BILLS_KEY, JSON.stringify(seed));
    return seed;
}
let bills = loadBills();
