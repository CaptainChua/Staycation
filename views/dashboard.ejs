async function confirmMarkPaid(){
    if(paidBillId == null) return;
    if(!paidReceiptData){ alert("Please upload the receipt / proof of payment first — a bill can't be marked paid without it."); return; }
    if(_markingPaid) return;
    _markingPaid = true;
    const _btn = document.getElementById("paidConfirmBtn"); btnBusy(_btn, "Saving…");
    try{
        const b = bills.find(x => x.id === paidBillId);
        if(!b) return;
        const item = { ...b, paid: true, receipt: paidReceiptData };
        const ok = await saveOneRecord(BILLS_KEY, item);   // per-record — offloads the receipt image
        if(!ok){ alert("⚠️ Couldn't save — the server didn't confirm (slow / offline). Please try again."); return; }
        const idx = bills.findIndex(x => x.id === paidBillId);
        if(idx !== -1) bills[idx] = item;
        setLocalKey(BILLS_KEY, bills);
        closeMarkPaid(); renderBills();
