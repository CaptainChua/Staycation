    for(let d = 1; d <= dim; d++){
        const ci = iso(new Date(y, m, d));
        const cls = "dp-day" + (ci === todayIso ? " today" : "");
        html += `<div class="${cls}" data-iso="${ci}" onclick="pickCleanDay('${ci}')" onmouseover="hoverCleanDay('${ci}')"><span class="n">${d}</span></div>`;
    }
    document.getElementById("cleanDpGrid").innerHTML = html;
    updateCleanHighlight();
}
function updateCleanHighlight(){
    const { start, end } = cleanHighlightRange();
    document.querySelectorAll("#cleanDpGrid .dp-day").forEach(cell => {
        cell.classList.remove("sel","range-start","range-end","in-range");
        const ci = cell.dataset.iso; if(!ci) return;
        if(ci === start && ci === end) cell.classList.add("sel");
        else if(ci === start) cell.classList.add("sel","range-start");
        else if(ci === end) cell.classList.add("sel","range-end");
        else if(ci > start && ci < end) cell.classList.add("in-range");
    });
    document.getElementById("cleanDpHint").textContent = cleanPendingStart
        ? "Now click an end date (max " + CLEAN_MAX_RANGE + " days), or the same day for one day"
        : "Click a date, then an end date for a range (max " + CLEAN_MAX_RANGE + " days)";
}
function pickCleanDay(ci){
    if(!cleanPendingStart){ cleanPendingStart = ci; cleanHoverIso = ci; updateCleanHighlight(); return; }
    if(ci < cleanPendingStart){ cleanPendingStart = ci; updateCleanHighlight(); return; }
    let end = ci;
    if(daysBetween(cleanPendingStart, end) > CLEAN_MAX_RANGE - 1)
        end = iso(addDays(new Date(cleanPendingStart + "T00:00:00"), CLEAN_MAX_RANGE - 1));
    applyCleanRange(cleanPendingStart, end);
}
function hoverCleanDay(ci){ if(!cleanPendingStart) return; cleanHoverIso = ci; updateCleanHighlight(); }
function applyCleanRange(s, e){
    cleanStart = new Date(s + "T00:00:00");
    cleanDays = daysBetween(s, e) + 1;
    closeCleanPicker();
    renderCleaners();
}
function cleanDpToday(){ applyCleanRange(iso(today()), iso(today())); }
function cleanDpClear(){ cleanShowWeek(); }

