  @media(max-width:1000px){ #page-analytics .an-two{ grid-template-columns:1fr; } }

  /* grouped bar chart */
  #page-analytics .chart{ display:flex; align-items:flex-end; gap:10px; padding:8px 4px 0; overflow:hidden; }
  #page-analytics .chart .col{ flex:1 1 0; min-width:0; display:flex; flex-direction:column; align-items:center; }
  #page-analytics .chart .bars{ display:flex; align-items:flex-end; justify-content:center; gap:5px; height:240px; width:100%; }
  #page-analytics .chart .bar{ position:static; top:auto; bottom:auto; padding:0; width:11px; flex:none; border-radius:5px 5px 0 0; min-height:2px; color:inherit; }
  #page-analytics .chart .bar.inc{ background:#5aa873; }
  #page-analytics .chart .bar.exp{ background:#bd6e3f; }
  #page-analytics .chart .mlabel{ font-size:11px; color:var(--hv-muted); margin-top:8px; }
  #page-analytics .chart-legend{ display:flex; align-items:center; gap:14px; font-size:12px; color:var(--hv-muted); }
  #page-analytics .chart-legend .k{ display:inline-flex; align-items:center; gap:6px; }
  #page-analytics .chart-legend .sw{ width:10px; height:10px; border-radius:3px; }
  #page-analytics .chart-net{ display:inline-flex; align-items:center; gap:6px; background:#e7f3ec; color:#2e7d4f; border-radius:20px; padding:4px 12px; font-weight:700; font-size:12px; }

  /* horizontal bars */
  #page-analytics .hbar-row{ margin-bottom:14px; }
  #page-analytics .hbar-top{ display:flex; justify-content:space-between; align-items:center; margin-bottom:6px; gap:10px; }
  #page-analytics .hbar-name{ display:inline-flex; align-items:center; gap:8px; font-weight:600; font-size:13.5px; color:var(--hv-ink); }
  #page-analytics .hbar-dot{ width:9px; height:9px; border-radius:50%; flex:none; }
  #page-analytics .hbar-val{ font-size:13px; font-weight:700; color:var(--hv-ink); white-space:nowrap; }
  #page-analytics .hbar-val .muted{ color:var(--hv-muted); font-weight:500; }
