/* ---------- cleaners / housekeeping ---------- */
const CLEAN_KEY = "shph_cleaning_v1";
const PHOTO_ROOMS = [
    ["kitchen", "Kitchen"],
    ["bedroom", "Bedroom"],
    ["dining", "Dining"],
    ["comfortRoom", "Comfort Room"],
    ["electronics", "Electronics"]
];
let cleaning = (() => { const raw = localStorage.getItem(CLEAN_KEY); return raw ? JSON.parse(raw) : {}; })();
function persistCleaning(){
    try{ localStorage.setItem(CLEAN_KEY, JSON.stringify(cleaning)); return true; }
    catch(e){ alert("Could not save — browser storage is full. Try removing some photos."); return false; }
}
function cleanLog(id){
    if(!cleaning[id]) cleaning[id] = { startedAt:null, doneAt:null, photos:{}, history:[] };
    return cleaning[id];
}
function cleanCurrentUser(){
    const sel = document.getElementById("cleanUser");
    return (sel && sel.value) ? sel.value : "Housekeeper";
}
function cleanAddHistory(log, action, id){
    log.history = log.history || [];
    log.history.push({ user:cleanCurrentUser(), action, at:new Date().toISOString() });
    const b = (id != null) ? bookings.find(x => x.id === id) : null;
    logActivity(`${action}${b ? " — " + b.haven : ""} (cleaning)`, cleanCurrentUser());
}
// "HH:MM" (24h) -> "h:mm AM/PM"
function time12(t){
    if(!t) return "—";
    const [h, m] = t.split(":").map(Number);
    const ap = h >= 12 ? "PM" : "AM";
    let hr = h % 12; if(hr === 0) hr = 12;
    return hr + ":" + String(m).padStart(2, "0") + " " + ap;
}
function nowFmt(isoStr){
    if(!isoStr) return "—";
    return new Date(isoStr).toLocaleString("en-PH", {
        year:"numeric", month:"short", day:"numeric", hour:"numeric", minute:"2-digit", hour12:true
    });
}

// "Acting as" = housekeeping staff from payroll (falls back to a generic name)
function fillCleanUser(){
    const sel = document.getElementById("cleanUser");
    const label = sel.closest("label");
    let staticEl = label ? label.querySelector(".clean-user-static") : null;

    // non-admins act only as themselves — no dropdown
    if(!payrollIsAdmin()){
        const mine = staff.find(s => payrollOwns(s));   // their own employee record (any role)
        const myName = (mine && mine.name) || currentUser();
        sel.innerHTML = `<option>${myName}</option>`;
        sel.value = myName;
        sel.style.display = "none";
        if(label && !staticEl){
            staticEl = document.createElement("span");
            staticEl.className = "clean-user-static";
            staticEl.style.fontWeight = "600";
            label.appendChild(staticEl);
        }
        if(staticEl) staticEl.textContent = myName;
        return;
    }

    // admin: full dropdown
    sel.style.display = "";
    if(staticEl) staticEl.remove();
    const prev = sel.value;
    const hk = staff.filter(s => s.role === "HOUSEKEEPING").map(s => s.name);
    const names = hk.length ? hk : ["Housekeeper"];
    sel.innerHTML = names.map(n => `<option>${n}</option>`).join("");
    if(names.includes(prev)) sel.value = prev;
}

/* ---------- cleaners date window + floating calendar ---------- */
let cleanStart = today();   // first day shown (Date)
let cleanDays = 7;          // number of days in the window
const CLEAN_MAX_RANGE = 7;
let cleanPickerMonth = today();
let cleanPendingStart = null, cleanHoverIso = null;

function cleanShift(dir){ closeCleanPicker(); cleanStart = addDays(cleanStart, dir * cleanDays); renderCleaners(); }
function cleanShowToday(){ closeCleanPicker(); cleanStart = today(); cleanDays = 1; renderCleaners(); }
function cleanShowWeek(){ closeCleanPicker(); cleanStart = today(); cleanDays = 7; renderCleaners(); }

function openCleanPicker(e){
    if(e) e.stopPropagation();
    const pop = document.getElementById("cleanDpPopup");
    if(pop.classList.contains("show")){ closeCleanPicker(); return; }
    cleanPendingStart = null; cleanHoverIso = null;
    cleanPickerMonth = new Date(cleanStart.getFullYear(), cleanStart.getMonth(), 1);
    renderCleanPicker();
    pop.classList.add("show");
}
function closeCleanPicker(){
    cleanPendingStart = null; cleanHoverIso = null;
    const pop = document.getElementById("cleanDpPopup");
    if(pop) pop.classList.remove("show");
}
function cleanPickerNav(dir){
    cleanPickerMonth = new Date(cleanPickerMonth.getFullYear(), cleanPickerMonth.getMonth() + dir, 1);
    renderCleanPicker();
}
function cleanHighlightRange(){
    if(cleanPendingStart){
        let end = (cleanHoverIso && cleanHoverIso >= cleanPendingStart) ? cleanHoverIso : cleanPendingStart;
        if(daysBetween(cleanPendingStart, end) > CLEAN_MAX_RANGE - 1)
            end = iso(addDays(new Date(cleanPendingStart + "T00:00:00"), CLEAN_MAX_RANGE - 1));
        return { start: cleanPendingStart, end };
    }
    return { start: iso(cleanStart), end: iso(addDays(cleanStart, cleanDays - 1)) };
}
function renderCleanPicker(){
    const y = cleanPickerMonth.getFullYear(), m = cleanPickerMonth.getMonth();
    document.getElementById("cleanDpTitle").textContent = MONTHS[m] + " " + y;
    const startDay = new Date(y, m, 1).getDay();
    const dim = new Date(y, m + 1, 0).getDate();
    const todayIso = iso(today());
    let html = "";
    ["Su","Mo","Tu","We","Th","Fr","Sa"].forEach(d => html += `<div class="dp-wd">${d}</div>`);
    for(let i = 0; i < startDay; i++) html += `<div class="dp-day empty"></div>`;
    for(let d = 1; d <= dim; d++){
        const ci = iso(new Date(y, m, d));
        const cls = "dp-day" + (ci === todayIso ? " today" : "");
        html += `<div class="${cls}" data-iso="${ci}" onclick="pickCleanDay('${ci}')" onmouseover="hoverCleanDay('${ci}')"><span class="n">${d}</span></div>`;
    }
    document.getElementById("cleanDpGrid").innerHTML = html;
    updateCleanHighlight();
}
function updateCleanHighlight(){
    const { start, end } = cleanHighlightRange();
    document.querySelectorAll("#cleanDpGrid .dp-day").forEach(cell => {
        cell.classList.remove("sel","range-start","range-end","in-range");
        const ci = cell.dataset.iso; if(!ci) return;
        if(ci === start && ci === end) cell.classList.add("sel");
        else if(ci === start) cell.classList.add("sel","range-start");
        else if(ci === end) cell.classList.add("sel","range-end");
        else if(ci > start && ci < end) cell.classList.add("in-range");
    });
    document.getElementById("cleanDpHint").textContent = cleanPendingStart
        ? "Now click an end date (max " + CLEAN_MAX_RANGE + " days), or the same day for one day"
        : "Click a date, then an end date for a range (max " + CLEAN_MAX_RANGE + " days)";
}
function pickCleanDay(ci){
    if(!cleanPendingStart){ cleanPendingStart = ci; cleanHoverIso = ci; updateCleanHighlight(); return; }
    if(ci < cleanPendingStart){ cleanPendingStart = ci; updateCleanHighlight(); return; }
    let end = ci;
    if(daysBetween(cleanPendingStart, end) > CLEAN_MAX_RANGE - 1)
        end = iso(addDays(new Date(cleanPendingStart + "T00:00:00"), CLEAN_MAX_RANGE - 1));
    applyCleanRange(cleanPendingStart, end);
}
function hoverCleanDay(ci){ if(!cleanPendingStart) return; cleanHoverIso = ci; updateCleanHighlight(); }
function applyCleanRange(s, e){
    cleanStart = new Date(s + "T00:00:00");
    cleanDays = daysBetween(s, e) + 1;
    closeCleanPicker();
    renderCleaners();
}
function cleanDpToday(){ applyCleanRange(iso(today()), iso(today())); }
function cleanDpClear(){ cleanShowWeek(); }

// close the cleaners picker when clicking outside it
document.addEventListener("click", e => { if(!e.target.closest(".dp-wrap")) closeCleanPicker(); });

/* ---------- housekeeping damage/issue reports ---------- */
let cleanReportId = null;
function openCleanReport(id){
    cleanReportId = id;
    const b = bookings.find(x => x.id === id);
    document.getElementById("cleanReportInfo").textContent = b ? `${b.haven} — ${primaryName(b)}` : "";
    document.getElementById("cleanReportNote").value = "";
    document.getElementById("cleanReportOverlay").classList.add("show");
}
function closeCleanReport(){ cleanReportId = null; document.getElementById("cleanReportOverlay").classList.remove("show"); }
function saveCleanReport(){
    if(cleanReportId == null) return;
    const note = document.getElementById("cleanReportNote").value.trim();
    if(!note){ alert("Please describe the issue."); return; }
    const log = cleanLog(cleanReportId);
    log.reports = log.reports || [];
    log.reports.push({ note, user: cleanCurrentUser(), at: new Date().toISOString() });
    cleanAddHistory(log, "Reported an issue: " + note, cleanReportId);
    persistCleaning();
    closeCleanReport();
    renderCleaners();
}

function cleanCardHtml(b){
    const log = cleaning[b.id] || {};
    const started = log.startedAt, done = log.doneAt;
    const photos = log.photos || {};
    const statusCls = done ? "paid" : started ? "partial" : "unpaid";
    const statusTxt = done ? "Done" : started ? "In progress" : "Not started";

    const towelsBanner = (Number(b.towels) > 0)
        ? `<div class="clean-towels">🧺 Retrieve ${b.towels} towel${b.towels > 1 ? "s" : ""} from this haven</div>`
        : `<div class="clean-towels none">No towels to retrieve</div>`;

    const photoSlots = PHOTO_ROOMS.map(([key, label]) => {
        const src = photos[key];
        return `<div class="photo-slot">
            <div class="photo-label">${label}</div>
            ${src
                ? `<a href="${src}" target="_blank"><img src="${src}" class="photo-thumb" alt="${label}"></a>`
                : `<div class="photo-empty">No photo</div>`}
            <label class="photo-btn">${src ? "Replace" : "Add photo"}
                <input type="file" accept="image/*" capture="environment" onchange="cleanPhoto(${b.id}, '${key}', this)">
            </label>
            ${src ? `<span class="photo-remove" onclick="cleanRemovePhoto(${b.id}, '${key}')">Remove</span>` : ""}
        </div>`;
    }).join("");

    const hist = (log.history || []).slice().reverse();
    const histHtml = hist.length
        ? `<details class="clean-log"><summary>Activity log (${hist.length})</summary><ul>` +
            hist.map(h => `<li><b>${h.user}</b> — ${h.action} — <span class="muted">${nowFmt(h.at)}</span></li>`).join("") +
          `</ul></details>`
        : `<div class="muted" style="font-size:12px;">No activity yet.</div>`;

    const reports = (log.reports || []).slice().reverse();
    const reportsHtml = reports.length
        ? `<div class="clean-reports"><b>⚠ Damage / issue reports</b>` +
            reports.map(r => `<div class="clean-report-item">${escHtml(r.note)} <span class="muted">— ${r.user} · ${nowFmt(r.at)}</span></div>`).join("") +
          `</div>`
        : "";

    const dot = (HAVEN_COLORS[b.haven] || { am:"#ccc" }).am;

    return `<div class="clean-card" id="clean-card-${b.id}">
        <div class="clean-head">
            <div>
                <div class="clean-haven"><span class="dot" style="background:${dot}"></span>${b.haven}</div>
                <div class="muted">${primaryName(b)}</div>
            </div>
            <span class="clean-status-wrap"><span class="ci-label" style="margin-right:6px;">Status:</span><span class="status ${statusCls}">${statusTxt}</span></span>
        </div>
        <div class="clean-info">
            <div><span class="ci-label">Check-in</span><b>${fmt(b.checkin)} · ${checkinTimeStr(b)}</b></div>
            <div><span class="ci-label">Check-out</span><b>${fmt(b.checkout)} · ${checkoutTimeStr(b)}</b></div>
            <div><span class="ci-label">Stay</span><b>${b.stayHours ? b.stayHours + "h" : "—"}</b></div>
        </div>
        ${towelsBanner}
        <div class="clean-photos-title">Room photos <span class="muted">— attach at least these 5</span></div>
        <div class="clean-photos">${photoSlots}</div>
        <div class="clean-actions">
            <button class="btn" onclick="cleanBegin(${b.id})" ${started ? "disabled" : ""}>START</button>
            <button class="btn" onclick="cleanDone(${b.id})" ${(!started || done) ? "disabled" : ""}>DONE</button>
            <button class="btn-report" onclick="openCleanReport(${b.id})">⚠ Report</button>
            ${started ? `<span class="muted">Started: ${nowFmt(started)} <span class="edit" onclick="cleanUndoStart(${b.id})">Undo</span></span>` : ""}
            ${done ? `<span class="muted">Done: ${nowFmt(done)} <span class="edit" onclick="cleanUndoDone(${b.id})">Undo</span></span>` : ""}
        </div>
        ${reportsHtml}
        ${histHtml}
    </div>`;
}

function renderCleaners(){
    fillCleanUser();
    const start = iso(cleanStart);
    const end = iso(addDays(cleanStart, cleanDays));   // exclusive
    const lastDay = fmt(iso(addDays(cleanStart, cleanDays - 1)));
    const label = cleanDays === 1 ? fmt(start) : fmt(start) + " – " + lastDay;
    document.getElementById("cleanRangeLabel").textContent = label;
    document.getElementById("cleanScopeLabel").textContent = "— " + label;

    // a turnover task = a booking whose check-out falls in the window
    const tasks = bookings
        .filter(b => b.checkout >= start && b.checkout < end)
        .sort((a, b) => (a.checkout || "").localeCompare(b.checkout || "") || a.haven.localeCompare(b.haven));

    const container = document.getElementById("cleanContainer");
    container.innerHTML = tasks.length
        ? tasks.map(cleanCardHtml).join("")
        : `<div class="panel"><p class="empty">🧹 No turnovers to clean for this period.</p></div>`;

    // turnover summary table (havens, check-in/out, what to retrieve)
    const scopeEl = document.getElementById("cleanSummaryScope");
    if(scopeEl) scopeEl.textContent = "— " + label;
    const sumBody = document.getElementById("cleanSummaryBody");
    if(sumBody){
        const stFilter = (document.getElementById("cleanStatusFilter") || {}).value || "";
        const sumRows = tasks.filter(b => {
            const lg = cleaning[b.id] || {};
            const cls = lg.doneAt ? "paid" : lg.startedAt ? "partial" : "unpaid";
            return !stFilter || cls === stFilter;
        });
        sumBody.innerHTML = sumRows.length ? sumRows.map(b => {
            const log = cleaning[b.id] || {};
            const stTxt = log.doneAt ? "Done" : log.startedAt ? "In progress" : "Not started";
            const stCls = log.doneAt ? "paid" : log.startedAt ? "partial" : "unpaid";
            const retrieve = (Number(b.towels) > 0)
                ? `🧺 ${b.towels} towel${b.towels > 1 ? "s" : ""}`
                : `<span class="muted">—</span>`;
            const dot = (HAVEN_COLORS[b.haven] || { am:"#ccc" }).am;
            return `<tr>
                <td><span class="dot" style="background:${dot}"></span><a class="haven-link" onclick="scrollToCleanCard(${b.id})">${b.haven}</a></td>
                <td>${checkinTimeStr(b)}</td>
                <td>${checkoutTimeStr(b)}</td>
                <td>${retrieve}</td>
                <td><span class="status ${stCls}">${stTxt}</span></td>
            </tr>`;
        }).join("") : `<tr><td colspan="5" class="empty">No turnovers match this status.</td></tr>`;
    }
}
// scroll to (and briefly highlight) a haven's cleaning card from the summary table
function scrollToCleanCard(id){
    const el = document.getElementById("clean-card-" + id);
    if(!el) return;
    el.scrollIntoView({ behavior: "smooth", block: "center" });
    el.classList.add("clean-card-flash");
    setTimeout(() => el.classList.remove("clean-card-flash"), 1500);
}

// downscale before saving so localStorage doesn't overflow
function resizeImage(file, cb){
    const reader = new FileReader();
    reader.onload = e => {
        const img = new Image();
        img.onload = () => {
            const max = 1000;
            let w = img.width, h = img.height;
            if(w > max || h > max){ const r = Math.min(max / w, max / h); w = Math.round(w * r); h = Math.round(h * r); }
            const canvas = document.createElement("canvas");
            canvas.width = w; canvas.height = h;
            canvas.getContext("2d").drawImage(img, 0, 0, w, h);
            cb(canvas.toDataURL("image/jpeg", 0.7));
        };
        img.src = e.target.result;
    };
    reader.readAsDataURL(file);
}

function cleanBegin(id){
    const log = cleanLog(id);
    log.startedAt = new Date().toISOString();
    if(log.doneAt && log.doneAt < log.startedAt) log.doneAt = null;
    cleanAddHistory(log, "Started cleaning", id);
    persistCleaning(); renderCleaners();
}
function cleanDone(id){
    const log = cleanLog(id);
    if(!log.startedAt){ alert("Please tap START first."); return; }
    const photos = log.photos || {};
    const missing = PHOTO_ROOMS.filter(([k]) => !photos[k]);
    if(missing.length){
        alert("Please attach all room photos before marking DONE:\n• " + missing.map(([, label]) => label).join("\n• "));
        return;
    }
    log.doneAt = new Date().toISOString();
    log.doneBy = cleanCurrentUser();   // who finished it → drives housekeeping payroll
    cleanAddHistory(log, "Marked done", id);
    persistCleaning(); renderCleaners();
}
// admin can revert an accidental START / DONE
function cleanUndoStart(id){
    if(!confirm("Undo START? This clears the start (and done) time for this task.")) return;
    const log = cleanLog(id);
    log.startedAt = null;
    log.doneAt = null;
    log.doneBy = null;
    cleanAddHistory(log, "Undid start", id);
    persistCleaning(); renderCleaners();
}
function cleanUndoDone(id){
    if(!confirm("Undo DONE? This marks the task back to in progress.")) return;
    const log = cleanLog(id);
    log.doneAt = null;
    log.doneBy = null;   // no longer counts toward payroll
    cleanAddHistory(log, "Undid done", id);
    persistCleaning(); renderCleaners();
}
function cleanPhoto(id, key, input){
    const file = input.files && input.files[0];
    if(!file) return;
    resizeImage(file, dataUrl => {
        const log = cleanLog(id);
        log.photos = log.photos || {};
        const existed = !!log.photos[key];
        log.photos[key] = dataUrl;
        cleanAddHistory(log, (existed ? "Replaced" : "Added") + " " + key + " photo", id);
        persistCleaning(); renderCleaners();
    });
}
function cleanRemovePhoto(id, key){
    const log = cleanLog(id);
    if(!log.photos || !log.photos[key]) return;
    if(!confirm("Remove this photo?")) return;
    delete log.photos[key];
    cleanAddHistory(log, "Removed " + key + " photo", id);
    persistCleaning(); renderCleaners();
}

renderCleaners();

/* ---------- haven listings manager (website content) ---------- */
let listings = loadHavens();

function escAttr(s){ return String(s).replace(/"/g, "&quot;"); }
function escHtml(s){ return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;"); }

/* show-per-page filter + pagination */
let listingPageSize = 9;   // 1, 2, 3, or 9 (View all)
let listingPage = 0;

function listingTotalPages(){ return Math.max(1, Math.ceil(listings.length / listingPageSize)); }

function setListingPageSize(size){
    collectListings();
    listingPageSize = size;
    listingPage = 0;
    renderListings();
}

function gotoListingPage(delta){
    collectListings();
    const pages = listingTotalPages();
    listingPage = Math.min(pages - 1, Math.max(0, listingPage + delta));
    renderListings();
}

function renderListingPager(){
    const pager = document.getElementById("listingPager");
    if(listings.length <= listingPageSize){ pager.innerHTML = ""; return; }
    const pages = listingTotalPages();
    pager.innerHTML =
        `<button class="btn secondary" onclick="gotoListingPage(-1)" ${listingPage === 0 ? "disabled" : ""}>‹ Prev</button>` +
        `<span class="muted">Page ${listingPage + 1} of ${pages}</span>` +
        `<button class="btn secondary" onclick="gotoListingPage(1)" ${listingPage >= pages - 1 ? "disabled" : ""}>Next ›</button>`;
}

function renderListings(){
    const pages = listingTotalPages();
    listingPage = Math.min(Math.max(0, listingPage), pages - 1);
    const start = listingPage * listingPageSize;
    const end = Math.min(start + listingPageSize, listings.length);

    let html = "";
    for(let i = start; i < end; i++){
        const h = listings[i];
        const gallery = h.gallery || [];
        const galleryInputs = gallery.map(galleryRowHtml).join("");
        html += `
        <div class="listing-card" data-index="${i}"
             ondragover="onDragOver(event)" ondragenter="onDragEnter(event)"
             ondragleave="onDragLeave(event)" ondrop="onDrop(event, ${i})">
            <div class="drag-handle" draggable="true" ondragstart="onDragStart(event, ${i})" ondragend="onDragEnd(event)">⠿ Drag to reorder</div>
            <img src="${escAttr(h.image)}" alt="preview" onerror="this.style.opacity=.25">
            <label>Name
                <input type="text" data-field="name" value="${escAttr(h.name)}">
            </label>
            <label>Main image URL
                <input type="text" data-field="image" value="${escAttr(h.image)}"
                       oninput="previewListing(${i}, this.value)">
            </label>
            <label>Photos</label>
            <div class="gallery-list">${galleryInputs}</div>
            <button type="button" class="btn secondary add-photo-btn" onclick="addPhotoInput(this)">+ Add photo</button>
            <label>Price
                <input type="text" data-field="price" value="${escAttr(h.price)}">
            </label>
            <label>Description
                <textarea data-field="description" rows="2">${escHtml(h.description)}</textarea>
            </label>
            <label>Amenities (separate with commas)
                <textarea data-field="amenities" rows="2">${escHtml(h.amenities.join(", "))}</textarea>
            </label>
            <button class="btn save-one-btn" onclick="saveOneListing(${i})">💾 Save this haven</button>
            <button class="delete-btn" onclick="deleteListing(${i})">🗑 Delete this haven</button>
        </div>`;
    }
    document.getElementById("listingList").innerHTML = html;
    renderListingPager();
}

function previewListing(i, url){
    const img = document.querySelector(`.listing-card[data-index="${i}"] img`);
    if(img){ img.src = url; img.style.opacity = 1; }
}

// one photo-URL row (used both on render and when adding a new one)
function galleryRowHtml(url){
    return `<div class="gallery-row">
        <input type="text" data-gallery placeholder="Photo URL" value="${escAttr(url || "")}">
        <button type="button" class="gallery-del" onclick="this.closest('.gallery-row').remove()" title="Remove">×</button>
    </div>`;
}
function addPhotoInput(btn){
    const list = btn.parentNode.querySelector(".gallery-list");
    list.insertAdjacentHTML("beforeend", galleryRowHtml(""));
    list.lastElementChild.querySelector("input").focus();
}

/* ---------- drag to reorder havens ---------- */
let dragSrcIndex = null;
function onDragStart(e, i){
    dragSrcIndex = i;
    e.dataTransfer.effectAllowed = "move";
    e.dataTransfer.setData("text/plain", String(i)); // Firefox needs data set
}
function onDragEnd(){
    dragSrcIndex = null;
    document.querySelectorAll(".listing-card.drag-over").forEach(c => c.classList.remove("drag-over"));
}
function onDragOver(e){ e.preventDefault(); e.dataTransfer.dropEffect = "move"; }
function onDragEnter(e){ if(dragSrcIndex !== null) e.currentTarget.classList.add("drag-over"); }
function onDragLeave(e){ e.currentTarget.classList.remove("drag-over"); }
function onDrop(e, targetIndex){
    e.preventDefault();
    e.currentTarget.classList.remove("drag-over");
    if(dragSrcIndex === null || dragSrcIndex === targetIndex) return;
    collectListings();                                  // keep any edits before reordering
    const moved = listings.splice(dragSrcIndex, 1)[0];
    listings.splice(targetIndex, 0, moved);
    dragSrcIndex = null;
    renderListings();
    saveHavens(listings);                               // persist the new order
}

// read inputs back into the listings array
function collectListings(){
    document.querySelectorAll(".listing-card").forEach(card => {
        const i = Number(card.dataset.index);
        const get = f => card.querySelector(`[data-field="${f}"]`).value;
        const gallery = Array.from(card.querySelectorAll("[data-gallery]"))
            .map(el => el.value.trim()).filter(Boolean);
        listings[i] = {
            id: listings[i].id,
            name: get("name"),
            image: get("image"),
            gallery: gallery,
            price: get("price"),
            description: get("description"),
            amenities: get("amenities").split(",").map(a => a.trim()).filter(Boolean)
        };
    });
}

function saveListings(){
    collectListings();
    saveHavens(listings);
    alert("Listings saved! They now show on the Home page and haven detail pages.");
}

// save just one haven's card
function saveOneListing(i){
    collectListings();
    saveHavens(listings);
    logActivity(`edited haven listing — ${listings[i].name}`);
    alert(`"${listings[i].name}" saved! It now shows on the website.`);
}

function addListing(){
    collectListings();
    const nextId = listings.reduce((m, h) => Math.max(m, h.id), 0) + 1;
    listings.push({
        id: nextId,
        name: "New Haven",
        image: "https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?w=1200",
        gallery: [],
        price: "₱0 / night",
        description: "Describe this haven...",
        amenities: ["📶 Fast WiFi"]
    });
    listingPage = listingTotalPages() - 1;   // jump to the page with the new haven
    renderListings();
}

function deleteListing(i){
    if(!confirm("Delete this haven listing?")) return;
    collectListings();
    const name = listings[i] ? listings[i].name : "";
    listings.splice(i, 1);
    logActivity(`deleted haven listing — ${name}`);
    renderListings();
}

function resetListings(){
    if(!confirm("Reset listings back to the original defaults? Your edits will be lost.")) return;
    resetHavens();
    listings = loadHavens();
    renderListings();
}

renderListings();

/* ---------- website booking rates & payment settings ---------- */
function setVal(id, v){ const el = document.getElementById(id); if(el) el.value = v; }
function getNum(id){ return Number(document.getElementById(id).value) || 0; }
function getStr(id){ return document.getElementById(id).value; }

function fillBookingSettings(){
    const s = loadSettings();
    const p = s.pricing;
    setVal("s_stay6", p.stay6);
    setVal("s_stay10", p.stay10);
    setVal("s_stay21Weekday", p.stay21Weekday);
    setVal("s_stay21Weekend", p.stay21Weekend);
    setVal("s_longWeekday", p.longWeekday);
    setVal("s_longWeekend", p.longWeekend);
    setVal("s_holidayNight", p.holidayNight);
    setVal("s_holidayDayUse", p.holidayDayUse);
    setVal("s_deposit", p.deposit);
    setVal("s_includedPax", p.includedPax);
    setVal("s_addPax", p.addPax);
    setVal("s_maxDays", p.maxDays);
    setVal("s_poolRegular", p.poolRegular);
    setVal("s_poolHoliday", p.poolHoliday);
    setVal("s_extraHour", p.extraHour);
    setVal("s_towelRate", p.towelRate);
    setVal("s_towelMaxPerPax", p.towelMaxPerPax);
    setVal("s_dp0", s.downpayment[0].amount);
    setVal("s_dp1", s.downpayment[1].amount);
    setVal("s_dp2", s.downpayment[2].amount);
    setVal("s_dp3", s.downpayment[3].amount);

    document.getElementById("s_offer6").checked  = p.offer6  !== false;
    document.getElementById("s_offer10").checked = p.offer10 !== false;
    document.getElementById("s_offer21").checked = p.offer21 !== false;

    customAddons = (s.customAddons || []).map(a => ({ name:a.name, price:Number(a.price)||0, perPax: !!a.perPax }));
    renderCustomAddons();

    promos = (s.promos || []).map(p => ({
        title: p.title || "", desc: p.desc || "",
        discount: Number(p.discount) || 0, type: p.type === "amount" ? "amount" : "percent",
        code: p.code || "", active: p.active !== false
    }));
    renderPromos();
}

/* ---------- custom add-ons editor ---------- */
let customAddons = [];

function renderCustomAddons(){
    document.getElementById("customAddonList").innerHTML = customAddons.map((a, i) => `
        <div class="addon-edit-row" data-ai="${i}">
            <input type="text" data-af="name" placeholder="Add-on name" value="${escAttr(a.name || "")}">
            <input type="number" data-af="price" placeholder="₱ price" value="${a.price || 0}">
            <label class="opt-check"><input type="checkbox" data-af="perPax" ${a.perPax ? "checked" : ""}> per pax</label>
            <button type="button" class="addon-del" onclick="deleteCustomAddon(${i})">🗑</button>
        </div>`).join("");
}

function collectCustomAddons(){
    customAddons = Array.from(document.querySelectorAll(".addon-edit-row")).map(row => ({
        name: row.querySelector('[data-af="name"]').value.trim(),
        price: Number(row.querySelector('[data-af="price"]').value) || 0,
        perPax: row.querySelector('[data-af="perPax"]').checked
    })).filter(a => a.name);
}

function addCustomAddon(){
    collectCustomAddons();
    customAddons.push({ name: "", price: 0, perPax: false });
    renderCustomAddons();
}

function deleteCustomAddon(i){
    collectCustomAddons();
    customAddons.splice(i, 1);
    renderCustomAddons();
}

/* ---------- promos editor ---------- */
let promos = [];

function renderPromos(){
    const list = document.getElementById("promoList");
    if(!list) return;
    list.innerHTML = promos.map((p, i) => `
        <div class="promo-edit-row" data-pi="${i}" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:8px;">
            <input type="text" data-pf="title" placeholder="Promo title" value="${escAttr(p.title || "")}" style="flex:1 1 160px;">
            <input type="text" data-pf="desc" placeholder="Short description" value="${escAttr(p.desc || "")}" style="flex:2 1 220px;">
            <input type="number" data-pf="discount" placeholder="0" value="${p.discount || 0}" style="width:90px;">
            <select data-pf="type" style="width:90px;">
                <option value="percent" ${p.type !== "amount" ? "selected" : ""}>% off</option>
                <option value="amount" ${p.type === "amount" ? "selected" : ""}>₱ off</option>
            </select>
            <input type="text" data-pf="code" placeholder="CODE (optional)" value="${escAttr(p.code || "")}" style="width:140px;">
            <label class="opt-check"><input type="checkbox" data-pf="active" ${p.active !== false ? "checked" : ""}> active</label>
            <button type="button" class="addon-del" onclick="deletePromo(${i})">🗑</button>
        </div>`).join("");
}

function collectPromos(){
    promos = Array.from(document.querySelectorAll(".promo-edit-row")).map(row => ({
        title: row.querySelector('[data-pf="title"]').value.trim(),
        desc: row.querySelector('[data-pf="desc"]').value.trim(),
        discount: Number(row.querySelector('[data-pf="discount"]').value) || 0,
        type: row.querySelector('[data-pf="type"]').value,
        code: row.querySelector('[data-pf="code"]').value.trim(),
        active: row.querySelector('[data-pf="active"]').checked
    })).filter(p => p.title);
}

function addPromo(){
    collectPromos();
    promos.push({ title: "", desc: "", discount: 0, type: "percent", code: "", active: true });
    renderPromos();
}

function deletePromo(i){
    collectPromos();
    promos.splice(i, 1);
    renderPromos();
}

function saveBookingSettings(){
    const s = loadSettings();
    collectCustomAddons();
    Object.assign(s.pricing, {
        stay6: getNum("s_stay6"),
        stay10: getNum("s_stay10"),
        stay21Weekday: getNum("s_stay21Weekday"),
        stay21Weekend: getNum("s_stay21Weekend"),
        longWeekday: getNum("s_longWeekday"),
        longWeekend: getNum("s_longWeekend"),
        holidayNight: getNum("s_holidayNight"),
        holidayDayUse: getNum("s_holidayDayUse"),
        deposit: getNum("s_deposit"),
        includedPax: getNum("s_includedPax"),
        addPax: getNum("s_addPax"),
        maxDays: getNum("s_maxDays"),
        poolRegular: getNum("s_poolRegular"),
        poolHoliday: getNum("s_poolHoliday"),
        extraHour: getNum("s_extraHour"),
        towelRate: getNum("s_towelRate"),
        towelMaxPerPax: getNum("s_towelMaxPerPax"),
        offer6: document.getElementById("s_offer6").checked,
        offer10: document.getElementById("s_offer10").checked,
        offer21: document.getElementById("s_offer21").checked
    });
    s.downpayment[0].amount = getNum("s_dp0");
    s.downpayment[1].amount = getNum("s_dp1");
    s.downpayment[2].amount = getNum("s_dp2");
    s.downpayment[3].amount = getNum("s_dp3");
    s.customAddons = customAddons;
    collectPromos();
    s.promos = promos;
    saveSettings(s);
    alert("Saved! Rates, add-ons and promos now apply to the website.");
}

function resetBookingSettings(){
    if(!confirm("Reset booking rates to the original defaults?")) return;
    const s = loadSettings();
    const d = JSON.parse(JSON.stringify(DEFAULT_SETTINGS));
    s.pricing = d.pricing;
    s.downpayment = d.downpayment;
    s.customAddons = d.customAddons;
    s.promos = d.promos || [];
    saveSettings(s);
    fillBookingSettings();
}

let paymentMethods = [];   // working copy of the editable methods

function renderMethods(){
    document.getElementById("methodList").innerHTML = paymentMethods.map((m, i) => `
        <div class="method-card" data-mi="${i}">
            <div class="settings-form">
                <label>Method name<input type="text" data-mf="name" value="${escAttr(m.name || "")}"></label>
                <label>Number / account no.<input type="text" data-mf="number" value="${escAttr(m.number || "")}"></label>
                <label>Account name<input type="text" data-mf="account" value="${escAttr(m.account || "")}"></label>
            </div>
            <div class="method-qr">
                <span class="muted">QR code (optional)</span>
                <img class="qr-preview" id="mqr_${i}" alt="" src="${escAttr(m.qr || "")}" style="display:${m.qr ? "block" : "none"};">
                <input type="file" accept="image/*" onchange="onMethodQrUpload(${i}, this)">
                <button type="button" class="btn secondary" id="mqrrm_${i}" onclick="removeMethodQr(${i})" style="display:${m.qr ? "inline-block" : "none"}; margin-top:8px; padding:7px 12px; font-size:12px;">Remove QR</button>
            </div>
            <button type="button" class="delete-btn" onclick="deleteMethod(${i})">🗑 Remove this method</button>
        </div>
    `).join("");
}

function collectMethods(){
    document.querySelectorAll(".method-card").forEach(card => {
        const i = Number(card.dataset.mi);
        const get = f => card.querySelector(`[data-mf="${f}"]`).value;
        paymentMethods[i] = {
            name: get("name"),
            number: get("number"),
            account: get("account"),
            qr: paymentMethods[i].qr || ""
        };
    });
}

function onMethodQrUpload(i, input){
    const file = input.files[0];
    if(!file) return;
    const reader = new FileReader();
    reader.onload = e => {
        paymentMethods[i].qr = e.target.result;
        const img = document.getElementById("mqr_" + i);
        img.src = e.target.result;
        img.style.display = "block";
        document.getElementById("mqrrm_" + i).style.display = "inline-block";
    };
    reader.readAsDataURL(file);
}

function removeMethodQr(i){
    paymentMethods[i].qr = "";
    const img = document.getElementById("mqr_" + i);
    img.removeAttribute("src");
    img.style.display = "none";
    document.getElementById("mqrrm_" + i).style.display = "none";
}

function addMethod(){
    collectMethods();
    paymentMethods.push({ name: "New method", number: "", account: "", qr: "" });
    renderMethods();
}

function deleteMethod(i){
    if(!confirm("Remove this payment method?")) return;
    collectMethods();
    paymentMethods.splice(i, 1);
    renderMethods();
}

function fillPaymentSettings(){
    const p = loadSettings().payment;
    setVal("p_intro", p.intro);
    setVal("p_screenshot", p.screenshotNote);
    setVal("p_warn", p.warnNote);
    setVal("p_cash", p.cashNote);
    paymentMethods = (p.methods || []).map(m => ({ name:m.name, number:m.number, account:m.account, qr:m.qr || "" }));
    renderMethods();
}

function savePaymentSettings(){
    collectMethods();
    const s = loadSettings();
    Object.assign(s.payment, {
        intro: getStr("p_intro"),
        screenshotNote: getStr("p_screenshot"),
        warnNote: getStr("p_warn"),
        cashNote: getStr("p_cash"),
        methods: paymentMethods
    });
    saveSettings(s);
    alert("Payment details saved! They now show on the website payment page.");
}

function resetPaymentSettings(){
    if(!confirm("Reset payment details to the original defaults?")) return;
    const s = loadSettings();
    s.payment = JSON.parse(JSON.stringify(DEFAULT_SETTINGS.payment));
    saveSettings(s);
    fillPaymentSettings();
}

fillBookingSettings();
fillPaymentSettings();

/* ---------- users & access control ---------- */
const USERS_KEY = "shph_users";
const DASH_PAGES = [
    { key:"today",     label:"Today's Booking" },
    { key:"finance",   label:"Finance" },
    { key:"analytics", label:"Analytics" },
    { key:"calendar",  label:"Calendar/Bookings" },
    { key:"havens",    label:"Havens" },
    { key:"booking",   label:"Rates and Add Ons" },
    { key:"payments",  label:"Payments" },
    { key:"cleaners",  label:"Housekeeping" },
    { key:"employees", label:"Employees" },
    { key:"log",       label:"Activity Log" },
    { key:"payroll",   label:"Payroll" },
    { key:"bills",     label:"Bills" },
    { key:"assist",    label:"Assist" }
];
function pageLabel(key){ const p = DASH_PAGES.find(x => x.key === key); return p ? p.label : key; }
function loadUsers(){
    const raw = localStorage.getItem(USERS_KEY);
    if(raw){ try { return JSON.parse(raw); } catch(e){} }
    const seed = [{ id:1, name:"admin", password:"1234", admin:true, perms: DASH_PAGES.map(p => p.key) }];
    localStorage.setItem(USERS_KEY, JSON.stringify(seed));
    return seed;
}
let users = loadUsers();
function persistUsers(){ localStorage.setItem(USERS_KEY, JSON.stringify(users)); }

function currentUserObj(){
    const name = currentUser();
    return users.find(u => (u.name || "").toLowerCase() === name.toLowerCase()) || null;
}
function isAdminUser(){ const u = currentUserObj(); return u ? !!u.admin : true; }   // unknown user (direct access) = full access
function currentPerms(){
    const u = currentUserObj();
    if(!u) return DASH_PAGES.map(p => p.key);
    if(u.admin) return DASH_PAGES.map(p => p.key);
    return u.perms || [];
}
function pageAllowed(page){
    if(page === "users") return isAdminUser();
    return currentPerms().includes(page);
}
// hide nav items the current user can't access; redirect off a disallowed page
function applyPermissions(){
    const perms = currentPerms();
    const admin = isAdminUser();
    document.querySelectorAll(".sidebar .nav-item").forEach(n => {
        const pg = n.dataset.page;
        const ok = (pg === "users") ? admin : perms.includes(pg);
        n.style.display = ok ? "flex" : "none";
    });
    document.querySelector(".sidebar").classList.remove("perms-pending");  // reveal now that it's filtered
    const ab = document.getElementById("addBookingBtn");
    if(ab) ab.style.display = canAddBooking() ? "" : "none";   // only admin/CSR can add bookings
    const active = document.querySelector(".sidebar .nav-item.active");
    if(!active || active.style.display === "none"){
        const first = [...document.querySelectorAll(".sidebar .nav-item")].find(n => n.style.display !== "none");
        if(first) showPage(first.dataset.page);
    }
}

function renderUsers(){
    const el = document.getElementById("usersList");
    if(!el) return;
    el.innerHTML = users.map(u => {
        const access = u.admin ? "All pages + Users (administrator)"
            : ((u.perms && u.perms.length) ? u.perms.map(pageLabel).join(", ") : "No pages");
        return `<div class="pay-staff">
            <div class="pay-staff-head">
                <div>
                    <div class="pay-name">${escHtml(u.name)} ${u.admin ? '<span class="tag yes">admin</span>' : ''}</div>
                    <div class="muted">${access}</div>
                </div>
                <div class="pay-staff-actions">
                    <span class="edit" onclick="openUserModal(${u.id})">Edit</span>
                    <span class="del" onclick="deleteUser(${u.id})">Delete</span>
                </div>
            </div>
        </div>`;
    }).join("");
}
function fillUserPerms(selected){
    document.getElementById("u_perms").innerHTML = `<div class="opt-row">` + DASH_PAGES.map(p =>
        `<label class="opt-check"><input type="checkbox" class="u-perm" value="${p.key}" ${selected.includes(p.key) ? "checked" : ""}> ${p.label}</label>`
    ).join("") + `</div>`;
}
function toggleUserAdmin(){
    const admin = document.getElementById("u_admin").checked;
    document.querySelectorAll(".u-perm").forEach(c => { c.disabled = admin; if(admin) c.checked = true; });
}
let editingUserId = null;
function openUserModal(id){
    editingUserId = id || null;
    const g = i => document.getElementById(i);
    if(editingUserId){
        const u = users.find(x => x.id === editingUserId);
        if(!u) return;
        g("userModalTitle").textContent = "Edit User";
        g("u_name").value = u.name;
        g("u_pass").value = u.password || "";
        g("u_admin").checked = !!u.admin;
        fillUserPerms(u.perms || []);
    } else {
        g("userModalTitle").textContent = "Add User";
        g("u_name").value = "";
        g("u_pass").value = "";
        g("u_admin").checked = false;
        fillUserPerms([]);
    }
    toggleUserAdmin();
    g("userOverlay").classList.add("show");
}
function closeUserModal(){ editingUserId = null; document.getElementById("userOverlay").classList.remove("show"); }
function saveUser(){
    const g = i => document.getElementById(i);
    const name = g("u_name").value.trim();
    if(!name){ alert("Please enter a username."); return; }
    const password = g("u_pass").value;
    if(!password){ alert("Please enter a password."); return; }
    if(users.some(u => (u.name || "").toLowerCase() === name.toLowerCase() && u.id !== editingUserId)){
        alert("That username already exists."); return;
    }
    const admin = g("u_admin").checked;
    const perms = admin ? DASH_PAGES.map(p => p.key) : [...document.querySelectorAll(".u-perm:checked")].map(c => c.value);
    if(editingUserId){
        const idx = users.findIndex(u => u.id === editingUserId);
        users[idx] = { ...users[idx], name, password, admin, perms };
        logActivity(`edited user — ${name}`);
    } else {
        const id = users.length ? Math.max(...users.map(u => u.id)) + 1 : 1;
        users.push({ id, name, password, admin, perms });
        logActivity(`added user — ${name}`);
    }
    persistUsers(); closeUserModal(); renderUsers(); applyPermissions();
}
function deleteUser(id){
    const u = users.find(x => x.id === id);
    if(u && u.admin && users.filter(x => x.admin).length <= 1){ alert("You can't delete the last administrator."); return; }
    if(!confirm("Delete this user?")) return;
    if(u) logActivity(`deleted user — ${u.name}`);
    users = users.filter(x => x.id !== id);
    persistUsers(); renderUsers(); applyPermissions();
}

renderUsers();
applyPermissions();
document.getElementById("currentUserLabel").textContent = "Logged in as " + currentUser();

// reopen the last page the admin was on (instead of resetting to Finance)
const savedPage = localStorage.getItem("shph_dashboard_page");
if(savedPage && document.getElementById("page-" + savedPage)) showPage(savedPage);
applyPermissions();
</script>

