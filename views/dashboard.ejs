function cleanCardHtml(b){
    const log = cleaning[b.id] || {};
    const started = log.startedAt, done = log.doneAt;
    const photos = log.photos || {};
    const statusCls = done ? "paid" : started ? "partial" : "unpaid";
    const statusTxt = done ? "Done" : started ? "In progress" : "Not started";

    const towelsBanner = (Number(b.towels) > 0)
        ? `<div class="clean-towels">🧺 Retrieve ${b.towels} towel${b.towels > 1 ? "s" : ""} from this haven</div>`
        : `<div class="clean-towels none">No towels to retrieve</div>`;

    const photoSlots = PHOTO_ROOMS.map(([key, label]) => {
        const src = photos[key];
        return `<div class="photo-slot">
            <div class="photo-label">${label}</div>
            ${src
                ? `<a href="${src}" target="_blank"><img src="${src}" class="photo-thumb" alt="${label}"></a>`
                : `<div class="photo-empty">No photo</div>`}
            <label class="photo-btn">${src ? "Replace" : "Add photo"}
                <input type="file" accept="image/*" capture="environment" onchange="cleanPhoto(${b.id}, '${key}', this)">
            </label>
            ${src ? `<span class="photo-remove" onclick="cleanRemovePhoto(${b.id}, '${key}')">Remove</span>` : ""}
        </div>`;
    }).join("");

    const hist = (log.history || []).slice().reverse();
    const histHtml = hist.length
        ? `<details class="clean-log"><summary>Activity log (${hist.length})</summary><ul>` +
            hist.map(h => `<li><b>${h.user}</b> — ${h.action} — <span class="muted">${nowFmt(h.at)}</span></li>`).join("") +
          `</ul></details>`
        : `<div class="muted" style="font-size:12px;">No activity yet.</div>`;

    const reports = (log.reports || []).slice().reverse();
    const reportsHtml = reports.length
        ? `<div class="clean-reports"><b>⚠ Damage / issue reports</b>` +
            reports.map(r => `<div class="clean-report-item">${escHtml(r.note)} <span class="muted">— ${r.user} · ${nowFmt(r.at)}</span></div>`).join("") +
          `</div>`
        : "";

    const dot = (HAVEN_COLORS[b.haven] || { am:"#ccc" }).am;

    return `<div class="clean-card" id="clean-card-${b.id}">
        <div class="clean-head">
            <div>
                <div class="clean-haven"><span class="dot" style="background:${dot}"></span>${b.haven}</div>
                <div class="muted">${primaryName(b)}</div>
            </div>
            <span class="clean-status-wrap"><span class="ci-label" style="margin-right:6px;">Status:</span><span class="status ${statusCls}">${statusTxt}</span></span>
        </div>
        <div class="clean-info">
            <div><span class="ci-label">Check-in</span><b>${fmt(b.checkin)} · ${checkinTimeStr(b)}</b></div>
            <div><span class="ci-label">Check-out</span><b>${fmt(b.checkout)} · ${checkoutTimeStr(b)}</b></div>
            <div><span class="ci-label">Stay</span><b>${b.stayHours ? b.stayHours + "h" : "—"}</b></div>
        </div>
        ${towelsBanner}
        <div class="clean-photos-title">Room photos <span class="muted">— attach at least these 5</span></div>
        <div class="clean-photos">${photoSlots}</div>
        <div class="clean-actions">
            <button class="btn" onclick="cleanBegin(${b.id})" ${started ? "disabled" : ""}>START</button>
            <button class="btn" onclick="cleanDone(${b.id})" ${(!started || done) ? "disabled" : ""}>DONE</button>
            <button class="btn-report" onclick="openCleanReport(${b.id})">⚠ Report</button>
            ${started ? `<span class="muted">Started: ${nowFmt(started)} <span class="edit" onclick="cleanUndoStart(${b.id})">Undo</span></span>` : ""}
            ${done ? `<span class="muted">Done: ${nowFmt(done)} <span class="edit" onclick="cleanUndoDone(${b.id})">Undo</span></span>` : ""}
        </div>
        ${reportsHtml}
        ${histHtml}
    </div>`;
}

function renderCleaners(){
    fillCleanUser();
    const start = iso(cleanStart);
    const end = iso(addDays(cleanStart, cleanDays));   // exclusive
    const lastDay = fmt(iso(addDays(cleanStart, cleanDays - 1)));
    const label = cleanDays === 1 ? fmt(start) : fmt(start) + " – " + lastDay;
    document.getElementById("cleanRangeLabel").textContent = label;
    document.getElementById("cleanScopeLabel").textContent = "— " + label;

    // a turnover task = a booking whose check-out falls in the window
    const tasks = bookings
        .filter(b => b.checkout >= start && b.checkout < end)
        .sort((a, b) => (a.checkout || "").localeCompare(b.checkout || "") || a.haven.localeCompare(b.haven));

    const container = document.getElementById("cleanContainer");
    container.innerHTML = tasks.length
        ? tasks.map(cleanCardHtml).join("")
        : `<div class="panel"><p class="empty">🧹 No turnovers to clean for this period.</p></div>`;

    // turnover summary table (havens, check-in/out, what to retrieve)
    const scopeEl = document.getElementById("cleanSummaryScope");
    if(scopeEl) scopeEl.textContent = "— " + label;
    const sumBody = document.getElementById("cleanSummaryBody");
    if(sumBody){
        const stFilter = (document.getElementById("cleanStatusFilter") || {}).value || "";
        const sumRows = tasks.filter(b => {
            const lg = cleaning[b.id] || {};
            const cls = lg.doneAt ? "paid" : lg.startedAt ? "partial" : "unpaid";
            return !stFilter || cls === stFilter;
        });
        sumBody.innerHTML = sumRows.length ? sumRows.map(b => {
            const log = cleaning[b.id] || {};
            const stTxt = log.doneAt ? "Done" : log.startedAt ? "In progress" : "Not started";
            const stCls = log.doneAt ? "paid" : log.startedAt ? "partial" : "unpaid";
            const retrieve = (Number(b.towels) > 0)
                ? `🧺 ${b.towels} towel${b.towels > 1 ? "s" : ""}`
                : `<span class="muted">—</span>`;
            const dot = (HAVEN_COLORS[b.haven] || { am:"#ccc" }).am;
            return `<tr>
                <td><span class="dot" style="background:${dot}"></span><a class="haven-link" onclick="scrollToCleanCard(${b.id})">${b.haven}</a></td>
                <td>${checkinTimeStr(b)}</td>
                <td>${checkoutTimeStr(b)}</td>
                <td>${retrieve}</td>
                <td><span class="status ${stCls}">${stTxt}</span></td>
            </tr>`;
        }).join("") : `<tr><td colspan="5" class="empty">No turnovers match this status.</td></tr>`;
    }
}
