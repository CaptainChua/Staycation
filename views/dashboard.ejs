    else if(apDate === "yesterday") list = list.filter(b => b.checkin === iso(addDays(today(), -1)));
    else if(apDate === "range" && apRangeStart){
        list = list.filter(b => b.checkin >= apRangeStart && b.checkin <= (apRangeEnd || apRangeStart));
    }
    list.sort((a, b) => (b.id || 0) - (a.id || 0));

    const scope = document.getElementById("approvalScope");
    const pendN = pendingBookings().length;
