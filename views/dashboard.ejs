function saveBill(){
    const data = {
        haven: document.getElementById("b_haven").value,
        type: document.getElementById("b_type").value,
        amount: Number(document.getElementById("b_amount").value) || 0,
        due: document.getElementById("b_due").value,
        paid: document.getElementById("b_paid").checked
    };
    if(data.amount <= 0){ alert("Please enter an amount."); return; }

    if(editingBillId){
        const idx = bills.findIndex(b => b.id === editingBillId);
        if(idx !== -1) bills[idx] = { ...bills[idx], ...data };
    } else {
        const newId = bills.length ? Math.max(...bills.map(b => b.id)) + 1 : 1;
        bills.push({ id:newId, ...data });
    }
    persistBills();
    closeBillModal();
    renderBills();
}

function toggleBillPaid(id){
    const b = bills.find(x => x.id === id);
    if(!b) return;
    b.paid = !b.paid;
    persistBills();
    renderBills();
}
function deleteBill(id){
    if(!confirm("Delete this bill?")) return;
    bills = bills.filter(b => b.id !== id);
    persistBills();
    renderBills();
}

