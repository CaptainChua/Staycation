/* ---------- Analytics: custom date-range picker (up to a year) ---------- */
const AN_MAX_RANGE = 366;
let anRangeStart = null, anRangeEnd = null;
let anDpMonth = null, anDpPending = null, anDpHover = null;
function openAnPicker(e){
    if(e) e.stopPropagation();
    const pop = document.getElementById("anDpPopup");
    if(pop.classList.contains("show")){ closeAnPicker(); return; }
    anDpPending = null; anDpHover = null;
    const base = anRangeStart ? new Date(anRangeStart + "T00:00:00") : today();
    anDpMonth = new Date(base.getFullYear(), base.getMonth(), 1);
    anRenderPicker();
    pop.classList.add("show");
}
function closeAnPicker(){ anDpPending = null; anDpHover = null; const p = document.getElementById("anDpPopup"); if(p) p.classList.remove("show"); }
function anPickerNav(dir){ anDpMonth = new Date(anDpMonth.getFullYear(), anDpMonth.getMonth() + dir, 1); anRenderPicker(); }
function anHighlightRange(){
    if(anDpPending){
        let end = (anDpHover && anDpHover >= anDpPending) ? anDpHover : anDpPending;
        if(daysBetween(anDpPending, end) > AN_MAX_RANGE - 1) end = iso(addDays(new Date(anDpPending + "T00:00:00"), AN_MAX_RANGE - 1));
        return { start: anDpPending, end };
    }
    if(anRangeStart) return { start: anRangeStart, end: anRangeEnd || anRangeStart };
    return { start: null, end: null };
}
function anRenderPicker(){
    const y = anDpMonth.getFullYear(), m = anDpMonth.getMonth();
    document.getElementById("anDpTitle").textContent = MONTHS[m] + " " + y;
    const startDay = new Date(y, m, 1).getDay();
    const daysInMonth = new Date(y, m + 1, 0).getDate();
    const todayIso = iso(today());
    let html = "";
    ["Su","Mo","Tu","We","Th","Fr","Sa"].forEach(d => html += `<div class="dp-wd">${d}</div>`);
    for(let i = 0; i < startDay; i++) html += `<div class="dp-day empty"></div>`;
    for(let d = 1; d <= daysInMonth; d++){
        const cellIso = iso(new Date(y, m, d));
        let cls = "dp-day"; if(cellIso === todayIso) cls += " today";
        html += `<div class="${cls}" data-iso="${cellIso}" onclick="anPickDay('${cellIso}')" onmouseover="anHoverDay('${cellIso}')"><span class="n">${d}</span></div>`;
    }
    document.getElementById("anDpGrid").innerHTML = html;
    anUpdateHighlight();
}
function anUpdateHighlight(){
    const { start, end } = anHighlightRange();
    document.querySelectorAll("#anDpGrid .dp-day").forEach(cell => {
        cell.classList.remove("sel","range-start","range-end","in-range");
        const ci = cell.dataset.iso; if(!ci || !start) return;
        if(ci === start && ci === end) cell.classList.add("sel");
        else if(ci === start) cell.classList.add("sel","range-start");
        else if(ci === end) cell.classList.add("sel","range-end");
        else if(ci > start && ci < end) cell.classList.add("in-range");
    });
    document.getElementById("anDpHint").textContent = anDpPending
        ? "Now click an end date (up to a year), or the same day for a single date"
        : "Click a start date, then an end date for a range";
}
function anPickDay(cellIso){
    if(!anDpPending){ anDpPending = cellIso; anDpHover = cellIso; anUpdateHighlight(); return; }
    if(cellIso < anDpPending){ anDpPending = cellIso; anUpdateHighlight(); return; }
    let endIso = cellIso;
    if(daysBetween(anDpPending, endIso) > AN_MAX_RANGE - 1) endIso = iso(addDays(new Date(anDpPending + "T00:00:00"), AN_MAX_RANGE - 1));
    anApplyRange(anDpPending, endIso);
}
function anHoverDay(cellIso){ if(!anDpPending) return; anDpHover = cellIso; anUpdateHighlight(); }
function anApplyRange(startIso, endIso){
    anRangeStart = startIso; anRangeEnd = endIso;
    anPeriod = "custom";
    document.querySelectorAll("#anSeg button").forEach(x => x.classList.toggle("active", x.dataset.p === "custom"));
    closeAnPicker();
    anUpdateRangeLabel();
    renderAnalytics();
}
function anUpdateRangeLabel(){
    const lbl = document.getElementById("anRangeLabel");
    if(!lbl) return;
    lbl.textContent = anRangeStart
        ? (anRangeStart === anRangeEnd ? fmt(anRangeStart) : fmt(anRangeStart) + " – " + fmt(anRangeEnd))
        : "Pick dates";
}
function anDpToday(){ anApplyRange(iso(today()), iso(today())); }
function anDpClear(){ anRangeStart = null; anRangeEnd = null; closeAnPicker(); anUpdateRangeLabel(); renderAnalytics(); }
document.addEventListener("click", e => {
    const pop = document.getElementById("anDpPopup");
    if(pop && pop.classList.contains("show") && !e.target.closest(".dp-wrap")) closeAnPicker();
});
renderAnalytics();

/* ---------- cleaners / housekeeping ---------- */
const CLEAN_KEY = "shph_cleaning_v1";
const PHOTO_ROOMS = [
    ["kitchen", "Kitchen"],
    ["bedroom", "Bedroom"],
    ["dining", "Dining"],
    ["comfortRoom", "Comfort Room"],
    ["electronics", "Electronics"]
];
let cleaning = (() => { const raw = localStorage.getItem(CLEAN_KEY); return raw ? JSON.parse(raw) : {}; })();
function persistCleaning(){
    try{ localStorage.setItem(CLEAN_KEY, JSON.stringify(cleaning)); return true; }
    catch(e){ alert("Could not save — browser storage is full. Try removing some photos."); return false; }
}
function cleanLog(id){
    if(!cleaning[id]) cleaning[id] = { startedAt:null, doneAt:null, photos:{}, history:[] };
    return cleaning[id];
}
function cleanCurrentUser(){
    const sel = document.getElementById("cleanUser");
    return (sel && sel.value) ? sel.value : "Housekeeper";
}
function cleanAddHistory(log, action, id){
    log.history = log.history || [];
    log.history.push({ user:cleanCurrentUser(), action, at:new Date().toISOString() });
    const b = (id != null) ? bookings.find(x => x.id === id) : null;
    logActivity(`${action}${b ? " — " + b.haven : ""} (cleaning)`, cleanCurrentUser());
}
// "HH:MM" (24h) -> "h:mm AM/PM"
function time12(t){
    if(!t) return "—";
    const [h, m] = t.split(":").map(Number);
    const ap = h >= 12 ? "PM" : "AM";
    let hr = h % 12; if(hr === 0) hr = 12;
    return hr + ":" + String(m).padStart(2, "0") + " " + ap;
}
function nowFmt(isoStr){
    if(!isoStr) return "—";
    return new Date(isoStr).toLocaleString("en-PH", {
        year:"numeric", month:"short", day:"numeric", hour:"numeric", minute:"2-digit", hour12:true
    });
}

// "Acting as" = housekeeping staff from payroll (falls back to a generic name)
function fillCleanUser(){
    const sel = document.getElementById("cleanUser");
    const label = sel.closest("label");
    let staticEl = label ? label.querySelector(".clean-user-static") : null;

    // non-admins act only as themselves — no dropdown
    if(!payrollIsAdmin()){
        const mine = staff.find(s => payrollOwns(s));   // their own employee record (any role)
        const myName = (mine && mine.name) || currentUser();
        sel.innerHTML = `<option>${myName}</option>`;
        sel.value = myName;
        sel.style.display = "none";
        if(label && !staticEl){
            staticEl = document.createElement("span");
            staticEl.className = "clean-user-static";
            staticEl.style.fontWeight = "600";
            label.appendChild(staticEl);
        }
        if(staticEl) staticEl.textContent = myName;
        return;
    }

    // admin: full dropdown
    sel.style.display = "";
    if(staticEl) staticEl.remove();
    const prev = sel.value;
    const hk = staff.filter(s => s.role === "HOUSEKEEPING").map(s => s.name);
    const names = hk.length ? hk : ["Housekeeper"];
    sel.innerHTML = names.map(n => `<option>${n}</option>`).join("");
    if(names.includes(prev)) sel.value = prev;
}

/* ---------- cleaners date window + floating calendar ---------- */
let cleanStart = today();   // first day shown (Date)
let cleanDays = 7;          // number of days in the window
const CLEAN_MAX_RANGE = 7;
let cleanPickerMonth = today();
let cleanPendingStart = null, cleanHoverIso = null;

function cleanShift(dir){ closeCleanPicker(); cleanStart = addDays(cleanStart, dir * cleanDays); renderCleaners(); }
function cleanShowToday(){ closeCleanPicker(); cleanStart = today(); cleanDays = 1; renderCleaners(); }
function cleanShowWeek(){ closeCleanPicker(); cleanStart = today(); cleanDays = 7; renderCleaners(); }

function openCleanPicker(e){
    if(e) e.stopPropagation();
    const pop = document.getElementById("cleanDpPopup");
    if(pop.classList.contains("show")){ closeCleanPicker(); return; }
    cleanPendingStart = null; cleanHoverIso = null;
    cleanPickerMonth = new Date(cleanStart.getFullYear(), cleanStart.getMonth(), 1);
    renderCleanPicker();
    pop.classList.add("show");
}
function closeCleanPicker(){
    cleanPendingStart = null; cleanHoverIso = null;
    const pop = document.getElementById("cleanDpPopup");
    if(pop) pop.classList.remove("show");
}
function cleanPickerNav(dir){
    cleanPickerMonth = new Date(cleanPickerMonth.getFullYear(), cleanPickerMonth.getMonth() + dir, 1);
    renderCleanPicker();
}
function cleanHighlightRange(){
    if(cleanPendingStart){
        let end = (cleanHoverIso && cleanHoverIso >= cleanPendingStart) ? cleanHoverIso : cleanPendingStart;
        if(daysBetween(cleanPendingStart, end) > CLEAN_MAX_RANGE - 1)
            end = iso(addDays(new Date(cleanPendingStart + "T00:00:00"), CLEAN_MAX_RANGE - 1));
        return { start: cleanPendingStart, end };
    }
    return { start: iso(cleanStart), end: iso(addDays(cleanStart, cleanDays - 1)) };
}
function renderCleanPicker(){
    const y = cleanPickerMonth.getFullYear(), m = cleanPickerMonth.getMonth();
    document.getElementById("cleanDpTitle").textContent = MONTHS[m] + " " + y;
    const startDay = new Date(y, m, 1).getDay();
    const dim = new Date(y, m + 1, 0).getDate();
    const todayIso = iso(today());
    let html = "";
    ["Su","Mo","Tu","We","Th","Fr","Sa"].forEach(d => html += `<div class="dp-wd">${d}</div>`);
