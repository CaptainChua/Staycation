// replace one collection's photo (by its index in the payments array) — saves now
function replaceCollectionProof(idx, input){
    if(editingId == null) return;
    const f = input.files && input.files[0];
    if(!f || !/^image\//.test(f.type)) return;
    const bIdx = bookings.findIndex(x => x.id === editingId);
    if(bIdx === -1) return;
    const pays = bookings[bIdx].payments || [];
    if(!pays[idx]) return;
    resizeImage(f, async dataUrl => {
        pays[idx].proof = await _offloadImg(dataUrl);   // durable /img ref, never lost
        bkPaymentEdit(bookings[bIdx], idx);
        logActivity(`replaced payment photo — ${bookings[bIdx].haven} · ${peso(pays[idx].amount)} (${pays[idx].category || "Balance"})`);
        renderProofPage(bookings[bIdx]);
        renderAll();
    });
    input.value = "";
}
// delete one specific collection (by its index) — its whole record incl. photo
function deleteCollectionAt(idx){
    if(editingId == null) return;
    const bIdx = bookings.findIndex(x => x.id === editingId);
    if(bIdx === -1) return;
    const pays = bookings[bIdx].payments || [];
    if(!pays[idx]) return;
    const cat = pays[idx].category || "Balance";
    if(!confirm(`Delete this ${cat} collection of ${peso(pays[idx].amount)}? This removes the payment and its photo. This cannot be undone.`)) return;
    const removed = pays.splice(idx, 1)[0];
    bkPaymentDelete(bookings[bIdx], idx, removed.pid);
    logActivity(`deleted ${cat} collection — ${bookings[bIdx].haven} · ${peso(removed.amount)}`);
    renderProofPage(bookings[bIdx]);
    renderAll();
}
// remove the latest collection of a given category from the booking being edited
function deleteCollection(category){
    if(editingId == null) return;
    const idx = bookings.findIndex(x => x.id === editingId);
    if(idx === -1) return;
    const pays = bookings[idx].payments || [];
    let pos = -1;
    for(let k = pays.length - 1; k >= 0; k--){
        const cat = pays[k].category || "Balance";
        if((category === "Add Ons") ? (cat === "Add Ons") : (cat !== "Add Ons")){ pos = k; break; }
    }
    if(pos === -1) return;
    if(!confirm(`Delete this ${category} collection of ${peso(pays[pos].amount)}? This cannot be undone.`)) return;
    const removed = pays.splice(pos, 1)[0];
    bkPaymentDelete(bookings[idx], pos, removed.pid);
    logActivity(`deleted ${category} collection — ${bookings[idx].haven} · ${peso(removed.amount)}`);
    renderProofPage(bookings[idx]);
    renderAll();
}
