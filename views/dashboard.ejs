/* ----- Security Deposit: refund-proof modal (proof required to mark returned) ----- */
let depReturnId = null, depProofData = null, depCurrentDeposit = 0;
// recompute "amount to refund" = deposit − deduction, and toggle the deduction fields
function depRecalcRefund(){
    const reason = document.getElementById("depDeduct").value;
    document.getElementById("depDeductRow").style.display = reason ? "block" : "none";
    document.getElementById("depOthersRow").style.display = reason === "Others" ? "block" : "none";
    const cost = reason ? (Number(document.getElementById("depDeductAmt").value) || 0) : 0;
    const refund = Math.max(0, depCurrentDeposit - cost);
    document.getElementById("depRefundVal").textContent = peso(refund);
    return refund;
}
function openDepReturn(id){
    const b = bookings.find(x => x.id === id);
    if(!b) return;
    const returned = !!b.depositReturned;
    depReturnId = id;
    depCurrentDeposit = Number(b.deposit || 0);
    depProofData = b.depositProof || null;   // keep existing proof when managing a returned one
    document.getElementById("depRetEyebrow").textContent = "Booking #" + bookingCode(bookings.find(x => x.id === id));
    document.getElementById("depRetTitle").textContent = returned ? "Manage Security Deposit" : "Return Security Deposit";
    document.getElementById("depRetInfo").innerHTML =
        `<strong>${b.haven}</strong> — ${primaryName(b)}<br>Deposit held: <strong>${peso(b.deposit || 0)}</strong>`;
    document.getElementById("depMop").value = b.depositMop || "Cash";
    document.getElementById("depDeduct").value = b.depositDeductReason || "";
    document.getElementById("depDeductAmt").value = (b.depositDeductAmount != null) ? b.depositDeductAmount : 0;
    document.getElementById("depDeductNote").value = b.depositDeductNote || "";
    depRecalcRefund();
    document.getElementById("depProofName").textContent = depProofData ? "Photo attached ✓" : "No file chosen";
    document.getElementById("depProofFile").value = "";
    const prev = document.getElementById("depProofPreview");
    if(depProofData){ prev.src = depProofData; prev.style.display = "block"; }
    else { prev.src = ""; prev.style.display = "none"; }
    const confirmBtn = document.getElementById("depConfirmBtn");
    confirmBtn.disabled = !depProofData;
    confirmBtn.textContent = returned ? "Update" : "Mark returned";
    document.getElementById("depUndoBtn").style.display = returned ? "inline-block" : "none";
    document.getElementById("depOverlay").classList.add("show");
}
function undoFromModal(){
    const id = depReturnId;
    closeDepReturn();
    if(id != null) undoDeposit(id);
}
function closeDepReturn(){
    depReturnId = null; depProofData = null;
    document.getElementById("depOverlay").classList.remove("show");
}
function applyDepProof(f){
    if(!f || !/^image\//.test(f.type)) return;
    document.getElementById("depProofName").textContent = f.name || "Photo attached";
    resizeImage(f, dataUrl => {
        depProofData = dataUrl;
        const prev = document.getElementById("depProofPreview");
        prev.src = dataUrl; prev.style.display = "block";
        document.getElementById("depConfirmBtn").disabled = false;
    });
}
function onDepProofChange(input){ if(input.files[0]) applyDepProof(input.files[0]); }
let _depSaving = false;
async function confirmDepReturn(){
    if(_partnerReadOnly()) return;   // partners are read-only
    if(_depSaving) return;   // block double-clicks
    if(depReturnId == null) return;
    if(!depProofData){ alert("Please attach a photo of the refunded security deposit first."); return; }
    const b = bookings.find(x => x.id === depReturnId);
    if(!b) return;
    const reason = document.getElementById("depDeduct").value;
    const cost = reason ? (Number(document.getElementById("depDeductAmt").value) || 0) : 0;
    const refund = Math.max(0, Number(b.deposit || 0) - cost);
    _depSaving = true;
    try{
        // 1) offload the refund-proof photo to a tiny /img link
        let proofRef = depProofData;
        if(depProofData && depProofData.indexOf("data:image") === 0){
            try{ const r = await fetch("/api/img", { method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify({ data: depProofData }) }); if(r.ok){ const j = await r.json(); if(j && j.url) proofRef = j.url; } }catch(e){}
        }
        const set = {
            depositReturned: true, depositProof: proofRef,
            depositMop: document.getElementById("depMop").value,
            depositDeductReason: reason || "", depositDeductAmount: cost,
            depositDeductNote: reason === "Others" ? document.getElementById("depDeductNote").value.trim() : "",
            depositRefundAmount: refund,
            depositReturnedAt: new Date().toISOString(), depositReturnedBy: currentUser()
        };
        // 2) PER-RECORD write — touches ONLY this booking (can't wipe other bookings' data)
        let ok = false;
        try{ const res = await fetch("/api/booking/" + encodeURIComponent(depReturnId) + "/deposit", { method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify({ set }) }); ok = res.ok; }catch(e){}
        if(!ok){ alert("⚠️ The deposit return was NOT saved — the server didn't confirm (slow / offline). Please try again."); return; }
        // 3) reflect locally without a whole-array push
        Object.assign(b, set);
        b.updatedAt = new Date().toISOString();
        try{ (window.shphSetLocal || localStorage.setItem.bind(localStorage))(KEY, JSON.stringify(bookings)); }catch(e){}
        const dedTxt = cost > 0 ? ` (−${peso(cost)} ${reason})` : "";
        logActivity(`returned security deposit — ${b.haven} (${primaryName(b)}) · refunded ${peso(refund)}${dedTxt} via ${set.depositMop}`);
        closeDepReturn();
        renderDeposit();
    } finally { _depSaving = false; }
}
// drag & drop onto the refund-proof card
(function initDepDnd(){
    const card = document.getElementById("depUploadCard");
    if(!card) return;
    card.addEventListener("dragover", e => { e.preventDefault(); card.classList.add("drag"); });
    card.addEventListener("dragleave", e => { if(!card.contains(e.relatedTarget)) card.classList.remove("drag"); });
    card.addEventListener("drop", e => {
        e.preventDefault(); card.classList.remove("drag");
        const f = e.dataTransfer && e.dataTransfer.files;
        if(f && f.length) applyDepProof(f[0]);
    });
})();
// paste an image while the refund modal is open
document.addEventListener("paste", e => {
    const ov = document.getElementById("depOverlay");
    if(!ov || !ov.classList.contains("show")) return;
    const items = (e.clipboardData && e.clipboardData.items) || [];
    for(const it of items){
        if(it.kind === "file" && /^image\//.test(it.type)){
            const f = it.getAsFile();
            if(f){ e.preventDefault(); applyDepProof(f); return; }
        }
    }
});
