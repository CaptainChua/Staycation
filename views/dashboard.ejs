/* ---------- global activity log (shared with todaysbooking.html) ---------- */
const ACTIVITY_KEY = "shph_activity_log";
function logActivity(action, user){
    try {
        let log = [];
        try { log = JSON.parse(localStorage.getItem(ACTIVITY_KEY)) || []; } catch(e){}
        log.push({ user: user || currentUser(), action, at: new Date().toISOString() });
        localStorage.setItem(ACTIVITY_KEY, JSON.stringify(log.slice(-500))); // keep last 500
    } catch(e){ /* never let logging break an action (e.g. storage full) */ }
}
function renderLog(){
    let log = [];
    try { log = JSON.parse(localStorage.getItem(ACTIVITY_KEY)) || []; } catch(e){}
    const rows = arr => arr.slice().reverse().map(e => `
        <div class="log-row">
            <span class="log-when">${new Date(e.at).toLocaleString("en-PH")}</span>
            <span class="log-user">${escHtml(e.user || "—")}</span>
            <span class="log-action">${escHtml(e.action || "")}</span>
        </div>`).join("");
    const empty = `<div class="muted">No activity logged yet.</div>`;
    const full = document.getElementById("logList");                 // full Activity Log page
    if(full) full.innerHTML = log.length ? rows(log) : empty;
    const cal = document.getElementById("logListCal");               // compact copy on the Calendar page (last 40)
    if(cal){ cal.innerHTML = log.length ? rows(log.slice(-40)) : empty; applyCalLogState(); }
}
// minimize / expand the inline Activity Log on the Calendar page (state remembered)
function applyCalLogState(){
    const cal = document.getElementById("logListCal");
    const btn = document.getElementById("calLogToggle");
    let collapsed = false;
    try { collapsed = localStorage.getItem("shph_callog_min") === "1"; } catch(e){}
    if(cal) cal.style.display = collapsed ? "none" : "";
    if(btn){ btn.textContent = collapsed ? "▸" : "▾"; btn.title = collapsed ? "Expand" : "Minimize"; }
}
function toggleCalLog(){
    let collapsed = false;
    try { collapsed = localStorage.getItem("shph_callog_min") === "1"; } catch(e){}
    try { localStorage.setItem("shph_callog_min", collapsed ? "0" : "1"); } catch(e){}
    applyCalLogState();
}
function clearActivityLog(){
    if(!confirm("Clear the entire activity log?")) return;
    localStorage.removeItem(ACTIVITY_KEY);
    renderLog();
}
// Download a full copy of all your data (bookings, bills, expenses, settings, etc.) as a JSON
// file — a manual backup you can keep anywhere. The server also keeps automatic daily backups.
async function exportAllData(){
    try{
        const res = await fetch("/api/kv", { cache:"no-store" });
        if(!res.ok) throw new Error("server error " + res.status);
        const all = await res.json();
        const stamp = new Date().toISOString().slice(0,19).replace(/[:T]/g, "-");
        const blob = new Blob([JSON.stringify(all, null, 2)], { type: "application/json" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url; a.download = "staycationhaven-backup-" + stamp + ".json";
        document.body.appendChild(a); a.click(); a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
        logActivity("exported a data backup");
    }catch(e){ alert("Export failed: " + (e && e.message) + "\nCheck your connection and try again."); }
}
// per-staff change log
