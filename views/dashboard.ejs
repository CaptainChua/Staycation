    const thumb = document.getElementById("billReceiptThumb"), img = document.getElementById("billReceiptImg"), nm = document.getElementById("billReceiptName"), fi = document.getElementById("billReceiptFile");
    if(thumb) thumb.style.display = "none"; if(img) img.src = ""; if(nm) nm.textContent = "No file chosen"; if(fi) fi.value = "";
}
function viewBillPhoto(id){ const b = bills.find(x => x.id === id); if(b && b.photo) openProofImg(b.photo); }
function viewBillReceipt(id){ const b = bills.find(x => x.id === id); if(b && b.receipt) openProofImg(b.receipt); }

// read-only detail popup for one bill — biller, amount, due, status + the bill photo & receipt
function viewBill(id){
    const b = bills.find(x => x.id === id);
    if(!b) return;
    const overdue = billOverdue(b);
    const st = overdue ? "overdue" : (b.paid ? "paid" : "unpaid");
    const stLabel = overdue ? "Overdue" : (b.paid ? "Paid" : "Unpaid");
    const attach = (label, src) => src
        ? `<div style="text-align:center;"><small class="muted" style="display:block;margin-bottom:4px;">${label}</small><img src="${src}" onclick="openProofImg(this.src)" style="width:100%;max-height:190px;object-fit:cover;border-radius:10px;cursor:zoom-in;border:1px solid #eadfce;"></div>`
        : `<div style="text-align:center;"><small class="muted" style="display:block;margin-bottom:4px;">${label}</small><div style="height:80px;display:flex;align-items:center;justify-content:center;border:1px dashed #e0d6c4;border-radius:10px;color:#b7ab97;font-size:13px;">None</div></div>`;
    document.getElementById("billViewTitle").textContent = (b.type || "Bill") + " · " + (b.haven || "");
    document.getElementById("billViewBody").innerHTML = `
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px 18px;margin:8px 0 16px;">
            <div><small class="muted">Biller</small><div style="font-weight:600;">${b.type || "—"}</div></div>
            <div><small class="muted">Haven</small><div style="font-weight:600;">${b.haven || "—"}</div></div>
            <div><small class="muted">Amount</small><div style="font-weight:700;">${peso(b.amount || 0)}</div></div>
            <div><small class="muted">Due date</small><div style="font-weight:600;">${b.due ? fmt(b.due) : "—"}</div></div>
