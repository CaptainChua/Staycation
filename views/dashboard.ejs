// open as "Add" when no id is passed, or "Edit" (pre-filled) when an id is given
function openModal(id){
    // only admins/CSRs may create a new booking (editing an existing one is still allowed via row Edit)
    if(!id && !canAddBooking()){ alert("Only an administrator or CSR can add a booking."); return; }
    editingId = id || null;
    // reset haven dropdown to all havens (filtering happens at the end via onStayChange)
    document.getElementById("f_haven").innerHTML = HAVENS.map(h => `<option>${h}</option>`).join("");
    fillCheckinTimes();
    if(editingId){
        const b = bookings.find(x => x.id === editingId);
        if(!b) return;
        document.getElementById("modalTitle").textContent = "Edit Booking";
        document.getElementById("bkEyebrow").textContent = "Booking #" + bookingCode(b);
        setField("f_haven", b.haven);
        setField("f_fbName", b.fbName || "");
        renderGuestRows(b.guests);
        setField("f_contact", b.contact || "");
        setField("f_checkin", b.checkin);
        setField("f_checkout", b.checkout);
        updateStayOptions(b.stayHours || 6);
        // an overnight booking spanning 2+ nights → show as "Multiple nights" with an editable check-out
        if(Number(b.stayHours) === 21 && stayNights(b.checkin, b.checkout) > 1){
            document.getElementById("f_stay").value = "multi";
        }
        setDashCheckinTime(checkinTimeStr(b));
        setField("f_swimpass", b.swimpass || 0);
        setField("f_towels", b.towels || 0);
        setField("f_extend", b.extend || 0);
        document.getElementById("f_holiday").checked = !!b.holiday;
        setField("f_deposit", b.deposit === undefined ? PRICING.deposit : b.deposit);
        setDiscountField(b.discount || 0);
        setField("f_method", b.method || "GCash");
        setField("f_reference", b.reference || "");
        setField("f_down", b.downpayment || 0);
        setField("f_notes", b.notes || "");
        renderProofPage(b);
        renderIdPage(b);
    } else {
        document.getElementById("modalTitle").textContent = "Add Booking";
        document.getElementById("bkEyebrow").textContent = "New Reservation";
        document.getElementById("f_haven").selectedIndex = 0;
        setField("f_fbName", "");
        renderGuestRows([{name:"",age:""}]);
        setField("f_contact", "");
        setField("f_checkin", iso(today()));
        setField("f_checkout", iso(addDays(today(),1)));
        updateStayOptions(6);
        setDashCheckinTime("9:00 AM");
        setField("f_swimpass", 0);
        setField("f_towels", 0);
        setField("f_extend", 0);
        document.getElementById("f_holiday").checked = false;
        setField("f_deposit", PRICING.deposit);
        setDiscountField(0);
        setField("f_method", "GCash");
        setField("f_reference", "");
        setField("f_down", 0);
        setField("f_notes", "");
        renderProofPage(null);
        renderIdPage(null);
    }
    clearSegRows();   // multi-haven rows start empty; add them to extend the stay
    bkGoPage(1);
    onStayChange();
    document.getElementById("overlay").classList.add("show");
}
