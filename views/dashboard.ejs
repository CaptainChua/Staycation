    </div>
</div>

<!-- Add record (separate cut-off computation) modal -->
<div class="overlay" id="recordOverlay">
    <div class="modal" style="width:460px;">
        <h2>Add Record</h2>
        <p class="muted" style="margin:-6px 0 14px;">A separate cut-off computation, kept apart from the regular cut-off totals.</p>
        <div class="form-grid">
            <div class="field full"><label>Staff</label><select id="r_staff"></select></div>
            <div class="field full"><label>Cut-off</label><select id="r_cutoff"></select></div>
        </div>
