            <td class="dep-amt">${dep > 0 ? peso(dep) : "—"}${(dep > 0 && returned && Number(b.depositDeductAmount) > 0)
                ? `<br><span class="muted" style="font-weight:500;">Refunded ${peso(b.depositRefundAmount)} · −${peso(b.depositDeductAmount)} ${b.depositDeductReason}</span>`
                : ""}</td>
