<!-- ============================================================
     "WARM HOSPITALITY" THEME  — global re-skin layer
     Remaps the dashboard's design tokens (accent #ff385c, dark
     sidebar, grey bg) to the cream / terracotta / gold palette
     across every page. Loaded last so it wins the cascade.
     Semantic colours (paid-green, unpaid-red) are left intact.
     ============================================================ -->
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Mulish:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style id="hv-theme">
  :root{
    --hv-cream:#f6f2ec; --hv-card:#ffffff; --hv-ink:#2f2a25; --hv-muted:#9a8f86;
