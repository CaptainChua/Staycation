            <div class="field full csr-field" style="margin-top:-6px;">
                <label class="check-label"><input type="checkbox" id="d_pmoff" onchange="toggleDayOff()"> No afternoon (half day)</label>
            </div>

            <div class="field full csr-field" style="height:6px;"></div>
            <div class="field full csr-field">
                <label>Overtime <span class="muted">(optional)</span></label>
                <div id="d_ot_list"></div>
                <button type="button" class="btn secondary add-guest" id="d_ot_add" onclick="addOtRow()" style="margin-top:4px;">+ Add another OT</button>
            </div>

            <!-- Assist / Commission -->
            <div class="field full assist-field">
                <label>Rooms booked</label>
                <div class="muted" style="font-size:13px;background:#faf7f1;border:1px solid #efe6d3;border-radius:8px;padding:10px 12px;">
                    Counted automatically from the calendar (check-ins on the selected date).
                </div>
