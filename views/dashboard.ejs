        if(img){ img.src = dataUrl; img.style.display = "block"; }
        if(cfg.thumbId){ const t = document.getElementById(cfg.thumbId); if(t) t.style.display = "inline-block"; }
    });
}
// delete an attached proof photo. Manual channels (down/addon/bal) clear the in-memory
// copy and hide it — persisted when you click Save Booking (so Cancel undoes it). When
// the add-ons image is actually a collection's photo, remove that photo immediately.
function deleteProofImg(type){
    if(type === "addon" && addonShownPayIdx >= 0){ deleteCollectionPhoto(addonShownPayIdx); return; }
    const cfg = PROOF_CFG[type];
    if(!cfg) return;
    if(type === "down")  downProofData = null;
    else if(type === "addon") addonProofData = null;
    else if(type === "extend") extendProofData = null;
    else if(type === "bal"){ balProofData = null; balProofDirty = true; }
    const img = document.getElementById(cfg.imgId); if(img){ img.src = ""; img.style.display = "none"; }
    const t = cfg.thumbId && document.getElementById(cfg.thumbId); if(t) t.style.display = "none";
    const nm = document.getElementById(cfg.nameId); if(nm) nm.textContent = "No file chosen";
    const fi = cfg.fileId && document.getElementById(cfg.fileId); if(fi) fi.value = "";
}
// remove just one collection's photo (keep the collection) — saves immediately
function deleteCollectionPhoto(idx){
