// offload one base64 image to a durable /img ref (tiny + never lost); returns the ref or the input
async function _offloadImg(v){
    if(typeof v !== "string" || v.indexOf("data:image") !== 0) return v;
    try{ const r = await fetch("/api/img", { method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify({ data: v }) }); if(r.ok){ const j = await r.json(); if(j && j.url) return j.url; } }catch(e){}
    return v;   // fall back to base64 — the server still stores it; never dropped
}
// patch ONLY the given fields of one booking on the LIVE server record (preserves everything else)
async function patchBooking(id, set){
    try{ const r = await fetch(`/api/booking/${encodeURIComponent(id)}/patch`, { method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify({ set }) }); return r.ok; }catch(e){ return false; }
}
// keep the local record's edit-time + change signature in step with a per-record server write
function _stampLocal(b){ try{ b.updatedAt = new Date().toISOString(); if(_bkSig && typeof _bkCanon === "function") _bkSig[String(b.id)] = _bkCanon(b); }catch(e){} }
// Clobber-safe AND durable per-record change to ONE booking. Stamps + mirrors locally FIRST (so if
// the server write fails, the load-time prime-merge sees the local record as newer and re-pushes it
// through the durable queue), then fires the matching per-record server write (reads the live record
// → can't clobber another device's edit to a different field/payment).
function _bkMirror(b){ _stampLocal(b); setLocalKey(KEY, bookings); }
function bkSave(b, set){ _bkMirror(b); patchBooking(b.id, set); }                       // b already mutated; `set` = fields to persist
function bkPaymentEdit(b, idx){ const p = b.payments[idx]; const existingPid = p && p.pid; if(p && p.pid == null) p.pid = uid(); _bkMirror(b); fetch(`/api/booking/${encodeURIComponent(b.id)}/payment`, { method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify({ payment: p, editId: existingPid, editIndex: idx }) }).catch(()=>{}); }
// pass the DELETED payment's pid (capture it before splicing locally) so the server matches by id, not position
function bkPaymentDelete(b, idx, pid){ _bkMirror(b); fetch(`/api/booking/${encodeURIComponent(b.id)}/payment`, { method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify({ deleteId: pid, deleteIndex: idx }) }).catch(()=>{}); }
let _savingBooking = false;
async function saveBooking(){
    const guests = readGuests();
    const checkin = document.getElementById("f_checkin").value;
    const checkout = document.getElementById("f_checkout").value;

    if(guests.length === 0){ alert("Please enter at least one guest name."); return; }

    // every guest needs a valid age
    for(let i=0;i<guests.length;i++){
        const g = guests[i];
        if(g.age == null || isNaN(g.age) || g.age < 0){
            alert(`Please enter a valid age for ${g.name || ("guest " + (i+1))}.`);
            return;
        }
    }

    // rule 1: first guest must be 18+
    if(guests[0].age < 18){
        alert("The first guest (primary booker) must be 18 years old and above.");
        return;
    }
    // rule 2: if the second guest is a minor, they must be a family member (same last name)
    if(guests.length >= 2 && guests[1].age < 18 && lastName(guests[1].name) !== lastName(guests[0].name)){
        alert("The second guest is a minor and must be a family member (same last name) of the first guest.");
        return;
    }

    // capacity & composition: max 5 pax, up to 4 adults and 2 kids (0–13)
    const kids = guests.filter(g => g.age <= PRICING.kidMaxAge).length;
    const adults = guests.length - kids;
    if(guests.length > PRICING.maxPax){ alert(`Maximum of ${PRICING.maxPax} pax per unit.`); return; }
    if(adults > PRICING.maxAdults){ alert(`Maximum of ${PRICING.maxAdults} adults per unit.`); return; }
    if(kids > PRICING.maxKids){ alert(`Maximum of ${PRICING.maxKids} kids (0–13 yrs) per unit.`); return; }

    if(!checkin || !checkout || checkout < checkin){
        alert("Please enter a valid check-in and check-out date.");
        return;
    }
    // "Multiple nights" is stored as a 21h overnight stay spanning several days
    const stayVal = document.getElementById("f_stay").value;
    const isMulti = stayVal === "multi";
    const stayHours = isMulti ? 21 : Number(stayVal);
    if(isMulti && stayNights(checkin, checkout) < 1){
        alert("For multiple nights, the check-out date must be at least one day after check-in.");
        return;
    }
    // Saturday check-ins are 21 hours only — admins are exempt (may book 6h/10h too)
    const checkinWd = new Date(checkin + "T00:00:00").getDay();
    if(checkinWd === 6 && stayHours !== 21 && !isAdminUser()){
        alert("Saturday check-ins are 21 hours only.");
        return;
    }
    // earliest check-in is 9:00 AM (a same-day check-out pushes it later via the 2h cleaning gap).
    // Admins are exempt — they may set an earlier custom time (e.g. 8:00 AM). The public website
    // (booknow) keeps the 9:00 AM minimum; this exemption is dashboard/admin-only.
    const ciMin = parseTimeMin(dashCheckinTimeValue());
    if(ciMin != null && ciMin < EARLIEST_CHECKIN_MIN && !isAdminUser()){
        alert("The earliest check-in time is 9:00 AM.");
        return;
    }

    const data = {
        haven: document.getElementById("f_haven").value,
        fbName: document.getElementById("f_fbName").value.trim(),
        guests,
        contact: document.getElementById("f_contact").value.trim(),
        checkin, checkout,
        stayHours: stayHours,
        checkinTime: dashCheckinTimeValue(),
        slot: stayHours === 6 ? (dashCheckinMin(dashCheckinTimeValue()) <= 720 ? "morning" : "evening") : null,
        swimpass: Number(document.getElementById("f_swimpass").value) || 0,
        towels: Number(document.getElementById("f_towels").value) || 0,
        extend: Number(document.getElementById("f_extend").value) || 0,
        holiday: document.getElementById("f_holiday").checked,
        deposit: Number(document.getElementById("f_deposit").value) || 0,
        discount: Number(document.getElementById("f_discount").value) || 0,
        method: document.getElementById("f_method").value,
        reference: document.getElementById("f_reference").value.trim(),
        downpayment: Number(document.getElementById("f_down").value) || 0,
        notes: document.getElementById("f_notes").value.trim(),
        downProof: downProofData || null,
        addonProof: addonProofData || null,
        extendProof: extendProofData || null,
        balanceProof: balProofData || null,
        ids: idsData.slice(),
        idOptOut: document.getElementById("f_idOptOut").checked
    };
    data.total = computeTotal(data); // auto-calculated from pricing rules

    if(!data.haven){
        alert("No haven is available for the selected dates and stay. Please choose different dates.");
        return;
    }

    // double-booking guard — time-window based (admin can slot a 6h booking into free hours)
    const clash = findConflictAdmin(data, editingId);
    if(clash){
        alert(
            `${data.haven} is already booked at that time by ${primaryName(clash)} ` +
            `(${fmt(clash.checkin)} · ${checkinTimeStr(clash)}–${checkoutTimeStr(clash)}).\n\n` +
            `Leave at least a 1-hour cleaning gap — pick a check-in time at least 1 hour after that check-out, or a different haven/date.`
        );
        return;
    }

    // ----- additional havens (multi-haven stay): each becomes a linked overnight booking -----
    const overlapClash = (a, c) => {
        if(a.haven !== c.haven) return false;
        return intervalsClash(bookingInterval(a), bookingInterval(c));   // incl. the 2h cleaning gap
    };
    const segDatas = [];
    for(const seg of readSegs()){
        if(!seg.checkout || seg.checkout <= seg.checkin){
            alert(`The additional haven "${seg.haven}" needs a valid check-in and a later check-out date.`);
            return;
        }
        const sd = {
            haven: seg.haven,
            fbName: data.fbName,
            guests: data.guests,
            contact: data.contact,
            checkin: seg.checkin,
            checkout: seg.checkout,
            stayHours: 21,             // a haven-night is an overnight stay
            checkinTime: "2:00 PM",
            slot: null,
            swimpass: 0, towels: 0, extend: 0,
            holiday: data.holiday,
            deposit: 0,                // security deposit is charged once, on the primary
            method: data.method,
            downpayment: 0,
            notes: data.notes,
            downProof: null, addonProof: null, extendProof: null, balanceProof: null,
            ids: data.ids, idOptOut: data.idOptOut,
            source: data.source
        };
        sd.total = computeTotal(sd);
        // can't clash with existing bookings (except the one being edited), the primary, or earlier segments
        const clashSeg = bookings.find(b => b.id !== editingId && overlapClash(b, sd))
            || (overlapClash(data, sd) ? data : null)
            || segDatas.find(s => overlapClash(s, sd));
        if(clashSeg){
            alert(`${sd.haven} is already booked for ${fmt(sd.checkin)}–${fmt(sd.checkout)}. Pick a different haven or dates for that segment.`);
            return;
        }
        segDatas.push(sd);
    }
    // a shared group id ties all havens of this single stay together
    let groupId = null;
    if(segDatas.length){
        const pb = editingId ? bookings.find(b => b.id === editingId) : null;
        groupId = (pb && pb.groupId) || ("g" + Date.now());
        data.groupId = groupId;
    }

    // ---- PERSIST PER-RECORD (never a whole-array write) so a stale save from another tab/device
    // can't clobber this booking, and its fields owned elsewhere (payments, IDs, deposit-return)
    // are preserved. Proof photos are offloaded to durable refs first. ----
    if(_savingBooking) return;
    _savingBooking = true;
    try{
        // offload the booking-level proof photos to /img refs (tiny request; image never lost)
        data.downProof   = await _offloadImg(data.downProof);
        data.addonProof  = await _offloadImg(data.addonProof);
        data.extendProof = await _offloadImg(data.extendProof);
        data.balanceProof= await _offloadImg(data.balanceProof);

        if(editingId){
            const idx = bookings.findIndex(b => b.id === editingId);
            if(idx === -1){ _savingBooking = false; return; }
            // patch = form-owned fields ONLY. Never send ids/idOptOut (saved per-record on upload) or
            // payments (their own endpoint) — leaving them out preserves them on the live record.
            const patch = { ...data };
            delete patch.ids; delete patch.idOptOut;
            const ok = await patchBooking(editingId, patch);
            if(!ok){ alert("⚠️ The booking was NOT saved — the server didn't confirm (slow / offline). Please try again."); _savingBooking = false; return; }
            bookings[idx] = { ...bookings[idx], ...patch };
            _stampLocal(bookings[idx]);
            // if a new BALANCE proof photo was chosen, update that ONE payment per-record too
            if(balProofDirty && balProofData){
                const ref = await _offloadImg(balProofData);
                const pays = bookings[idx].payments || [];
                let k = -1; for(let j = pays.length - 1; j >= 0; j--){ if((pays[j].category || "Balance") !== "Add Ons"){ k = j; break; } }
                if(k !== -1){
                    const existingPid = pays[k].pid;   // null for legacy → server uses index fallback
                    pays[k] = { ...pays[k], pid: pays[k].pid || uid(), proof: ref, editedAt: new Date().toISOString(), editedBy: currentUser() };
                    _stampLocal(bookings[idx]);   // local is now newest → prime-merge re-pushes if this fails
                    try{ await fetch(`/api/booking/${encodeURIComponent(editingId)}/payment`, { method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify({ payment: pays[k], editId: existingPid, editIndex: k }) }); }catch(e){}
                }
            }
            logActivity(`edited booking — ${data.haven} (${primaryName(data)})`);
        } else {
            const rec = { id: uid(), ...data };          // unique id; upsertOne offloads its images (ids)
            const ok = await saveOneRecord("shph_bookings_v3", rec);
            if(!ok){ alert("⚠️ The booking was NOT saved — the server didn't confirm (slow / offline). Please try again."); _savingBooking = false; return; }
            bookings.push(rec); _lastCreatedBookingId = rec.id; _stampLocal(rec);
            logActivity(`added booking — ${data.haven} (${primaryName(data)})`);
        }
        // linked haven segments → each its own per-record booking
        if(segDatas.length){
            for(const sd of segDatas){
                const rec = { id: uid(), ...sd, groupId };
                const ok = await saveOneRecord("shph_bookings_v3", rec);
                if(ok){ bookings.push(rec); _stampLocal(rec); }
            }
            logActivity(`linked ${segDatas.length} more haven(s) to this stay — ${segDatas.map(s => s.haven).join(", ")}`);
        }
        setLocalKey(KEY, bookings);   // mirror locally WITHOUT a whole-array push
        closeModal();
        renderAll();
    } finally {
        _savingBooking = false;
    }
}

function logout(){
    if(window.__PARTNER__){ localStorage.removeItem("shph_partner_session"); window.location.href = "/partner-login"; return; }
    logActivity("logged out"); localStorage.removeItem("shph_current_user"); window.location.href = "/admin.html";
}

/* ---------- sidebar navigation ---------- */
function showPage(page){
    if(!pageAllowed(page)) return;   // access control
    document.querySelectorAll(".page").forEach(p =>
        p.classList.toggle("active", p.id === "page-" + page));
    document.querySelectorAll(".sidebar .nav-item").forEach(n =>
        n.classList.toggle("active", n.dataset.page === page));
    localStorage.setItem("shph_dashboard_page", page);   // remember across refreshes
    // breadcrumb in the top bar
    const CRUMB = {
        today:["Main","Today's Booking"], calendar:["Main","Calendar & Bookings"], guestform:["Main","Guest Form"], approval:["Front Desk","Booking Approval"], paymentapproval:["Front Desk","Payment Approval"], deposit:["Front Desk","Security Deposit"],
        havens:["Property","Havens"], booking:["Property","Rates & Add-ons"], cleaners:["Property","Housekeeping"],
        finance:["Finance","Finance"], payments:["Finance","Payments"], payroll:["Finance","Payroll"],
        bills:["Finance","Bills"], expenses:["Finance","Expenses"], analytics:["Finance","Analytics"],
        users:["Team","Users"], employees:["Team","Employees"], assist:["Team","Assist"], log:["Team","Log"]
    };
    const cr = CRUMB[page] || (window.PARTNER_CRUMB && window.PARTNER_CRUMB[page]) || ["Main", page];
    const cg = document.getElementById("crumbGroup"), cp = document.getElementById("crumbPage");
    if(cg) cg.textContent = cr[0];
    if(cp) cp.textContent = cr[1];
    const mcp = document.getElementById("mCurrentPage");   // mobile top-bar page name
    if(mcp) mcp.textContent = cr[1];
    // the timeline needs the element visible to measure cell widths
    if(page === "today") renderToday();
    if(page === "approval") renderApproval();
    if(page === "paymentapproval") renderPaymentApproval();
    if(page === "deposit") renderDeposit();
    if(page === "calendar"){ renderTimeline(); if(typeof renderLog === "function") renderLog(); }
    if(page === "guestform") renderGuestForm();
    if(typeof partnersOnShowPage === "function") partnersOnShowPage(page);   // Partners sub-module (partners.js)
    if(page === "expenses" && typeof renderExpenses === "function") renderExpenses();
    if(page === "analytics" && typeof renderAnalytics === "function") renderAnalytics();
    if(page === "users" && typeof renderUsers === "function") renderUsers();
    if(page === "employees" && typeof renderEmployees === "function") renderEmployees();
    if(page === "log" && typeof renderLog === "function") renderLog();
    if(page === "assist" && typeof renderAssist === "function") renderAssist();
}

