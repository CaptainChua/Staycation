    <span class="m-pp-ico"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/><path d="m9 15 2 2 4-4"/></svg></span>
    <span class="m-pp-text"><span class="m-pp-eyebrow">Current Page</span><span class="m-pp-name" id="mCurrentPage">Dashboard</span></span>
    <svg class="m-pp-caret" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
  </button>
  <button class="m-add" onclick="openModal()" aria-label="Add booking">+</button>
</div>
<div class="sidebar-backdrop" id="sidebarBackdrop" onclick="closeSidebar()"></div>
<script>
  function toggleSidebar(){
    var sb=document.querySelector('.sidebar');
    var bd=document.getElementById('sidebarBackdrop');
    var open=sb.classList.toggle('open');
    if(bd) bd.classList.toggle('show', open);
    document.body.classList.toggle('nav-open', open);
    if(!open){ var s=document.getElementById('mNavSearch'); if(s){ s.value=''; filterNav(''); } }
  }
  function closeSidebar(){
    var sb=document.querySelector('.sidebar'); if(sb) sb.classList.remove('open');
    var bd=document.getElementById('sidebarBackdrop'); if(bd) bd.classList.remove('show');
    document.body.classList.remove('nav-open');
  }
  function filterNav(q){
    q=(q||'').toLowerCase().trim();
    document.querySelectorAll('.sidebar .nav-item').forEach(function(it){
      it.style.display = (!q || it.textContent.toLowerCase().indexOf(q)!==-1) ? '' : 'none';
    });
    document.querySelectorAll('.sidebar .nav-group').forEach(function(g){
      var sib=g.nextElementSibling, any=false;
      while(sib && !(sib.classList && sib.classList.contains('nav-group'))){
        if(sib.classList && sib.classList.contains('nav-item') && sib.style.display!=='none'){ any=true; break; }
        sib=sib.nextElementSibling;
      }
      g.style.display = (!q || any) ? '' : 'none';
    });
    applyNavCollapse();   // re-apply minimized sections once the search clears
  }
  document.addEventListener('click', function(e){
    if(window.innerWidth<=760 && e.target.closest && e.target.closest('.sidebar .nav-item')) closeSidebar();
  });
  // ----- collapsible sidebar sub-categories (Main / Front Desk / Partners / …) -----
  function navCollapsedSet(){
    try { return JSON.parse(localStorage.getItem('shph_nav_collapsed')) || []; } catch(e){ return []; }
  }
  function applyNavCollapse(){
    var collapsed = navCollapsedSet();
    var search = document.querySelector('.m-navsearch');
    var searching = !!(search && search.value && search.value.trim());   // while searching, show everything
    document.querySelectorAll('.sidebar .nav-group').forEach(function(g){
      var key = (g.textContent || '').trim();
      var isCol = !searching && collapsed.indexOf(key) !== -1;
      g.classList.toggle('collapsed', isCol);
      var sib = g.nextElementSibling;
      while(sib && !(sib.classList && sib.classList.contains('nav-group'))){
        if(sib.classList && sib.classList.contains('nav-item')) sib.classList.toggle('nav-collapsed', isCol);
        sib = sib.nextElementSibling;
      }
    });
  }
  function toggleNavGroup(g){
    var key = (g.textContent || '').trim();
    if(!key) return;
    var set = navCollapsedSet(), i = set.indexOf(key);
    if(i === -1) set.push(key); else set.splice(i, 1);
    try { localStorage.setItem('shph_nav_collapsed', JSON.stringify(set)); } catch(e){}   // per-device UI pref
    applyNavCollapse();
  }
  document.addEventListener('click', function(e){
    var g = e.target.closest && e.target.closest('.sidebar .nav-group');
    if(g) toggleNavGroup(g);
  });
  document.addEventListener('DOMContentLoaded', applyNavCollapse);
</script>

