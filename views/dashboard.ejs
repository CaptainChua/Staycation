// open the same clickable calendar, but in range mode: click a start day, then an end day
function openDepRange(e){
    if(e) e.stopPropagation();
    const pop = document.getElementById("sdDpPopup");
    sdRangeMode = true; sdPendingStart = null;
    depQuick = "custom";
    const cur = document.getElementById("depositDate").value || iso(today());
    const base = new Date(cur + "T00:00:00");
    sdDpMonth = new Date(base.getFullYear(), base.getMonth(), 1);
    sdRenderPicker();
    pop.classList.add("show");
}
function closeDepPicker(){ const p = document.getElementById("sdDpPopup"); if(p) p.classList.remove("show"); }
function sdPickerNav(dir){ sdDpMonth = new Date(sdDpMonth.getFullYear(), sdDpMonth.getMonth() + dir, 1); sdRenderPicker(); }
function sdRenderPicker(){
    const y = sdDpMonth.getFullYear(), m = sdDpMonth.getMonth();
    document.getElementById("sdDpTitle").textContent = MONTHS[m] + " " + y;
    const startDay = new Date(y, m, 1).getDay(), dim = new Date(y, m + 1, 0).getDate();
    const di = document.getElementById("depositDate").value;
    const de = (document.getElementById("depositDateEnd") || {}).value;
    const todayIso = iso(today());
    // while picking a range, highlight only the pending start until the end is chosen
    const rngS = (sdRangeMode && sdPendingStart) ? sdPendingStart : di;
    const rngE = (sdRangeMode && sdPendingStart) ? sdPendingStart : (de || di);
    let html = "";
    ["Su","Mo","Tu","We","Th","Fr","Sa"].forEach(d => html += `<div class="dp-wd">${d}</div>`);
    for(let i = 0; i < startDay; i++) html += `<div class="dp-day empty"></div>`;
    for(let d = 1; d <= dim; d++){
        const ci = iso(new Date(y, m, d));
        let cls = "dp-day";
        if(ci === todayIso) cls += " today";
        if(ci === rngS || ci === rngE) cls += " sel";
        else if(rngS && rngE && ci > rngS && ci < rngE) cls += " in-range";
        html += `<div class="${cls}" onclick="sdPickDay('${ci}')"><span class="n">${d}</span></div>`;
    }
    document.getElementById("sdDpGrid").innerHTML = html;
    const hint = document.getElementById("sdDpHint");
    if(hint) hint.textContent = sdRangeMode ? (sdPendingStart ? "Now pick the end date" : "Pick the start date") : "";
}
function sdPickDay(ci){
    const di = document.getElementById("depositDate"), de = document.getElementById("depositDateEnd");
    if(sdRangeMode){
        if(!sdPendingStart){            // first click → start (keep popup open for the end date)
            sdPendingStart = ci; di.value = ci; de.value = ci;
            sdUpdateLabel(); sdRenderPicker();
            return;
        }
        let s = sdPendingStart, en = ci;                 // second click → finalize
        if(en < s){ const t = s; s = en; en = t; }       // allow picking end before start
        di.value = s; de.value = en;
        sdPendingStart = null; sdRangeMode = false;
        depQuick = "custom";
        sdUpdateLabel(); closeDepPicker(); renderDeposit();
        return;
    }
    di.value = ci; de.value = "";       // single day
    depQuick = (ci === iso(today())) ? "today" : (ci === iso(addDays(today(), -1)) ? "yesterday" : "custom");
    sdUpdateLabel(); closeDepPicker(); renderDeposit();
}
function sdUpdateLabel(){
    const lbl = document.getElementById("depositDateLabel");
    if(!lbl) return;
    const v = document.getElementById("depositDate").value;
    const e = (document.getElementById("depositDateEnd") || {}).value;
    lbl.textContent = !v ? "Pick a date" : (e && e !== v ? fmt(v) + " – " + fmt(e) : fmt(v));
}
