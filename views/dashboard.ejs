            <button class="btn secondary" onclick="closeRecordModal()">Cancel</button>
            <button class="btn" onclick="saveRecord()">Create Record</button>
        </div>
    </div>
</div>

<script src="havens-data.js"></script>
<script src="site-settings.js"></script>
<script>
/* ---------- config ---------- */
const HAVENS = ["Haven 1", "Haven 2", "Haven 3", "Haven 4", "Haven 5", "Haven 7", "Haven 8", "Casa Bienca"];
// per-haven calendar colors: am = pastel, pm = slightly darker pastel
const HAVEN_COLORS = {
    "Haven 1":     { am:"#d9bdf5", pm:"#b98ee6" }, // pastel purple
    "Haven 2":     { am:"#fde68a", pm:"#ecca4e" }, // pastel yellow
    "Haven 3":     { am:"#bcbcbc", pm:"#8c8c8c" }, // pastel black (gray)
    "Haven 4":     { am:"#bcf3cf", pm:"#84dca0" }, // pastel green
    "Haven 5":     { am:"#bcd0fb", pm:"#7ea6f4" }, // pastel royal blue
    "Haven 7":     { am:"#aef0f7", pm:"#66d8e8" }, // pastel cyan
    "Haven 8":     { am:"#fcd0e7", pm:"#f5a3d0" }, // pastel pink
    "Casa Bienca": { am:"#cdff8f", pm:"#a8ec5c" }  // pastel neon green
};
function havenColor(b){
    const c = HAVEN_COLORS[b.haven] || { am:"#dddddd", pm:"#bbbbbb" };
    return b.slot === "evening" ? c.pm : c.am;
}
const STATUS_COLOR = { paid:"#2e9e5b", partial:"#e0a800", unpaid:"#d63a4f" };
const DAYS = 7; // days shown in calendar (week view)
let viewDays = DAYS; // current number of days shown (1 = today only)
let filterToWindow = false; // when true, the bookings table is limited to the shown date window
const MAX_RANGE = 7; // max selectable days in the date picker
let pendingStart = null; // iso of first click while choosing a range
let hoverIso = null;     // iso of hovered day (for live range preview)
const KEY = "shph_bookings_v3"; // bumped: pricing-based totals + deposit/holiday fields

/* ---------- date helpers ---------- */
function today(){ const d = new Date(); d.setHours(0,0,0,0); return d; }
function addDays(date, n){ const d = new Date(date); d.setDate(d.getDate()+n); return d; }
function iso(date){
    // local date (avoids UTC timezone shifting the day, e.g. in PH / UTC+8)
    const y = date.getFullYear();
    const m = String(date.getMonth()+1).padStart(2,"0");
    const d = String(date.getDate()).padStart(2,"0");
    return `${y}-${m}-${d}`;
}
function fmt(dateStr){
    const d = new Date(dateStr + "T00:00:00");
    return d.toLocaleDateString("en-PH", {month:"short", day:"numeric"});
}
function daysBetween(a, b){ // whole days from a to b
    return Math.round((new Date(b) - new Date(a)) / 86400000);
}
function peso(n){ return "₱" + Number(n).toLocaleString("en-PH"); }
// money with centavos, e.g. ₱90.50
function peso2(n){ return "₱" + Number(n).toLocaleString("en-PH", { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }

/* ---------- booking check-in / check-out times ---------- */
const DASH_HAVEN_TIMES = {
    "Haven 1":{in:"12:00 NN"}, "Haven 2":{in:"12:00 NN"}, "Haven 3":{in:"12:00 NN"},
    "Haven 4":{in:"3:00 PM"}, "Haven 5":{in:"3:00 PM"}, "Haven 7":{in:"3:00 PM"},
    "Haven 8":{in:"6:00 PM"}, "Casa Bienca":{in:"6:00 PM"}
};
function parseTimeMin(str){
    const m = String(str).match(/^(\d{1,2}):(\d{2})\s*(AM|PM|NN|MN)$/i);
    if(!m) return null;
    let h = Number(m[1]); const min = Number(m[2]); const suf = m[3].toUpperCase();
    if(suf === "NN") h = 12; else if(suf === "MN") h = 0; else if(suf === "PM") h = (h % 12) + 12; else h = h % 12;
    return h * 60 + min;
}
function minToTime(min){
    min = ((min % 1440) + 1440) % 1440;
    const h = Math.floor(min / 60), mm = String(min % 60).padStart(2, "0");
    if(h === 0) return `12:${mm} MN`;
    if(h === 12) return `12:${mm} NN`;
    return `${h > 12 ? h - 12 : h}:${mm} ${h < 12 ? "AM" : "PM"}`;
}
function bookingCheckinMin(b){
    if(b.checkinTime){ const m = parseTimeMin(b.checkinTime); if(m != null) return m === 0 ? 1440 : m; }
    const h = Number(b.stayHours) || 21;
    if(h === 6) return parseTimeMin(b.slot === "evening" ? "7:00 PM" : "8:00 AM");
    if(h === 21){ const t = DASH_HAVEN_TIMES[b.haven]; return t ? parseTimeMin(t.in) : parseTimeMin("12:00 NN"); }
    return parseTimeMin("8:00 AM");
}
function checkinTimeStr(b){ return minToTime(bookingCheckinMin(b)); }
function checkoutTimeStr(b){
    return minToTime(bookingCheckinMin(b) + ((Number(b.stayHours) || 21) + (Number(b.extend) || 0)) * 60);
}

/* ---------- pricing ---------- */
const PRICING = {
    stay6: 999,
    stay10: 1599,
    stay21Weekday: 1799,   // Sunday–Thursday
    stay21Weekend: 2099,   // Friday or Saturday (based on check-in day)
    swimRegular: 150,      // per pax
    swimHoliday: 300,      // per pax
    towel: 50,             // each
    extendPerHr: 150,
    deposit: 1000,
    baseIncludedPax: 2,    // base stay rate covers 2 pax
    addPax: 300,           // per extra head, age 5 and above
    addPaxMinAge: 5,       // only guests this age or older are charged
    maxPax: 5,             // max guests per unit
    maxAdults: 4,
    maxKids: 2,
    kidMaxAge: 13          // kid = 0–13 yo
};
// billable heads = guests aged 5+ ; first 2 are covered by the base rate
function billablePax(guests){
    return (guests || []).filter(g => g.age != null && Number(g.age) >= PRICING.addPaxMinAge).length;
}
function addPaxFee(guests){
    return Math.max(0, billablePax(guests) - PRICING.baseIncludedPax) * PRICING.addPax;
}
function lastName(name){
    const parts = (name || "").trim().split(/\s+/);
    return parts.length ? parts[parts.length - 1].toLowerCase() : "";
}
// occupied day range as a half-open interval [checkin, endExcl); same-day (6h) = 1 day
function endExcl(b){
    return b.checkout > b.checkin ? b.checkout : iso(addDays(new Date(b.checkin + "T00:00:00"), 1));
}
// returns an existing booking that conflicts with `cand`, or null.
// 10h/21h fully occupy the haven for overlapping dates; 6h allows a second
// booking on the same date only if it uses the OTHER time slot.
function findConflict(cand, excludeId){
    const cs = cand.checkin, ce = endExcl(cand);
    return bookings.find(b => {
        if(b.id === excludeId) return false;
        if(b.haven !== cand.haven) return false;
        const overlap = cs < endExcl(b) && b.checkin < ce; // half-open: back-to-back is OK
        if(!overlap) return false;
        if(Number(b.stayHours) !== 6 || Number(cand.stayHours) !== 6) return true; // a 10h/21h blocks fully
        return b.slot === cand.slot; // both 6h: clash only if same slot
    }) || null;
}
function slotLabel(slot){
    return slot === "morning" ? "AM (8AM–12NN)" : slot === "evening" ? "PM (7PM–12MN)" : "";
}
function baseRate(stayHours, checkinIso){
    stayHours = Number(stayHours);
    if(stayHours === 6) return PRICING.stay6;
    if(stayHours === 10) return PRICING.stay10;
    if(stayHours === 21){
        const wd = new Date(checkinIso + "T00:00:00").getDay(); // 0 Sun .. 6 Sat
        return (wd === 5 || wd === 6) ? PRICING.stay21Weekend : PRICING.stay21Weekday;
    }
    return 0;
}
function computeTotal(b){
    const base = baseRate(b.stayHours, b.checkin);
    const pax  = addPaxFee(b.guests);
    const swim = (Number(b.swimpass) || 0) * (b.holiday ? PRICING.swimHoliday : PRICING.swimRegular);
    const tow  = (Number(b.towels) || 0) * PRICING.towel;
    const ext  = (Number(b.extend) || 0) * PRICING.extendPerHr;
    const dep  = (b.deposit === undefined ? PRICING.deposit : Number(b.deposit)) || 0;
    return base + pax + swim + tow + ext + dep;
}

/* ---------- data ---------- */
function load(){
    const raw = localStorage.getItem(KEY);
    if(raw) return JSON.parse(raw).map(migrate);
    const seed = seedData();
    localStorage.setItem(KEY, JSON.stringify(seed));
    return seed;
}
function save(data){ localStorage.setItem(KEY, JSON.stringify(data)); }

// bring older saved bookings up to the current data shape
function migrate(b){
    if(!b.guests){
        b.guests = b.name ? [{ name:b.name, age:18 }] : [];
    }
    if(b.downpayment === undefined) b.downpayment = Number(b.paid) || 0;
    if(typeof b.swimpass === "boolean") b.swimpass = b.swimpass ? 1 : 0;
    if(b.stayHours === undefined) b.stayHours = 6;
    if(Number(b.stayHours) === 6 && !b.slot) b.slot = "morning"; // legacy 6h → default to AM slot
    return b;
}

// collections recorded after booking (via the Paid button) — separate from the downpayment
function collectedSum(b){ return (b.payments || []).reduce((s,p) => s + (Number(p.amount) || 0), 0); }
// total the customer has paid = original downpayment + later collections
function paidOf(b){ return Number(b.downpayment || 0) + collectedSum(b); }
function balanceOf(b){ return Math.max(0, Number(b.total || 0) - paidOf(b)); }
function statusOf(b){
    const paid = paidOf(b);
    if(paid >= b.total && b.total > 0) return "paid";
    if(paid > 0) return "partial";
    return "unpaid";
}

function seedData(){
    const t = today();
    const d = n => iso(addDays(t, n));
    const raw = [
        { id:1, haven:"Haven 1", contact:"0917 123 4567",
          guests:[{name:"Maria Santos",age:34},{name:"Pedro Santos",age:36}],
          checkin:d(0), checkout:d(2), stayHours:21,
          swimpass:2, towels:3, extend:0, holiday:false, method:"GCash", pay:"full", notes:"Early check-in requested" },
        { id:2, haven:"Haven 3", contact:"0928 555 1212",
          guests:[{name:"John Dela Cruz",age:28}],
          checkin:d(0), checkout:d(1), stayHours:10,
          swimpass:1, towels:4, extend:2, holiday:false, method:"Cash", pay:"partial", notes:"" },
        { id:3, haven:"Casa Bienca", contact:"0905 777 8899",
          guests:[{name:"Anna Reyes",age:41},{name:"Luis Reyes",age:43}],
          checkin:d(1), checkout:d(4), stayHours:21,
          swimpass:0, towels:5, extend:0, holiday:true, method:"BDO", pay:"full", notes:"Anniversary celebration" },
        { id:4, haven:"Haven 2", contact:"0917 444 3322",
          guests:[{name:"Mark Villanueva",age:30},{name:"Liza Cruz",age:27}],
          checkin:d(3), checkout:d(5), stayHours:10,
          swimpass:2, towels:2, extend:0, holiday:false, method:"Maya", pay:"none", notes:"" },
        { id:5, haven:"Haven 5", contact:"0939 222 1100",
          guests:[{name:"Grace Lim",age:25}],
          checkin:d(2), checkout:d(2), stayHours:6, slot:"morning",
          swimpass:0, towels:1, extend:1, holiday:false, method:"GCash", pay:"partial", notes:"" }
    ];
    return raw.map(b => {
        b.deposit = PRICING.deposit;
        b.total = computeTotal(b);
        b.downpayment = b.pay === "full" ? b.total : b.pay === "partial" ? 500 : 0;
        delete b.pay;
        return b;
    });
}

let bookings = load();
let rangeStart = today();
let viewMode = "week";   // "today" | "week" | "custom" — remembered across refreshes

/* ---------- guest helpers ---------- */
function primaryName(b){ return (b.guests && b.guests[0] && b.guests[0].name) || "(no name)"; }
function guestNames(b){ return (b.guests || []).map(g => g.name).join(", "); }
function guestSummary(b){
    return (b.guests || []).map(g => `${g.name} (${g.age})`).join("<br>");
}

/* ---------- today's booking ---------- */
// classify a booking relative to TODAY
function todayInfo(b, t){
    const dayUse = !(b.checkout > b.checkin);          // 6h/10h same-day stays
    const arrives  = b.checkin === t;
    const departs  = dayUse ? b.checkin === t : b.checkout === t;
    const staying  = b.checkin <= t && t < endExcl(b); // physically in-house today
    let status = "", cls = "";
    if(arrives && departs){ status = "Day-use"; cls = "partial"; }
    else if(arrives)      { status = "Arriving"; cls = "unpaid"; }
    else if(departs)      { status = "Departing"; cls = "paid"; }
    else if(staying)      { status = "In-house"; cls = "partial"; }
    return { arrives, departs, staying, status, cls, relevant: arrives || departs || staying };
}
function addonsCell(b){
    const bits = [];
    if(b.swimpass > 0) bits.push(`🏊 ${b.swimpass}`);
    if(b.towels   > 0) bits.push(`🧺 ${b.towels}`);
    if(b.extend   > 0) bits.push(`⏱ +${b.extend}h`);
    return bits.length ? bits.join(" · ") : '<span class="muted">—</span>';
}
function todayRow(b, amountCol){
    const balance = balanceOf(b);
    const st = statusOf(b);
    return `<tr>
        <td><strong>${b.haven}</strong></td>
        <td>${guestSummary(b)}<br><span class="muted">${b.contact||""}</span></td>
        <td>${fmt(b.checkin)}<br><span class="muted">${checkinTimeStr(b)}</span></td>
        <td>${fmt(b.checkout)}<br><span class="muted">${checkoutTimeStr(b)}</span></td>
        <td>${b.stayHours ? b.stayHours + "h" + (Number(b.stayHours)===6 && b.slot ? "<br><span class='muted'>"+(b.slot==="morning"?"AM":"PM")+"</span>" : "") : "—"}</td>
        <td>${addonsCell(b)}</td>
        <td>${amountCol > 0 ? peso(amountCol) : '<span class="muted">—</span>'}</td>
        <td><span class="status ${st}">${st}</span></td>
        <td class="actions"><span class="edit" onclick="openModal(${b.id})">Edit</span></td>
    </tr>`;
}
function renderToday(){
    const t = iso(today());
    const lbl = document.getElementById("todayDateLabel");
    if(lbl) lbl.textContent = "— " + new Date(t + "T00:00:00").toLocaleDateString("en-PH", { weekday:"long", month:"long", day:"numeric", year:"numeric" });

    const tagged = bookings.map(b => ({ b, info: todayInfo(b, t) })).filter(x => x.info.relevant);
    const arrivals = tagged.filter(x => x.info.arrives).map(x => x.b)
        .sort((a,c) => bookingCheckinMin(a) - bookingCheckinMin(c));
    // in-house + departing, excluding pure arrivals already shown above
    const others = tagged.filter(x => !x.info.arrives).map(x => x.b)
        .sort((a,c) => checkoutTimeStr(a).localeCompare(checkoutTimeStr(c)));

    // cards
    const departCount = tagged.filter(x => x.info.departs).length;
    const inHouseCount = tagged.filter(x => x.info.staying).length;
    const toCollect = arrivals.reduce((s,b) => s + balanceOf(b), 0);
    const cards = [
        ["Arriving today",   arrivals.length, ""],
        ["Departing today",  departCount, ""],
        ["In-house now",     inHouseCount, ""],
        ["To collect today", peso(toCollect), "money"]
    ];
    const cardsEl = document.getElementById("todayCards");
    if(cardsEl) cardsEl.innerHTML = cards.map(c =>
        `<div class="card"><h3>${c[0]}</h3><div class="number ${c[2]}">${c[1]}</div></div>`).join("");

    const aBody = document.getElementById("todayArriveBody");
    if(aBody) aBody.innerHTML = arrivals.length
        ? arrivals.map(b => todayRow(b, balanceOf(b))).join("")
        : `<tr><td colspan="9" class="empty">No arrivals today.</td></tr>`;
    const aCount = document.getElementById("todayArriveCount");
    if(aCount) aCount.textContent = arrivals.length ? `(${arrivals.length})` : "";

    const sBody = document.getElementById("todayStayBody");
    if(sBody) sBody.innerHTML = others.length
        ? others.map(b => todayRow(b, balanceOf(b))).join("")
        : `<tr><td colspan="9" class="empty">Nobody else in-house or departing today.</td></tr>`;
    const sCount = document.getElementById("todayStayCount");
    if(sCount) sCount.textContent = others.length ? `(${others.length})` : "";
}

/* ---------- summary cards ---------- */
// the cards reflect whatever date window the calendar is showing
function renderSummary(){
    const startIso = iso(rangeStart);
    const endIso = iso(addDays(rangeStart, viewDays)); // exclusive
    const todayIso = iso(today());
    const isToday = (viewDays === 1 && startIso === todayIso);

    const inWindow = b => b.checkin >= startIso && b.checkin < endIso;
    const checkins  = bookings.filter(inWindow).length;
    const checkouts = bookings.filter(b => b.checkout >= startIso && b.checkout < endIso).length;
    // occupied = havens with a booking overlapping the window
    const occHavens = new Set(
        bookings.filter(b => b.checkin < endIso && endExcl(b) > startIso).map(b => b.haven)
    );
    const occupied = HAVENS.filter(h => occHavens.has(h)).length;
    const available = HAVENS.length - occupied;
    const revenue = bookings.filter(inWindow).reduce((s,b) => s + paidOf(b), 0);
    const pending = bookings.filter(inWindow).reduce((s,b) => s + balanceOf(b), 0);

    // period label for the card titles
    const period = isToday ? "Today"
        : (viewDays === 1 ? fmt(startIso)
        : fmt(startIso) + "–" + fmt(iso(addDays(rangeStart, viewDays-1))));
    const occLabel = isToday ? "" : ` (${period})`;

    const cards = [
        [isToday ? "Today's Check-ins"  : `Check-ins · ${period}`, checkins, ""],
        [isToday ? "Today's Check-outs" : `Check-outs · ${period}`, checkouts, ""],
        [`Occupied Havens${occLabel}`, occupied, ""],
        [`Available Havens${occLabel}`, available, ""],
        [isToday ? "Collected Today" : `Collected · ${period}`, peso(revenue), "money"],
        [isToday ? "Pending Today"   : `Pending · ${period}`, peso(pending), "money"]
    ];
    const cardsHtml = cards.map(c => `
        <div class="card">
            <h3>${c[0]}</h3>
            <div class="number ${c[2]}">${c[1]}</div>
        </div>`).join("");
    document.getElementById("summaryCards").innerHTML = cardsHtml;
    const calCards = document.getElementById("summaryCardsCal");
    if(calCards) calCards.innerHTML = cardsHtml;
    syncFinInputs();
    renderHavenAnalytics();
    saveView();
}

/* ---------- per-haven analytics ---------- */
// small horizontal bar group; bolds the biggest row ("mostly booked")
function miniBars(items){
    const max = Math.max(1, ...items.map(i => i.value));
    const peak = Math.max(...items.map(i => i.value));
    return `<div class="mini-bars">` + items.map(i => `
        <div class="mb-row">
            <span class="mb-label">${i.label}</span>
            <span class="mb-track"><span class="mb-fill" style="width:${(i.value / max) * 100}%;background:${i.color}"></span></span>
            <span class="mb-val ${peak > 0 && i.value === peak ? "ha-peak" : ""}">${i.value}</span>
        </div>`).join("") + `</div>`;
}

function renderHavenAnalytics(){
    const el = document.getElementById("havenAnalytics");
    if(!el) return;

    const startIso = iso(rangeStart);
    const endIso   = iso(addDays(rangeStart, viewDays)); // exclusive
    const inWin = b => b.checkin < endIso && endExcl(b) > startIso;

    const periodEl = document.getElementById("havenAnalyticsPeriod");
    if(periodEl){
        periodEl.textContent = viewDays === 1
            ? "— " + fmt(startIso)
            : "— " + fmt(startIso) + " to " + fmt(iso(addDays(rangeStart, viewDays - 1)));
    }

    // show all havens, or only the one chosen in the haven filter
    const havenSel = document.getElementById("finHaven");
    const pick = havenSel ? havenSel.value : "";
    const list = pick ? HAVENS.filter(h => h === pick) : HAVENS;

    el.innerHTML = list.map(h => {
        const c  = HAVEN_COLORS[h] || { am:"#cccccc", pm:"#aaaaaa" };
        const bk = bookings.filter(b => b.haven === h && inWin(b));
        const booked = bk.length;

        // booked vs free days inside the window (clamped to the window)
        const occDays = new Set();
        bk.forEach(b => {
            const s = b.checkin < startIso ? startIso : b.checkin;
            const e = endExcl(b) > endIso ? endIso : endExcl(b);
            for(let d = new Date(s + "T00:00:00"); iso(d) < e; d = addDays(d, 1)) occDays.add(iso(d));
        });
        const occupiedDays = occDays.size;
        const freeDays = Math.max(0, viewDays - occupiedDays);

        // stay-length distribution (which hours are mostly booked)
        const stay = { 6:0, 10:0, 21:0 };
        bk.forEach(b => { const s = Number(b.stayHours) || 0; if(stay[s] != null) stay[s]++; });

        // check-in time (AM / PM for 6h, otherwise full-day)
        const ci = { AM:0, PM:0, Full:0 };
        bk.forEach(b => {
            if(Number(b.stayHours) === 6) ci[b.slot === "evening" ? "PM" : "AM"]++;
            else ci.Full++;
        });

        const towels    = bk.reduce((s, b) => s + (Number(b.towels)   || 0), 0);
        const pool      = bk.reduce((s, b) => s + (Number(b.swimpass) || 0), 0);
        const extendHrs = bk.reduce((s, b) => s + (Number(b.extend)   || 0), 0);
        const advList   = bk.filter(b => Number(b.downpayment) > 0);
        const advCount  = advList.length;
        const advTotal  = advList.reduce((s, b) => s + Number(b.downpayment), 0);

        return `<div class="ha-card">
            <div class="ha-head"><span class="dot" style="background:${c.am}"></span>${h}</div>
            <div class="ha-stats">
                <div class="ha-stat"><b>${booked}</b><span>booking${booked === 1 ? "" : "s"}</span></div>
                <div class="ha-stat"><b>${freeDays}</b><span>free day${freeDays === 1 ? "" : "s"}</span></div>
                <div class="ha-stat"><b>${occupiedDays}</b><span>booked day${occupiedDays === 1 ? "" : "s"}</span></div>
                <div class="ha-stat"><b>${towels}</b><span>towels</span></div>
                <div class="ha-stat"><b>${pool}</b><span>pool pass</span></div>
                <div class="ha-stat"><b>+${extendHrs}h</b><span>extended</span></div>
                <div class="ha-stat" style="grid-column:1 / -1;"><b>${peso(advTotal)}</b><span>${advCount} advance booking${advCount === 1 ? "" : "s"} (with downpayment)</span></div>
            </div>
            <div class="ha-chart">
                <div class="ha-chart-title">Hours booked</div>
                ${miniBars([
                    { label:"6 hrs",  value:stay[6],  color:c.am },
                    { label:"10 hrs", value:stay[10], color:c.pm },
                    { label:"21 hrs", value:stay[21], color:"#7a7a7a" }
                ])}
            </div>
            <div class="ha-chart">
                <div class="ha-chart-title">Check-in time</div>
                ${miniBars([
                    { label:"AM slot",  value:ci.AM,   color:"#f5a3d0" },
                    { label:"PM slot",  value:ci.PM,   color:"#7ea6f4" },
                    { label:"Full day", value:ci.Full, color:"#bcbcbc" }
                ])}
            </div>
        </div>`;
    }).join("");
}

