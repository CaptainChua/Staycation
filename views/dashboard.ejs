        <button type="button" onclick="dayCalNav(-1)">‹</button>
        <span>${MONTHS[m]} ${y}</span>
        <button type="button" onclick="dayCalNav(1)">›</button>
    </div><div class="dp-grid">`;
    ["Su","Mo","Tu","We","Th","Fr","Sa"].forEach(d => html += `<div class="dp-wd">${d}</div>`);
    for(let i = 0; i < first; i++) html += `<div class="dp-day empty"></div>`;
    for(let d = 1; d <= dim; d++){
        const ci = iso(new Date(y, m, d));
        const cls = "dp-day" + (ci === dayCalSelected ? " sel" : "") + (ci === todayIso ? " today" : "");
        html += `<div class="${cls}" onclick="pickDayDate('${ci}')"><span class="n">${d}</span></div>`;
    }
    html += `</div>`;
    document.getElementById("d_date_cal").innerHTML = html;
}
function dayCalNav(dir){
    dayCalMonth = new Date(dayCalMonth.getFullYear(), dayCalMonth.getMonth() + dir, 1);
    renderDayCal();
}
function toggleDayCal(e){
    if(e) e.stopPropagation();
    const pop = document.getElementById("d_date_cal");
    if(pop.classList.contains("show")){ pop.classList.remove("show"); return; }
    dayCalMonth = new Date((dayCalSelected || iso(today())) + "T00:00:00");
    renderDayCal();
    pop.classList.add("show");
}
function closeDayCal(){ const el = document.getElementById("d_date_cal"); if(el) el.classList.remove("show"); }

/* ---------- cut-off + day pickers for the record modal ---------- */
function cutoffOptionLabel(payIso){
    const d = new Date(payIso + "T00:00:00"), r = cutoffRangeOf(payIso);
    return d.toLocaleDateString("en-PH", { month:"short", day:"numeric", year:"numeric" }) + " cut-off · " + fmt(r.start) + "–" + fmt(r.end);
}
// list cut-offs around today (a few months back and forward)
function fillCutoffOptions(){
    const sel = document.getElementById("d_cutoff");
    const t = today();
    const opts = [];
    for(let off = -4; off <= 2; off++){
        const d = new Date(t.getFullYear(), t.getMonth() + off, 1);
        const y = d.getFullYear(), m = d.getMonth();
        opts.push(pIso(new Date(y, m, 15)));
        opts.push(pIso(new Date(y, m, Math.min(30, pLastDay(y, m)))));
    }
    sel.innerHTML = opts.map(p => `<option value="${p}">${cutoffOptionLabel(p)}</option>`).join("");
}
// fill the Day dropdown with every date inside the chosen cut-off
function fillDayOptions(payIso, selectIso){
    const sel = document.getElementById("d_day");
    const r = cutoffRangeOf(payIso);
    let opts = "";
    for(let d = new Date(r.start + "T00:00:00"); iso(d) <= r.end; d = addDays(d, 1)){
        const i = iso(d);
        opts += `<option value="${i}">${fmt(i)}</option>`;
    }
    sel.innerHTML = opts;
    if(selectIso) sel.value = selectIso;
    syncDayDate();
}
