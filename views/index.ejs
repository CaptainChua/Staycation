<script>
// Render the hero feature + haven cards from the shared data (managed in the Admin Dashboard)
(function renderHome(){
    function esc(s){ return String(s == null ? "" : s).replace(/[&<>"]/g, c => ({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;" }[c])); }
    function cleanPrice(raw){ return String(raw || "").replace(/^\s*price\s*starts?\s*at:?\s*/i, "").trim(); }
    function metaOf(h){ return h.meta || h.type || h.roomType || (h.pax ? h.pax + " pax" : ""); }

    const havens = ((typeof loadHavens === "function") ? loadHavens() : []).filter(h => h.live !== false);

    // hero feature = the first live haven
    const feat = havens[0];
    if(feat){
        const img = document.getElementById("shHeroImg");
        if(img){ img.src = feat.image || ""; img.alt = feat.name || "Featured haven"; }
        const nm = document.getElementById("shHeroName");
        const meta = metaOf(feat);
        if(nm) nm.textContent = feat.name + (meta ? " · " + meta : "");
        const pr = document.getElementById("shHeroPrice");
        if(pr){ const p = cleanPrice(feat.price); pr.textContent = p ? "Price starts at " + p : ""; }
        const tag = document.getElementById("shHeroTag");
        if(tag) tag.href = "havens.html?id=" + feat.id;
    }

    const cards = havens.map(h => {
        const price = cleanPrice(h.price);
        const priceTxt = price ? "Price starts at " + price : "";
        const meta = metaOf(h);
        const desc = h.description || "";
        return `
        <article class="sh-card">
          <a class="sh-card-media" href="havens.html?id=${encodeURIComponent(h.id)}"><img src="${esc(h.image)}" alt="${esc(h.name)}" loading="lazy"></a>
          <div class="sh-card-body">
            <div class="sh-card-head">
              <h3>${esc(h.name)}</h3>
              ${meta ? `<span class="sh-card-meta">${esc(meta)}</span>` : ""}
            </div>
            ${desc ? `<p class="sh-card-desc">${esc(desc)}</p>` : ""}
            <div class="sh-card-foot">
              <span class="sh-card-price">${esc(priceTxt)}</span>
              <a class="sh-book" href="havens.html?id=${encodeURIComponent(h.id)}">Book</a>
            </div>
          </div>
        </article>`;
    }).join("");
    const wrap = document.getElementById("cards");
    if(wrap) wrap.innerHTML = cards;
})();
</script>
<script src="script.js"></script>
<script>
/* ---------- homepage date range (native date inputs, matches the design) ---------- */
(function(){
    const ci = document.getElementById("checkinDate");
    const co = document.getElementById("checkoutDate");
    function todayIso(){ const d = new Date(); return d.getFullYear() + "-" + String(d.getMonth()+1).padStart(2,"0") + "-" + String(d.getDate()).padStart(2,"0"); }
    if(ci) ci.min = todayIso();

    function onCheckin(){
        if(co){ co.min = (ci && ci.value) || todayIso(); if(co.value && ci.value && co.value < ci.value) co.value = ""; }
        updateStayHours();
    }
    if(ci) ci.addEventListener("change", onCheckin);
    if(co) co.addEventListener("change", updateStayHours);

    // the booking flow reads dates through these (script.js / checkAvailability unchanged)
    window.getStayDates = function(){ return { start: (ci && ci.value) || null, end: (co && co.value) || null }; };
    window.openCalendar = function(){ if(ci){ ci.focus(); try{ if(ci.showPicker) ci.showPicker(); }catch(e){} } };

    // when the stay spans 2+ nights, inject a "N nights" option into HOURS and auto-select it
    function updateStayHours(){
        const sel = document.getElementById("searchHours");
        if(!sel) return;
        const prev = sel.querySelector("option[data-nights]");
        if(prev) prev.remove();
        const s = ci && ci.value, e = co && co.value;
        if(s && e && e > s){
            const nights = Math.round((new Date(e) - new Date(s)) / 86400000);
            if(nights >= 2){
                const opt = document.createElement("option");
                opt.value = "nights:" + nights;
                opt.textContent = nights + " nights";
                opt.setAttribute("data-nights", nights);
                sel.appendChild(opt);
                sel.value = opt.value;
            }
        }
    }
})();
</script>

</body>
