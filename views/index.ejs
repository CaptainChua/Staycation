<!-- ============================================================
     Front page — imported from Claude Design "Staycation Haven PH"
     Scoped styles (sh-*) live here so other pages (which share
     style.css) are unaffected. The booking search, date picker,
     guest selector and live haven cards keep their original hooks.
     ============================================================ -->
<style>
  /* self-hosted Recoleta (the design's headline font) — single Black weight file */
  @font-face{
    font-family:'Recoleta';
    src:url('/fonts/RecoletaAlt-Bold.ttf') format('truetype');
    font-weight:400 900; font-style:normal; font-display:swap;
  }
  :root{
    --sh-bg:#faf6ef; --sh-card:#ffffff; --sh-ink:#1b1a17; --sh-muted:#6f6a60;
    --sh-gold:#b1832f; --sh-gold-2:#c99a3f; --sh-line:#ece4d5; --sh-footer:#f2ece0;
  }
  /* headline serif — Recoleta (Fraunces is the fallback if the font can't load) */
  .sh-brand, .sh-badge, .sh-hero h1, #results h2, .sh-sec-head h2, .sh-card-head h3, .sh-promo h2{ font-family:'Recoleta', 'Fraunces', Georgia, 'Times New Roman', serif; }
  .sh-hero h1, .sh-promo h2, .sh-sec-head h2{ font-weight:800; }
  *, *::before, *::after{ box-sizing:border-box; }
  body{ background:var(--sh-bg); color:var(--sh-ink); font-family:'Inter',system-ui,-apple-system,sans-serif; margin:0; }
  .sh-wrap{ max-width:1320px; margin:0 auto; padding-left:24px; padding-right:24px; }

  /* nav — overrides the bare header{} rule in style.css (padding/white bg/shadow) */
  .sh-nav{ position:sticky; top:0; z-index:60; display:block; padding:0; box-shadow:none; background:rgba(250,246,239,.9); backdrop-filter:blur(8px); border-bottom:1px solid var(--sh-line); }
  .sh-nav-in{ max-width:1320px; margin:0 auto; padding:15px 24px; display:flex; align-items:center; justify-content:space-between; }
  .sh-brand{ display:flex; align-items:center; gap:10px; text-decoration:none; color:var(--sh-ink); font-family:'Recoleta','Fraunces',Georgia,serif; font-weight:700; font-size:22px; letter-spacing:.01em; }
  .sh-badge{ width:34px; height:34px; border-radius:9px; background:linear-gradient(135deg,#c49a45,#9c7327); color:#fff; display:grid; place-items:center; font-family:'Recoleta','Fraunces',Georgia,serif; font-weight:700; font-size:18px; box-shadow:0 3px 10px rgba(156,115,39,.35); }
  .sh-links{ display:flex; gap:28px; }
  .sh-links a{ margin:0; text-decoration:none; color:var(--sh-ink); font-size:14px; font-weight:400; }
  .sh-links a:hover{ color:var(--sh-gold); }

  /* hero */
  .sh-hero{ position:relative; padding:56px 0 26px; }
  .sh-hero-grid{ display:grid; grid-template-columns:1fr 1.1fr; gap:48px; align-items:stretch; }
  /* left column and photo are equal-height (align-items:stretch); the photo matches the copy's height */
  .sh-hero-copy{ display:flex; flex-direction:column; }
  .sh-eyebrow{ color:var(--sh-gold); font-size:12px; font-weight:500; letter-spacing:.26em; text-transform:uppercase; margin-bottom:18px; }
  .sh-hero h1{ font-family:'Recoleta','Fraunces',Georgia,serif; font-weight:700; font-size:clamp(44px,5.8vw,68px); line-height:1.03; letter-spacing:-.01em; margin:0 0 18px; }
  .sh-lead{ color:var(--sh-muted); font-size:16px; line-height:1.6; max-width:440px; margin:0 0 26px; }

  /* search card (native date inputs + working #searchHours / guest hooks) */
  .sh-search{ background:#fff; border-radius:22px; box-shadow:0 18px 40px rgba(60,45,20,.10); padding:12px; max-width:none; position:relative; }
  .sh-search-grid{ display:grid; grid-template-columns:1fr 1fr; }
  .sh-search .search-item{ padding:19px 22px; text-align:left; position:relative; }
  .sh-search .search-item:nth-child(odd){ border-right:1px solid var(--sh-line); }
  .sh-search .search-item:nth-child(1), .sh-search .search-item:nth-child(2){ border-bottom:1px solid var(--sh-line); }
  .sh-search .label{ display:block; font-size:10px; letter-spacing:.14em; color:#9a9384; text-transform:uppercase; margin-bottom:6px; font-weight:600; }
  .sh-search .value{ font-size:15px; color:var(--sh-ink); font-weight:400; }
  .sh-search .sh-date{ font-family:inherit; font-size:15px; color:var(--sh-ink); border:none; background:none; padding:0; margin:0; width:100%; cursor:pointer; outline:none; }
  .sh-search .sh-date::-webkit-calendar-picker-indicator{ opacity:.55; cursor:pointer; }
  .sh-search #searchHours{ border:none; background:none; padding:0; margin:0; font-family:inherit; font-size:15px; color:var(--sh-ink); width:100%; cursor:pointer; outline:none; }
  .sh-search .guest-trigger{ cursor:pointer; }
  .sh-search .guest-trigger .value{ display:block; }
  .sh-cta{ display:block; width:100%; margin-top:12px; padding:17px; border:none; border-radius:14px; background:var(--sh-ink); color:#f0d59a; font-family:'Inter',sans-serif; font-weight:600; font-size:15px; letter-spacing:.05em; cursor:pointer; }
  .sh-cta:hover{ background:#000; }

  /* hero photo + overlay tag */
  .sh-hero-media{ position:relative; border-radius:22px; overflow:hidden; box-shadow:0 24px 50px rgba(60,45,20,.16); height:100%; min-height:440px; background:#e7ded0; }
  /* absolute so the image fills the box but never expands the row — height comes from the copy */
  .sh-hero-media img{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block; }
  .sh-hero-tag{ position:absolute; left:16px; bottom:16px; background:#fff; border-radius:12px; padding:10px 14px; box-shadow:0 8px 22px rgba(0,0,0,.14); text-decoration:none; }
  .sh-hero-tag b{ display:block; color:var(--sh-ink); font-size:13px; font-weight:600; }
  .sh-hero-tag span{ display:block; color:var(--sh-gold); font-size:12px; margin-top:2px; }

  /* results (availability search output) */
  #results{ max-width:1320px; margin:0 auto; padding:8px 24px 0; }
  #results:empty{ display:none; padding:0; }
  #results h2{ font-family:'Recoleta','Fraunces',Georgia,serif; font-weight:700; font-size:30px; margin:14px 0 4px; }

  /* section header */
  .sh-section{ padding:38px 0; }
  .sh-sec-head{ display:flex; align-items:flex-end; justify-content:space-between; gap:16px; margin-bottom:22px; }
  .sh-sec-eyebrow{ color:var(--sh-gold); font-size:12px; font-weight:500; letter-spacing:.24em; text-transform:uppercase; margin-bottom:6px; }
  .sh-sec-head h2{ font-family:'Recoleta','Fraunces',Georgia,serif; font-weight:700; font-size:34px; margin:0; }
  .sh-viewall{ color:var(--sh-gold); text-decoration:none; font-size:14px; font-weight:500; white-space:nowrap; }
  .sh-viewall:hover{ text-decoration:underline; }

  /* haven cards */
  .sh-cards{ display:grid; grid-template-columns:repeat(3,1fr); gap:22px; }
  .sh-card{ background:#fff; border-radius:18px; overflow:hidden; box-shadow:0 12px 26px rgba(60,45,20,.08); display:flex; flex-direction:column; }
  .sh-card-media{ display:block; }
  .sh-card-media img{ width:100%; aspect-ratio:16/10; object-fit:cover; display:block; }
  .sh-card-body{ padding:16px 16px 18px; display:flex; flex-direction:column; gap:8px; flex:1; }
  .sh-card-head{ display:flex; align-items:baseline; justify-content:space-between; gap:10px; }
  .sh-card-head h3{ font-family:'Recoleta','Fraunces',Georgia,serif; font-weight:700; font-size:21px; margin:0; }
  .sh-card-meta{ color:#9a9384; font-size:12px; white-space:nowrap; }
  .sh-card-desc{ color:var(--sh-muted); font-size:13.5px; line-height:1.55; margin:0; }
  .sh-card-foot{ display:flex; align-items:center; justify-content:space-between; margin-top:auto; padding-top:8px; gap:10px; }
  .sh-card-price{ color:var(--sh-gold); font-size:13.5px; font-weight:500; }
  .sh-book{ background:var(--sh-ink); color:#fff; text-decoration:none; padding:8px 17px; border-radius:9px; font-size:13px; font-weight:500; }
  .sh-book:hover{ background:#000; }

  /* promo banner */
  .sh-promo{ padding:8px 0 48px; }
  .sh-promo-in{ background:#161513; border-radius:20px; padding:40px 44px; display:flex; align-items:center; justify-content:space-between; gap:24px; flex-wrap:wrap; }
  .sh-promo-eyebrow{ color:var(--sh-gold-2); font-size:12px; letter-spacing:.24em; text-transform:uppercase; margin-bottom:12px; }
  .sh-promo h2{ font-family:'Recoleta','Fraunces',Georgia,serif; font-weight:700; color:#fff; font-size:clamp(24px,3vw,32px); line-height:1.18; margin:0; max-width:560px; }
  .sh-promo-btn{ background:linear-gradient(180deg,#dcb052,#c2932e); color:#241a08; text-decoration:none; padding:14px 24px; border-radius:11px; font-weight:600; font-size:14px; white-space:nowrap; box-shadow:0 6px 16px rgba(194,147,46,.35); }
  .sh-promo-btn:hover{ background:linear-gradient(180deg,#e3b959,#c99a34); }

  /* footer */
  .sh-footer{ background:var(--sh-footer); border-top:1px solid var(--sh-line); }
  .sh-footer-in{ max-width:1320px; margin:0 auto; padding:48px 24px 28px; display:grid; grid-template-columns:1.5fr 1fr 1fr; gap:32px; }
  .sh-foot-brand p{ color:var(--sh-muted); font-size:13px; line-height:1.6; max-width:290px; margin:12px 0 0; }
  .sh-foot-col h4{ color:#9a9384; font-size:11px; letter-spacing:.18em; text-transform:uppercase; margin:0 0 14px; font-weight:600; }
  .sh-foot-col a, .sh-foot-col span{ display:block; color:var(--sh-ink); text-decoration:none; font-size:14px; margin-bottom:10px; }
  .sh-foot-col a:hover{ color:var(--sh-gold); }
  .sh-foot-bar{ border-top:1px solid var(--sh-line); text-align:center; padding:16px; color:#9a9384; font-size:12.5px; }

  @media(max-width:900px){
    .sh-hero{ padding-top:36px; }
    .sh-hero-grid{ grid-template-columns:1fr; gap:30px; }
    .sh-hero-media{ height:auto; min-height:0; aspect-ratio:4/3; }
    .sh-search{ max-width:none; }
    .sh-cards{ grid-template-columns:repeat(2,1fr); }
    .sh-footer-in{ grid-template-columns:1fr 1fr; }
    .sh-foot-brand{ grid-column:1 / -1; }
  }
  @media(max-width:600px){
    .sh-links{ gap:16px; font-size:13px; }
    .sh-brand{ font-size:19px; }
    .sh-cards{ grid-template-columns:1fr; }
    .sh-promo-in{ padding:28px 24px; }
    .sh-sec-head h2{ font-size:28px; }
    .sh-footer-in{ grid-template-columns:1fr 1fr; }
  }
  @media(max-width:420px){ .sh-footer-in{ grid-template-columns:1fr; } }
</style>

