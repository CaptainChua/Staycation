                        </div>
                        <div class="cal-fields">
                            <div class="cal-field" id="calFieldIn">
                                <span class="cell-label">CHECK-IN</span>
                                <span class="cal-field-value ph" id="calInValue">MM/DD/YYYY</span>
                                <button type="button" class="cal-clear-x" id="calClearX" onclick="clearDates()">✕</button>
                            </div>
                            <div class="cal-field" id="calFieldOut">
                                <span class="cell-label">CHECKOUT</span>
                                <span class="cal-field-value ph" id="calOutValue">MM/DD/YYYY</span>
                            </div>
                        </div>
                    </div>

                    <div class="cal-months">
                        <button type="button" class="cal-nav cal-prev" id="calPrev" onclick="changeMonth(-1)">‹</button>
                        <div class="cal-month" id="calMonth0"></div>
                        <div class="cal-month" id="calMonth1"></div>
                        <button type="button" class="cal-nav cal-next" onclick="changeMonth(1)">›</button>
                    </div>

                    <div class="cal-footer">
                        <span class="cal-kbd" aria-hidden="true">⌨</span>
                        <div class="cal-actions">
                            <button type="button" class="cal-text-btn" onclick="clearDates()">Clear dates</button>
