                            <div class="g-sub">₱150/pax · ₱300 on holidays</div>
                        </div>
                        <div class="stepper">
                            <button type="button" class="step-btn" id="poolMinus" onclick="changeAddon('pool',-1)">−</button>
                            <span class="step-count" id="poolPassCount">0</span>
