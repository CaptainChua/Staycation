<!--
    Haven details are managed from the Admin Dashboard
    (dashboard.html → "Haven Listings"). This page just
    displays the haven matching ?id= in the link.
-->
<script src="havens-data.js"></script>
<script src="site-settings.js"></script>
<script src="amenity-icons.js"></script>

<section class="haven-detail">
    <a class="back-link" id="backLink" href="havens.html">← Back to all havens</a>

    <div id="haven-content">
        <!-- Haven details are filled in automatically -->
    </div>
</section>

<footer>
    <p>© 2026 Staycation Haven PH. All Rights Reserved.</p>
</footer>

<!-- floating photo viewer -->
<div class="lightbox" id="photoLightbox" hidden onclick="closeLightbox()">
    <span class="lightbox-close" aria-hidden="true">✕</span>
    <img id="lightboxImg" src="" alt="">
</div>

<script>
function openLightbox(src){
    document.getElementById("lightboxImg").src = src;
    document.getElementById("photoLightbox").removeAttribute("hidden");
}
// clicking a thumbnail swaps it into the big main photo
function setMainPhoto(el){
    const main = document.getElementById("havenPhoto");
    if(main) main.src = el.src;
    document.querySelectorAll(".haven-thumb").forEach(t => t.classList.remove("active"));
    el.classList.add("active");
}
function closeLightbox(){
    document.getElementById("photoLightbox").setAttribute("hidden", "");
}

// listing of all havens (shown when havens.html is opened without ?id=)
function renderHavenList(container) {
    document.title = "Our Havens | Staycation Haven PH";
    const section = document.querySelector(".haven-detail");
    if (section) section.style.maxWidth = "1200px";
    const backLink = document.getElementById("backLink");
    if (backLink) { backLink.textContent = "← Back to home"; backLink.href = "index.html"; }

    const havens = loadHavens();
    container.innerHTML = `
        <h1 style="margin-bottom:24px;">Our Havens</h1>
        <div class="cards">
            ${havens.map(h => `
                <a class="card" href="havens.html?id=${h.id}">
                    <img src="${h.image}" alt="${h.name}">
                    <h3>${h.name}</h3>
                    <p>${h.description}</p>
                </a>`).join("")}
        </div>`;
}

function renderHaven() {
    const id = new URLSearchParams(window.location.search).get("id");
    const container = document.getElementById("haven-content");

    // no specific haven → show the full listing of all havens
    if (!id) { renderHavenList(container); return; }

    const haven = getHaven(id);
    if (!haven) {
        container.innerHTML = "<p>Sorry, that haven was not found.</p>";
        return;
    }

    document.title = haven.name + " | Staycation Haven PH";
    currentHavenName = haven.name;

    const gallery = haven.gallery || [];
    const photos = [haven.image, ...gallery].filter(Boolean);
    const thumbs = photos.length > 1
        ? `<div class="haven-thumbs">${photos.map((src, i) =>
              `<img class="haven-thumb${i === 0 ? " active" : ""}" src="${src}" alt="" onclick="setMainPhoto(this)">`).join("")}</div>`
        : "";

    const customAddonRows = CUSTOM_ADDONS.map((a, i) => `
        <div class="addon-row">
            <div>
                <div class="g-title">${a.name}</div>
                <div class="g-sub">${peso(a.price)}${a.perPax ? " / pax" : ""}</div>
            </div>
            <div class="stepper">
                <button type="button" class="step-btn" id="ca${i}Minus" onclick="changeCustomAddon(${i},-1)" disabled>−</button>
                <span class="step-count" id="ca${i}Count">0</span>
                <button type="button" class="step-btn" onclick="changeCustomAddon(${i},1)">+</button>
            </div>
        </div>`).join("");

    container.innerHTML = `
        <img class="haven-photo" id="havenPhoto" src="${haven.image}" alt="${haven.name}" onclick="openLightbox(this.src)">
        ${thumbs}
        <div class="haven-grid">
            <div class="haven-main">
                <h1>${haven.name}</h1>
                <p class="haven-meta">Entire staycation unit · Up to 6 guests · Mplace Tower D, Quezon City</p>
                <p class="haven-price">Price starts at ₱999</p>
                <hr class="haven-divider">
                <p class="haven-desc">${haven.description}</p>
                <hr class="haven-divider">
                <h3>What this place offers</h3>
                <ul class="haven-amenities">
                    ${haven.amenities.map(a => `<li>${amenityIcon(a)}<span>${amenityLabel(a)}</span></li>`).join("")}
                </ul>
                <button class="book-btn" onclick="alert('Booking request sent for ${haven.name}!')">Book This Haven</button>
            </div>

            <aside class="booking-card">
                <h2 class="booking-title">Details of your stay:</h2>

                <div class="booking-fields">
                    <div class="date-row">
                        <button type="button" class="date-cell" onclick="openCalendar()">
                            <span class="cell-label">CHECK-IN</span>
                            <span class="date-value empty" id="checkinValue">Add date</span>
                        </button>
                        <button type="button" class="date-cell" onclick="openCalendar()">
                            <span class="cell-label">CHECKOUT</span>
                            <span class="date-value empty" id="checkoutValue">Add date</span>
                        </button>
                    </div>

                    <div class="stay-cell" id="stayCell">
                        <span class="cell-label">HOURS OF STAY</span>
                        <select id="hoursOfStay" onchange="syncBooking()" disabled>
                            <option value="">Select dates first</option>
                        </select>
                    </div>

                    <div class="stay-cell">
                        <span class="cell-label">CHECK-IN TIME</span>
                        <select id="checkinTime" onchange="syncBooking()" disabled>
                            <option value="">Select dates first</option>
                        </select>
                    </div>

                    <div class="stay-cell">
                        <span class="cell-label">CHECK-OUT TIME</span>
                        <span class="checkout-time empty" id="checkoutTimeValue">—</span>
                    </div>

                    <div class="checkin-info" id="checkinInfo"></div>

                    <div class="guest-cell">
                        <button type="button" class="guest-toggle" onclick="toggleGuests()">
                            <span class="guest-toggle-text">
                                <span class="cell-label">GUESTS</span>
                                <span id="guestSummary">1 guest</span>
                            </span>
                            <span class="chevron" id="guestChevron">⌄</span>
                        </button>

                        <div class="guest-panel" id="guestPanel" hidden>
                            <div class="guest-stepper-row">
                                <div>
                                    <div class="g-title">Adults</div>
                                    <div class="g-sub">Age 18+</div>
                                </div>
                                <div class="stepper">
                                    <button type="button" class="step-btn" id="adultsMinus" onclick="changeGuest('adults',-1)">−</button>
                                    <span class="step-count" id="adultsCount">1</span>
