<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/seed') %>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment | Staycation Haven PH</title>
    <link rel="icon" href="images/logo.png">
    <link rel="stylesheet" href="style.css">
    <style>
        .booknow-wrap{ max-width:1000px; margin:40px auto; padding:0 20px; }
        .booknow-wrap h1{ margin-bottom:20px; }

        .booknow-grid{
            display:grid;
            grid-template-columns:1fr 360px;
            gap:40px;
            align-items:start;
        }
        @media(max-width:760px){ .booknow-grid{ grid-template-columns:1fr; } }

        .booking-form,
        .summary-card,
        .empty-state,
        .booknow-success{
            background:#fff;
            padding:24px;
            border-radius:16px;
            box-shadow:0 5px 15px rgba(0,0,0,.06);
        }
        .summary-card{ border:1px solid #e6e6e6; box-shadow:0 6px 20px rgba(0,0,0,.08); }
        .booking-form h2, .summary-card h2{ margin:0 0 16px; }

        .pay-amount{ font-size:34px; font-weight:bold; color:#b8923a; margin:6px 0 2px; }
        .pay-sub{ color:#666; margin:0 0 20px; }
        .pay-method{
            background:#faf7f8;
            border:1px solid #eee;
            border-radius:10px;
            padding:14px;
            margin-bottom:18px;
            text-align:center;
        }
        .pay-label{ font-size:12px; font-weight:bold; letter-spacing:.5px; color:#717171; }
        .pay-details{ font-size:18px; font-weight:600; margin-top:6px; color:#1f1f1f; line-height:1.5; }
        .pay-note{ font-size:13px; color:#777; margin-top:16px; line-height:1.5; }
        .pay-intro{ margin:14px 0 4px; font-size:15px; }
        .pay-screenshot{ margin:0 0 8px; font-size:12px; font-weight:bold; color:#c1123e; letter-spacing:.3px; }
        .pay-acct{ padding:4px 0 12px; border-bottom:1px solid #eee; text-align:center; }
        .pay-qr{ display:block; width:230px; max-width:100%; margin:16px auto; border:1px solid #eee; border-radius:10px; }
        .pay-warn{ margin:10px 0 0; font-size:13px; color:#444; }
        .confirm-btn{ width:100%; font-size:16px; font-weight:bold; }
        .confirm-btn:disabled{ opacity:.5; cursor:not-allowed; }
        .pay-upload{ margin:0 0 16px; }
        .pay-upload-label{ font-size:13px; font-weight:bold; color:#444; margin-bottom:8px; }
        .pay-upload-label .req{ color:#c1123e; }
        .pay-upload-box{ display:flex; align-items:center; justify-content:center;
            cursor:pointer; color:#9a8f86; font-size:14px; font-weight:600; text-align:center; padding:6px 0; }
        .pay-upload-box img{ max-width:100%; max-height:240px; border-radius:8px; }
        .pay-upload-btn{ display:inline-flex; align-items:center; gap:8px; background:#b8923a; color:#fff;
            padding:12px 24px; border-radius:40px; font-size:14px; font-weight:bold; cursor:pointer; }
        .pay-upload-box:hover .pay-upload-btn{ background:#a37f2f; }

        .sum-row{
            display:flex;
            justify-content:space-between;
            gap:12px;
            padding:7px 0;
            font-size:14px;
            color:#555;
        }
        .sum-row strong{ color:#222; text-align:right; }
        .price-list{ margin-top:14px; border-top:1px solid #e6e6e6; padding-top:6px; }

        .empty-state, .booknow-success{ padding:34px; line-height:1.6; }
        .booknow-success h2{ margin-top:0; }
        .booknow-success{ text-align:center; }
        #payTitle{ display:flex; justify-content:space-between; align-items:baseline; gap:16px; flex-wrap:wrap; }
        .booking-no{ font-size:18px; font-weight:bold; color:#b8923a; white-space:nowrap; }
        .confirm-recap{ background:#faf7f2; border:1px solid #eee; border-radius:12px; padding:14px 18px; margin:18px auto; max-width:440px; text-align:left; }
        .cr-row{ display:flex; justify-content:space-between; gap:12px; padding:7px 0; font-size:14px; color:#555; }
        .cr-row strong{ color:#222; text-align:right; }
        .cr-row.cr-total{ border-top:1px solid #e6e6e6; margin-top:4px; padding-top:11px; font-size:15px; }
        .confirm-msg{ font-size:15px; color:#222; margin:6px 0 6px; }
        .fb-link{ display:inline-block; color:#1877f2; font-weight:bold; text-decoration:none; margin-bottom:10px; }
        .fb-link:hover{ text-decoration:underline; }
        .home-link{
            display:inline-block;
            margin-top:18px;
            background:#b8923a;
            color:#fff;
            padding:12px 26px;
            border-radius:40px;
            text-decoration:none;
            font-weight:bold;
        }
    </style>
</head>
<body>

<header>
    <a class="logo" href="index.html"><img class="logo-img" src="images/logo.png" alt="" onerror="this.remove()"> Staycation Haven PH</a>
    <nav>
        <a href="index.html">Home</a>
        <a href="havens.html">Havens</a>
        <a href="#">Promos</a>
        <a href="#">Contact</a>
    </nav>
</header>

<section class="booknow-wrap">
    <a class="back-link" href="booknow.html">← Back</a>
    <h1 id="payTitle">Payment</h1>
    <div id="payment-content"><!-- filled by JS --></div>
</section>

<footer>
    <p>© 2026 Staycation Haven PH. All Rights Reserved.</p>
</footer>

<script src="site-settings.js"></script>
<script>
function peso(n){ return "₱" + Number(n).toLocaleString("en-PH"); }
function fmtDate(iso){
    if(!iso) return "";
    const d = new Date(iso + "T00:00:00");
    return d.toLocaleDateString("en-US", { weekday:"short", month:"short", day:"numeric", year:"numeric" });
}

const PAY = loadSettings().payment;
const container = document.getElementById("payment-content");

// --- final slot-aware double-booking guard (point of no return) ---
function pAddOneDay(iso){
    const d = new Date(iso + "T00:00:00");
    d.setDate(d.getDate() + 1);
    const y = d.getFullYear(), m = String(d.getMonth() + 1).padStart(2, "0"), day = String(d.getDate()).padStart(2, "0");
    return `${y}-${m}-${day}`;
}
function pEndExcl(checkin, checkout){ return checkout > checkin ? checkout : pAddOneDay(checkin); }
function pSameHaven(a, b){ return String(a || "").trim().toLowerCase() === String(b || "").trim().toLowerCase(); }

// time-aware conflict guard, mirroring the haven page (2-hour cleaning gap)
const PAY_CLEAN_BUFFER = 120;
const PAY_HAVEN_TIMES = {
    "Haven 1":{in:"12:00 NN"}, "Haven 2":{in:"12:00 NN"}, "Haven 3":{in:"12:00 NN"},
    "Haven 4":{in:"3:00 PM"}, "Haven 5":{in:"3:00 PM"}, "Haven 7":{in:"3:00 PM"},
    "Haven 8":{in:"6:00 PM"}, "Casa Bienca":{in:"6:00 PM"}
};
function pParseTime(str){
    const m = String(str).match(/^(\d{1,2}):(\d{2})\s*(AM|PM|NN|MN)$/i);
    if(!m) return null;
    let h = Number(m[1]); const min = Number(m[2]); const suf = m[3].toUpperCase();
    if(suf === "NN") h = 12; else if(suf === "MN") h = 0; else if(suf === "PM") h = (h % 12) + 12; else h = h % 12;
    return h * 60 + min;
}
function pDayIndex(iso){ return Math.round((new Date(iso + "T00:00:00") - new Date("2000-01-01T00:00:00")) / 86400000); }
function pCheckinMin(timeStr){ const m = pParseTime(timeStr); if(m == null) return null; return m === 0 ? 1440 : m; }
function pStartMin(x){
    if(x.checkinTime){ const m = pCheckinMin(x.checkinTime); if(m != null) return m; }
    const h = Number(x.stayHours) || 21;
    if(h === 6) return pParseTime(x.slot === "evening" ? "7:00 PM" : "8:00 AM");
    if(h === 21){ const t = PAY_HAVEN_TIMES[x.haven]; return t ? pParseTime(t.in) : pParseTime("12:00 NN"); }
    return pParseTime("8:00 AM");
}
function pAbsInterval(x){
    const s = pDayIndex(x.checkin) * 1440 + (pStartMin(x) || 0);
    return { s, e: s + ((Number(x.stayHours) || 21) + (Number(x.extend) || 0)) * 60 };
}
function bookingConflicts(arr, b){
    const cs = b.checkinDate, ce = pEndExcl(b.checkinDate, b.checkoutDate || b.checkinDate);
    const isMulti = (b.nights && b.nights >= 2) ||
        (b.checkoutDate && pDayIndex(b.checkoutDate) - pDayIndex(b.checkinDate) >= 2);
    if(isMulti){
        // multi-night needs whole days → any overlap blocks (ignore deleted/cancelled)
        return arr.some(x => !x.deleted && !x.cancelled && pSameHaven(x.haven, b.haven) && cs < pEndExcl(x.checkin, x.checkout) && x.checkin < ce);
    }
    const sMin = b.checkinTime ? pCheckinMin(b.checkinTime) : pStartMin(b);
    const candS = pDayIndex(b.checkinDate) * 1440 + (sMin != null ? sMin : 0);
    const candE = candS + ((Number(b.stayHours) || 21) + (Number(b.addons && b.addons.hours) || 0)) * 60;
    return arr.some(x => {
        if(x.deleted || x.cancelled) return false;   // freed slot
        if(!pSameHaven(x.haven, b.haven)) return false;
        const { s, e } = pAbsInterval(x);
        return candS < e + PAY_CLEAN_BUFFER && s - PAY_CLEAN_BUFFER < candE;
    });
}
// short booking code — SAME algorithm as the dashboard (bookingCode) so both show e.g. MJN3ET
function deriveCode(id){
    const CH = "ABCDEFGHJKMNPQRSTUVWXYZ23456789";
    let h = 2166136261 >>> 0;
    const s = String(id == null ? "" : id);
    for(let i=0;i<s.length;i++){ h ^= s.charCodeAt(i); h = Math.imul(h, 16777619) >>> 0; }
    let c = "";
    for(let i=0;i<6;i++){ c += CH.charAt(h % CH.length); h = Math.imul(h ^ (h >>> 13), 2654435761) >>> 0; }
    return c;
}

// push the paid booking into the dashboard calendar (shph_bookings_v3); returns false if it would double-book
// downscale an uploaded screenshot to keep storage light, return a JPEG data URL
function payResizeImage(file, cb){
    const reader = new FileReader();
    reader.onload = function(e){
        const img = new Image();
        img.onload = function(){
            const MAX = 1200;
            let w = img.width, h = img.height;
            if(w > MAX || h > MAX){ const r = Math.min(MAX / w, MAX / h); w = Math.round(w * r); h = Math.round(h * r); }
            const c = document.createElement("canvas");
            c.width = w; c.height = h;
            c.getContext("2d").drawImage(img, 0, 0, w, h);
            try { cb(c.toDataURL("image/jpeg", 0.85)); }
            catch(err){ cb(e.target.result); }   // fallback to the raw data URL
        };
        img.onerror = function(){ cb(e.target.result); };
        img.src = e.target.result;
    };
    reader.readAsDataURL(file);
}

async function addToCalendar(b, proof){
    const KEY = "shph_bookings_v3";
    let arr;
    try { arr = JSON.parse(localStorage.getItem(KEY)) || []; } catch(e){ arr = []; }

    // Durable per-record write to the SERVER so a website booking is NEVER lost. Previously the
    // booking only went to localStorage and relied on a background sync that's lost if the page
    // closes — while the confirmation email (a server call) always sent, so a guest could get an
    // email with no booking recorded. The server offloads the base64 proof to a tiny /img ref.
    async function persist(rec){
        try{ const res = await fetch("/api/list/" + KEY, { method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify({ upsert: rec }) }); return res.ok; }catch(e){ return false; }
    }

    // avoid duplicates if the button is clicked twice / retried after a failed save — re-send to the server.
    // MUST ignore deleted/cancelled records: a soft-deleted past booking for the same haven/date/contact is
    // NOT a duplicate — treating it as one re-saves the tombstone (stays deleted) and hands back its id, so the
    // guest gets a confirmation + email but no booking is ever created (and always the SAME code). Skip them.
    const dupB = arr.find(x => !x.deleted && !x.cancelled && x.source === "website" && x.haven === b.haven &&
        x.checkin === b.checkinDate && x.contact === (b.contact || ""));
    if(dupB) return (await persist(dupB)) ? dupB.id : -1;

    // refuse to write a booking that clashes with an existing one
    if(bookingConflicts(arr, b)) return false;

    // Internal id must be UNIQUE across concurrent guests — a shared Math.max+1 would let two
    // simultaneous website bookings collide and one overwrite the other. Use a ms timestamp + random
    // (safe integer). The human-friendly SH-000x number stays sequential (a rare duplicate label is
    // only cosmetic; the id keeps both bookings safe).
    const nextId = Date.now() * 1000 + Math.floor(Math.random() * 1000);
    const seqNo = arr.reduce((m, x) => { const mt = /^SH-0*(\d+)$/.exec(x.bookingNo || ""); return mt ? Math.max(m, Number(mt[1])) : m; }, 0) + 1;
    const guests = (b.guestDetails || []).map(g => ({ name: g.name, age: g.age != null ? g.age : 18 }));
    // derive stay hours / slot from the summary so the calendar bar lands correctly
    const stayHours = Number(b.stayHours) || parseInt(b.stayLabel, 10) || 21;
    const slot = b.slot || (stayHours === 6 ? (/pm/i.test(b.checkinTime || "") ? "evening" : "morning") : "");

    const rec = {
        id: nextId,
        bookingNo: "SH-" + String(seqNo).padStart(4, "0"),
        haven: b.haven,
        contact: b.contact || "",
        guests: guests.length ? guests : [{ name: "Guest", age: 18 }],
        checkin: b.checkinDate,
        checkout: b.checkoutDate || b.checkinDate,
        checkinTime: b.checkinTime || "",
        stayHours: stayHours,
        slot: slot,
        swimpass: (b.addons && b.addons.pool) || 0,
        towels: b.towels || 0,
        extend: (b.addons && b.addons.hours) || 0,
        holiday: false,
        method: b.method || "",
        deposit: b.deposit || 0,
        total: b.total || 0,
        downpayment: b.downpayment || 0,
        downProof: proof || null,          // guest's uploaded payment screenshot
        email: b.email || "",
        notes: [
            b.notes,
            b.facebook ? "FB: " + b.facebook : "",
            "Website booking"
        ].filter(Boolean).join(" · "),
        bookedBy: "Website",                    // guest self-booked → logs as WEBSITE, not an admin
        bookedAt: new Date().toISOString(),
        dpDate: (function(){ const d = new Date(); return d.getFullYear() + "-" + String(d.getMonth()+1).padStart(2,"0") + "-" + String(d.getDate()).padStart(2,"0"); })(),   // downpayment counts on the booking-made day
        source: "website"
    };
    arr.push(rec);
    localStorage.setItem(KEY, JSON.stringify(arr));   // local copy + background-sync backup
    return (await persist(rec)) ? nextId : -1;         // require the server to confirm; -1 = save failed, retry
}
const raw = localStorage.getItem("shph_confirmed_booking");

if(!raw){
    container.innerHTML =
        `<div class="empty-state">
            <h2>Nothing to pay yet</h2>
            <p>Complete a booking first to reach the payment step.</p>
            <a class="home-link" href="index.html#our-havens">Browse havens</a>
        </div>`;
} else {
    renderPayment(JSON.parse(raw));
}

function renderPayment(b){
    // price breakdown
    let priceRows = (b.lines || []).map(([label, amt]) =>
        `<div class="price-row"><span>${label}</span><span>${peso(amt)}</span></div>`).join("");
    priceRows += `<div class="price-row"><span>Security deposit</span><span>${peso(b.deposit)}</span></div>`;
    priceRows += `<div class="price-row price-total"><span>Total</span><span>${peso(b.total)}</span></div>`;
    priceRows += `<div class="price-row"><span>Downpayment</span><span>${peso(b.downpayment)}</span></div>`;
    priceRows += `<div class="price-row price-balance"><span>Balance on arrival</span><span>${peso(b.balance)}</span></div>`;

    const guestNames = (b.guestDetails || []).map(g => g.name + (g.age != null ? ` (${g.age})` : "")).join(", ");

    // show only the account for the payment method the guest picked
    const isCash = b.method === "Cash on arrival";
    const m = (PAY.methods || []).find(x => x.name === b.method);

    let acctHtml, qrHtml = "";
    if (isCash || !m) {
        acctHtml = `<div class="pay-acct">
                        <div class="pay-details">${PAY.cashNote}</div>
                    </div>`;
    } else {
        acctHtml = `<div class="pay-acct">
                        <div class="pay-label">${m.name.toUpperCase()}</div>
                        <div class="pay-details">${m.number}<br>${m.account}</div>
                    </div>`;
        qrHtml = m.qr ? `<img class="pay-qr" src="${m.qr}" alt="${m.name} QR code">` : "";
    }

    // account details on top (bigger) · QR photo centered in the middle · notes below
    const payMethodHtml = isCash
        ? `<div class="pay-method">
                ${acctHtml}
                <p class="pay-intro">You chose <strong>Cash on arrival</strong>. 😊</p>
                <p class="pay-warn">${PAY.warnNote}</p>
           </div>`
        : `<div class="pay-method">
                ${acctHtml}
                ${qrHtml}
                <p class="pay-intro">${PAY.intro}</p>
                <p class="pay-screenshot">${PAY.screenshotNote}</p>
                <p class="pay-warn">${PAY.warnNote}</p>
           </div>`;

    container.innerHTML = `
        <div class="booknow-grid">
            <div class="form-col">
                <div class="booking-form">
                    <h2>Pay your downpayment</h2>
                    <p class="pay-amount">${peso(b.downpayment)}</p>
                    <p class="pay-sub">to reserve <strong>${b.haven}</strong> on ${fmtDate(b.checkinDate)}</p>

                    ${payMethodHtml}

                    ${isCash ? "" : `
                    <div class="pay-upload">
                        <div class="pay-upload-label">Upload your payment screenshot <span class="req">*</span></div>
                        <label class="pay-upload-box" id="proofBox">
                            <input type="file" id="payProof" accept="image/*" hidden>
                            <span id="proofPlaceholder" class="pay-upload-btn">📷 Upload a photo</span>
                            <img id="proofPreview" alt="" style="display:none;">
                        </label>
                    </div>`}

                    <button class="confirm-btn" id="paidBtn"${isCash ? "" : " disabled"}>${isCash ? "Confirm reservation" : "I've completed payment"}</button>

                    <p class="pay-note">
                        Balance of <strong>${peso(b.balance)}</strong> is payable on arrival.
                        The <strong>${peso(b.deposit)}</strong> security deposit is refundable the day after
                        check-out, as long as there's no violation, damage, or lost item in the unit.
                    </p>
                </div>
            </div>

            <aside class="summary-col">
                <div class="summary-card">
                    <h2>Booking summary</h2>
                    <div class="sum-row"><span>Haven</span><strong>${b.haven}</strong></div>
                    <div class="sum-row"><span>Check-in</span><strong>${fmtDate(b.checkinDate)}${b.checkinTime ? " · " + b.checkinTime : ""}</strong></div>
                    <div class="sum-row"><span>Check-out</span><strong>${b.checkoutTime || fmtDate(b.checkoutDate)}</strong></div>
                    <div class="sum-row"><span>Stay</span><strong>${b.stayLabel || "—"}</strong></div>
                    ${guestNames ? `<div class="sum-row"><span>Guests</span><strong>${guestNames}</strong></div>` : ""}
                    ${b.contact ? `<div class="sum-row"><span>Contact</span><strong>${b.contact}</strong></div>` : ""}
                    <div class="price-list">${priceRows}</div>
                </div>
            </aside>
        </div>
    `;

    // payment screenshot is required for online methods before completing
    let proofData = null;
    const proofInput = document.getElementById("payProof");
    if(proofInput){
        proofInput.addEventListener("change", function(){
            const f = this.files[0];
            if(!f) return;
            payResizeImage(f, function(url){
                proofData = url;
                const img = document.getElementById("proofPreview");
                img.src = url; img.style.display = "block";
                document.getElementById("proofPlaceholder").style.display = "none";
                document.getElementById("paidBtn").disabled = false;
            });
        });
    }

    document.getElementById("paidBtn").addEventListener("click", async function(){
        if(!isCash && !proofData){
            alert("Please upload a screenshot of your payment before completing.");
            return;
        }
        const paidBtn = document.getElementById("paidBtn");
        const _label = paidBtn.textContent;
        paidBtn.disabled = true; paidBtn.textContent = "Saving your booking…";
        let bookingNo;
        try{ bookingNo = await addToCalendar(b, proofData); }catch(e){ bookingNo = -1; }
        if(bookingNo === false){
            container.innerHTML = `
                <div class="booknow-success">
                    <h2>😔 That slot was just booked</h2>
                    <p>Sorry, <strong>${b.haven}</strong> on <strong>${fmtDate(b.checkinDate)}</strong>
                       (${b.checkinTime || "your time"}) was just reserved by someone else.</p>
                    <p>Please go back and pick a different date or time slot. No payment has been recorded.</p>
                    <a class="home-link" href="havens.html${b.havenId ? "?id=" + b.havenId : ""}">Pick another time</a>
                </div>`;
            window.scrollTo(0, 0);
            return;
        }
        if(bookingNo === -1 || !bookingNo){
            // server didn't confirm the save — let the guest retry instead of showing a false success
            paidBtn.disabled = false; paidBtn.textContent = _label;
            alert("Sorry, we couldn't save your booking — please check your internet connection and tap “I've completed payment” again. Your screenshot is still attached.");
            return;
        }
        localStorage.removeItem("shph_confirmed_booking");
        localStorage.removeItem("shph_pending_booking");
        const code = deriveCode(bookingNo);   // short code, matches the dashboard (e.g. MJN3ET)
        // email the guest a confirmation (server sends via Gmail; no-ops quietly if not yet configured)
        if(b.email){
            try{
                fetch("/api/send-confirmation", {
                    method: "POST", headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ to: b.email, booking: {
                        code: code, haven: b.haven,
                        bookedOn: (function(){ const d = new Date(); return String(d.getMonth()+1).padStart(2,"0") + String(d.getDate()).padStart(2,"0") + d.getFullYear(); })(),   // MMDDYYYY (booked today)
                        checkin: fmtDate(b.checkinDate) + (b.checkinTime ? " · " + b.checkinTime : ""),
                        checkout: b.checkoutTime || fmtDate(b.checkoutDate),
                        stay: b.stayLabel || "",
                        guests: guestNames || "", contact: b.contact || "",
                        total: peso(b.total), downpayment: peso(b.downpayment), balance: peso(b.balance)
                    } })
                }).catch(function(){});
            }catch(e){}
        }
        const title = document.getElementById("payTitle");
        if(title) title.innerHTML = `Thank you for Booking with us! <span class="booking-no">${code}</span>`;
        container.innerHTML = `
            <div class="booknow-success">
                <p style="color:#d11020; font-weight:800; letter-spacing:.04em; text-align:center; margin:0 0 8px; font-size:15px;">PLEASE TAKE A SCREENSHOT</p>
                <h2>⏰ We are now reviewing your payment</h2>
                <p>Thank you! Your reservation for <strong>${b.haven}</strong> has been received.</p>

                <div class="confirm-recap">
                    <div class="cr-row"><span>Booking number</span><strong>${code}</strong></div>
                    <div class="cr-row"><span>Haven</span><strong>${b.haven}</strong></div>
                    <div class="cr-row"><span>Check-in</span><strong>${fmtDate(b.checkinDate)}${b.checkinTime ? " · " + b.checkinTime : ""}</strong></div>
                    <div class="cr-row"><span>Check-out</span><strong>${b.checkoutTime || fmtDate(b.checkoutDate)}</strong></div>
                    <div class="cr-row"><span>Stay</span><strong>${b.stayLabel || "—"}</strong></div>
                    ${guestNames ? `<div class="cr-row"><span>Guests</span><strong>${guestNames}</strong></div>` : ""}
                    ${b.contact ? `<div class="cr-row"><span>Contact</span><strong>${b.contact}</strong></div>` : ""}
                    <div class="cr-row cr-total"><span>Total</span><strong>${peso(b.total)}</strong></div>
                    <div class="cr-row"><span>Downpayment</span><strong>${peso(b.downpayment)}</strong></div>
                    <div class="cr-row"><span>Balance on arrival</span><strong>${peso(b.balance)}</strong></div>
                </div>

                <p class="confirm-msg">Please message us with your booking number <strong>${code}</strong> to confirm your booking :)</p>
                <a class="fb-link" href="https://www.facebook.com/staycationhavenph" target="_blank" rel="noopener">facebook.com/staycationhavenph</a>

                <p>We'll message a confirmation to <strong>${b.contact || "your number"}</strong> once your
                   payment is verified. See you at your staycation! 🏠</p>
                <a class="home-link" href="index.html">Back to home</a>
            </div>`;
        window.scrollTo(0, 0);
    });
}
</script>

</body>
</html>
