<div class="m-topbar" id="mTopbar">
  <span class="m-logo"><img src="images/logo.png" alt="S" onerror="this.parentNode.textContent='S'"></span>
  <button class="m-pagepick" onclick="toggleSidebar()">
    <span class="m-pp-ico"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/><path d="m9 15 2 2 4-4"/></svg></span>
    <span class="m-pp-text"><span class="m-pp-eyebrow">Current Page</span><span class="m-pp-name" id="mCurrentPage">Today's Booking</span></span>
    <svg class="m-pp-caret" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
  </button>
  <button class="m-add" onclick="openAdd()" aria-label="Add booking">+</button>
</div>
<div class="sidebar-backdrop" id="sidebarBackdrop" onclick="closeSidebar()"></div>
<script>
  function toggleSidebar(){
    var sb=document.querySelector('.sidebar');
    var bd=document.getElementById('sidebarBackdrop');
    var open=sb.classList.toggle('open');
    if(bd) bd.classList.toggle('show', open);
    document.body.classList.toggle('nav-open', open);
    if(!open){ var s=document.getElementById('mNavSearch'); if(s){ s.value=''; filterNav(''); } }
  }
  function closeSidebar(){
    var sb=document.querySelector('.sidebar'); if(sb) sb.classList.remove('open');
    var bd=document.getElementById('sidebarBackdrop'); if(bd) bd.classList.remove('show');
    document.body.classList.remove('nav-open');
  }
  function filterNav(q){
    q=(q||'').toLowerCase().trim();
    document.querySelectorAll('.sidebar .nav-item').forEach(function(it){
      it.style.display = (!q || it.textContent.toLowerCase().indexOf(q)!==-1) ? '' : 'none';
    });
    document.querySelectorAll('.sidebar .nav-group').forEach(function(g){
      var sib=g.nextElementSibling, any=false;
      while(sib && !(sib.classList && sib.classList.contains('nav-group'))){
        if(sib.classList && sib.classList.contains('nav-item') && sib.style.display!=='none'){ any=true; break; }
        sib=sib.nextElementSibling;
      }
      g.style.display = (!q || any) ? '' : 'none';
    });
  }
  document.addEventListener('click', function(e){
    if(window.innerWidth<=760 && e.target.closest && e.target.closest('.sidebar .nav-item')) closeSidebar();
  });
</script>
