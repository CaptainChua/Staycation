  let _savingPay = false;
  let _pmtIdLast = 0;   // monotonic guard for payment ids minted this tab (see pmtId below)
  async function savePay(again){
    if(_savingPay) return;   // block rapid double-clicks — they were appending DUPLICATE payments
    const bookingId = payBookingId;
    if(payBookingId == null) return;
    if(!payEditDown && !payProof){ alert("Please upload a photo of the proof of payment."); return; }
    const mop = document.getElementById("payMop").value;
    const category = document.getElementById("payFor").value; // "Balance" or "Add Ons"
    const amount = Number(document.getElementById("payAmount").value) || 0;
    if(amount <= 0){ alert("Please enter the amount collected."); return; }
    _savingPay = true;
    const _payBtns = ["paySaveBtn","paySaveAddBtn"].map(i => document.getElementById(i)).filter(Boolean);
    _payBtns.forEach(x => x.disabled = true);
    try{
    // always work off the freshest data in storage
    bookings = loadBookings();
    const b = bookings.find(x => x.id === payBookingId);
    if(!b) return;
    b.payments = b.payments || [];
    const editing = !!(payEditing && payEditIndex >= 0 && b.payments[payEditIndex]);

    // 1) offload the proof photo to a tiny /img link so the request stays small
    let proofRef = payProof;
    if(payProof && payProof.indexOf("data:image") === 0){
      try{
        const r = await fetch("/api/img", { method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify({ data: payProof }) });
        if(r.ok){ const j = await r.json(); if(j && j.url) proofRef = j.url; }
      }catch(e){}
    }

    // 1b) editing the booking's DOWNPAYMENT (not a payment record) → patch the booking's own fields.
    // Also route a "Downpayment"-category save here as a backstop so it can never become a phantom
    // payment record that double-counts the downpayment.
    if(payEditDown || category === "Downpayment"){
      const set = { downpayment: amount, method: mop, dpDate: document.getElementById("payDate").value || null, downProof: proofRef || null };
      let okDp = false;
      try{ const res = await fetch("/api/booking/" + encodeURIComponent(bookingId) + "/patch", { method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify({ set }) }); okDp = res.ok; }catch(e){}
      if(!okDp){ alert("⚠️ The downpayment was NOT saved — the server didn't confirm (slow / offline). Please try again."); return; }
      Object.assign(b, set); b.updatedAt = new Date().toISOString();
      try{ (window.shphSetLocal || localStorage.setItem.bind(localStorage))(KEY, JSON.stringify(bookings)); }catch(e){}
      logActivity(`edited downpayment — ${b.haven} · ${peso(amount)} (${mop})`);
      renderToday();
      closePay();
      return;
    }

    // 2) build the payment record — each carries a stable `pid` so edits/deletes match by id, not position.
    //    Monotonic within the tab (like dashboard's uid()) so two payments minted in the same millisecond
    //    can't collide into the same pid (which would misroute a later edit/delete to the wrong payment).
    const pmtId = () => { let t = Date.now() * 1000 + Math.floor(Math.random() * 1000); if(t <= _pmtIdLast) t = _pmtIdLast + 1; _pmtIdLast = t; return t; };
    const existingPid = editing ? b.payments[payEditIndex].pid : null;   // null for legacy → server uses index fallback
    const payment = editing
      ? Object.assign({}, b.payments[payEditIndex], { pid: b.payments[payEditIndex].pid || pmtId(), amount, mop, category, proof: proofRef, at: payAtFromInput(), editedAt: new Date().toISOString(), editedBy: currentUser() })
      : { pid: pmtId(), amount, mop, category, proof: proofRef, at: payAtFromInput(), by: currentUser() };

    // 3) PER-RECORD write — touches ONLY this booking on the server, so a payment can NEVER
    //    overwrite another booking (this replaces the old whole-array save that lost data).
    let ok = false;
    try{
      const res = await fetch("/api/booking/" + encodeURIComponent(bookingId) + "/payment", {
        method:"POST", headers:{"Content-Type":"application/json"},
        body: JSON.stringify({ payment, editId: existingPid, editIndex: editing ? payEditIndex : null })
      });
      ok = res.ok;
    }catch(e){}
    if(!ok){
      alert("⚠️ The payment was NOT saved — the server didn't confirm (slow / offline). Please try again.");
      return;
    }

    // 4) reflect locally WITHOUT re-pushing the whole array (no clobber). The server already has it.
    if(editing) b.payments[payEditIndex] = payment;
    else b.payments.push(payment);
    b.updatedAt = new Date().toISOString();
    try{ (window.shphSetLocal || localStorage.setItem.bind(localStorage))(KEY, JSON.stringify(bookings)); }catch(e){}
    logActivity(`${editing ? "edited" : "uploaded"} ${category} payment — ${b.haven} · ${peso(amount)} (${mop})`);
    renderToday();
    if(again){
      openPay(bookingId, false);   // keep the popup open for the next entry
    } else {
      closePay();
    }
    } finally {
      _savingPay = false;
      _payBtns.forEach(x => { if(x) x.disabled = false; });
    }
  }
