  let _savingAddon = false;
  async function saveAddon(){
    if(addonBookingId == null) return;
    const { pool, tow, hrs, added } = addonAddedAmount();
    if(pool <= 0 && tow <= 0 && hrs <= 0){ alert("Enter pool passes, towels, or hours to add."); return; }
    if(_savingAddon) return;   // block double-click (a 2nd click would double-charge the add-ons)
    _savingAddon = true;
    try{
      const data = loadBookings();
      const b = data.find(x => x.id === addonBookingId);
      if(!b) return;
      // compute the new values WITHOUT mutating anything yet — so a failed save leaves state unchanged
      const newSwim  = (Number(b.swimpass) || 0) + pool;
      const newTow   = (Number(b.towels)   || 0) + tow;
      const newExt   = (Number(b.extend)   || 0) + hrs;
      const newTotal = (Number(b.total)    || 0) + added;   // the late charge added to the bill
      const newLog   = (b.addonLog || []).concat([{ pool, towels: tow, hours: hrs, amount: added, at: new Date().toISOString(), by: currentUser() }]);
      // PER-RECORD patch — updates only these fields on the live booking (can't clobber other data)
      let ok = false;
      try{ const res = await fetch("/api/booking/" + encodeURIComponent(addonBookingId) + "/patch", { method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify({ set: { swimpass: newSwim, towels: newTow, extend: newExt, total: newTotal, addonLog: newLog } }) }); ok = res.ok; }catch(e){}
      if(!ok){ alert("⚠️ Couldn't save the add-on — the server didn't confirm (slow / offline). Please try again."); return; }
      // server confirmed → NOW apply locally and adopt the fresh array
      b.swimpass = newSwim; b.towels = newTow; b.extend = newExt; b.total = newTotal; b.addonLog = newLog;
      b.updatedAt = new Date().toISOString();
      bookings = data;
