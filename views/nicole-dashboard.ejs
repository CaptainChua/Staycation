  // short, STABLE booking code DERIVED from the id — identical algorithm to dashboard.html deriveCode()
  // so the same booking shows the same code everywhere. No randomness/storage → it can never change.
  function tbBookingCode(b){
    if(!b || b.id == null) return "";
    const CH = "ABCDEFGHJKMNPQRSTUVWXYZ23456789";
    let h = 2166136261 >>> 0;
    const s = String(b.id);
    for(let i=0;i<s.length;i++){ h ^= s.charCodeAt(i); h = Math.imul(h, 16777619) >>> 0; }
    let c = "";
    for(let i=0;i<6;i++){ c += CH.charAt(h % CH.length); h = Math.imul(h ^ (h >>> 13), 2654435761) >>> 0; }
    return c;
  }
