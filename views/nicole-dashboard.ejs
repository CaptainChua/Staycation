    <div class="pay-info" id="addonTotalInfo" style="margin-top:12px;"></div>

    <div class="modal-actions">
      <button class="btn secondary" onclick="closeAddon()">Cancel</button>
      <button class="btn" onclick="saveAddon()">Add to Bill</button>
    </div>
  </div>
</div>

<!-- full-size proof image viewer -->
<div class="img-lightbox" id="imgLightbox" onclick="this.classList.remove('show')">
  <img id="imgLightboxImg" alt="proof of payment">
</div>

<script>
  // shares the dashboard's data — same localStorage key
  const KEY = "shph_bookings_v3";
  // Persist bookings WITH an edit-time stamp on whatever changed, so the merge layers keep
  // the newest version and a refresh / stale tab can't wipe a fresh payment. MUST match the
  // main dashboard's save() — without this, payments entered here are lost on reload.
  function _bkCanon(v){
    if(Array.isArray(v)) return "[" + v.map(_bkCanon).join(",") + "]";
    if(v && typeof v === "object") return "{" + Object.keys(v).filter(k => k !== "updatedAt").sort()
      .map(k => JSON.stringify(k) + ":" + _bkCanon(v[k])).join(",") + "}";
    return JSON.stringify(v);
  }
  let _bkSig = null;
  // baseline for change-stamping = the loaded list, so save() only stamps records the user
  // actually edits (never mass-stamps stale data, which could win the merge and wipe edits).
  function _seedBkSig(arr){ _bkSig = {}; (arr || []).forEach(b => { if(b && b.id != null) _bkSig[String(b.id)] = _bkCanon(b); }); }
  function saveBookings(data){
    try{
      if(_bkSig === null) _seedBkSig(data);
      const now = new Date().toISOString();
      (data || []).forEach(b => { if(!b || b.id == null) return; const sig = _bkCanon(b); if(_bkSig[String(b.id)] !== sig) b.updatedAt = now; _bkSig[String(b.id)] = _bkCanon(b); });
    }catch(e){}
    localStorage.setItem(KEY, JSON.stringify(data));
  }
  const HAVEN_TIMES = {
    "Haven 1":{in:"12:00 NN"}, "Haven 2":{in:"12:00 NN"}, "Haven 3":{in:"12:00 NN"},
    "Haven 4":{in:"3:00 PM"}, "Haven 5":{in:"3:00 PM"}, "Haven 7":{in:"3:00 PM"},
    "Haven 8":{in:"6:00 PM"}, "Casa Bienca":{in:"6:00 PM"}
  };

  /* ---------- date helpers ---------- */
  function today(){ const d = new Date(); d.setHours(0,0,0,0); return d; }
  function addDays(date, n){ const d = new Date(date); d.setDate(d.getDate()+n); return d; }
  function iso(date){
    const y = date.getFullYear();
    const m = String(date.getMonth()+1).padStart(2,"0");
    const d = String(date.getDate()).padStart(2,"0");
    return `${y}-${m}-${d}`;
  }
  function fmt(dateStr){
    const d = new Date(dateStr + "T00:00:00");
    return d.toLocaleDateString("en-PH", {month:"short", day:"numeric"});
  }
  function peso(n){ return "₱" + Number(n).toLocaleString("en-PH"); }

  /* ---------- haven colour scheme (matches the calendar legend) ---------- */
  const HAVEN_COLORS = {
    "Haven 1":    { am:"#d9bdf5", pm:"#b98ee6" },
    "Haven 2":    { am:"#fde68a", pm:"#ecca4e" },
    "Haven 3":    { am:"#bcbcbc", pm:"#8c8c8c" },
    "Haven 4":    { am:"#bcf3cf", pm:"#84dca0" },
    "Haven 5":    { am:"#bcd0fb", pm:"#7ea6f4" },
    "Haven 7":    { am:"#aef0f7", pm:"#66d8e8" },
    "Haven 8":    { am:"#fcd0e7", pm:"#f5a3d0" },
    "CasaBienca": { am:"#cdff8f", pm:"#a8ec5c" },
    "CasaSiesta": { am:"#ffd2a8", pm:"#f5ab68" }
  };
  function havenPastel(name){
    let h = 0; for(let i=0;i<name.length;i++) h = (h*31 + name.charCodeAt(i)) % 360;
    return { am:`hsl(${h} 70% 80%)`, pm:`hsl(${h} 60% 66%)` };
  }
  function havenColors(name){ return HAVEN_COLORS[name] || (HAVEN_COLORS[name] = havenPastel(name)); }
  // a darker, text-legible shade of the haven's colour
  function havenInk(name){
    const c = havenColors(name);
    // CSS color-mix darkens the pastel for readable text while staying on-scheme
    return `color-mix(in srgb, ${c.pm} 78%, #2f2a25)`;
  }

  /* ---------- check-in / check-out times ---------- */
  function parseTimeMin(str){
    const m = String(str).match(/^(\d{1,2}):(\d{2})\s*(AM|PM|NN|MN)$/i);
    if(!m) return null;
    let h = Number(m[1]); const min = Number(m[2]); const suf = m[3].toUpperCase();
    if(suf === "NN") h = 12; else if(suf === "MN") h = 0; else if(suf === "PM") h = (h % 12) + 12; else h = h % 12;
    return h * 60 + min;
  }
  function minToTime(min){
    min = ((min % 1440) + 1440) % 1440;
    const h = Math.floor(min / 60), mm = String(min % 60).padStart(2, "0");
    if(h === 0) return `12:${mm} MN`;
    if(h === 12) return `12:${mm} NN`;
    return `${h > 12 ? h - 12 : h}:${mm} ${h < 12 ? "AM" : "PM"}`;
  }
  function bookingCheckinMin(b){
    if(b.checkinTime){ const m = parseTimeMin(b.checkinTime); if(m != null) return m === 0 ? 1440 : m; }
    const h = Number(b.stayHours) || 21;
    if(h === 6) return parseTimeMin(b.slot === "evening" ? "7:00 PM" : "8:00 AM");
    if(h === 21){ const t = HAVEN_TIMES[b.haven]; return t ? parseTimeMin(t.in) : parseTimeMin("12:00 NN"); }
    return parseTimeMin("8:00 AM");
  }
  function checkinTimeStr(b){ return minToTime(bookingCheckinMin(b)); }
  function checkoutTimeStr(b){
    return minToTime(bookingCheckinMin(b) + ((Number(b.stayHours) || 21) + (Number(b.extend) || 0)) * 60);
  }
  function endExcl(b){
    return b.checkout > b.checkin ? b.checkout : iso(addDays(new Date(b.checkin + "T00:00:00"), 1));
  }

  /* ---------- booking helpers ---------- */
  // total collected AFTER booking (via the Paid button) — kept separate from the downpayment
  function collectedSum(b){ return (b.payments || []).reduce((s,p) => s + (Number(p.amount) || 0), 0); }
  // everything the customer has paid so far = original downpayment + later collections
  function paidOf(b){ return Number(b.downpayment || 0) + collectedSum(b); }
  function balanceOf(b){ return Math.max(0, Number(b.total || 0) - paidOf(b)); }
  function statusOf(b){
    const paid = paidOf(b);
    if(paid >= b.total && b.total > 0) return "paid";
    if(paid > 0) return "partial";
    return "unpaid";
  }
  function guestSummary(b){ return (b.guests || []).map(g => `${g.name} (${g.age})`).join("<br>"); }
  function addonsCell(b){
    const ico = s => `<svg class="addon-ico" viewBox="0 0 24 24">${s}</svg>`;
    const POOL  = '<path d="M2 16c1.5 0 1.5 1 3 1s1.5-1 3-1 1.5 1 3 1 1.5-1 3-1 1.5 1 3 1 1.5-1 3-1"/><path d="M2 20c1.5 0 1.5 1 3 1s1.5-1 3-1 1.5 1 3 1 1.5-1 3-1 1.5 1 3 1 1.5-1 3-1"/><path d="M8 13V6a2 2 0 0 1 4 0"/>';
    const TOWEL = '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 3v18"/>';
    const CLOCK = '<circle cx="12" cy="12" r="9"/><path d="M12 7.5v5l3 2"/>';
    const bits = [];
    if(b.swimpass > 0) bits.push(`<span class="addon">${ico(POOL)}${b.swimpass}</span>`);
    if(b.towels   > 0) bits.push(`<span class="addon">${ico(TOWEL)}${b.towels}</span>`);
    if(b.extend   > 0) bits.push(`<span class="addon">${ico(CLOCK)}+${b.extend}h</span>`);
    return bits.length ? bits.join(" ") : '<span class="muted">—</span>';
  }
  function todayInfo(b, t){
    const dayUse = !(b.checkout > b.checkin);
    const arrives  = b.checkin === t;
    const departs  = dayUse ? b.checkin === t : b.checkout === t;
    const staying  = b.checkin <= t && t < endExcl(b);
    return { arrives, departs, staying, relevant: arrives || departs || staying };
  }
  function todayRow(b, amountCol, statusHtml){
    const st = statusOf(b);
    const hasPayment = b.payments && b.payments.length;
    const updateLink = ` <span class="edit-pay" onclick="openPay(${b.id}, true)">Update payment</span>`;
    // action follows the real status: fully paid → ✓ Paid; otherwise → Paid button to collect
    const payCell = (st === "paid")
      ? `<span class="paid-tag">✓ Paid</span>${updateLink}`
      : `<button class="btn-paid" onclick="openPay(${b.id})">Paid</button>${hasPayment ? updateLink : ""}`;
    const over = paidOf(b) - Number(b.total || 0);   // excess payment, if any
    const amtCell = amountCol > 0
        ? peso(amountCol)
        : (over > 0 ? `<span style="color:#2e9e5b; font-weight:700;">+${peso(over)} over</span>` : '<span class="muted">—</span>');
    const addonLink = ` <span class="edit-pay" onclick="openAddon(${b.id})">+ Add-ons</span>`;
    return `<tr>
        <td><strong style="color:${havenInk(b.haven)};"><span class="hv-dot" style="background:${havenColors(b.haven).pm};"></span>${b.haven}</strong><br><a class="bk-code" href="/dashboard.html?open=${encodeURIComponent(b.id)}" title="Open booking details in Calendar">#${tbBookingCode(b)}</a></td>
        <td>${guestSummary(b)}${b.fbName ? `<br><span class="muted">FB: ${b.fbName}</span>` : ""}<br><span class="muted">${b.contact||""}</span></td>
        <td>${fmt(b.checkin)}<br><span class="muted">${checkinTimeStr(b)}</span></td>
        <td>${fmt(b.checkout)}<br><span class="muted">${checkoutTimeStr(b)}</span></td>
        <td>${b.stayHours ? b.stayHours + "h" + (Number(b.stayHours)===6 && b.slot ? "<br><span class='muted'>"+(b.slot==="morning"?"AM":"PM")+"</span>" : "") : "—"}</td>
        <td>${addonsCell(b)}</td>
        <td>${amtCell}</td>
        <td>${statusHtml || `<span class="status ${st}">${st}</span>`}</td>
        <td>${payCell}${addonLink}</td>
    </tr>`;
  }

  /* ---------- data ---------- */
  function loadBookings(){
    try { return (JSON.parse(localStorage.getItem(KEY)) || []).filter(b => b && !b.deleted); }   // soft-deleted bookings stay on the server, hidden here (matches the dashboard)
    catch(e){ return []; }
  }
  let bookings = loadBookings();
  _seedBkSig(bookings);   // baseline = the loaded state (prevents stale re-stamping)

  /* ---------- render ---------- */
  let currentView = "today"; // today | tomorrow | week | month | custom
  let customStart = null, customEnd = null;   // admin date-range picker (iso "YYYY-MM-DD")

  // [start, end) iso date range for the chosen view
  function viewRange(){
    const t0 = today();
    if(currentView === "yesterday"){ const d = addDays(t0, -1); return { start: iso(d), end: iso(t0) }; }
    if(currentView === "tomorrow"){ const d = addDays(t0, 1); return { start: iso(d), end: iso(addDays(d, 1)) }; }
    if(currentView === "week"){ const s = addDays(t0, -t0.getDay()); return { start: iso(s), end: iso(addDays(s, 7)) }; }
    if(currentView === "month"){ const s = new Date(t0.getFullYear(), t0.getMonth(), 1); const e = new Date(t0.getFullYear(), t0.getMonth() + 1, 1); return { start: iso(s), end: iso(e) }; }
    if(currentView === "custom" && customStart && customEnd){ return { start: customStart, end: iso(addDays(new Date(customEnd + "T00:00:00"), 1)) }; }   // end inclusive
    return { start: iso(t0), end: iso(addDays(t0, 1)) };
  }
  // ---- admin-only custom-range calendar picker (max 30 days) ----
  const TB_MAX = 30;
  const TB_MONTHS = ["January","February","March","April","May","June","July","August","September","October","November","December"];
  let tbPickerMonth = null, tbPendingStart = null, tbHoverIso = null;
  function tbDaysBetween(a, b){ return Math.round((Date.parse(b + "T00:00:00") - Date.parse(a + "T00:00:00")) / 86400000); }

  function toggleRangePop(e){
    if(e) e.stopPropagation();
    const p = document.getElementById("tbRangePop");
    if(!p) return;
    if(p.style.display === "block"){ p.style.display = "none"; return; }
    tbPendingStart = null; tbHoverIso = null;
    const base = customStart ? new Date(customStart + "T00:00:00") : today();
    tbPickerMonth = new Date(base.getFullYear(), base.getMonth(), 1);
    tbRenderPicker();
    p.style.display = "block";
  }
  document.addEventListener("click", function(){ const p = document.getElementById("tbRangePop"); if(p && p.style.display === "block") p.style.display = "none"; });

  function tbPickerNav(dir){ tbPickerMonth = new Date(tbPickerMonth.getFullYear(), tbPickerMonth.getMonth() + dir, 1); tbRenderPicker(); }
  function tbHighlightRange(){
    if(tbPendingStart){
      let end = (tbHoverIso && tbHoverIso >= tbPendingStart) ? tbHoverIso : tbPendingStart;
      if(tbDaysBetween(tbPendingStart, end) > TB_MAX - 1) end = iso(addDays(new Date(tbPendingStart + "T00:00:00"), TB_MAX - 1));
      return { start: tbPendingStart, end };
    }
    if(currentView === "custom" && customStart && customEnd) return { start: customStart, end: customEnd };
    return { start: "", end: "" };
  }
  function tbRenderPicker(){
    const y = tbPickerMonth.getFullYear(), m = tbPickerMonth.getMonth();
    document.getElementById("tbDpTitle").textContent = TB_MONTHS[m] + " " + y;
    const startDay = new Date(y, m, 1).getDay();
    const daysInMonth = new Date(y, m + 1, 0).getDate();
    const todayIso = iso(today());
    let html = "";
    ["Su","Mo","Tu","We","Th","Fr","Sa"].forEach(d => html += `<div class="dp-wd">${d}</div>`);
    for(let i = 0; i < startDay; i++) html += `<div class="dp-day empty"></div>`;
    for(let d = 1; d <= daysInMonth; d++){
      const cellIso = iso(new Date(y, m, d));
      html += `<div class="dp-day${cellIso === todayIso ? " today" : ""}" data-iso="${cellIso}" onclick="tbPickDay('${cellIso}')" onmouseover="tbHoverDay('${cellIso}')"><span class="n">${d}</span></div>`;
    }
    document.getElementById("tbDpGrid").innerHTML = html;
    tbUpdateHighlight();
  }
  function tbUpdateHighlight(){
    const { start, end } = tbHighlightRange();
    document.querySelectorAll("#tbDpGrid .dp-day").forEach(cell => {
      cell.classList.remove("sel","range-start","range-end","in-range");
      const ci = cell.dataset.iso; if(!ci) return;
      if(start && ci === start && ci === end) cell.classList.add("sel");
      else if(start && ci === start) cell.classList.add("sel","range-start");
      else if(end && ci === end) cell.classList.add("sel","range-end");
      else if(start && end && ci > start && ci < end) cell.classList.add("in-range");
    });
    document.getElementById("tbDpHint").textContent = tbPendingStart
      ? "Now click an end date (max " + TB_MAX + " days), or the same day for a single date"
      : "Click a date, then an end date for a range (max " + TB_MAX + " days)";
  }
  function tbPickDay(cellIso){
    if(!tbPendingStart){ tbPendingStart = cellIso; tbHoverIso = cellIso; tbUpdateHighlight(); return; }
    if(cellIso < tbPendingStart){ tbPendingStart = cellIso; tbUpdateHighlight(); return; }
    let endIso = cellIso;
    if(tbDaysBetween(tbPendingStart, endIso) > TB_MAX - 1) endIso = iso(addDays(new Date(tbPendingStart + "T00:00:00"), TB_MAX - 1));
    tbApplyRange(tbPendingStart, endIso);
  }
  function tbHoverDay(cellIso){ if(!tbPendingStart) return; tbHoverIso = cellIso; tbUpdateHighlight(); }
  function tbApplyRange(f, t){
    customStart = f; customEnd = t; currentView = "custom";
    tbPendingStart = null; tbHoverIso = null;
    document.querySelectorAll(".view-tab").forEach(b => b.classList.remove("active"));
    const lbl = document.getElementById("tbRangeBtnLabel"); if(lbl) lbl.textContent = fmt(f) + (f === t ? "" : " – " + fmt(t));
    const p = document.getElementById("tbRangePop"); if(p) p.style.display = "none";
    try{ localStorage.setItem("shph_today_view", "custom"); localStorage.setItem("shph_today_custom", JSON.stringify({ f, t })); }catch(e){}
    renderToday();
  }
  function tbDpToday(){ tbApplyRange(iso(today()), iso(today())); }
  function tbDpClear(){ tbPendingStart = null; tbHoverIso = null; const p = document.getElementById("tbRangePop"); if(p) p.style.display = "none"; setView("today"); }
  // classify a booking against a date range [start, end)
  function rangeInfo(b, start, end){
    const dayUse = !(b.checkout > b.checkin);
    const arrives = b.checkin >= start && b.checkin < end;
    const departDate = dayUse ? b.checkin : b.checkout;
    const departs = departDate >= start && departDate < end;
    const overlaps = b.checkin < end && endExcl(b) > start;
    return { arrives, departs, staying: overlaps, relevant: arrives || departs || overlaps };
  }

  // activity log shown below the booking lists — ADMINS ONLY
  function renderTodayLog(){
    const panel = document.getElementById("logPanel");
    if(!panel) return;
    if(!IS_ADMIN){ panel.style.display = "none"; return; }   // hide for non-admins
    panel.style.display = "";
    let log = [];
    try { log = JSON.parse(localStorage.getItem("shph_activity_log")) || []; } catch(e){}
    const cnt = document.getElementById("logCount");
    if(cnt) cnt.textContent = log.length ? "(" + log.length + ")" : "";
    const el = document.getElementById("todayLogList");
    if(!el) return;
    if(!log.length){ el.innerHTML = '<div class="muted" style="padding:14px 4px;">No activity logged yet.</div>'; return; }
    const esc = s => String(s == null ? "" : s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
    el.innerHTML = log.slice().reverse().slice(0, 200).map(e =>
      `<div class="log-row">
         <span class="log-when">${new Date(e.at).toLocaleString("en-PH")}</span>
         <span class="log-user">${esc(e.user || "—")}</span>
         <span class="log-action">${esc(e.action || "")}</span>
       </div>`).join("");
  }

  function setView(v){
    currentView = v;
    localStorage.setItem("shph_today_view", v);   // remember across refreshes
    document.querySelectorAll(".view-tab").forEach(t => t.classList.toggle("active", t.dataset.view === v));
    const lbl = document.getElementById("tbRangeBtnLabel"); if(lbl) lbl.textContent = "Custom range";   // reset the range pill
    if(typeof apTab === "function") apTab("arriving");   // a new date view shows its arrivals, not a stale Availability panel for an unrelated date
    renderToday();
  }

  /* ---------- Availability tab (mirrors the dashboard Calendar → Availability view) ---------- */
  const EARLIEST_CHECKIN_MIN = 540;   // 9:00 AM — earliest a guest may check in
  const CLEANING_GAP_MIN = 60;        // 1h turnaround/cleaning gap required between two stays

  // occupied window [start, end) in ABSOLUTE minutes; a 21h overnight stay blocks until its check-out morning
  function bookingInterval(b){
    const midnightMin = Math.round(new Date(b.checkin + "T00:00:00").getTime() / 60000);
    const start = midnightMin + bookingCheckinMin(b);
    if(Number(b.stayHours) === 21 && b.checkout && b.checkout > b.checkin){
      const coMidnight = Math.round(new Date(b.checkout + "T00:00:00").getTime() / 60000);
      const checkoutMin = (bookingCheckinMin(b) + (21 + (Number(b.extend) || 0)) * 60) % 1440;
      return { start, end: coMidnight + checkoutMin };
    }
    const dur = ((Number(b.stayHours) || 21) + (Number(b.extend) || 0)) * 60;
    return { start, end: start + dur };
  }

  // same haven source the dashboard uses (admin-saved havens, in their set order) so the list matches everywhere
  function availHavenNames(){
    try{
      const saved = localStorage.getItem("staycation_havens");
      if(saved){
        const names = JSON.parse(saved).filter(h => h && !h.deleted)
          .sort((a, b) => (a.order != null ? a.order : 1e9) - (b.order != null ? b.order : 1e9))
          .map(h => h.name).filter(Boolean);
        if(names.length) return names;
      }
    }catch(e){}
    return ["Haven 1","Haven 2","Haven 3","Haven 4","Haven 5","Haven 7","Haven 8","CasaBienca","CasaSiesta"];
  }

  // Arriving ⇄ Availability tab switch (inside the arriving panel head)
  function apTab(view){
    document.querySelectorAll("#arrivePanel .ap-tab").forEach(t => t.classList.toggle("active", t.dataset.at === view));
    const isAvail = (view === "availability");
    const arr = document.getElementById("apArrivingBody"), av = document.getElementById("tbAvailBody");
    if(arr) arr.style.display = isAvail ? "none" : "";
    if(av) av.style.display = isAvail ? "" : "none";
    if(isAvail) renderAvailability();
  }

  // availability date picker (single date; same mini-calendar look as the custom-range picker)
  let tbAvailDate = null, tbAvailPickerMonth = null;
  function tbAvailOpenPicker(e){
    if(e && e.stopPropagation) e.stopPropagation();
    const pop = document.getElementById("tbAvailDpPop"); if(!pop) return;
    if(pop.style.display === "block"){ pop.style.display = "none"; return; }
    const d = new Date((tbAvailDate || iso(today())) + "T00:00:00");
    tbAvailPickerMonth = new Date(d.getFullYear(), d.getMonth(), 1);
    tbAvailRenderPicker();
    pop.style.display = "block";
  }
  function tbAvailPickerNav(dir){
    if(!tbAvailPickerMonth){ const d = new Date((tbAvailDate || iso(today())) + "T00:00:00"); tbAvailPickerMonth = new Date(d.getFullYear(), d.getMonth(), 1); }
    tbAvailPickerMonth = new Date(tbAvailPickerMonth.getFullYear(), tbAvailPickerMonth.getMonth() + dir, 1);
    tbAvailRenderPicker();
  }
  function tbAvailToday(){ tbAvailDate = iso(today()); const p = document.getElementById("tbAvailDpPop"); if(p) p.style.display = "none"; renderAvailability(); }
  function tbAvailPickDay(di){ tbAvailDate = di; const p = document.getElementById("tbAvailDpPop"); if(p) p.style.display = "none"; renderAvailability(); }
  function tbAvailRenderPicker(){
    const ttl = document.getElementById("tbAvailDpTitle"); if(!ttl || !tbAvailPickerMonth) return;
    const y = tbAvailPickerMonth.getFullYear(), m = tbAvailPickerMonth.getMonth();
    ttl.textContent = TB_MONTHS[m] + " " + y;
    const todayIso = iso(today()), sel = tbAvailDate || iso(today());
    const startDay = new Date(y, m, 1).getDay(), dim = new Date(y, m + 1, 0).getDate();
    let html = "";
    ["Su","Mo","Tu","We","Th","Fr","Sa"].forEach(d => html += '<div class="dp-wd">' + d + '</div>');
    for(let i = 0; i < startDay; i++) html += '<div class="dp-day empty"></div>';
    for(let d = 1; d <= dim; d++){
      const di = iso(new Date(y, m, d));
      html += '<div class="dp-day' + (di === todayIso ? " today" : "") + (di === sel ? " sel" : "") + '" onclick="tbAvailPickDay(\'' + di + '\')"><span class="n">' + d + '</span></div>';
    }
    document.getElementById("tbAvailDpGrid").innerHTML = html;
  }
  document.addEventListener("click", function(e){
    const p = document.getElementById("tbAvailDpPop");
    if(p && p.style.display === "block" && e.target && e.target.closest && !e.target.closest(".tb-dp-wrap")) p.style.display = "none";
  });

  // For the selected date, show each haven's earliest available check-in + its next booking.
  function renderAvailability(){
    bookings = loadBookings();   // reflect the latest saved bookings
    if(!tbAvailDate) tbAvailDate = iso(today());
    const D = tbAvailDate;
    const lbl = document.getElementById("tbAvailDateLabel"); if(lbl) lbl.textContent = fmt(D);
    const dayAbs = Math.round(new Date(D + "T00:00:00").getTime() / 60000);
    const dayEnd = dayAbs + 1440;
    let floor = dayAbs + EARLIEST_CHECKIN_MIN;                                    // can't check in before 9 AM on the day
    if(D === iso(today())) floor = Math.max(floor, Math.round(new Date().getTime() / 60000));   // for TODAY, no earlier than right now
    const fmtAbs = function(absMin){
      const dIso = iso(new Date(absMin * 60000));
      const mi = absMin - Math.round(new Date(dIso + "T00:00:00").getTime() / 60000);
      const t = minToTime(mi);
      return dIso === D ? t : (fmt(dIso) + " · " + t);
    };
    const havenList = availHavenNames();
    const rows = havenList.map(function(h){
      const intervals = bookings.filter(function(b){ return b && !b.cancelled && b.haven === h && b.checkin; })
        .map(function(b){ const iv = bookingInterval(b); return { ci: iv.start, freeAt: iv.end + CLEANING_GAP_MIN }; })
        .sort(function(a, b){ return a.ci - b.ci; });
      // earliest free check-in at/after the 9 AM floor (chain past any overlapping occupancy + cleaning)
      let availFrom = floor, changed = true, guard = 0;
      while(changed && guard++ < 80){
        changed = false;
        intervals.forEach(function(it){ if(it.ci <= availFrom && it.freeAt > availFrom){ availFrom = it.freeAt; changed = true; } });
      }
      // the next booking starting at/after that free time — limits how long a new guest can stay
      let next = null;
      intervals.forEach(function(it){ if(it.ci >= availFrom && (next === null || it.ci < next)) next = it.ci; });
      const dot = (HAVEN_COLORS[h] || { am:"#ccc" }).am;
      const hcell = '<span class="av-hcell"><span class="dot" style="background:' + dot + '"></span>' + h + '</span>';
      if(availFrom >= dayEnd){
        return '<tr><td>' + hcell + '</td><td><span class="av-bad">Not available</span></td><td>—</td><td class="muted">free ' + fmtAbs(availFrom) + '</td></tr>';
      }
      // which stay lengths (6 / 10 / 21 hrs) fit before the next booking, keeping the cleaning gap
      const windowMin = (next !== null) ? (next - availFrom) : Infinity;
      const fits = [6, 10, 21].filter(function(H){ return (H * 60 + CLEANING_GAP_MIN) <= windowMin; });
      if(!fits.length){
        return '<tr><td>' + hcell + '</td><td><span class="av-bad">Not available</span></td><td>—</td><td>' + (next !== null ? fmtAbs(next) : "—") + '</td></tr>';
      }
      const availTxt = (availFrom <= floor) ? (minToTime(floor - dayAbs) + ' <span class="muted">(open)</span>') : minToTime(availFrom - dayAbs);
      const hoursTxt = (fits.length === 1 ? String(fits[0]) : (fits.slice(0, -1).join(", ") + " or " + fits[fits.length - 1])) + " hrs";
      const nextTxt = (next !== null) ? fmtAbs(next) : '<span class="av-open">Open slot</span>';
      return '<tr><td>' + hcell + '</td><td><b>' + availTxt + '</b></td><td>' + hoursTxt + '</td><td>' + nextTxt + '</td></tr>';
    }).join("");
    document.getElementById("tbAvailList").innerHTML = rows
      ? '<div style="overflow-x:auto;"><table class="av-table"><thead><tr><th>Haven</th><th>Available check-in</th><th>Hours of stay available</th><th>Next check-in</th></tr></thead><tbody>' + rows + '</tbody></table></div>'
      : '<p class="muted">No havens.</p>';
  }

  function renderToday(){
    bookings = loadBookings();
    const _ab = document.getElementById("approvalBadge");
    if(_ab){ const n = bookings.filter(b => b.approved !== true).length; _ab.textContent = n ? String(n) : ""; }
    const _pab = document.getElementById("paymentApprovalBadge");
    if(_pab){
      const todayIso = iso(today());
      let pn = 0;
      bookings.forEach(b => (b.payments || []).forEach(p => { if(p && p.at && iso(new Date(p.at)) === todayIso && p.approved !== true) pn++; }));
      _pab.textContent = pn ? String(pn) : "";
    }
    const { start, end } = viewRange();
    const single = (currentView === "today" || currentView === "tomorrow" || currentView === "yesterday");
    const suffix = currentView === "today" ? "today" : currentView === "tomorrow" ? "tomorrow"
                 : currentView === "yesterday" ? "yesterday"
                 : currentView === "week" ? "this week"
                 : currentView === "custom" ? "selected range" : "this month";

    const lastDay = iso(addDays(new Date(end + "T00:00:00"), -1));
    document.getElementById("todayDateLabel").textContent = single
      ? new Date(start + "T00:00:00").toLocaleDateString("en-PH", { weekday:"long", month:"long", day:"numeric", year:"numeric" })
      : fmt(start) + " – " + fmt(lastDay);

    const tagged = bookings.filter(b => !b.cancelled).map(b => ({ b, info: rangeInfo(b, start, end) })).filter(x => x.info.relevant);
    const arrivals = tagged.filter(x => x.info.arrives).map(x => x.b)
      .sort((a,c) => (a.checkin||"").localeCompare(c.checkin||"") || bookingCheckinMin(a) - bookingCheckinMin(c));
    const others = tagged.filter(x => !x.info.arrives).map(x => x.b)
      .sort((a,c) => (a.checkout||"").localeCompare(c.checkout||"") || checkoutTimeStr(a).localeCompare(checkoutTimeStr(c)));

    const departCount = tagged.filter(x => x.info.departs).length;
    const inHouseCount = tagged.filter(x => x.info.staying).length;
    const toCollect = arrivals.reduce((s,b) => s + balanceOf(b), 0);

    // "Collected" is DATE-BASED (cash actually received in this range): each payment counts on its own
    // date. A collection uses its recorded date (p.at). The downpayment uses its dpDate if set (editable
    // per booking), else falls back to the booking-created date / check-in — so a downpayment taken on
    // an earlier day counts THAT day, not today. Cancelled bookings never count.
    const MOPS = ["Cash", "GCash", "BDO", "Maya", "Maribank", "Others"];
    const byMop = {}; MOPS.forEach(m => byMop[m] = 0);
    const bucket = (mop, amt) => { byMop[MOPS.includes(mop) ? mop : "Others"] += amt; };
    // A downpayment is collected when the booking is MADE (online / walk-in), so it counts on that day —
    // its dpDate if set, else the booking-created day (bookedAt, or derived from the timestamp id), else
    // check-in. So an online booking's downpayment (paid on a past day) is NOT in today's collected.
    const dpDayOf = b => {
      if(b.dpDate) return b.dpDate;
      if(b.bookedAt){ const s = String(b.bookedAt).slice(0, 10); if(/^\d{4}-\d\d-\d\d$/.test(s)) return s; }
      const idn = Number(b.id);
      if(isFinite(idn) && idn >= 1e12){
        const ms = idn >= 1e15 ? Math.floor(idn / 1000) : idn;
        const d = new Date(ms);
        if(!isNaN(d.getTime()) && d.getFullYear() >= 2020 && d.getFullYear() < 2100) return iso(d);
      }
      return b.checkin || null;
    };
    // Collected = every payment whose DATE falls in the range, across ALL bookings — arrivals' payments,
    // in-house/departing guests' add-ons or extra payments dated today, and new (Add-booking) payments
    // dated today. Each collection counts on its recorded date (p.at); the downpayment counts on the day
    // it was collected (dpDayOf → the booking-made day), so an online downpayment paid earlier is excluded.
    let collected = 0;
    bookings.forEach(b => {
      if(b.cancelled) return;
      const dp = Number(b.downpayment) || 0;
      if(dp > 0){
        const dpDay = dpDayOf(b);
        if(dpDay && dpDay >= start && dpDay < end){ collected += dp; bucket(b.method, dp); }
      }
      (b.payments || []).forEach(p => {
        const amt = Number(p.amount) || 0; if(!amt) return;
        const payDay = p.at ? iso(new Date(p.at)) : null;
        if(payDay && payDay >= start && payDay < end){ collected += amt; bucket(p.mop, amt); }
      });
    });

    // extra figures for the card sub-labels
    const inHouseGuests = tagged.filter(x => x.info.staying)
      .reduce((s, x) => s + ((x.b.guests || []).length || 0), 0);
    const balancesOpen = arrivals.filter(b => balanceOf(b) > 0).length;
    const nextArr = arrivals.length ? checkinTimeStr(arrivals[0]) : "";

    const ICON = {
      arrive:'<svg viewBox="0 0 24 24"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><path d="m10 17 5-5-5-5"/><path d="M15 12H3"/></svg>',
      depart:'<svg viewBox="0 0 24 24"><path d="M9 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/></svg>',
      bed:'<svg viewBox="0 0 24 24"><path d="M2 20v-7a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v7"/><path d="M2 16h20"/><path d="M6 11V8.5A1.5 1.5 0 0 1 7.5 7h3A1.5 1.5 0 0 1 12 8.5V11"/></svg>',
      clock:'<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>',
      cash:'<svg viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 12h.01M18 12h.01"/></svg>'
    };
    const cards = [
      { label:"Arriving " + suffix,  val:arrivals.length, ico:ICON.arrive, chip:"ico-green", sub: nextArr ? "Next at " + nextArr : "" },
      { label:"Departing " + suffix, val:departCount,     ico:ICON.depart, chip:"ico-terra", sub: departCount ? departCount + " checkout" + (departCount > 1 ? "s" : "") : "" },
      { label:(currentView === "today" ? "In-house now" : "In-house"), val:inHouseCount, ico:ICON.bed, chip:"ico-brown", sub: inHouseGuests ? inHouseGuests + " guests total" : "" },
      { label:"To collect " + suffix, val:peso(toCollect), ico:ICON.clock, chip:"ico-gold", sub: balancesOpen ? balancesOpen + " balance" + (balancesOpen > 1 ? "s" : "") + " open" : "" },
      { label:"Collected " + suffix,  val:peso(collected), ico:ICON.cash,  chip:"ico-green", sub:"" }
    ];
    document.getElementById("todayCards").innerHTML = cards.map(c =>
      `<div class="card">
        <div class="card-top"><span class="card-label">${c.label}</span><span class="card-ico ${c.chip}">${c.ico}</span></div>
        <div class="number">${c.val}</div>
        ${c.sub ? `<div class="card-sub">${c.sub}</div>` : ""}
      </div>`).join("");

    document.getElementById("mopHeading").textContent = "Collected " + suffix + " by payment method";
    document.getElementById("arriveHeading").textContent = "Arriving " + suffix;
    document.getElementById("stayHeading").innerHTML = "In-house &amp; departing " + suffix;

    document.getElementById("mopGrid").innerHTML = MOPS.map(m =>
      `<div class="mop-item"><span class="mop-label">${m}</span><span class="mop-val">${peso(byMop[m])}</span></div>`).join("");

    const arrivePill = b => statusOf(b) === "paid"
      ? '<span class="status paid">Paid</span>'
      : '<span class="status confirmed">Confirmed</span>';
    const stayPill = b => rangeInfo(b, start, end).departs
      ? '<span class="status departing">Departing</span>'
      : '<span class="status inhouse">In-house</span>';

    document.getElementById("todayArriveBody").innerHTML = arrivals.length
      ? arrivals.map(b => todayRow(b, balanceOf(b), arrivePill(b))).join("")
      : `<tr><td colspan="9" class="empty">No arrivals ${suffix}.</td></tr>`;
    document.getElementById("todayArriveCount").textContent = arrivals.length ? `(${arrivals.length})` : "";

    document.getElementById("todayStayBody").innerHTML = others.length
      ? others.map(b => todayRow(b, balanceOf(b), stayPill(b))).join("")
      : `<tr><td colspan="9" class="empty">Nobody else in-house or departing ${suffix}.</td></tr>`;
    document.getElementById("todayStayCount").textContent = others.length ? `(${others.length})` : "";

    // if the Availability tab is the one on screen, keep it fresh too — Refresh and cross-tab
    // updates both land here, and otherwise the availability table would show stale occupancy.
    const availTab = document.querySelector('#arrivePanel .ap-tab[data-at="availability"]');
    if(availTab && availTab.classList.contains("active")) renderAvailability();
  }

  // jump to another dashboard page — remember it so dashboard.html opens there
  function goPage(page){
    localStorage.setItem("shph_dashboard_page", page);
    window.location.href = "/dashboard.html";
  }
  function currentUser(){ return localStorage.getItem("shph_current_user") || "Admin"; }
  function logout(){ logActivity("logged out"); localStorage.removeItem("shph_current_user"); window.location.href = "/admin.html"; }
  // shared activity log (viewable on the dashboard's Log page)
  function logActivity(action){
    try {
      let log = [];
      try { log = JSON.parse(localStorage.getItem("shph_activity_log")) || []; } catch(e){}
      log.push({ user: currentUser(), action, at: new Date().toISOString() });
      localStorage.setItem("shph_activity_log", JSON.stringify(log.slice(-500)));
    } catch(e){ /* never let logging break an action (e.g. storage full) */ }
  }
  // after creating a booking, confirm the server actually stored it (the bookings
  // write is a large array that can be dropped on a flaky connection). Re-send and
  // retry, then warn the user so a customer booking is never silently lost.
  async function confirmBookingSaved(id){
    if(id == null) return;
    for(let attempt = 1; attempt <= 4; attempt++){
      await new Promise(r => setTimeout(r, 800 * attempt));
      try {
        const res = await fetch("/api/kv/" + encodeURIComponent(KEY), { cache:"no-store" });
        if(res.ok){
          const arr = await res.json();
          if(Array.isArray(arr) && arr.some(b => String(b.id) === String(id))) return;  // confirmed
        }
      } catch(e){ /* offline → try again */ }
      try { saveBookings(bookings); } catch(e){}   // re-send (mirror retries)
    }
    alert("⚠️ The booking is saved on THIS device, but the server hasn't confirmed it yet "
      + "(slow or unstable connection).\n\nPlease check your internet and REFRESH the page — "
      + "if the booking is missing, add it again.");
  }
  // confirm a CHANGE to an existing booking (e.g. a payment/collection) actually reached the
  // server. confirmBookingSaved only checks the id exists — which is always true for an edit,
  // so it can't catch a lost payment. This verifies the server's copy is as fresh as our edit.
  async function confirmBookingFresh(id, stamp){
    if(id == null || !stamp) return;
    for(let attempt = 1; attempt <= 5; attempt++){
      await new Promise(r => setTimeout(r, 900 * attempt));
      try {
        const res = await fetch("/api/kv/" + encodeURIComponent(KEY), { cache:"no-store" });
        if(res.ok){
          const arr = await res.json();
          const sb = Array.isArray(arr) && arr.find(b => String(b.id) === String(id));
          if(sb && sb.updatedAt && String(sb.updatedAt) >= String(stamp)) return;  // server has our change
        }
      } catch(e){ /* offline → retry */ }
      try { saveBookings(bookings); } catch(e){}   // nudge the durable queue to re-send
    }
    alert("⚠️ The payment is saved on THIS device, but the server hasn't confirmed it yet "
      + "(slow / unstable connection).\n\nKeep this tab OPEN and check your internet — it keeps "
      + "retrying automatically. Don't close the tab until the red 'unsaved' banner disappears.");
  }
  // is the logged-in user an administrator? (unknown / direct access = treated as admin)
  /* ---------- access control (mirrors dashboard.html) ---------- */
  const PAGE_KEYS = ["today","addbooking","calendar","guestform","approval","paymentapproval","deposit","havens","booking","cleaners","finance","payments","payroll","bills","expenses","analytics","users","employees","assist","log"];
  // resolve the logged-in user from the RAW stored name (no "Admin" default), so a
  // missing/unknown session can't inherit admin access and flash the full sidebar
  function currentUserObj(){
    try {
      const name = (localStorage.getItem("shph_current_user") || "").trim();
      if(!name) return null;
      const users = JSON.parse(localStorage.getItem("shph_users")) || [];
      return users.find(u => (u.name || "").toLowerCase() === name.toLowerCase()) || null;
    } catch(e){ return null; }
  }
  // fail CLOSED: an unrecognised user gets no admin / no pages
  function isAdmin(){ const u = currentUserObj(); return !!(u && u.admin); }
  let IS_ADMIN = isAdmin();
  function currentPerms(){
    const u = currentUserObj();
    if(!u) return [];
    if(u.admin) return PAGE_KEYS;
    return u.perms || [];
  }
  // admins, CSRs, and users granted the "Add Booking" permission may create bookings
  function canAddBooking(){
    if(IS_ADMIN) return true;
    if(currentPerms().includes("addbooking")) return true;
    try {
      const st = JSON.parse(localStorage.getItem("shph_staff_v1")) || [];
      const un = currentUser().trim().toLowerCase();
      const owns = s => {
        const sn = (s.name || "").trim().toLowerCase();
        return sn === un || sn.startsWith(un + " ") || sn.split(/\s+/)[0] === un;
      };
      return st.filter(owns).some(s => s.role === "CSR");
    } catch(e){ return false; }
  }
  function applyPerms(){
    // no recognised logged-in user → send to login instead of revealing anything
    if(!currentUserObj()){ window.location.href = "/admin.html"; return; }
    const admin = IS_ADMIN;
    // Branded per-user URL (e.g. /nicole-todaysbooking) is LOCKED to its owner — only that user
    // (or an admin, so the owner is never locked out) may open it; a different signed-in user is
    // bounced to the plain dashboard. Logged-out visitors were already sent to login just above.
    const _bo = (location.pathname.replace(/\/+$/, "").toLowerCase().match(/^\/([a-z]+)-(?:todaysbooking|dashboard)$/) || [])[1];
    if(_bo && !admin){
      const _me = (localStorage.getItem("shph_current_user") || "").trim().toLowerCase();
      if(_me !== _bo){
        alert("This page is only for " + _bo.charAt(0).toUpperCase() + _bo.slice(1) + "'s account. You're signed in as someone else.");
        window.location.href = "/dashboard.html"; return;
      }
    }
    const perms = currentPerms();
    // not allowed to view Today's Booking → bounce to the dashboard (it routes to an allowed page)
    if(!admin && !perms.includes("today")){ window.location.href = "/dashboard.html"; return; }
    // hide sidebar items the user can't access
    document.querySelectorAll(".sidebar .nav-item").forEach(n => {
      const pg = n.dataset.page;
      if(!pg) return;
      const ok = (pg === "users") ? admin : (admin || perms.includes(pg));
      n.style.display = ok ? "flex" : "none";
    });
    // hide a section header (Property / Finance / Team …) when all its items are hidden
    document.querySelectorAll(".sidebar .nav-group").forEach(g => {
      let sib = g.nextElementSibling, any = false;
      while(sib && !(sib.classList && sib.classList.contains("nav-group"))){
        if(sib.classList && sib.classList.contains("nav-item") && sib.style.display !== "none"){ any = true; break; }
        sib = sib.nextElementSibling;
      }
      g.style.display = any ? "" : "none";
    });
    document.querySelector(".sidebar").classList.remove("perms-pending");  // reveal now that it's filtered
    const ab = document.getElementById("addBookingBtn");
    if(ab) ab.style.display = canAddBooking() ? "" : "none";   // only admin/CSR can add bookings
  }

  /* ---------- payment / collection popup ---------- */
  let payBookingId = null, payProof = null, payEditing = false, payEditIndex = -1, payEditDown = false;

  // show the downpayment's uploaded proof photo (recorded on the booking) in the lightbox
  function viewDownProof(id){
    const b = bookings.find(x => x.id === id);
    if(b && b.downProof) openProofImg(b.downProof);
    else uhOhNoProof();
  }
  function uhOhNoProof(){ alert("No downpayment proof was uploaded for this booking."); }

  // list of all payments made for this booking
  function renderPayList(b){
    const el = document.getElementById("payList");
    const pays = (b && b.payments) || [];
    const dp = Number(b && b.downpayment) || 0;
    const count = pays.length + (dp > 0 ? 1 : 0);
    if(!count){ el.innerHTML = ""; return; }
    const check = `<span class="pli-check"><svg viewBox="0 0 24 24"><path d="m5 12 4.5 4.5L19 7"/></svg></span>`;
    let html = `<div class="pay-list-title">Payments made <span class="plt-count">(${count})</span></div>`;
    if(dp > 0){
      const hasProof = !!b.downProof;
      html += `<div class="pay-list-item ${payEditDown ? "active" : ""}">
          ${check}
          <span class="pli-main" onclick="loadDownInto()" style="cursor:pointer;"><strong>${peso(dp)}</strong> · Downpayment · ${b.method || "—"}
            <small>tap to edit (amount / date / method)${hasProof ? " · view proof →" : ""}</small></span>
          ${hasProof ? `<span class="pli-del" style="color:#2b6cb0;" onclick="viewDownProof(${b.id})">View</span>` : ""}
        </div>`;
    }
    html += pays.map((p, i) => `
        <div class="pay-list-item ${i === payEditIndex ? "active" : ""}">
          ${check}
          <span class="pli-main" onclick="loadPayInto(${i})">
            <strong>${peso(p.amount)}</strong> · ${p.category || "Balance"} · ${p.mop}
            <small>${new Date(p.at).toLocaleString("en-PH", {month:"short",day:"numeric",hour:"numeric",minute:"2-digit"})}${p.by ? " · " + p.by : ""}</small>
          </span>
          <span class="pli-del" onclick="deletePaymentAt(${i})">Delete</span>
        </div>`).join("");
    el.innerHTML = html;
  }
  // fill the form from a payment (p = null → blank new entry)
  function fillPayForm(b, p){
    const prev = document.getElementById("payPreview");
    document.getElementById("payFile").value = "";
    const nameEl = document.getElementById("payFileName");
    if(p){
      document.getElementById("payAmount").value = Number(p.amount) || 0;
      document.getElementById("payMop").value = p.mop || "Cash";
      document.getElementById("payFor").value = p.category || "Balance";
      payDateSet(p.at ? iso(new Date(p.at)) : iso(today()));
      payProof = p.proof || null;
      if(nameEl) nameEl.textContent = payProof ? "Photo attached ✓" : "No file chosen";
      if(payProof){ prev.src = payProof; prev.style.display = "block"; } else { prev.src = ""; prev.style.display = "none"; }
    } else {
      document.getElementById("payAmount").value = balanceOf(b);
      document.getElementById("payMop").selectedIndex = 0;
      document.getElementById("payFor").value = "Balance";
      payDateSet(iso(today()));
      payProof = null; prev.src = ""; prev.style.display = "none";
      if(nameEl) nameEl.textContent = "No file chosen";
    }
  }
  function updatePayButtons(editingExisting){
    document.getElementById("payDelBtn").style.display = editingExisting ? "inline-block" : "none";
    document.getElementById("payAddBtn").style.display = editingExisting ? "inline-block" : "none";  // "+ Add payment" = new entry
    document.getElementById("paySaveAddBtn").style.display = editingExisting ? "none" : "inline-block";
    document.getElementById("paySaveBtn").textContent = editingExisting ? "Update Payment" : "Save Payment";
  }
  // ---- styled "Date collected" calendar (matches the app's other date pickers) ----
  let payDpMonth = null;
  function payDpFmt(ci){ if(!ci) return "Pick a date"; const d = new Date(ci + "T00:00:00"); return TB_MONTHS[d.getMonth()].slice(0,3) + " " + d.getDate() + ", " + d.getFullYear(); }
  function payDateSet(ci){
    const inp = document.getElementById("payDate"); if(inp) inp.value = ci || "";
    const lbl = document.getElementById("payDateLabel"); if(lbl) lbl.textContent = payDpFmt(ci);
  }
  function payDpToggle(e){
    if(e) e.stopPropagation();
    const pop = document.getElementById("payDpPop");
    if(pop.style.display === "block"){ pop.style.display = "none"; return; }
    const cur = document.getElementById("payDate").value;
    const base = cur ? new Date(cur + "T00:00:00") : today();
    payDpMonth = new Date(base.getFullYear(), base.getMonth(), 1);
    payDpRender();
