  function renderPool(start, end){
    const all = loadPool();
    // index map so delete targets the right entry after filtering
    const rows = all.map((p, i) => ({ p, i })).filter(({ p }) => { const d = iso(new Date(p.at)); return d >= start && d < end; });
    const qtyTotal = rows.reduce((s, { p }) => s + (Number(p.qty) || 0), 0);
    const amtTotal = rows.reduce((s, { p }) => s + (Number(p.amount) || 0), 0);
    const scopeEl = document.getElementById("poolScope");
    if(scopeEl) scopeEl.textContent = "— sold this period";
    document.getElementById("poolCards").innerHTML =
      `<div class="card"><h3>Passes sold</h3><div class="number"><svg class="addon-ico" viewBox="0 0 24 24" style="width:22px;height:22px;vertical-align:-2px"><path d="M2 16c1.5 0 1.5 1 3 1s1.5-1 3-1 1.5 1 3 1 1.5-1 3-1 1.5 1 3 1 1.5-1 3-1"/><path d="M2 20c1.5 0 1.5 1 3 1s1.5-1 3-1 1.5 1 3 1 1.5-1 3-1 1.5 1 3 1 1.5-1 3-1"/><path d="M8 13V6a2 2 0 0 1 4 0"/></svg> ${qtyTotal}</div></div>` +
      `<div class="card"><h3>Pool pass income</h3><div class="number money">${peso(amtTotal)}</div></div>`;
    document.getElementById("poolBody").innerHTML = rows.length ? rows.map(({ p, i }) => `
        <tr>
          <td>${new Date(p.at).toLocaleTimeString("en-PH", { hour:"numeric", minute:"2-digit" })}</td>
          <td>${p.name ? escTxt(p.name) : '<span class="muted">Walk-in</span>'}</td>
          <td>${p.qty}</td>
          <td>${p.mop}</td>
          <td>${peso(p.amount)}</td>
          <td>${p.by || "—"}</td>
          <td><span class="edit-pay" style="color:#c0283d;" onclick="deletePoolPass(${i})">Delete</span></td>
        </tr>`).join("") : `<tr><td colspan="7" class="empty">No pool passes sold this period.</td></tr>`;
  }
  function escTxt(s){ return String(s).replace(/[&<>"]/g, c => ({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;" }[c])); }

  /* ---------- add booking (saves to the shared Calendar/Bookings data) ---------- */
  const HAVENS = ["Haven 1","Haven 2","Haven 3","Haven 4","Haven 5","Haven 7","Haven 8","Casa Bienca"];
  const PRICING = { stay6:999, stay10:1599, stay21Weekday:1799, stay21Weekend:2099, swimRegular:150, swimHoliday:300,
    towel:50, extendPerHr:150, deposit:1000, baseIncludedPax:2, addPax:300, addPaxMinAge:5, maxPax:5, maxAdults:4, maxKids:2, kidMaxAge:13 };
  const STAY_OPTIONS = [[6,"6 hrs — ₱999"],[10,"10 hrs — ₱1,599"],[21,"21 hrs — ₱1,799 / ₱2,099 (Fri–Sat)"]];

  function billablePax(g){ return (g||[]).filter(x => x.age != null && Number(x.age) >= PRICING.addPaxMinAge).length; }
  function addPaxFee(g){ return Math.max(0, billablePax(g) - PRICING.baseIncludedPax) * PRICING.addPax; }
  function lastName(name){ const p = (name||"").trim().split(/\s+/); return p.length ? p[p.length-1].toLowerCase() : ""; }
  function baseRate(stayHours, checkinIso){
    stayHours = Number(stayHours);
    if(stayHours === 6) return PRICING.stay6;
    if(stayHours === 10) return PRICING.stay10;
    if(stayHours === 21){ const wd = new Date(checkinIso + "T00:00:00").getDay(); return (wd === 5 || wd === 6) ? PRICING.stay21Weekend : PRICING.stay21Weekday; }
    return 0;
  }
  function computeTotal(b){
    const base = baseRate(b.stayHours, b.checkin);
    const pax  = addPaxFee(b.guests);
    const swim = (Number(b.swimpass) || 0) * (b.holiday ? PRICING.swimHoliday : PRICING.swimRegular);
    const tow  = (Number(b.towels) || 0) * PRICING.towel;
    const ext  = (Number(b.extend) || 0) * PRICING.extendPerHr;
    const dep  = (b.deposit === undefined ? PRICING.deposit : Number(b.deposit)) || 0;
    return base + pax + swim + tow + ext + dep;
  }
  function findConflict(cand, excludeId){
    const cs = cand.checkin, ce = endExcl(cand);
    return bookings.find(b => {
      if(b.id === excludeId) return false;
      if(b.cancelled) return false;   // cancelled → haven is free
      if(b.haven !== cand.haven) return false;
      const overlap = cs < endExcl(b) && b.checkin < ce;
      if(!overlap) return false;
      if(Number(b.stayHours) !== 6 || Number(cand.stayHours) !== 6) return true;
      return b.slot === cand.slot;
    }) || null;
  }
  function dashCheckinMin(timeStr){ const m = parseTimeMin(timeStr); if(m == null) return 480; return m === 0 ? 1440 : m; }

  function aFillCheckinTimes(){
    let html = ""; for(let h = 0; h < 24; h++){ const t = minToTime(h * 60); html += `<option value="${t}">${t}</option>`; }
    html += `<option value="__custom__">Custom time…</option>`;
    document.getElementById("a_checkinTime").innerHTML = html;
  }
  // toggle the free time input when "Custom time…" is picked
  function aTimeSelChange(){
    const custom = document.getElementById("a_checkinTimeCustom");
    custom.style.display = document.getElementById("a_checkinTime").value === "__custom__" ? "block" : "none";
    aRecompute();
  }
  // the effective check-in time string (handles the custom HH:MM input)
  function aCheckinTimeValue(){
    const sel = document.getElementById("a_checkinTime");
    if(sel.value === "__custom__"){
      const v = document.getElementById("a_checkinTimeCustom").value; // "HH:MM" 24h
      if(!v) return "8:00 AM";
      const [h, m] = v.split(":").map(Number);
      return minToTime(h * 60 + m);
    }
    return sel.value;
  }
  function aUpdateStayOptions(keep){
    const sel = document.getElementById("a_stay");
    const ci = document.getElementById("a_checkin").value;
    const wd = ci ? new Date(ci + "T00:00:00").getDay() : 1;
    const opts = (wd === 6) ? STAY_OPTIONS.filter(o => o[0] === 21) : STAY_OPTIONS;
    const want = String(keep != null ? keep : sel.value);
    sel.innerHTML = opts.map(o => `<option value="${o[0]}">${o[1]}</option>`).join("");
    sel.value = opts.some(o => String(o[0]) === want) ? want : String(opts[0][0]);
  }
  function aGuestRow(g){
    g = g || { name:"", age:"" };
    const age = (g.age !== "" && g.age != null) ? g.age : "";
    const nm = (g.name || "").trim();
    const sp = nm.lastIndexOf(" ");
    const first = sp > 0 ? nm.slice(0, sp) : nm;
    const last  = sp > 0 ? nm.slice(sp + 1) : "";
    const esc = s => String(s).replace(/"/g, "&quot;");
    return `<div class="guest-row">
      <input class="gfirst" placeholder="First name" value="${esc(first)}">
      <input class="glast" placeholder="Last name" value="${esc(last)}">
      <input class="gage" type="number" min="0" placeholder="Age" value="${age}">
      <button type="button" class="gdel" onclick="this.parentNode.remove(); aRecalc();">×</button>
    </div>`;
  }
  function aBindGuestInputs(){ document.querySelectorAll("#aGuestList input").forEach(inp => { inp.oninput = aRecalc; }); }
  function aRenderGuests(list){
    document.getElementById("aGuestList").innerHTML = (list && list.length ? list : [{name:"",age:""}]).map(aGuestRow).join("");
    aBindGuestInputs();
  }
  function aAddGuest(){ document.getElementById("aGuestList").insertAdjacentHTML("beforeend", aGuestRow()); aBindGuestInputs(); }
  function aReadGuests(){
    return [...document.querySelectorAll("#aGuestList .guest-row")].map(r => {
      const first = (r.querySelector(".gfirst").value || "").trim();
      const last  = (r.querySelector(".glast").value || "").trim();
      return {
        name: (first + " " + last).trim(),
        age: r.querySelector(".gage").value === "" ? null : Number(r.querySelector(".gage").value)
      };
    }).filter(g => g.name !== "");
  }
  function aRecompute(){
    const ci = document.getElementById("a_checkin").value;
    const t = aCheckinTimeValue();
    const hours = Number(document.getElementById("a_stay").value) || 0;
    const ext = Number(document.getElementById("a_extend").value) || 0;
    if(ci && t){
      const total = dashCheckinMin(t) + (hours + ext) * 60;
      const co = addDays(new Date(ci + "T00:00:00"), Math.floor(total / 1440));
      document.getElementById("a_checkout").value = iso(co);
      document.getElementById("a_checkoutTime").value = minToTime(total);
    }
    aRecalc();
  }
  function aOnCheckinChange(){ aUpdateStayOptions(); aRecompute(); }
  function aRecalc(){
    const b = {
      checkin: document.getElementById("a_checkin").value,
      stayHours: Number(document.getElementById("a_stay").value),
      guests: aReadGuests(),
      swimpass: Number(document.getElementById("a_swimpass").value) || 0,
      towels: Number(document.getElementById("a_towels").value) || 0,
      extend: Number(document.getElementById("a_extend").value) || 0,
      holiday: document.getElementById("a_holiday").checked,
      deposit: Number(document.getElementById("a_deposit").value) || 0
    };
    const total = computeTotal(b);
    document.getElementById("a_total").value = total;
    const down = Number(document.getElementById("a_down").value) || 0;
    document.getElementById("a_balance").value = peso(Math.max(0, total - down));
    const base = baseRate(b.stayHours, b.checkin);
    const swimRate = b.holiday ? PRICING.swimHoliday : PRICING.swimRegular;
    document.getElementById("a_breakdown").innerHTML =
      `Base for 2 pax (${b.stayHours}h): ${peso(base)} · Extra pax: ${peso(addPaxFee(b.guests))}` +
      ` · Swimpass ${b.swimpass}×${peso(swimRate)}: ${peso(b.swimpass*swimRate)}` +
      ` · Towels ${b.towels}×₱50: ${peso(b.towels*PRICING.towel)}` +
      ` · Extend ${b.extend}h×₱150: ${peso(b.extend*PRICING.extendPerHr)} · Deposit: ${peso(b.deposit)}`;
  }
  function openAdd(){
    if(!canAddBooking()){ alert("Only an administrator or CSR can add a booking."); return; }
    // Use the ONE unified Add Booking modal that lives on the dashboard, then
    // come straight back to Today's Booking once it's saved or cancelled.
    try{
      localStorage.setItem("shph_open_add", "1");
      localStorage.setItem("shph_add_return", "todaysbooking.html");
    }catch(e){}
    window.location.href = "/dashboard.html";
  }
  function closeAdd(){ document.getElementById("addOverlay").classList.remove("show"); }
  async function saveNewBooking(){
    bookings = loadBookings();
    const guests = aReadGuests();
    const checkin = document.getElementById("a_checkin").value;
    const checkout = document.getElementById("a_checkout").value;
    if(guests.length === 0){ alert("Please enter at least one guest name."); return; }
    for(let i=0;i<guests.length;i++){ const g = guests[i]; if(g.age == null || isNaN(g.age) || g.age < 0){ alert(`Please enter a valid age for ${g.name || ("guest "+(i+1))}.`); return; } }
    if(guests[0].age < 18){ alert("The first guest (primary booker) must be 18 years old and above."); return; }
    if(guests.length >= 2 && guests[1].age < 18 && lastName(guests[1].name) !== lastName(guests[0].name)){ alert("The second guest is a minor and must be a family member (same last name) of the first guest."); return; }
    const kids = guests.filter(g => g.age <= PRICING.kidMaxAge).length;
    const adults = guests.length - kids;
    if(guests.length > PRICING.maxPax){ alert(`Maximum of ${PRICING.maxPax} pax per unit.`); return; }
    if(adults > PRICING.maxAdults){ alert(`Maximum of ${PRICING.maxAdults} adults per unit.`); return; }
    if(kids > PRICING.maxKids){ alert(`Maximum of ${PRICING.maxKids} kids (0–13 yrs) per unit.`); return; }
    if(!checkin || !checkout || checkout < checkin){ alert("Please enter a valid check-in and check-out date."); return; }
    const stayHours = Number(document.getElementById("a_stay").value);
    if(new Date(checkin + "T00:00:00").getDay() === 6 && stayHours !== 21){ alert("Saturday check-ins are 21 hours only."); return; }
    const checkinTime = aCheckinTimeValue();
    const data = {
      haven: document.getElementById("a_haven").value,
      guests, contact: document.getElementById("a_contact").value.trim(),
      checkin, checkout, stayHours, checkinTime,
      slot: stayHours === 6 ? (dashCheckinMin(checkinTime) <= 720 ? "morning" : "evening") : null,
      swimpass: Number(document.getElementById("a_swimpass").value) || 0,
      towels: Number(document.getElementById("a_towels").value) || 0,
      extend: Number(document.getElementById("a_extend").value) || 0,
      holiday: document.getElementById("a_holiday").checked,
      deposit: Number(document.getElementById("a_deposit").value) || 0,
      method: document.getElementById("a_method").value,
      downpayment: Number(document.getElementById("a_down").value) || 0,
      notes: document.getElementById("a_notes").value.trim()
    };
    data.total = computeTotal(data);
    if(!data.haven){ alert("Please choose a haven."); return; }
    const clash = findConflict(data, null);
    if(clash){ alert(`${data.haven} is already booked for those dates by ${(clash.guests && clash.guests[0] && clash.guests[0].name) || "another guest"}.`); return; }
    if(_savingNewBooking) return;   // block double-click (a 2nd click would create a duplicate booking)
    _savingNewBooking = true;
    try{
      // unique across browsers (Math.max+1 would let two concurrent creators collide and overwrite)
      const newId = Date.now() * 1000 + Math.floor(Math.random() * 1000);
      const rec = { id:newId, ...data };
      // PER-RECORD create — inserts only this booking on the server (can't overwrite the rest)
      let ok = false;
      try{ const res = await fetch("/api/list/" + encodeURIComponent(KEY), { method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify({ upsert: rec }) }); ok = res.ok; }catch(e){}
      if(!ok){ alert("⚠️ The booking was NOT saved — the server didn't confirm (slow / offline). Please try again."); return; }
      bookings.push(rec);
      try{ (window.shphSetLocal || localStorage.setItem.bind(localStorage))(KEY, JSON.stringify(bookings)); }catch(e){}
      const gName = (data.guests[0] && data.guests[0].name) || "";
      logActivity(`added booking — ${data.haven} (${gName})`);
      closeAdd();
      renderToday();
      alert("Booking saved. It now appears in Calendar/Bookings.");
    } finally { _savingNewBooking = false; }
  }
  let _savingNewBooking = false;
  document.getElementById("addOverlay").addEventListener("click", e => { if(e.target.id === "addOverlay") closeAdd(); });

  document.getElementById("currentUserLabel").textContent = "Logged in as " + currentUser();
  applyPerms();
  // restore the last-selected view (Yesterday/Today/Tomorrow/Week/Month) across refreshes
  (function restoreView(){
    const saved = localStorage.getItem("shph_today_view");
    const valid = ["yesterday","today","tomorrow","week","month","custom"];
    if(saved && valid.includes(saved)) currentView = saved;
    if(currentView === "custom"){
      try{ const c = JSON.parse(localStorage.getItem("shph_today_custom") || "null"); if(c && c.f && c.t){ customStart = c.f; customEnd = c.t; } else { currentView = "today"; } }catch(e){ currentView = "today"; }
    }
    if(currentView === "custom" && !IS_ADMIN) currentView = "today";   // range picker is admin-only
    document.querySelectorAll(".view-tab").forEach(t => t.classList.toggle("active", t.dataset.view === currentView));
    // show the admin-only date range picker
    if(IS_ADMIN){
      const r = document.getElementById("tbRangeWrap");
      if(r) r.style.display = "inline-block";
      if(currentView === "custom" && customStart){
        const lbl = document.getElementById("tbRangeBtnLabel");
        if(lbl) lbl.textContent = fmt(customStart) + (customStart === customEnd ? "" : " – " + fmt(customEnd));
      }
    }
  })();
  renderToday();
  renderTodayLog();   // admin-only activity log below the lists

  // keep this page in sync when bookings are changed in another tab (e.g. the dashboard)
  window.addEventListener("storage", e => {
    // another tab/device changed the bookings → RELOAD them (never keep a stale list in memory
    // that a later save would push back over newer data) and reset the change baseline.
    if(e.key === KEY){ bookings = loadBookings(); _seedBkSig(bookings); renderToday(); }
    if(e.key === "shph_activity_log") renderTodayLog();
  });

  /* ---- premium hero: live greeting + clock, real "today" arrivals/checkouts ---- */
  (function(){
    var DAYS=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
    var MONTHS=['January','February','March','April','May','June','July','August','September','October','November','December'];
    var two = function(n){ return String(n).padStart(2,'0'); };
    function heroTick(){
      var now = new Date();
      var h = now.getHours();
      var greet = h < 12 ? 'Good Morning' : (h < 18 ? 'Good Afternoon' : 'Good Evening');
      var name = (typeof currentUser === 'function' ? currentUser() : 'Nicole') || 'Nicole';
      var first = String(name).trim().split(/\s+/)[0] || 'Nicole';
      var set = function(id, v){ var el = document.getElementById(id); if(el) el.textContent = v; };
      set('nhGreeting', greet + ', ' + first + '!');
      set('nhDayName', DAYS[now.getDay()]);
      set('nhDate', DAYS[now.getDay()] + ', ' + MONTHS[now.getMonth()] + ' ' + now.getDate() + ', ' + now.getFullYear());
      var hr = now.getHours(), ap = hr >= 12 ? 'PM' : 'AM'; hr = hr % 12; if(hr === 0) hr = 12;
      set('nhClock', hr + ':' + two(now.getMinutes()) + ' ' + ap);
      // real arrivals / checkouts for TODAY (reuses this page's own live data + helpers)
      try{
        if(typeof loadBookings === 'function' && typeof todayInfo === 'function' && typeof iso === 'function' && typeof today === 'function'){
          var t = iso(today()), arr = 0, dep = 0;
          loadBookings().forEach(function(b){ var i = todayInfo(b, t); if(i.arrives) arr++; if(i.departs) dep++; });
          set('nhSub', 'You have ' + arr + ' arrival' + (arr === 1 ? '' : 's') + ' and ' + dep + ' checkout' + (dep === 1 ? '' : 's') + ' today.');
        }
      }catch(e){}
      var av = document.getElementById('hvAvatar'); if(av) av.textContent = (first.charAt(0) || 'N').toUpperCase();
    }
    heroTick();
    setInterval(heroTick, 1000);
  })();
</script>
</body>
