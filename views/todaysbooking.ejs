<script>
  // shares the dashboard's data — same localStorage key
  const KEY = "shph_bookings_v3";
  const HAVEN_TIMES = {
    "Haven 1":{in:"12:00 NN"}, "Haven 2":{in:"12:00 NN"}, "Haven 3":{in:"12:00 NN"},
    "Haven 4":{in:"3:00 PM"}, "Haven 5":{in:"3:00 PM"}, "Haven 7":{in:"3:00 PM"},
    "Haven 8":{in:"6:00 PM"}, "Casa Bienca":{in:"6:00 PM"}
  };

  /* ---------- date helpers ---------- */
  function today(){ const d = new Date(); d.setHours(0,0,0,0); return d; }
  function addDays(date, n){ const d = new Date(date); d.setDate(d.getDate()+n); return d; }
  function iso(date){
    const y = date.getFullYear();
    const m = String(date.getMonth()+1).padStart(2,"0");
    const d = String(date.getDate()).padStart(2,"0");
    return `${y}-${m}-${d}`;
  }
  function fmt(dateStr){
    const d = new Date(dateStr + "T00:00:00");
    return d.toLocaleDateString("en-PH", {month:"short", day:"numeric"});
  }
  function peso(n){ return "₱" + Number(n).toLocaleString("en-PH"); }

  /* ---------- haven colour scheme (matches the calendar legend) ---------- */
  const HAVEN_COLORS = {
    "Haven 1":    { am:"#d9bdf5", pm:"#b98ee6" },
    "Haven 2":    { am:"#fde68a", pm:"#ecca4e" },
    "Haven 3":    { am:"#bcbcbc", pm:"#8c8c8c" },
    "Haven 4":    { am:"#bcf3cf", pm:"#84dca0" },
    "Haven 5":    { am:"#bcd0fb", pm:"#7ea6f4" },
    "Haven 7":    { am:"#aef0f7", pm:"#66d8e8" },
    "Haven 8":    { am:"#fcd0e7", pm:"#f5a3d0" },
    "CasaBienca": { am:"#cdff8f", pm:"#a8ec5c" },
    "CasaSiesta": { am:"#ffd2a8", pm:"#f5ab68" }
  };
  function havenPastel(name){
    let h = 0; for(let i=0;i<name.length;i++) h = (h*31 + name.charCodeAt(i)) % 360;
    return { am:`hsl(${h} 70% 80%)`, pm:`hsl(${h} 60% 66%)` };
  }
  function havenColors(name){ return HAVEN_COLORS[name] || (HAVEN_COLORS[name] = havenPastel(name)); }
  // a darker, text-legible shade of the haven's colour
  function havenInk(name){
    const c = havenColors(name);
    // CSS color-mix darkens the pastel for readable text while staying on-scheme
    return `color-mix(in srgb, ${c.pm} 78%, #2f2a25)`;
  }

  /* ---------- check-in / check-out times ---------- */
  function parseTimeMin(str){
    const m = String(str).match(/^(\d{1,2}):(\d{2})\s*(AM|PM|NN|MN)$/i);
    if(!m) return null;
    let h = Number(m[1]); const min = Number(m[2]); const suf = m[3].toUpperCase();
    if(suf === "NN") h = 12; else if(suf === "MN") h = 0; else if(suf === "PM") h = (h % 12) + 12; else h = h % 12;
    return h * 60 + min;
  }
  function minToTime(min){
    min = ((min % 1440) + 1440) % 1440;
    const h = Math.floor(min / 60), mm = String(min % 60).padStart(2, "0");
    if(h === 0) return `12:${mm} MN`;
    if(h === 12) return `12:${mm} NN`;
    return `${h > 12 ? h - 12 : h}:${mm} ${h < 12 ? "AM" : "PM"}`;
  }
  function bookingCheckinMin(b){
    if(b.checkinTime){ const m = parseTimeMin(b.checkinTime); if(m != null) return m === 0 ? 1440 : m; }
    const h = Number(b.stayHours) || 21;
    if(h === 6) return parseTimeMin(b.slot === "evening" ? "7:00 PM" : "8:00 AM");
    if(h === 21){ const t = HAVEN_TIMES[b.haven]; return t ? parseTimeMin(t.in) : parseTimeMin("12:00 NN"); }
    return parseTimeMin("8:00 AM");
  }
  function checkinTimeStr(b){ return minToTime(bookingCheckinMin(b)); }
  function checkoutTimeStr(b){
    return minToTime(bookingCheckinMin(b) + ((Number(b.stayHours) || 21) + (Number(b.extend) || 0)) * 60);
  }
  function endExcl(b){
    return b.checkout > b.checkin ? b.checkout : iso(addDays(new Date(b.checkin + "T00:00:00"), 1));
  }

  /* ---------- booking helpers ---------- */
  // total collected AFTER booking (via the Paid button) — kept separate from the downpayment
  function collectedSum(b){ return (b.payments || []).reduce((s,p) => s + (Number(p.amount) || 0), 0); }
  // everything the customer has paid so far = original downpayment + later collections
  function paidOf(b){ return Number(b.downpayment || 0) + collectedSum(b); }
  function balanceOf(b){ return Math.max(0, Number(b.total || 0) - paidOf(b)); }
  function statusOf(b){
    const paid = paidOf(b);
    if(paid >= b.total && b.total > 0) return "paid";
    if(paid > 0) return "partial";
    return "unpaid";
  }
  function guestSummary(b){ return (b.guests || []).map(g => `${g.name} (${g.age})`).join("<br>"); }
  function addonsCell(b){
    const ico = s => `<svg class="addon-ico" viewBox="0 0 24 24">${s}</svg>`;
    const POOL  = '<path d="M2 16c1.5 0 1.5 1 3 1s1.5-1 3-1 1.5 1 3 1 1.5-1 3-1 1.5 1 3 1 1.5-1 3-1"/><path d="M2 20c1.5 0 1.5 1 3 1s1.5-1 3-1 1.5 1 3 1 1.5-1 3-1 1.5 1 3 1 1.5-1 3-1"/><path d="M8 13V6a2 2 0 0 1 4 0"/>';
    const TOWEL = '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 3v18"/>';
    const CLOCK = '<circle cx="12" cy="12" r="9"/><path d="M12 7.5v5l3 2"/>';
    const bits = [];
    if(b.swimpass > 0) bits.push(`<span class="addon">${ico(POOL)}${b.swimpass}</span>`);
    if(b.towels   > 0) bits.push(`<span class="addon">${ico(TOWEL)}${b.towels}</span>`);
    if(b.extend   > 0) bits.push(`<span class="addon">${ico(CLOCK)}+${b.extend}h</span>`);
    return bits.length ? bits.join(" ") : '<span class="muted">—</span>';
  }
  function todayInfo(b, t){
    const dayUse = !(b.checkout > b.checkin);
    const arrives  = b.checkin === t;
    const departs  = dayUse ? b.checkin === t : b.checkout === t;
    const staying  = b.checkin <= t && t < endExcl(b);
    return { arrives, departs, staying, relevant: arrives || departs || staying };
  }
  function todayRow(b, amountCol, statusHtml){
    const st = statusOf(b);
    const hasPayment = b.payments && b.payments.length;
    const updateLink = ` <span class="edit-pay" onclick="openPay(${b.id}, true)">Update payment</span>`;
    // action follows the real status: fully paid → ✓ Paid; otherwise → Paid button to collect
    const payCell = (st === "paid")
      ? `<span class="paid-tag">✓ Paid</span>${IS_ADMIN ? updateLink : ""}`
      : `<button class="btn-paid" onclick="openPay(${b.id})">Paid</button>${(IS_ADMIN && hasPayment) ? updateLink : ""}`;
    const over = paidOf(b) - Number(b.total || 0);   // excess payment, if any
    const amtCell = amountCol > 0
        ? peso(amountCol)
        : (over > 0 ? `<span style="color:#2e9e5b; font-weight:700;">+${peso(over)} over</span>` : '<span class="muted">—</span>');
    const addonLink = canAddBooking() ? ` <span class="edit-pay" onclick="openAddon(${b.id})">+ Add-ons</span>` : "";
    return `<tr>
        <td><strong style="color:${havenInk(b.haven)};"><span class="hv-dot" style="background:${havenColors(b.haven).pm};"></span>${b.haven}</strong></td>
        <td>${guestSummary(b)}<br><span class="muted">${b.contact||""}</span></td>
        <td>${fmt(b.checkin)}<br><span class="muted">${checkinTimeStr(b)}</span></td>
        <td>${fmt(b.checkout)}<br><span class="muted">${checkoutTimeStr(b)}</span></td>
        <td>${b.stayHours ? b.stayHours + "h" + (Number(b.stayHours)===6 && b.slot ? "<br><span class='muted'>"+(b.slot==="morning"?"AM":"PM")+"</span>" : "") : "—"}</td>
        <td>${addonsCell(b)}</td>
        <td>${amtCell}</td>
        <td>${statusHtml || `<span class="status ${st}">${st}</span>`}</td>
        <td>${payCell}${addonLink}</td>
    </tr>`;
  }

  /* ---------- data ---------- */
  function loadBookings(){
    try { return JSON.parse(localStorage.getItem(KEY)) || []; } catch(e){ return []; }
  }
  let bookings = loadBookings();

  /* ---------- render ---------- */
  let currentView = "today"; // today | tomorrow | week | month

  // [start, end) iso date range for the chosen view
  function viewRange(){
    const t0 = today();
    if(currentView === "yesterday"){ const d = addDays(t0, -1); return { start: iso(d), end: iso(t0) }; }
    if(currentView === "tomorrow"){ const d = addDays(t0, 1); return { start: iso(d), end: iso(addDays(d, 1)) }; }
    if(currentView === "week"){ const s = addDays(t0, -t0.getDay()); return { start: iso(s), end: iso(addDays(s, 7)) }; }
    if(currentView === "month"){ const s = new Date(t0.getFullYear(), t0.getMonth(), 1); const e = new Date(t0.getFullYear(), t0.getMonth() + 1, 1); return { start: iso(s), end: iso(e) }; }
    return { start: iso(t0), end: iso(addDays(t0, 1)) };
  }
  // classify a booking against a date range [start, end)
  function rangeInfo(b, start, end){
    const dayUse = !(b.checkout > b.checkin);
    const arrives = b.checkin >= start && b.checkin < end;
    const departDate = dayUse ? b.checkin : b.checkout;
    const departs = departDate >= start && departDate < end;
    const overlaps = b.checkin < end && endExcl(b) > start;
    return { arrives, departs, staying: overlaps, relevant: arrives || departs || overlaps };
  }
  function setView(v){
    currentView = v;
    localStorage.setItem("shph_today_view", v);   // remember across refreshes
    document.querySelectorAll(".view-tab").forEach(t => t.classList.toggle("active", t.dataset.view === v));
    renderToday();
  }

  function renderToday(){
    bookings = loadBookings();
    const _ab = document.getElementById("approvalBadge");
    if(_ab){ const n = bookings.filter(b => b.approved !== true).length; _ab.textContent = n ? String(n) : ""; }
    const _pab = document.getElementById("paymentApprovalBadge");
    if(_pab){
      const todayIso = iso(today());
      let pn = 0;
      bookings.forEach(b => (b.payments || []).forEach(p => { if(p && p.at && iso(new Date(p.at)) === todayIso && p.approved !== true) pn++; }));
      _pab.textContent = pn ? String(pn) : "";
    }
    const { start, end } = viewRange();
    const single = (currentView === "today" || currentView === "tomorrow" || currentView === "yesterday");
    const suffix = currentView === "today" ? "today" : currentView === "tomorrow" ? "tomorrow"
                 : currentView === "yesterday" ? "yesterday"
                 : currentView === "week" ? "this week" : "this month";

    const lastDay = iso(addDays(new Date(end + "T00:00:00"), -1));
    document.getElementById("todayDateLabel").textContent = single
      ? new Date(start + "T00:00:00").toLocaleDateString("en-PH", { weekday:"long", month:"long", day:"numeric", year:"numeric" })
      : fmt(start) + " – " + fmt(lastDay);

    const tagged = bookings.map(b => ({ b, info: rangeInfo(b, start, end) })).filter(x => x.info.relevant);
    const arrivals = tagged.filter(x => x.info.arrives).map(x => x.b)
      .sort((a,c) => (a.checkin||"").localeCompare(c.checkin||"") || bookingCheckinMin(a) - bookingCheckinMin(c));
    const others = tagged.filter(x => !x.info.arrives).map(x => x.b)
      .sort((a,c) => (a.checkout||"").localeCompare(c.checkout||"") || checkoutTimeStr(a).localeCompare(checkoutTimeStr(c)));

    const departCount = tagged.filter(x => x.info.departs).length;
    const inHouseCount = tagged.filter(x => x.info.staying).length;
    const toCollect = arrivals.reduce((s,b) => s + balanceOf(b), 0);

    // money collected from guests CHECKING IN within the range, totalled per MOP
    // (downpayment via its method + every collection recorded via the "Paid" button)
    const MOPS = ["Cash", "GCash", "BDO", "Maya", "Maribank", "Others"];
    const byMop = {}; MOPS.forEach(m => byMop[m] = 0);
    const bucket = (mop, amt) => { byMop[MOPS.includes(mop) ? mop : "Others"] += amt; };
    let collected = 0;
    bookings.forEach(b => {
      const checkinInRange = (b.checkin >= start && b.checkin < end);
      // downpayment counts for guests checking in within the range
      if(checkinInRange){
        const dp = Number(b.downpayment) || 0;
        if(dp > 0){ collected += dp; bucket(b.method, dp); }
      }
      (b.payments || []).forEach(p => {
        const amt = Number(p.amount) || 0;
        const payDay = iso(new Date(p.at));
        // add-ons count on the day they were actually purchased; room/balance follows check-in day
        const inRange = (p.category === "Add Ons")
          ? (payDay >= start && payDay < end)
          : checkinInRange;
        if(inRange){ collected += amt; bucket(p.mop, amt); }
      });
    });

    // extra figures for the card sub-labels
    const inHouseGuests = tagged.filter(x => x.info.staying)
      .reduce((s, x) => s + ((x.b.guests || []).length || 0), 0);
    const balancesOpen = arrivals.filter(b => balanceOf(b) > 0).length;
    const nextArr = arrivals.length ? checkinTimeStr(arrivals[0]) : "";

    const ICON = {
      arrive:'<svg viewBox="0 0 24 24"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><path d="m10 17 5-5-5-5"/><path d="M15 12H3"/></svg>',
      depart:'<svg viewBox="0 0 24 24"><path d="M9 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/></svg>',
      bed:'<svg viewBox="0 0 24 24"><path d="M2 20v-7a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v7"/><path d="M2 16h20"/><path d="M6 11V8.5A1.5 1.5 0 0 1 7.5 7h3A1.5 1.5 0 0 1 12 8.5V11"/></svg>',
      clock:'<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>',
      cash:'<svg viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 12h.01M18 12h.01"/></svg>'
    };
    const cards = [
      { label:"Arriving " + suffix,  val:arrivals.length, ico:ICON.arrive, chip:"ico-green", sub: nextArr ? "Next at " + nextArr : "" },
      { label:"Departing " + suffix, val:departCount,     ico:ICON.depart, chip:"ico-terra", sub: departCount ? departCount + " checkout" + (departCount > 1 ? "s" : "") : "" },
      { label:(currentView === "today" ? "In-house now" : "In-house"), val:inHouseCount, ico:ICON.bed, chip:"ico-brown", sub: inHouseGuests ? inHouseGuests + " guests total" : "" },
      { label:"To collect " + suffix, val:peso(toCollect), ico:ICON.clock, chip:"ico-gold", sub: balancesOpen ? balancesOpen + " balance" + (balancesOpen > 1 ? "s" : "") + " open" : "" },
      { label:"Collected " + suffix,  val:peso(collected), ico:ICON.cash,  chip:"ico-green", sub:"" }
    ];
    document.getElementById("todayCards").innerHTML = cards.map(c =>
      `<div class="card">
        <div class="card-top"><span class="card-label">${c.label}</span><span class="card-ico ${c.chip}">${c.ico}</span></div>
        <div class="number">${c.val}</div>
        ${c.sub ? `<div class="card-sub">${c.sub}</div>` : ""}
      </div>`).join("");

    document.getElementById("mopHeading").textContent = "Collected " + suffix + " by payment method";
    document.getElementById("arriveHeading").textContent = "Arriving " + suffix;
    document.getElementById("stayHeading").innerHTML = "In-house &amp; departing " + suffix;

    document.getElementById("mopGrid").innerHTML = MOPS.map(m =>
      `<div class="mop-item"><span class="mop-label">${m}</span><span class="mop-val">${peso(byMop[m])}</span></div>`).join("");

    const arrivePill = b => statusOf(b) === "paid"
      ? '<span class="status paid">Paid</span>'
      : '<span class="status confirmed">Confirmed</span>';
    const stayPill = b => rangeInfo(b, start, end).departs
      ? '<span class="status departing">Departing</span>'
      : '<span class="status inhouse">In-house</span>';

    document.getElementById("todayArriveBody").innerHTML = arrivals.length
      ? arrivals.map(b => todayRow(b, balanceOf(b), arrivePill(b))).join("")
      : `<tr><td colspan="9" class="empty">No arrivals ${suffix}.</td></tr>`;
    document.getElementById("todayArriveCount").textContent = arrivals.length ? `(${arrivals.length})` : "";

    document.getElementById("todayStayBody").innerHTML = others.length
      ? others.map(b => todayRow(b, balanceOf(b), stayPill(b))).join("")
      : `<tr><td colspan="9" class="empty">Nobody else in-house or departing ${suffix}.</td></tr>`;
    document.getElementById("todayStayCount").textContent = others.length ? `(${others.length})` : "";
  }

  // jump to another dashboard page — remember it so dashboard.html opens there
  function goPage(page){
    localStorage.setItem("shph_dashboard_page", page);
    window.location.href = "dashboard.html";
  }
  function currentUser(){ return localStorage.getItem("shph_current_user") || "Admin"; }
  function logout(){ logActivity("logged out"); localStorage.removeItem("shph_current_user"); window.location.href = "admin.html"; }
  // shared activity log (viewable on the dashboard's Log page)
  function logActivity(action){
    try {
      let log = [];
      try { log = JSON.parse(localStorage.getItem("shph_activity_log")) || []; } catch(e){}
      log.push({ user: currentUser(), action, at: new Date().toISOString() });
      localStorage.setItem("shph_activity_log", JSON.stringify(log.slice(-500)));
    } catch(e){ /* never let logging break an action (e.g. storage full) */ }
  }
  // is the logged-in user an administrator? (unknown / direct access = treated as admin)
  function isAdmin(){
    try {
      const users = JSON.parse(localStorage.getItem("shph_users")) || [];
      const u = users.find(x => x.name === currentUser());
      return u ? !!u.admin : true;
    } catch(e){ return true; }
  }
  let IS_ADMIN = isAdmin();

  /* ---------- access control (mirrors dashboard.html) ---------- */
  const PAGE_KEYS = ["today","finance","analytics","calendar","havens","booking","payments","cleaners","employees","log","payroll","bills","assist","users"];
  function currentUserObj(){
    try {
      const users = JSON.parse(localStorage.getItem("shph_users")) || [];
      return users.find(u => (u.name || "").toLowerCase() === currentUser().toLowerCase()) || null;
    } catch(e){ return null; }
  }
  function currentPerms(){
    const u = currentUserObj();
    if(!u) return PAGE_KEYS;       // direct access (no login) = full
    if(u.admin) return PAGE_KEYS;
    return u.perms || [];
  }
  // only admins and CSRs may create bookings
  function canAddBooking(){
    if(IS_ADMIN) return true;
    try {
      const st = JSON.parse(localStorage.getItem("shph_staff_v1")) || [];
      const un = currentUser().trim().toLowerCase();
      const owns = s => {
        const sn = (s.name || "").trim().toLowerCase();
        return sn === un || sn.startsWith(un + " ") || sn.split(/\s+/)[0] === un;
      };
      return st.filter(owns).some(s => s.role === "CSR");
    } catch(e){ return false; }
  }
  function applyPerms(){
    const admin = IS_ADMIN;
    const perms = currentPerms();
    // not allowed to view Today's Booking → bounce to the dashboard (it routes to an allowed page)
    if(!admin && !perms.includes("today")){ window.location.href = "dashboard.html"; return; }
    // hide sidebar items the user can't access
    document.querySelectorAll(".sidebar .nav-item").forEach(n => {
      const pg = n.dataset.page;
      if(!pg) return;
      const ok = (pg === "users") ? admin : (admin || perms.includes(pg));
      n.style.display = ok ? "flex" : "none";
    });
    document.querySelector(".sidebar").classList.remove("perms-pending");  // reveal now that it's filtered
    const ab = document.getElementById("addBookingBtn");
    if(ab) ab.style.display = canAddBooking() ? "" : "none";   // only admin/CSR can add bookings
  }

  /* ---------- payment / collection popup ---------- */
  let payBookingId = null, payProof = null, payEditing = false, payEditIndex = -1;

  // show the downpayment's uploaded proof photo (recorded on the booking) in the lightbox
  function viewDownProof(id){
    const b = bookings.find(x => x.id === id);
    if(b && b.downProof) openProofImg(b.downProof);
    else uhOhNoProof();
  }
  function uhOhNoProof(){ alert("No downpayment proof was uploaded for this booking."); }

  // list of all payments made for this booking
  function renderPayList(b){
    const el = document.getElementById("payList");
    const pays = (b && b.payments) || [];
    const dp = Number(b && b.downpayment) || 0;
    const count = pays.length + (dp > 0 ? 1 : 0);
    if(!count){ el.innerHTML = ""; return; }
    const check = `<span class="pli-check"><svg viewBox="0 0 24 24"><path d="m5 12 4.5 4.5L19 7"/></svg></span>`;
    let html = `<div class="pay-list-title">Payments made <span class="plt-count">(${count})</span></div>`;
    if(dp > 0){
      const hasProof = !!b.downProof;
      html += `<div class="pay-list-item">
          ${check}
          <span class="pli-main" ${hasProof ? `onclick="viewDownProof(${b.id})" style="cursor:zoom-in;"` : ""}><strong>${peso(dp)}</strong> · Downpayment · ${b.method || "—"}
            <small>upfront (edit in booking)${hasProof ? " · tap to view proof" : ""}</small></span>
          ${hasProof ? `<span class="pli-del" style="color:#2b6cb0;" onclick="viewDownProof(${b.id})">View</span>` : ""}
        </div>`;
    }
    html += pays.map((p, i) => `
        <div class="pay-list-item ${i === payEditIndex ? "active" : ""}">
          ${check}
          <span class="pli-main" onclick="loadPayInto(${i})">
            <strong>${peso(p.amount)}</strong> · ${p.category || "Balance"} · ${p.mop}
            <small>${new Date(p.at).toLocaleString("en-PH", {month:"short",day:"numeric",hour:"numeric",minute:"2-digit"})}${p.by ? " · " + p.by : ""}</small>
          </span>
          <span class="pli-del" onclick="deletePaymentAt(${i})">Delete</span>
        </div>`).join("");
    el.innerHTML = html;
  }
  // fill the form from a payment (p = null → blank new entry)
  function fillPayForm(b, p){
    const prev = document.getElementById("payPreview");
    document.getElementById("payFile").value = "";
    const nameEl = document.getElementById("payFileName");
    if(p){
      document.getElementById("payAmount").value = Number(p.amount) || 0;
      document.getElementById("payMop").value = p.mop || "Cash";
      document.getElementById("payFor").value = p.category || "Balance";
      document.getElementById("payDate").value = p.at ? iso(new Date(p.at)) : iso(today());
      payProof = p.proof || null;
      if(nameEl) nameEl.textContent = payProof ? "Photo attached ✓" : "No file chosen";
      if(payProof){ prev.src = payProof; prev.style.display = "block"; } else { prev.src = ""; prev.style.display = "none"; }
    } else {
      document.getElementById("payAmount").value = balanceOf(b);
      document.getElementById("payMop").selectedIndex = 0;
      document.getElementById("payFor").value = "Balance";
      document.getElementById("payDate").value = iso(today());
      payProof = null; prev.src = ""; prev.style.display = "none";
      if(nameEl) nameEl.textContent = "No file chosen";
    }
  }
  function updatePayButtons(editingExisting){
    document.getElementById("payDelBtn").style.display = editingExisting ? "inline-block" : "none";
    document.getElementById("payAddBtn").style.display = editingExisting ? "inline-block" : "none";  // "+ Add payment" = new entry
    document.getElementById("paySaveAddBtn").style.display = editingExisting ? "none" : "inline-block";
    document.getElementById("paySaveBtn").textContent = editingExisting ? "Update Payment" : "Save Payment";
  }
  // the chosen collection date (with current time-of-day) so late inputs land on the right day
  function payAtFromInput(){
    const d = document.getElementById("payDate").value;
    const now = new Date();
    if(!d) return now.toISOString();
    const dt = new Date(d + "T00:00:00");
    dt.setHours(now.getHours(), now.getMinutes(), now.getSeconds());
    return dt.toISOString();
  }
  function payInfoLine(b){
    const guest = (b.guests && b.guests[0] && b.guests[0].name) || "";
    const collected = paidOf(b);          // total received = downpayment + later collections
    const balance = balanceOf(b);
    const total = Number(b.total || 0) || (collected + balance);
    const pct = total > 0 ? Math.max(0, Math.min(100, Math.round(collected / total * 100))) : 0;
    return `
      <div class="pi-head"><strong>${b.haven}</strong> <span class="pi-guest">— ${guest}</span></div>
      <div class="pi-stats">
        <div class="pi-stat"><span class="pi-label">Collected</span><span class="pi-val paid">${peso(collected)}</span></div>
        <div class="pi-stat"><span class="pi-label">Balance</span><span class="pi-val bal">${peso(balance)}</span></div>
      </div>
      <div class="pi-bar"><span style="width:${pct}%"></span></div>`;
  }

  function openPay(id, edit){
    payBookingId = id; payProof = null;
    const b = bookings.find(x => x.id === id);
    if(!b) return;
    const pays = b.payments || [];
    document.getElementById("payEyebrow").textContent = "Reservation #" + b.id;
    document.getElementById("payInfo").innerHTML = payInfoLine(b);
    if(edit && pays.length){
      payEditIndex = pays.length - 1; payEditing = true;
      document.getElementById("payTitle").textContent = "Edit Payment";
      fillPayForm(b, pays[payEditIndex]);
      updatePayButtons(true);
    } else {
      payEditIndex = -1; payEditing = false;
      document.getElementById("payTitle").textContent = "Record Payment";
      fillPayForm(b, null);
      updatePayButtons(false);
    }
    renderPayList(b);
    document.getElementById("payOverlay").classList.add("show");
  }
  // click a payment in the list to edit it
  function loadPayInto(index){
    const b = bookings.find(x => x.id === payBookingId);
    if(!b || !b.payments || !b.payments[index]) return;
    payEditIndex = index; payEditing = true;
    document.getElementById("payTitle").textContent = "Edit Payment";
    fillPayForm(b, b.payments[index]);
    updatePayButtons(true);
    renderPayList(b);
  }
  // delete a specific payment by index
  function deletePaymentAt(index){
    if(payBookingId == null) return;
    const data = loadBookings();
    const b = data.find(x => x.id === payBookingId);
    if(!b || !b.payments || !b.payments[index]){ return; }
    const p = b.payments[index];
    if(!confirm(`Delete this ${p.category || "Balance"} payment of ${peso(p.amount)}? This cannot be undone.`)) return;
    b.payments.splice(index, 1);
    if(!(b.payments || []).some(x => x.category === "Add Ons")) delete b.addonProof;
    try { localStorage.setItem(KEY, JSON.stringify(data)); }
    catch(e){ alert("Couldn't save the change — browser storage may be full."); return; }
    logActivity(`deleted ${p.category || "Balance"} payment — ${b.haven} · ${peso(p.amount)} (${p.mop})`);
    bookings = data;
    renderToday();
    if(b.payments.length) openPay(payBookingId, true);   // reopen showing remaining
    else closePay();
  }
  // Delete button (deletes the payment currently in the form)
  function deletePaymentEntry(){
    if(payEditIndex >= 0) deletePaymentAt(payEditIndex);
    else closePay();
  }
  // "+ Add payment" — switch to a blank new entry without leaving the popup
  function addFollowUpPayment(){
    const b = bookings.find(x => x.id === payBookingId);
    if(!b) return;
    payEditing = false; payEditIndex = -1;
    document.getElementById("payTitle").textContent = "Record Payment";
    fillPayForm(b, null);
    document.getElementById("payFor").value = "Add Ons";   // follow-ups are usually add-ons
    updatePayButtons(false);
    renderPayList(b);
  }
  function closePay(){
    payBookingId = null; payProof = null; payEditing = false; payEditIndex = -1;
    document.getElementById("payOverlay").classList.remove("show");
  }
  // shrink + compress an image to keep localStorage small
  function resizeImage(file, cb){
    const reader = new FileReader();
    reader.onload = e => {
      const img = new Image();
      img.onload = () => {
        const max = 1000;
        let w = img.width, h = img.height;
        if(w > max || h > max){ const r = Math.min(max / w, max / h); w = Math.round(w * r); h = Math.round(h * r); }
        const canvas = document.createElement("canvas");
        canvas.width = w; canvas.height = h;
        canvas.getContext("2d").drawImage(img, 0, 0, w, h);
        cb(canvas.toDataURL("image/jpeg", 0.7));
      };
      img.src = e.target.result;
    };
    reader.readAsDataURL(file);
  }
  // shared: accept an image File from the picker, a drop, or a paste
  function applyPayProofFile(f){
    if(!f || !/^image\//.test(f.type)) return;
    const nameEl = document.getElementById("payFileName");
    if(nameEl) nameEl.textContent = f.name || "Photo attached";
    resizeImage(f, dataUrl => {
      payProof = dataUrl;
      const prev = document.getElementById("payPreview");
      prev.src = payProof; prev.style.display = "block";
    });
  }
  function onProofChange(input){
    if(input.files[0]) applyPayProofFile(input.files[0]);
    else payProof = null;
  }
  // drag & drop onto the upload card
  (function initPayProofDnd(){
    const card = document.querySelector("#payOverlay .pay-upload");
    if(!card) return;
    card.addEventListener("dragover", e => { e.preventDefault(); card.classList.add("drag"); });
    card.addEventListener("dragleave", e => { if(!card.contains(e.relatedTarget)) card.classList.remove("drag"); });
    card.addEventListener("drop", e => {
      e.preventDefault(); card.classList.remove("drag");
      const files = e.dataTransfer && e.dataTransfer.files;
      if(files && files.length) applyPayProofFile(files[0]);
    });
  })();
  // paste an image (Ctrl/Cmd+V) while the Record Payment popup is open
  document.addEventListener("paste", e => {
    const ov = document.getElementById("payOverlay");
    if(!ov || !ov.classList.contains("show")) return;
    const items = (e.clipboardData && e.clipboardData.items) || [];
    for(const it of items){
      if(it.kind === "file" && /^image\//.test(it.type)){
        const f = it.getAsFile();
        if(f){ e.preventDefault(); applyPayProofFile(f); return; }
      }
    }
  });
  function savePay(again){
    const bookingId = payBookingId;
    if(payBookingId == null) return;
    if(!payProof){ alert("Please upload a photo of the proof of payment."); return; }
    const mop = document.getElementById("payMop").value;
    const category = document.getElementById("payFor").value; // "Balance" or "Add Ons"
    const amount = Number(document.getElementById("payAmount").value) || 0;
    if(amount <= 0){ alert("Please enter the amount collected."); return; }
    // always work off the freshest data in storage
    bookings = loadBookings();
    const b = bookings.find(x => x.id === payBookingId);
    if(!b) return;
    b.payments = b.payments || [];

    if(payEditing && payEditIndex >= 0 && b.payments[payEditIndex]){
      // update the selected collection in place — does NOT touch the customer's downpayment
      const p = b.payments[payEditIndex];
      p.amount = amount;
      p.mop = mop;
      p.category = category;
      p.proof = payProof;
      p.at = payAtFromInput();   // collection date (editable for late inputs)
      p.editedAt = new Date().toISOString();
      p.editedBy = currentUser();
      logActivity(`edited ${category} payment — ${b.haven} · ${peso(amount)} (${mop})`);
    } else {
      // record a new collection (may be partial) — tracked separately from the downpayment
      b.payments.push({
        amount,
        mop,
        category,
        proof: payProof,
        at: payAtFromInput(),   // collection date (editable for late inputs)
        by: currentUser()
      });
      logActivity(`uploaded ${category} payment — ${b.haven} · ${peso(amount)} (${mop})`);
    }
    // each payment carries its own category, so it shows in the right section on the dashboard
    try { localStorage.setItem(KEY, JSON.stringify(bookings)); }
    catch(e){ alert("Couldn't save — browser storage is full. Older proof photos may need to be removed."); return; }
    renderToday();
    if(again){
      // keep the popup open and start a fresh entry for the same booking
      openPay(bookingId, false);
    } else {
      closePay();
    }
  }
  function openProofImg(src){
    if(!src) return;
    document.getElementById("imgLightboxImg").src = src;
    document.getElementById("imgLightbox").classList.add("show");
  }
  // close when clicking the dark backdrop
  document.getElementById("payOverlay").addEventListener("click", e => {
    if(e.target.id === "payOverlay") closePay();
  });
  function goBack(){
    if(window.opener && !window.opener.closed){ window.close(); }
    else { window.location.href = "dashboard.html"; }
  }

  /* ---------- late add-ons (pool pass / towels) added to an existing booking ---------- */
  let addonBookingId = null;
  const TOWEL_RATE = 50, POOL_RATE = 150, POOL_RATE_HOLIDAY = 300;
  function openAddon(id){
    if(!canAddBooking()){ alert("Only an administrator or CSR can add to a bill."); return; }
    addonBookingId = id;
    const b = bookings.find(x => x.id === id);
    if(!b) return;
    const guest = (b.guests && b.guests[0] && b.guests[0].name) || "";
    document.getElementById("addonInfo").innerHTML =
      `<strong>${b.haven}</strong> — ${guest}<br>Current: <span class="addon"><svg class="addon-ico" viewBox="0 0 24 24"><path d="M2 16c1.5 0 1.5 1 3 1s1.5-1 3-1 1.5 1 3 1 1.5-1 3-1 1.5 1 3 1 1.5-1 3-1"/><path d="M2 20c1.5 0 1.5 1 3 1s1.5-1 3-1 1.5 1 3 1 1.5-1 3-1 1.5 1 3 1 1.5-1 3-1"/><path d="M8 13V6a2 2 0 0 1 4 0"/></svg>${Number(b.swimpass)||0}</span> <span class="addon"><svg class="addon-ico" viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 3v18"/></svg>${Number(b.towels)||0}</span> · Balance: <strong>${peso(balanceOf(b))}</strong>`;
    document.getElementById("addonPool").value = 0;
    document.getElementById("addonTowels").value = 0;
    document.getElementById("addonHoliday").checked = !!b.holiday;
    addonRecalc();
    document.getElementById("addonOverlay").classList.add("show");
  }
  function addonAddedAmount(){
    const pool = Number(document.getElementById("addonPool").value) || 0;
    const tow  = Number(document.getElementById("addonTowels").value) || 0;
    const poolRate = document.getElementById("addonHoliday").checked ? POOL_RATE_HOLIDAY : POOL_RATE;
    return { pool, tow, added: pool * poolRate + tow * TOWEL_RATE };
  }
  function addonRecalc(){
    const { added } = addonAddedAmount();
    document.getElementById("addonTotalInfo").innerHTML = `Added to bill: <strong>${peso(added)}</strong>`;
  }
  function closeAddon(){ addonBookingId = null; document.getElementById("addonOverlay").classList.remove("show"); }
  function saveAddon(){
    if(addonBookingId == null) return;
    const { pool, tow, added } = addonAddedAmount();
    if(pool <= 0 && tow <= 0){ alert("Enter pool passes or towels to add."); return; }
    bookings = loadBookings();
    const b = bookings.find(x => x.id === addonBookingId);
    if(!b) return;
    b.swimpass = (Number(b.swimpass) || 0) + pool;
    b.towels   = (Number(b.towels) || 0) + tow;
    b.total    = (Number(b.total) || 0) + added;   // add the late charge to the bill
    // record the late request
    b.addonLog = b.addonLog || [];
    b.addonLog.push({ pool, towels: tow, amount: added, at: new Date().toISOString(), by: currentUser() });
    try { localStorage.setItem(KEY, JSON.stringify(bookings)); }
    catch(e){ alert("Couldn't save — storage may be full."); return; }
    const parts = [];
    if(pool) parts.push(`${pool} pool pass${pool > 1 ? "es" : ""}`);
    if(tow) parts.push(`${tow} towel${tow > 1 ? "s" : ""}`);
    logActivity(`added late add-ons — ${b.haven}: ${parts.join(", ")} (${peso(added)})`);
    closeAddon();
    renderToday();
    alert(`Added ${peso(added)} to the bill. The balance has been updated.`);
  }
  document.getElementById("addonOverlay").addEventListener("click", e => { if(e.target.id === "addonOverlay") closeAddon(); });

  /* ---------- pool pass sales ---------- */
  const POOL_KEY = "shph_poolpass_v1";
  function loadPool(){ try { return JSON.parse(localStorage.getItem(POOL_KEY)) || []; } catch(e){ return []; } }
  function savePoolData(arr){ try { localStorage.setItem(POOL_KEY, JSON.stringify(arr)); } catch(e){ alert("Couldn't save — storage full."); } }
  function poolRecalc(){
    const qty = Number(document.getElementById("poolQty").value) || 0;
    const price = Number(document.getElementById("poolPrice").value) || 0;
    document.getElementById("poolTotalInfo").innerHTML = `Total: <strong>${peso(qty * price)}</strong>`;
  }
  function openPool(){
    document.getElementById("poolName").value = "";
    document.getElementById("poolQty").value = 1;
    document.getElementById("poolPrice").value = 150;
    document.getElementById("poolMop").selectedIndex = 0;
    poolRecalc();
    document.getElementById("poolOverlay").classList.add("show");
  }
  function closePool(){ document.getElementById("poolOverlay").classList.remove("show"); }
  function savePoolPass(){
    const qty = Number(document.getElementById("poolQty").value) || 0;
    const price = Number(document.getElementById("poolPrice").value) || 0;
    if(qty <= 0){ alert("Enter the number of passes."); return; }
    const arr = loadPool();
    arr.push({ qty, price, amount: qty * price, mop: document.getElementById("poolMop").value,
               name: document.getElementById("poolName").value.trim(), by: currentUser(), at: new Date().toISOString() });
    savePoolData(arr);
    logActivity(`sold ${qty} pool pass${qty > 1 ? "es" : ""} — ${peso(qty * price)}`);
    closePool();
    renderToday();
  }
  function deletePoolPass(idx){
    const arr = loadPool();
    if(idx < 0 || idx >= arr.length) return;
    if(!confirm(`Delete this pool pass sale of ${peso(arr[idx].amount)}?`)) return;
    const removed = arr.splice(idx, 1)[0];
    savePoolData(arr);
    logActivity(`deleted pool pass sale — ${peso(removed.amount)}`);
    renderToday();
  }
  function renderPool(start, end){
    const all = loadPool();
    // index map so delete targets the right entry after filtering
    const rows = all.map((p, i) => ({ p, i })).filter(({ p }) => { const d = iso(new Date(p.at)); return d >= start && d < end; });
    const qtyTotal = rows.reduce((s, { p }) => s + (Number(p.qty) || 0), 0);
    const amtTotal = rows.reduce((s, { p }) => s + (Number(p.amount) || 0), 0);
    const scopeEl = document.getElementById("poolScope");
    if(scopeEl) scopeEl.textContent = "— sold this period";
    document.getElementById("poolCards").innerHTML =
      `<div class="card"><h3>Passes sold</h3><div class="number"><svg class="addon-ico" viewBox="0 0 24 24" style="width:22px;height:22px;vertical-align:-2px"><path d="M2 16c1.5 0 1.5 1 3 1s1.5-1 3-1 1.5 1 3 1 1.5-1 3-1 1.5 1 3 1 1.5-1 3-1"/><path d="M2 20c1.5 0 1.5 1 3 1s1.5-1 3-1 1.5 1 3 1 1.5-1 3-1 1.5 1 3 1 1.5-1 3-1"/><path d="M8 13V6a2 2 0 0 1 4 0"/></svg> ${qtyTotal}</div></div>` +
      `<div class="card"><h3>Pool pass income</h3><div class="number money">${peso(amtTotal)}</div></div>`;
    document.getElementById("poolBody").innerHTML = rows.length ? rows.map(({ p, i }) => `
        <tr>
          <td>${new Date(p.at).toLocaleTimeString("en-PH", { hour:"numeric", minute:"2-digit" })}</td>
          <td>${p.name ? escTxt(p.name) : '<span class="muted">Walk-in</span>'}</td>
          <td>${p.qty}</td>
          <td>${p.mop}</td>
          <td>${peso(p.amount)}</td>
          <td>${p.by || "—"}</td>
          <td>${IS_ADMIN ? `<span class="edit-pay" style="color:#c0283d;" onclick="deletePoolPass(${i})">Delete</span>` : ""}</td>
        </tr>`).join("") : `<tr><td colspan="7" class="empty">No pool passes sold this period.</td></tr>`;
  }
  function escTxt(s){ return String(s).replace(/[&<>"]/g, c => ({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;" }[c])); }

  /* ---------- add booking (saves to the shared Calendar/Bookings data) ---------- */
  const HAVENS = ["Haven 1","Haven 2","Haven 3","Haven 4","Haven 5","Haven 7","Haven 8","Casa Bienca"];
  const PRICING = { stay6:999, stay10:1599, stay21Weekday:1799, stay21Weekend:2099, swimRegular:150, swimHoliday:300,
    towel:50, extendPerHr:150, deposit:1000, baseIncludedPax:2, addPax:300, addPaxMinAge:5, maxPax:5, maxAdults:4, maxKids:2, kidMaxAge:13 };
  const STAY_OPTIONS = [[6,"6 hrs — ₱999"],[10,"10 hrs — ₱1,599"],[21,"21 hrs — ₱1,799 / ₱2,099 (Fri–Sat)"]];

  function billablePax(g){ return (g||[]).filter(x => x.age != null && Number(x.age) >= PRICING.addPaxMinAge).length; }
  function addPaxFee(g){ return Math.max(0, billablePax(g) - PRICING.baseIncludedPax) * PRICING.addPax; }
  function lastName(name){ const p = (name||"").trim().split(/\s+/); return p.length ? p[p.length-1].toLowerCase() : ""; }
  function baseRate(stayHours, checkinIso){
    stayHours = Number(stayHours);
    if(stayHours === 6) return PRICING.stay6;
    if(stayHours === 10) return PRICING.stay10;
    if(stayHours === 21){ const wd = new Date(checkinIso + "T00:00:00").getDay(); return (wd === 5 || wd === 6) ? PRICING.stay21Weekend : PRICING.stay21Weekday; }
    return 0;
  }
  function computeTotal(b){
    const base = baseRate(b.stayHours, b.checkin);
    const pax  = addPaxFee(b.guests);
    const swim = (Number(b.swimpass) || 0) * (b.holiday ? PRICING.swimHoliday : PRICING.swimRegular);
    const tow  = (Number(b.towels) || 0) * PRICING.towel;
    const ext  = (Number(b.extend) || 0) * PRICING.extendPerHr;
    const dep  = (b.deposit === undefined ? PRICING.deposit : Number(b.deposit)) || 0;
    return base + pax + swim + tow + ext + dep;
  }
  function findConflict(cand, excludeId){
    const cs = cand.checkin, ce = endExcl(cand);
    return bookings.find(b => {
      if(b.id === excludeId) return false;
      if(b.haven !== cand.haven) return false;
      const overlap = cs < endExcl(b) && b.checkin < ce;
      if(!overlap) return false;
      if(Number(b.stayHours) !== 6 || Number(cand.stayHours) !== 6) return true;
      return b.slot === cand.slot;
    }) || null;
  }
  function dashCheckinMin(timeStr){ const m = parseTimeMin(timeStr); if(m == null) return 480; return m === 0 ? 1440 : m; }

  function aFillCheckinTimes(){
    let html = ""; for(let h = 0; h < 24; h++){ const t = minToTime(h * 60); html += `<option value="${t}">${t}</option>`; }
    html += `<option value="__custom__">Custom time…</option>`;
    document.getElementById("a_checkinTime").innerHTML = html;
  }
  // toggle the free time input when "Custom time…" is picked
  function aTimeSelChange(){
    const custom = document.getElementById("a_checkinTimeCustom");
    custom.style.display = document.getElementById("a_checkinTime").value === "__custom__" ? "block" : "none";
    aRecompute();
  }
  // the effective check-in time string (handles the custom HH:MM input)
  function aCheckinTimeValue(){
    const sel = document.getElementById("a_checkinTime");
    if(sel.value === "__custom__"){
      const v = document.getElementById("a_checkinTimeCustom").value; // "HH:MM" 24h
      if(!v) return "8:00 AM";
      const [h, m] = v.split(":").map(Number);
      return minToTime(h * 60 + m);
    }
    return sel.value;
  }
  function aUpdateStayOptions(keep){
    const sel = document.getElementById("a_stay");
    const ci = document.getElementById("a_checkin").value;
    const wd = ci ? new Date(ci + "T00:00:00").getDay() : 1;
    const opts = (wd === 6) ? STAY_OPTIONS.filter(o => o[0] === 21) : STAY_OPTIONS;
    const want = String(keep != null ? keep : sel.value);
    sel.innerHTML = opts.map(o => `<option value="${o[0]}">${o[1]}</option>`).join("");
    sel.value = opts.some(o => String(o[0]) === want) ? want : String(opts[0][0]);
  }
  function aGuestRow(g){
    g = g || { name:"", age:"" };
    const age = (g.age !== "" && g.age != null) ? g.age : "";
    const nm = (g.name || "").trim();
    const sp = nm.lastIndexOf(" ");
    const first = sp > 0 ? nm.slice(0, sp) : nm;
    const last  = sp > 0 ? nm.slice(sp + 1) : "";
    const esc = s => String(s).replace(/"/g, "&quot;");
    return `<div class="guest-row">
      <input class="gfirst" placeholder="First name" value="${esc(first)}">
      <input class="glast" placeholder="Last name" value="${esc(last)}">
      <input class="gage" type="number" min="0" placeholder="Age" value="${age}">
      <button type="button" class="gdel" onclick="this.parentNode.remove(); aRecalc();">×</button>
    </div>`;
  }
  function aBindGuestInputs(){ document.querySelectorAll("#aGuestList input").forEach(inp => { inp.oninput = aRecalc; }); }
  function aRenderGuests(list){
    document.getElementById("aGuestList").innerHTML = (list && list.length ? list : [{name:"",age:""}]).map(aGuestRow).join("");
    aBindGuestInputs();
  }
  function aAddGuest(){ document.getElementById("aGuestList").insertAdjacentHTML("beforeend", aGuestRow()); aBindGuestInputs(); }
  function aReadGuests(){
    return [...document.querySelectorAll("#aGuestList .guest-row")].map(r => {
      const first = (r.querySelector(".gfirst").value || "").trim();
      const last  = (r.querySelector(".glast").value || "").trim();
      return {
        name: (first + " " + last).trim(),
        age: r.querySelector(".gage").value === "" ? null : Number(r.querySelector(".gage").value)
      };
    }).filter(g => g.name !== "");
  }
  function aRecompute(){
    const ci = document.getElementById("a_checkin").value;
    const t = aCheckinTimeValue();
    const hours = Number(document.getElementById("a_stay").value) || 0;
    const ext = Number(document.getElementById("a_extend").value) || 0;
    if(ci && t){
      const total = dashCheckinMin(t) + (hours + ext) * 60;
      const co = addDays(new Date(ci + "T00:00:00"), Math.floor(total / 1440));
      document.getElementById("a_checkout").value = iso(co);
      document.getElementById("a_checkoutTime").value = minToTime(total);
    }
    aRecalc();
  }
  function aOnCheckinChange(){ aUpdateStayOptions(); aRecompute(); }
  function aRecalc(){
    const b = {
      checkin: document.getElementById("a_checkin").value,
      stayHours: Number(document.getElementById("a_stay").value),
      guests: aReadGuests(),
      swimpass: Number(document.getElementById("a_swimpass").value) || 0,
      towels: Number(document.getElementById("a_towels").value) || 0,
      extend: Number(document.getElementById("a_extend").value) || 0,
      holiday: document.getElementById("a_holiday").checked,
      deposit: Number(document.getElementById("a_deposit").value) || 0
    };
    const total = computeTotal(b);
    document.getElementById("a_total").value = total;
    const down = Number(document.getElementById("a_down").value) || 0;
    document.getElementById("a_balance").value = peso(Math.max(0, total - down));
    const base = baseRate(b.stayHours, b.checkin);
    const swimRate = b.holiday ? PRICING.swimHoliday : PRICING.swimRegular;
    document.getElementById("a_breakdown").innerHTML =
      `Base for 2 pax (${b.stayHours}h): ${peso(base)} · Extra pax: ${peso(addPaxFee(b.guests))}` +
      ` · Swimpass ${b.swimpass}×${peso(swimRate)}: ${peso(b.swimpass*swimRate)}` +
      ` · Towels ${b.towels}×₱50: ${peso(b.towels*PRICING.towel)}` +
      ` · Extend ${b.extend}h×₱150: ${peso(b.extend*PRICING.extendPerHr)} · Deposit: ${peso(b.deposit)}`;
  }
  function openAdd(){
    if(!canAddBooking()){ alert("Only an administrator or CSR can add a booking."); return; }
    bookings = loadBookings();
    document.getElementById("a_haven").innerHTML = HAVENS.map(h => `<option>${h}</option>`).join("");
    aFillCheckinTimes();
    aRenderGuests([{name:"",age:""}]);
    document.getElementById("a_contact").value = "";
    document.getElementById("a_checkin").value = iso(today());
    aUpdateStayOptions(6);
    document.getElementById("a_checkinTime").value = "8:00 AM";
    document.getElementById("a_checkinTimeCustom").value = "";
    document.getElementById("a_checkinTimeCustom").style.display = "none";
    document.getElementById("a_extend").value = 0;
    document.getElementById("a_swimpass").value = 0;
    document.getElementById("a_towels").value = 0;
    document.getElementById("a_holiday").checked = false;
    document.getElementById("a_method").selectedIndex = 0;
    document.getElementById("a_deposit").value = PRICING.deposit;
    document.getElementById("a_down").value = 0;
    document.getElementById("a_notes").value = "";
    aRecompute();
    document.getElementById("addOverlay").classList.add("show");
  }
  function closeAdd(){ document.getElementById("addOverlay").classList.remove("show"); }
  function saveNewBooking(){
    bookings = loadBookings();
    const guests = aReadGuests();
    const checkin = document.getElementById("a_checkin").value;
    const checkout = document.getElementById("a_checkout").value;
    if(guests.length === 0){ alert("Please enter at least one guest name."); return; }
    for(let i=0;i<guests.length;i++){ const g = guests[i]; if(g.age == null || isNaN(g.age) || g.age < 0){ alert(`Please enter a valid age for ${g.name || ("guest "+(i+1))}.`); return; } }
    if(guests[0].age < 18){ alert("The first guest (primary booker) must be 18 years old and above."); return; }
    if(guests.length >= 2 && guests[1].age < 18 && lastName(guests[1].name) !== lastName(guests[0].name)){ alert("The second guest is a minor and must be a family member (same last name) of the first guest."); return; }
    const kids = guests.filter(g => g.age <= PRICING.kidMaxAge).length;
    const adults = guests.length - kids;
    if(guests.length > PRICING.maxPax){ alert(`Maximum of ${PRICING.maxPax} pax per unit.`); return; }
    if(adults > PRICING.maxAdults){ alert(`Maximum of ${PRICING.maxAdults} adults per unit.`); return; }
    if(kids > PRICING.maxKids){ alert(`Maximum of ${PRICING.maxKids} kids (0–13 yrs) per unit.`); return; }
    if(!checkin || !checkout || checkout < checkin){ alert("Please enter a valid check-in and check-out date."); return; }
    const stayHours = Number(document.getElementById("a_stay").value);
    if(new Date(checkin + "T00:00:00").getDay() === 6 && stayHours !== 21){ alert("Saturday check-ins are 21 hours only."); return; }
    const checkinTime = aCheckinTimeValue();
    const data = {
      haven: document.getElementById("a_haven").value,
      guests, contact: document.getElementById("a_contact").value.trim(),
      checkin, checkout, stayHours, checkinTime,
      slot: stayHours === 6 ? (dashCheckinMin(checkinTime) <= 720 ? "morning" : "evening") : null,
      swimpass: Number(document.getElementById("a_swimpass").value) || 0,
      towels: Number(document.getElementById("a_towels").value) || 0,
      extend: Number(document.getElementById("a_extend").value) || 0,
      holiday: document.getElementById("a_holiday").checked,
      deposit: Number(document.getElementById("a_deposit").value) || 0,
      method: document.getElementById("a_method").value,
      downpayment: Number(document.getElementById("a_down").value) || 0,
      notes: document.getElementById("a_notes").value.trim()
    };
    data.total = computeTotal(data);
    if(!data.haven){ alert("Please choose a haven."); return; }
    const clash = findConflict(data, null);
    if(clash){ alert(`${data.haven} is already booked for those dates by ${(clash.guests && clash.guests[0] && clash.guests[0].name) || "another guest"}.`); return; }
    const newId = bookings.length ? Math.max(...bookings.map(b => b.id)) + 1 : 1;
    bookings.push({ id:newId, ...data });
    localStorage.setItem(KEY, JSON.stringify(bookings));
    const gName = (data.guests[0] && data.guests[0].name) || "";
    logActivity(`added booking — ${data.haven} (${gName})`);
    closeAdd();
    renderToday();
    alert("Booking saved. It now appears in Calendar/Bookings.");
  }
  document.getElementById("addOverlay").addEventListener("click", e => { if(e.target.id === "addOverlay") closeAdd(); });

  document.getElementById("currentUserLabel").textContent = "Logged in as " + currentUser();
  applyPerms();
  // restore the last-selected view (Yesterday/Today/Tomorrow/Week/Month) across refreshes
  (function restoreView(){
    const saved = localStorage.getItem("shph_today_view");
    const valid = ["yesterday","today","tomorrow","week","month"];
    if(saved && valid.includes(saved)) currentView = saved;
    document.querySelectorAll(".view-tab").forEach(t => t.classList.toggle("active", t.dataset.view === currentView));
  })();
  renderToday();

  // keep this page in sync when bookings are changed in another tab (e.g. the dashboard)
  window.addEventListener("storage", e => { if(e.key === KEY) renderToday(); });
</script>
</body>
</html>
