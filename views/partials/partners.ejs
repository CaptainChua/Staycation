<%# Partners pages (Partner List, Add/Edit Partner, Commissions,
    Bookings by Partner, PR-Rooms). Logic lives in /partners.js. %>
<!-- ===== Partners ===== -->
<style>
  .pt-actions{ white-space:nowrap; text-align:right; }
  .pt-form{ display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .pt-form .field.full{ grid-column:1 / -1; }
  .pt-form textarea{ resize:vertical; min-height:74px; font-family:inherit; }
  .pt-formfoot{ display:flex; gap:10px; margin-top:20px; }
  .pt-group{ margin-bottom:22px; }
  .pt-group h3{ font-family:'Playfair Display',Georgia,serif; font-size:18px; margin:0 0 10px; color:var(--hv-ink); display:flex; align-items:center; gap:9px; }
  .pt-group .pt-count{ font-family:'Mulish',sans-serif; font-size:11px; font-weight:700; color:var(--hv-muted); background:#faf6ee; border:1px solid var(--hv-line); padding:2px 9px; border-radius:20px; }
  #page-prrooms .cal-nav{ display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
  #page-prrooms #prRoomFilter{ min-width:140px; }
  #page-prrooms .bar{ border-radius:8px; font-size:12px; font-weight:600; }
  /* Partner logins (Users page) */
  .pl-row{ display:grid; grid-template-columns:1.3fr 1fr 1fr auto; gap:10px; align-items:center; padding:10px 0; border-bottom:1px solid var(--hv-line); }
  #partnerLoginsList input{ padding:9px 11px; border:1px solid var(--hv-line); border-radius:8px; background:#faf6ee; font-family:inherit; font-size:13.5px; }
  #partnerLoginsList .btn{ padding:9px 16px; }
  @media(max-width:680px){ .pt-form{ grid-template-columns:1fr; } .pl-row{ grid-template-columns:1fr 1fr; } }
  /* Partner DASHBOARD mode (dashboard.html?mode=partner) — read-only chrome */
  body.partner-mode #addBookingBtn{ display:none !important; }
  body.partner-mode .actions .cancel,
  body.partner-mode .actions .del{ display:none !important; }
  body.partner-mode #cancelledPanel{ display:none !important; }
  /* read-only on the finance-style pages */
  body.partner-mode #page-expenses .panel-head .btn,
  body.partner-mode #page-bills .panel-head .btn{ display:none !important; }
  body.partner-mode #page-expenses .act,
  body.partner-mode #page-bills .act{ display:none !important; }
</style>

<!-- Partner List -->
<div class="page" id="page-partners">
    <div class="panel">
        <div class="panel-head">
            <h2><span class="sec-ico"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.2"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 5.5a3 3 0 0 1 0 6M21.5 20a6.5 6.5 0 0 0-4.5-6.2"/></svg></span>Partner List</h2>
            <button class="btn" onclick="openAddPartner()">+ Add Partner</button>
        </div>
        <p class="muted" style="margin:0 0 14px;">Agencies, property owners and referral sources you work with.</p>
        <div style="overflow-x:auto;">
            <table class="clean-summary-table">
                <thead><tr><th>Name</th><th>Type</th><th>Contact</th><th>Email</th><th>Commission</th><th></th></tr></thead>
                <tbody id="partnersBody"></tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add / Edit Partner -->
<div class="page" id="page-addpartner">
    <div class="panel" style="max-width:660px;">
        <div class="panel-head">
            <h2><span class="sec-ico"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M19 8v6M16 11h6"/></svg></span><span id="partnerFormTitle">Add Partner</span></h2>
        </div>
        <div class="pt-form">
            <div class="field full"><label>Partner name</label><input type="text" id="pf_name" placeholder="e.g. Skyline Travel Agency"></div>
            <div class="field"><label>Type</label>
                <select id="pf_type">
                    <option>Agency</option>
                    <option>Property Owner</option>
                    <option>Referral</option>
                    <option>OTA (Booking.com, Agoda…)</option>
                    <option>Spa</option>
                    <option>Other</option>
                </select>
            </div>
            <div class="field"><label>Commission / booking (₱)</label><input type="number" id="pf_rate" min="0" step="1" placeholder="e.g. 500"></div>
            <div class="field full"><label>Haven / Casa owned</label><select id="pf_haven"></select></div>
            <div class="field"><label>Contact number</label><input type="text" id="pf_contact" placeholder="09xx xxx xxxx"></div>
            <div class="field"><label>Email</label><input type="email" id="pf_email" placeholder="name@email.com"></div>
            <div class="field"><label>Login name</label><input type="text" id="pf_login" placeholder="username" autocomplete="off"></div>
            <div class="field"><label>Password</label><input type="text" id="pf_pw" placeholder="password" autocomplete="off"></div>
            <div class="field full"><label>Notes</label><textarea id="pf_notes" placeholder="Agreement terms, payout schedule, etc."></textarea></div>
        </div>
        <div class="pt-formfoot">
            <button class="btn" onclick="savePartnerForm()">Save Partner</button>
            <button class="btn secondary" onclick="showPage('partners')">Cancel</button>
        </div>
    </div>
</div>

<!-- Commissions -->
<div class="page" id="page-commissions">
    <div class="panel">
        <div class="panel-head">
            <h2><span class="sec-ico"><svg viewBox="0 0 24 24"><path d="M19 5 5 19"/><circle cx="7.5" cy="7.5" r="2.5"/><circle cx="16.5" cy="16.5" r="2.5"/></svg></span>Commissions</h2>
        </div>
        <p class="muted" style="margin:0 0 14px;">Commission owed per partner = their per-booking commission &times; the number of bookings tagged to them.</p>
        <div style="overflow-x:auto;">
            <table class="clean-summary-table">
                <thead><tr><th>Partner</th><th>Type</th><th>Per booking</th><th>Bookings</th><th>Revenue</th><th>Commission</th></tr></thead>
                <tbody id="commissionsBody"></tbody>
            </table>
        </div>
    </div>
</div>

<!-- Bookings by Partner -->
<div class="page" id="page-partnerbookings">
    <div class="panel">
        <div class="panel-head">
            <h2><span class="sec-ico"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/><circle cx="12" cy="15" r="1.8"/></svg></span>Bookings by Partner</h2>
        </div>
        <p class="muted" style="margin:0 0 16px;">Bookings grouped by the partner they were referred from.</p>
        <div id="partnerBookingsBody"></div>
    </div>
</div>

<!-- PR-Rooms -->
<div class="page" id="page-prrooms">
    <div class="panel">
        <div class="panel-head">
            <h2>PR-Rooms — <span id="prRoomLabel"></span></h2>
            <div class="cal-nav">
                <button class="btn secondary" onclick="prShiftWeek(-1)">‹ Prev</button>
                <span class="date-pill" style="cursor:default;"><svg class="cal-ico" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg><span id="prRangeLabel"></span></span>
                <button class="btn secondary" onclick="prShiftWeek(1)">Next ›</button>
                <button class="btn secondary" onclick="prToday()">Today</button>
                <select id="prRoomFilter" onchange="prSetRoom(this.value)" title="Which haven's calendar to show"></select>
            </div>
        </div>
        <div class="timeline"><div class="tl-grid" id="prTimeline"></div></div>
        <p class="muted" style="margin:10px 0 0; font-size:12.5px;">Lighter = AM · darker = PM · left stripe = payment (<span style="color:#2e9e5b;">paid</span> / <span style="color:#e0a800;">partial</span> / <span style="color:#d63a4f;">unpaid</span>)</p>
    </div>

    <div class="panel">
        <div class="panel-head">
            <h2>Bookings — <span id="prBookingsRoom"></span></h2>
        </div>
        <div style="overflow-x:auto;">
            <table>
                <thead>
                    <tr>
                        <th>Haven</th><th>Guests</th><th>Check-in</th><th>Check-out</th><th>Stay</th>
                        <th>Swimpass</th><th>Towels</th><th>Extend</th><th>Downpayment</th><th>Balance</th><th>Status</th><th></th>
                    </tr>
                </thead>
                <tbody id="prBookingsBody"></tbody>
            </table>
        </div>
    </div>
</div>
