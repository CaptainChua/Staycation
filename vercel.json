{
  "version": 2,
  "buildCommand": "node tools/build-views.js",
  "functions": {
    "api/index.js": {
      "includeFiles": "{views,images}/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/backup", "schedule": "0 18 * * *" }
  ]
}
